    rdfs:domain aro:InterpretationRecord ;
    rdfs:range aro:InterpretiveAct .

aro:supportsInterpretation a owl:ObjectProperty ;
    rdfs:label "interpretation supports another"@en,
        "interpretação apoia outra"@pt-BR ;
    rdfs:domain aro:InterpretationRecord ;
    rdfs:range aro:InterpretationRecord .

aro:usesCriterion a owl:ObjectProperty ;
