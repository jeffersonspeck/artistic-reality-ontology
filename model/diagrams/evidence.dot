// Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.
digraph ontology {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.35", ranksep="0.75", fontname="Arial"];
node [shape=box, style="rounded,filled", color="#64748b", fontname="Arial", fontsize=10];
edge [color="#64748b", fontname="Arial", fontsize=8];
"EmpiricalCase" [label="«kind»\nEmpiricalCase",fillcolor="#d1fae5"];
"EmpiricalClaim" [label="«kind»\nEmpiricalClaim",fillcolor="#d1fae5"];
"ReferenceSource" [label="«kind»\nReferenceSource",fillcolor="#d1fae5"];
"EvidenceItem" [label="«kind»\nEvidenceItem",fillcolor="#d1fae5"];
"CorrespondenceClaim" [label="«kind»\nCorrespondenceClaim",fillcolor="#d1fae5"];
"EvidenceAssessment" [label="«kind»\nEvidenceAssessment",fillcolor="#d1fae5"];
"ExplanationHypothesis" [label="«kind»\nExplanationHypothesis",fillcolor="#d1fae5"];
"EmpiricalSituation" [label="«situation»\nEmpiricalSituation",fillcolor="#d1fae5"];
"EmpiricalEvent" [label="«event»\nEmpiricalEvent",fillcolor="#d1fae5"];
"EmpiricalCase" -> "EmpiricalSituation" [label="caseAboutSituation  [0..*]",arrowsize=.65];
"EmpiricalCase" -> "EmpiricalEvent" [label="caseAboutEvent  [0..*]",arrowsize=.65];
"CorrespondenceClaim" -> "EmpiricalCase" [label="assertsCase  [1]",arrowsize=.65];
"EvidenceItem" -> "ReferenceSource" [label="derivedFromSource  [1]",arrowsize=.65];
"EvidenceAssessment" -> "EmpiricalClaim" [label="supportsClaim  [0..1]",arrowsize=.65];
"EvidenceAssessment" -> "CorrespondenceClaim" [label="assessesCorrespondence  [0..1]",arrowsize=.65];
"EvidenceAssessment" -> "EvidenceItem" [label="assessesEvidence  [1..*]",arrowsize=.65];
"CorrespondenceClaim" -> "ReferenceSource" [label="referencesSource  [0..*]",arrowsize=.65];
"EmpiricalCase" -> "ReferenceSource" [label="caseHasReference  [0..*]",arrowsize=.65];
}