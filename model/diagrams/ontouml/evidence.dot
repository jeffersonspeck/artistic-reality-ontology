"CorrespondenceClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>CorrespondenceClaim</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"EvidenceAssessment" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>EvidenceAssessment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"ExplanationHypothesis" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>ExplanationHypothesis</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"EmpiricalSituation" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«situation»</FONT><BR/><B>EmpiricalSituation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"EmpiricalEvent" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>EmpiricalEvent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"DerivationClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>DerivationClaim</B></TD></TR></TABLE>>];
"InterpretationRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>InterpretationRecord</B></TD></TR></TABLE>>];
