"ReferenceSource" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>ReferenceSource</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">sourceURL : anyURI<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
