node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"EvidenceAssessment" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>EvidenceAssessment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"EmpiricalCase" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>EmpiricalCase</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"EmpiricalClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>EmpiricalClaim</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"ReferenceSource" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>ReferenceSource</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">sourceURL : anyURI<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"EvidenceItem" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>EvidenceItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"CorrespondenceClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>CorrespondenceClaim</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"ExplanationHypothesis" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>ExplanationHypothesis</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"EmpiricalSituation" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«situation»</FONT><BR/><B>EmpiricalSituation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">startDate : Literal<BR ALIGN="LEFT"/>endDate : Literal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"EmpiricalEvent" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d1fae5"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>EmpiricalEvent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">startDate : Literal<BR ALIGN="LEFT"/>endDate : Literal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"AnalyticalRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B><I>AnalyticalRecord</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"Assessment" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B><I>Assessment</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"Claim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B><I>Claim</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"SituationPattern" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>SituationPattern</B></TD></TR></TABLE>>];
"AnalyticalRecord" -> "ReferenceSource" [label="citesSource", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"EvidenceAssessment" -> "EvidenceItem" [label="assessesEvidence", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"EmpiricalCase" -> "EmpiricalSituation" [label="caseAboutSituation", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
