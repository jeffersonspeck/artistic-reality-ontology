"CorrespondenceClaim" -> "EmpiricalCase" [label="assertsCase", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"EvidenceItem" -> "ReferenceSource" [label="derivedFromSource", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"ExplanationHypothesis" -> "SituationPattern" [label="explainsPattern", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"EvidenceAssessment" -> "Assessment" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
