// Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.
digraph ontouml {
graph [rankdir=BT, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="0.8", fontname="Arial", fontsize=14, labeljust="l", newrank=true, splines=true];
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"Agent" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«category»</FONT><BR/><B><I>Agent</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Person" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Person</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Collective" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«collective»</FONT><BR/><B>Collective</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Analyst" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«roleMixin»</FONT><BR/><B>Analyst</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"CreativeAgent" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«roleMixin»</FONT><BR/><B>CreativeAgent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"PersonAnalyst" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«role»</FONT><BR/><B>PersonAnalyst</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"CollectiveAnalyst" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«role»</FONT><BR/><B>CollectiveAnalyst</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"PersonCreator" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«role»</FONT><BR/><B>PersonCreator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"CollectiveCreator" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ccfbf1"><FONT POINT-SIZE="9">«role»</FONT><BR/><B>CollectiveCreator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"CreativeContribution" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«relator»</FONT><BR/><B>CreativeContribution</B></TD></TR></TABLE>>];
"InterpretiveAct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>InterpretiveAct</B></TD></TR></TABLE>>];
"InterpretiveAct" -> "Analyst" [label="«participation»\nhasParticipant", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"CreativeContribution" -> "CreativeAgent" [label="«mediation»\ncontributionBy", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"Person" -> "Agent" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Collective" -> "Agent" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Analyst" -> "Agent" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"CreativeAgent" -> "Agent" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"PersonAnalyst" -> "Person" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"PersonAnalyst" -> "Analyst" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"CollectiveAnalyst" -> "Collective" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"CollectiveAnalyst" -> "Analyst" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"PersonCreator" -> "Person" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"PersonCreator" -> "CreativeAgent" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"CollectiveCreator" -> "Collective" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"CollectiveCreator" -> "CreativeAgent" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
}