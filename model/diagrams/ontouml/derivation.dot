node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"DerivationClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffedd5"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>DerivationClaim</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">derivationExtent : langString<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
