"ArtisticEntity" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«category»</FONT><BR/><B><I>ArtisticEntity</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"Claim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B><I>Claim</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
