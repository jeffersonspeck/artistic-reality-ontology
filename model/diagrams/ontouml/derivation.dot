"Selection" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Selection</B></TD></TR></TABLE>>];
"SituationPattern" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>SituationPattern</B></TD></TR></TABLE>>];
"DerivationClaim" -> "ArtisticEntity" [label="hasSourceAnchor", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
