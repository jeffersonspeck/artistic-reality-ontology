"CreativeAct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffedd5"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>CreativeAct</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">startDate : Literal<BR ALIGN="LEFT"/>endDate : Literal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"CreativeContribution" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffedd5"><FONT POINT-SIZE="9">«relator»</FONT><BR/><B>CreativeContribution</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"DerivationType" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffedd5"><FONT POINT-SIZE="9">«type»</FONT><BR/><B>DerivationType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"DerivationRegime" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffedd5"><FONT POINT-SIZE="9">«type»</FONT><BR/><B>DerivationRegime</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
