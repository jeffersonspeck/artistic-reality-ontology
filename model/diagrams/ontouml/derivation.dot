"TransformationAspect" -> "Selection" [label="aspectDerivedSelection", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"TransformationAspect" -> "SituationPattern" [label="aspectConcernsPattern", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "CreativeAct" [label="derivationRealizedBy", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"CreativeAct" -> "ArtisticEntity" [label="«creation»\nproducesCreation", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"CreativeAct" -> "CreativeContribution" [label="«creation»\nhasContribution", taillabel="1", headlabel="0..*", arrowhead=open, labelfontsize=8];
"CreativeContribution" -> "CreativeAgent" [label="«mediation»\ncontributionBy", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"CreativeContribution" -> "ArtisticEntity" [label="«mediation»\ncontributionTo", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"CreativeContribution" -> "CreativeRole" [label="«instantiation»\ncontributionRole", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
