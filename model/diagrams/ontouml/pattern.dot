"SituationPattern" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fce7f3"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>SituationPattern</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"PatternCondition" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fce7f3"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>PatternCondition</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">isRequiredCondition : boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"AnalyticalRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B><I>AnalyticalRecord</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"CorrespondenceClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>CorrespondenceClaim</B></TD></TR></TABLE>>];
"ExplanationHypothesis" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>ExplanationHypothesis</B></TD></TR></TABLE>>];
"SituationDescription" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>SituationDescription</B></TD></TR></TABLE>>];
"TransformationAspect" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>TransformationAspect</B></TD></TR></TABLE>>];
"SituationDescription" -> "SituationPattern" [label="generalizesAs", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"SituationPattern" -> "PatternCondition" [label="hasCondition", taillabel="1", headlabel="1..*", arrowhead=open, labelfontsize=8];
"CorrespondenceClaim" -> "SituationPattern" [label="assertsPattern", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"ExplanationHypothesis" -> "SituationPattern" [label="explainsPattern", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"TransformationAspect" -> "SituationPattern" [label="aspectConcernsPattern", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
