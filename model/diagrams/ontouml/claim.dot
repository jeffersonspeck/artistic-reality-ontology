// Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.
digraph ontouml {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="0.8", fontname="Arial", fontsize=14, labeljust="l", newrank=true, splines=true];
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"AnalyticalRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B><I>AnalyticalRecord</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Claim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B><I>Claim</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Justification" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>Justification</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Challenge" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>Challenge</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Assessment" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B><I>Assessment</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">assessmentOutcome : string<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"CriteriaAssessment" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>CriteriaAssessment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"AssessmentCriterion" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>AssessmentCriterion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"EpistemicCriterion" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>EpistemicCriterion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"ValueCriterion" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e0e7ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>ValueCriterion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"InterpretiveAct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>InterpretiveAct</B></TD></TR></TABLE>>];
"ReferenceSource" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>ReferenceSource</B></TD></TR></TABLE>>];
"AnalyticalRecord" -> "InterpretiveAct" [label="«creation»\nproducedByAct", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"Claim" -> "Justification" [label="hasJustification", taillabel="1", headlabel="0..*", arrowhead=open, labelfontsize=8];
"AnalyticalRecord" -> "ReferenceSource" [label="citesSource", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"Challenge" -> "Claim" [label="challenges", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"Assessment" -> "Claim" [label="assessesClaim", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"CriteriaAssessment" -> "AssessmentCriterion" [label="usesCriterion", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"Claim" -> "AnalyticalRecord" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Justification" -> "AnalyticalRecord" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Challenge" -> "Claim" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Assessment" -> "AnalyticalRecord" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"CriteriaAssessment" -> "Assessment" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"AssessmentCriterion" -> "AnalyticalRecord" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"EpistemicCriterion" -> "AssessmentCriterion" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"ValueCriterion" -> "AssessmentCriterion" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
}