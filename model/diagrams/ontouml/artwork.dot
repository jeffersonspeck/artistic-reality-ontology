// Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.
digraph ontouml {
graph [rankdir=BT, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="0.8", fontname="Arial", fontsize=12, labeljust="l", newrank=true, splines=true];
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"Artwork" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Artwork</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Manifestation" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Manifestation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Selection" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Selection</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">selectorExpression : string<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"AnalysisUnit" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>AnalysisUnit</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"CreativeAct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>CreativeAct</B></TD></TR></TABLE>>];
"DerivationClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>DerivationClaim</B></TD></TR></TABLE>>];
"InterpretationRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>InterpretationRecord</B></TD></TR></TABLE>>];
"TransformationAspect" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>TransformationAspect</B></TD></TR></TABLE>>];
"Artwork" -> "Manifestation" [label="hasManifestation", taillabel="1", headlabel="1..*", arrowhead=open, labelfontsize=8];
"Manifestation" -> "Artwork" [label="realizesArtwork", taillabel="1..*", headlabel="1", arrowhead=open, labelfontsize=8];
"Selection" -> "Manifestation" [label="selectsFrom", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"Selection" -> "oa:Selector" [label="hasSelector", taillabel="1", headlabel="0..*", arrowhead=open, labelfontsize=8];
"AnalysisUnit" -> "Selection" [label="groupsSelection", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "Selection" [label="hasPrimarySelection", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "Selection" [label="hasSupportingSelection", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "Artwork" [label="hasSourceAnchor {union}", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "Manifestation" [label="hasSourceAnchor {union}", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "Selection" [label="hasSourceAnchor {union}", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "Artwork" [label="hasDerivedAnchor {union}", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "Manifestation" [label="hasDerivedAnchor {union}", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "Selection" [label="hasDerivedAnchor {union}", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"TransformationAspect" -> "Selection" [label="aspectSourceSelection", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"TransformationAspect" -> "Selection" [label="aspectDerivedSelection", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"CreativeAct" -> "Artwork" [label="«creation»\nproducesCreation {union}", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"CreativeAct" -> "Manifestation" [label="«creation»\nproducesCreation {union}", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"oa:Selector" [shape=box, style="rounded,dashed", color="#94a3b8", fontcolor="#475569", label="oa:Selector\n(external)"];
}