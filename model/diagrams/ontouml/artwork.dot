// Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.
digraph ontouml {
graph [rankdir=BT, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="0.8", fontname="Arial", fontsize=14, labeljust="l", newrank=true, splines=true];
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"ArtisticEntity" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«category»</FONT><BR/><B><I>ArtisticEntity</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Artwork" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Artwork</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Expression" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Expression</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Manifestation" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Manifestation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Selection" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Selection</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">selectorExpression : string<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"AnalysisUnit" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>AnalysisUnit</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"AnalyticalRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B><I>AnalyticalRecord</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"CreativeAct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>CreativeAct</B></TD></TR></TABLE>>];
"CreativeContribution" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«relator»</FONT><BR/><B>CreativeContribution</B></TD></TR></TABLE>>];
"DerivationClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>DerivationClaim</B></TD></TR></TABLE>>];
"InterpretationRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>InterpretationRecord</B></TD></TR></TABLE>>];
"TransformationAspect" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>TransformationAspect</B></TD></TR></TABLE>>];
"Artwork" -> "Expression" [label="hasExpression", taillabel="1", headlabel="1..*", arrowhead=open, labelfontsize=8];
"Expression" -> "Artwork" [label="realizesArtwork", taillabel="1..*", headlabel="1", arrowhead=open, labelfontsize=8];
"Expression" -> "Manifestation" [label="hasManifestation", taillabel="1..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"Manifestation" -> "Expression" [label="embodiesExpression", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"Selection" -> "Expression" [label="selectsFrom", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"Selection" -> "Manifestation" [label="locatedInManifestation", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"Selection" -> "oa:Selector" [label="hasSelector", taillabel="1", headlabel="0..*", arrowhead=open, labelfontsize=8];
"AnalysisUnit" -> "Selection" [label="groupsSelection", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "Selection" [label="hasPrimarySelection", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "Selection" [label="hasSupportingSelection", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "ArtisticEntity" [label="hasSourceAnchor", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "ArtisticEntity" [label="hasDerivedAnchor", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"TransformationAspect" -> "Selection" [label="aspectSourceSelection", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"TransformationAspect" -> "Selection" [label="aspectDerivedSelection", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"CreativeAct" -> "ArtisticEntity" [label="«creation»\nproducesCreation", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"CreativeContribution" -> "ArtisticEntity" [label="«mediation»\ncontributionTo", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"oa:Selector" [shape=box, style="rounded,dashed", color="#94a3b8", fontcolor="#475569", label="oa:Selector\n(external)"];
"Artwork" -> "ArtisticEntity" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Expression" -> "ArtisticEntity" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Manifestation" -> "ArtisticEntity" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"Selection" -> "ArtisticEntity" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
"AnalysisUnit" -> "AnalyticalRecord" [arrowhead=empty, arrowsize=1.1, color="#0f172a"];
}