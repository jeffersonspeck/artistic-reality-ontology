node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"InterpretationRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>InterpretationRecord</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"InterpretiveAct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>InterpretiveAct</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9">startDate : Literal<BR ALIGN="LEFT"/>endDate : Literal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Analyst" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«roleMixin»</FONT><BR/><B>Analyst</B></TD></TR></TABLE>>];
"AnalyticalRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B><I>AnalyticalRecord</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"Claim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B><I>Claim</I></B><BR/><FONT POINT-SIZE="8">{abstract}</FONT></TD></TR></TABLE>>];
"Selection" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Selection</B></TD></TR></TABLE>>];
"SituationDescription" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«subkind»</FONT><BR/><B>SituationDescription</B></TD></TR></TABLE>>];
"AnalyticalRecord" -> "InterpretiveAct" [label="«creation»\nproducedByAct", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "Selection" [label="hasPrimarySelection", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "Selection" [label="hasSupportingSelection", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"InterpretiveAct" -> "Analyst" [label="«participation»\nhasParticipant", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "SituationDescription" [label="describesSituation", taillabel="1..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "InterpretationRecord" [label="supportsInterpretation", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
