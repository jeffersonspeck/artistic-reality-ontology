// Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.
digraph ontouml {
graph [rankdir=BT, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="0.8", fontname="Arial", fontsize=14, labeljust="l", newrank=true, splines=true];
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8, color="#475569", arrowsize=0.7];
"InterpretationRecord" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>InterpretationRecord</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"InterpretiveAct" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«event»</FONT><BR/><B>InterpretiveAct</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"Analyst" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«roleMixin»</FONT><BR/><B>Analyst</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"InterpretiveJustification" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>InterpretiveJustification</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"InterpretationChallenge" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>InterpretationChallenge</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"InterpretationAssessment" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>InterpretationAssessment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"AssessmentCriterion" [shape=plain, label=<<TABLE BORDER="1" COLOR="#334155" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>AssessmentCriterion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
"DerivationClaim" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>DerivationClaim</B></TD></TR></TABLE>>];
"ReferenceSource" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>ReferenceSource</B></TD></TR></TABLE>>];
"Selection" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>Selection</B></TD></TR></TABLE>>];
"SituationDescription" [shape=plain, label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8fafc"><FONT POINT-SIZE="9">«kind»</FONT><BR/><B>SituationDescription</B></TD></TR></TABLE>>];
"InterpretationRecord" -> "Selection" [label="hasPrimarySelection", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "Selection" [label="hasSupportingSelection", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "InterpretiveAct" [label="«creation»\nproducedByAct", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"InterpretiveAct" -> "Analyst" [label="«participation»\nhasParticipant", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "InterpretiveJustification" [label="hasJustification", taillabel="1", headlabel="0..*", arrowhead=open, labelfontsize=8];
"InterpretationChallenge" -> "InterpretationRecord" [label="challenges", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"InterpretationAssessment" -> "InterpretationRecord" [label="assessesInterpretation", taillabel="0..*", headlabel="1", arrowhead=open, labelfontsize=8];
"InterpretationAssessment" -> "AssessmentCriterion" [label="usesCriterion", taillabel="0..*", headlabel="1..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "SituationDescription" [label="describesSituation", taillabel="1..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "ReferenceSource" [label="citesSource", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"InterpretationRecord" -> "InterpretationRecord" [label="supportsInterpretation", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "InterpretiveJustification" [label="derivationJustifiedBy", taillabel="0..*", headlabel="0..*", arrowhead=open, labelfontsize=8];
"DerivationClaim" -> "InterpretiveAct" [label="«creation»\nclaimProducedByAct", taillabel="0..*", headlabel="0..1", arrowhead=open, labelfontsize=8];
}