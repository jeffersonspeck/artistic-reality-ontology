// Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.
digraph modules {
graph [rankdir=LR, compound=true, bgcolor="white", pad="0.3", nodesep="0.3", ranksep="0.9", fontname="Arial", fontsize=13, labeljust="l", newrank=true];
node [shape=box, style="rounded,filled", color="#475569", fillcolor="white", fontname="Arial", fontsize=10];
edge [color="#64748b", fontname="Arial", fontsize=8, arrowsize=.6];
subgraph "cluster_artwork" {
label="Artwork and selection"; style="rounded,filled"; fillcolor="#dbeafe"; color="#dbeafe";
"Artwork" [label="Artwork\n«kind»"];
"Manifestation" [label="Manifestation\n«kind»"];
"Selection" [label="Selection\n«kind»"];
}
subgraph "cluster_interpretation" {
label="Interpretation"; style="rounded,filled"; fillcolor="#e9d5ff"; color="#e9d5ff";
"InterpretationRecord" [label="InterpretationRecord\n«kind»"];
"InterpretiveAct" [label="InterpretiveAct\n«event»"];
"Analyst" [label="Analyst\n«roleMixin»"];
"InterpretiveJustification" [label="InterpretiveJustification\n«kind»"];
}
subgraph "cluster_representation" {
label="Representation"; style="rounded,filled"; fillcolor="#fef3c7"; color="#fef3c7";
"DepictedElement" [label="DepictedElement\n«kind»"];
"SituationDescription" [label="SituationDescription\n«kind»"];
}
subgraph "cluster_pattern" {
label="Situation pattern"; style="rounded,filled"; fillcolor="#fce7f3"; color="#fce7f3";
"SituationPattern" [label="SituationPattern\n«kind»"];
"PatternCondition" [label="PatternCondition\n«kind»"];
}
subgraph "cluster_evidence" {
label="Evidence and empirical world"; style="rounded,filled"; fillcolor="#d1fae5"; color="#d1fae5";
"EmpiricalCase" [label="EmpiricalCase\n«kind»"];
"ReferenceSource" [label="ReferenceSource\n«kind»"];
"EvidenceItem" [label="EvidenceItem\n«kind»"];
"CorrespondenceClaim" [label="CorrespondenceClaim\n«kind»"];
"EvidenceAssessment" [label="EvidenceAssessment\n«kind»"];
"ExplanationHypothesis" [label="ExplanationHypothesis\n«kind»"];
"EmpiricalSituation" [label="EmpiricalSituation\n«situation»"];
}
subgraph "cluster_derivation" {
label="Derivation and creation"; style="rounded,filled"; fillcolor="#ffedd5"; color="#ffedd5";
"DerivationClaim" [label="DerivationClaim\n«kind»"];
"TransformationAspect" [label="TransformationAspect\n«kind»"];
"CreativeAct" [label="CreativeAct\n«event»"];
"CreativeAgent" [label="CreativeAgent\n«roleMixin»"];
"CreativeContribution" [label="CreativeContribution\n«relator»"];
}
"Manifestation" -> "Artwork" [label="realizesArtwork"];
"Selection" -> "Manifestation" [label="selectsFrom"];
"InterpretationRecord" -> "Selection" [label="hasPrimarySelection"];
"InterpretationRecord" -> "InterpretiveAct" [label="producedByAct"];
"InterpretiveAct" -> "Analyst" [label="hasParticipant"];
"InterpretationRecord" -> "InterpretiveJustification" [label="hasJustification"];
"InterpretationRecord" -> "SituationDescription" [label="describesSituation"];
"SituationDescription" -> "DepictedElement" [label="mentionsDepictedElement"];
"SituationDescription" -> "SituationPattern" [label="generalizesAs"];
"SituationPattern" -> "PatternCondition" [label="hasCondition"];
"CorrespondenceClaim" -> "SituationPattern" [label="assertsPattern"];
"CorrespondenceClaim" -> "EmpiricalCase" [label="assertsCase"];
"EmpiricalCase" -> "EmpiricalSituation" [label="caseAboutSituation"];
"EmpiricalCase" -> "ReferenceSource" [label="caseHasReference"];
"EvidenceItem" -> "ReferenceSource" [label="derivedFromSource"];
"EvidenceAssessment" -> "EvidenceItem" [label="assessesEvidence"];
"EvidenceAssessment" -> "CorrespondenceClaim" [label="assessesCorrespondence"];
"ExplanationHypothesis" -> "SituationPattern" [label="explainsPattern"];
"DerivationClaim" -> "Manifestation" [label="hasSourceAnchor", lhead="cluster_artwork"];
"DerivationClaim" -> "Manifestation" [label="hasDerivedAnchor", lhead="cluster_artwork"];
"DerivationClaim" -> "TransformationAspect" [label="hasTransformation"];
"TransformationAspect" -> "SituationPattern" [label="aspectConcernsPattern"];
"DerivationClaim" -> "InterpretiveJustification" [label="derivationJustifiedBy"];
"DerivationClaim" -> "CreativeAct" [label="derivationRealizedBy"];
"CreativeAct" -> "Manifestation" [label="producesCreation", lhead="cluster_artwork"];
"CreativeAct" -> "CreativeContribution" [label="hasContribution"];
"CreativeContribution" -> "CreativeAgent" [label="contributionBy"];
"EvidenceAssessment" -> "DerivationClaim" [label="assessesDerivation"];
}