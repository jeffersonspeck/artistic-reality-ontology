<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand. -->
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#assertsPattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">correspondence references pattern</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação referencia padrão</rdfs:label>
    <skos:definition xml:lang="en">Links a correspondence claim to the situation pattern it compares with a real case: the side of art in the claim that art and reality correspond.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma alegação de correspondência ao padrão situacional que ela compara com um caso real: o lado da arte na alegação de que arte e realidade se correspondem.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CorrespondenceClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#SituationPattern"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd7c57cd767244519b2ce339f5444918c">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Artwork"/>
    <rdf:rest rdf:nodeID="Nb127767a2dcf479182925a2b549ce8d6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Continuation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">continuation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">continuação</skos:prefLabel>
    <skos:definition xml:lang="en">Work continuing the story of the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Obra que continua a história da origem.</skos:definition>
    <dcterms:source>Tillett 1991</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Extension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#contributionTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contribution is to artistic entity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">contribuição é para entidade artística</rdfs:label>
    <skos:definition xml:lang="en">Links a creative contribution to the artistic entities the agent contributed to (the work, the recording, the edition). With contributionBy, it gives the relator its two mediated ends.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma contribuição criativa às entidades artísticas para as quais o agente contribuiu (a obra, a gravação, a edição). Com contributionBy, dá ao relator suas duas pontas mediadas.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CreativeContribution"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DerivationClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">derivation claim</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação de derivação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim; neither a UFO relator nor an asserted fact; dependency: exactly one source anchor and one derived anchor; typed by at least one derivation type</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim; nem relator UFO nem fato afirmado; dependência: exatamente uma âncora de origem e uma derivada; tipificada por ao menos um tipo de derivação</rdfs:comment>
    <skos:definition xml:lang="en">Contestable assertion, made by an agent, that one artistic entity (artwork, expression, manifestation or selection) derives from another in specified ways. The derived entity is represented as a creation in its own right; legality and originality are outside the scope of the ontology.</skos:definition>
    <skos:definition xml:lang="pt-BR">Alegação contestável, feita por um agente, de que uma entidade artística (obra, expressão, manifestação ou recorte) deriva de outra de modos especificados. A entidade derivada é representada como criação por direito próprio; legalidade e originalidade estão fora do escopo da ontologia.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Claim"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/isBasedOn"/>
    <rdfs:seeAlso rdf:resource="http://www.wikidata.org/prop/direct/P144"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N029dc25794d9486d846ee9a6267ae596">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#DepictedElement"/>
    <rdf:rest rdf:nodeID="N217499186d964c36af9259e77bcc3e75"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#textValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">text value</rdfs:label>
    <rdfs:label xml:lang="pt-BR">valor textual</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable text (labels, descriptions, explanations). Use language-tagged literals; the same resource may carry one value per language.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Texto legível (rótulos, descrições, explicações). Use literais marcados por idioma; o mesmo recurso pode ter um valor por idioma.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#InterpretationRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interpretation record</rdfs:label>
    <rdfs:label xml:lang="pt-BR">registro de interpretação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: anchor selection; the interpretive act that produced it</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: recorte de ancoragem; o ato interpretativo que o produziu</rdfs:comment>
    <skos:definition xml:lang="en">Persistent authored record of an interpretation of a selection.</skos:definition>
    <skos:definition xml:lang="pt-BR">Registro autoral persistente de uma interpretação de recorte.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Claim"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ArtisticEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">artistic entity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">entidade artística</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: category; foundation: UFO-A rigid non-sortal (category) generalizing kinds with different identity principles; dependency: none of its own; each instance takes the identity of its kind</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: category; fundamentação: não-sortal rígido UFO-A (category) que generaliza kinds com princípios de identidade diferentes; dependência: nenhuma própria; cada instância tem a identidade de seu kind</rdfs:comment>
    <skos:definition xml:lang="en">Anything artistic that can be the origin or result of a derivation or a creative act: an artwork, an expression, a manifestation or a selection.</skos:definition>
    <skos:definition xml:lang="pt-BR">Tudo o que é artístico e pode ser origem ou resultado de uma derivação ou de um ato criativo: obra, expressão, manifestação ou recorte.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <owl:disjointUnionOf rdf:nodeID="Nd7c57cd767244519b2ce339f5444918c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Artistic Reality Ontology</dcterms:title>
    <dcterms:title xml:lang="pt-BR">Ontologia de Arte e Realidade</dcterms:title>
    <dcterms:description xml:lang="en">Operational OWL vocabulary inspired by UFO; not a complete translation of the OntoUML reference model. It represents claims made by agents and their grounds; it asserts no claim as true. Terms are identified in English and fully labelled and defined in English and Brazilian Portuguese; textual content may be recorded in any language using language-tagged literals.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">Vocabulário OWL operacional inspirado na UFO; não é tradução completa do modelo de referência OntoUML. Representa alegações feitas por agentes e seus fundamentos; não afirma nenhuma alegação como verdadeira. Os termos são identificados em inglês e integralmente rotulados e definidos em inglês e português do Brasil; o conteúdo textual pode ser registrado em qualquer idioma com literais marcados por idioma.</dcterms:description>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/aro/ontology/1.0.0"/>
    <owl:priorVersion rdf:resource="https://w3id.org/aro/ontology/0.3.0-beta"/>
    <dcterms:creator>Jefferson Rodrigo Speck (UFPR, PPGInf)</dcterms:creator>
    <dcterms:contributor>Roberto Pereira (UFPR) — doctoral supervisor</dcterms:contributor>
    <dcterms:contributor>Clodis Boscarioli (UNIOESTE) — doctoral co-supervisor</dcterms:contributor>
    <rdfs:comment xml:lang="en">Integral part of the doctoral research of Jefferson Rodrigo Speck in the Graduate Program in Informatics (PPGInf) of the Federal University of Paraná (UFPR), supervised by Prof. Dr. Roberto Pereira (UFPR) and co-supervised by Prof. Dr. Clodis Boscarioli (UNIOESTE), linked to the Research Group on Technology and Innovation in Education (GTIE), UNIOESTE.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Parte integrante da pesquisa de doutorado de Jefferson Rodrigo Speck no Programa de Pós-Graduação em Informática (PPGInf) da Universidade Federal do Paraná (UFPR), sob orientação do Prof. Dr. Roberto Pereira (UFPR) e coorientação do Prof. Dr. Clodis Boscarioli (UNIOESTE), com vinculação ao Grupo de Pesquisa em Tecnologia e Inovação na Educação (GTIE), UNIOESTE.</rdfs:comment>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/representation"/>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/pattern"/>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <dcterms:hasPart rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SatiricalRegime">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationRegime"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
    <skos:prefLabel xml:lang="en">satirical / critical</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">satírico / crítico</skos:prefLabel>
    <skos:definition xml:lang="en">Derivation aimed at mocking or criticizing the source or its world.</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação voltada a zombar ou criticar a origem ou seu mundo.</skos:definition>
    <dcterms:source>Genette 1982; Hutcheon 1985</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasDerivedAnchor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim names the derived entity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação indica entidade derivada</rdfs:label>
    <skos:definition xml:lang="en">Links a derivation claim to the entity said to derive from the source (any artistic entity): the derived side of the claim. It must differ from the source anchor.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma alegação de derivação à entidade que se diz derivar da origem (qualquer entidade artística): o lado derivado da alegação. Deve ser diferente da âncora de origem.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#DerivationClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#retrievedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">retrieved at</rdfs:label>
    <rdfs:label xml:lang="pt-BR">acessado em</rdfs:label>
    <rdfs:comment xml:lang="en">Capture provenance timestamp.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Momento de captura, para proveniência.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DerivationRegime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">derivation regime</rdfs:label>
    <rdfs:label xml:lang="pt-BR">regime de derivação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado</rdfs:comment>
    <skos:definition xml:lang="en">Stance of a derivation toward its source (playful, satirical, serious, reverential); its instances are SKOS concepts.</skos:definition>
    <skos:definition xml:lang="pt-BR">Postura da derivação em relação à origem (lúdica, satírica, séria, reverencial); suas instâncias são conceitos SKOS.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label xml:lang="en">end date</rdfs:label>
    <rdfs:label xml:lang="pt-BR">data de término</rdfs:label>
    <rdfs:comment xml:lang="en">When an act, event or situation ended. Year, year-month, date or date-time.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Quando um ato, evento ou situação terminou. Ano, ano-mês, data ou data-hora.</rdfs:comment>
    <rdfs:domain rdf:nodeID="N138ac48f1aeb4932bf420da647e73eb5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Expression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">expression</rdfs:label>
    <rdfs:label xml:lang="pt-BR">expressão</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: kind; foundation: UFO-C information object (content level); dependency: realizes exactly one artwork</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C (nível de conteúdo); dependência: realiza exatamente uma obra</rdfs:comment>
    <skos:definition xml:lang="en">Specific realization of an artwork with its own content: a performance or recording, a translation, an arrangement, a text version, a film cut (the LRM expression level).</skos:definition>
    <skos:definition xml:lang="pt-BR">Realização específica de uma obra com conteúdo próprio: uma interpretação ou gravação, uma tradução, um arranjo, uma versão do texto, uma montagem de filme (nível expressão do LRM).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
    <rdfs:seeAlso rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F2_Expression"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TransformationAspect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">transformation aspect</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aspecto de transformação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: host derivation claim; one dimension and one operation</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: alegação de derivação hospedeira; uma dimensão e uma operação</rdfs:comment>
    <skos:definition xml:lang="en">Recorded statement of what happened to one artistic dimension in a derivation (retained, modified, added, removed or recontextualized).</skos:definition>
    <skos:definition xml:lang="pt-BR">Registro do que ocorreu com uma dimensão artística numa derivação (mantida, modificada, acrescentada, removida ou recontextualizada).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#generalizesAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">description motivates pattern abstraction</rdfs:label>
    <rdfs:label xml:lang="pt-BR">descrição motiva abstração</rdfs:label>
    <skos:definition xml:lang="en">Links a situation description to a situation pattern abstracted from it: the reusable configuration that the represented situation is taken to exemplify.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma descrição de situação a um padrão situacional abstraído dela: a configuração reutilizável que a situação representada é tomada como exemplo.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/representation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#SituationDescription"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#SituationPattern"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CharacterDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">character</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">personagem</skos:prefLabel>
    <skos:definition xml:lang="en">Represented agents and their traits.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agentes representados e seus traços.</skos:definition>
    <dcterms:source>Chatman 1978</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Retained">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#TransformationOperation"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
    <skos:prefLabel xml:lang="en">retained</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">mantido</skos:prefLabel>
    <skos:definition xml:lang="en">Dimension kept substantially as in the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Dimensão mantida substancialmente como na origem.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Collective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collective</rdfs:label>
    <rdfs:label xml:lang="pt-BR">coletivo</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: collective; foundation: UFO-A collective; agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: its members, under a unifying relation</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: collective; fundamentação: coletivo UFO-A; agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: seus membros, sob uma relação unificadora</rdfs:comment>
    <skos:definition xml:lang="en">Group of agents acting as one: a band, a company, a research group, a film crew, a publisher.</skos:definition>
    <skos:definition xml:lang="pt-BR">Grupo de agentes que age como um: banda, companhia, grupo de pesquisa, equipe de filmagem, editora.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Agent"/>
    <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Group"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Organization"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/MusicGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#MiseEnSceneDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">mise-en-scène</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">mise-en-scène</skos:prefLabel>
    <skos:definition xml:lang="en">What is placed before the camera.</skos:definition>
    <skos:definition xml:lang="pt-BR">O que é posto diante da câmera.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#AudiovisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#HarmonyDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">harmony</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">harmonia</skos:prefLabel>
    <skos:definition xml:lang="en">Chordal and tonal organization.</skos:definition>
    <skos:definition xml:lang="pt-BR">Organização acordal e tonal.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#PlotDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">plot</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">enredo</skos:prefLabel>
    <skos:definition xml:lang="en">Sequence of represented events.</skos:definition>
    <skos:definition xml:lang="pt-BR">Sequência de eventos representados.</skos:definition>
    <dcterms:source>Chatman 1978</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#startDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label xml:lang="en">start date</rdfs:label>
    <rdfs:label xml:lang="pt-BR">data de início</rdfs:label>
    <rdfs:comment xml:lang="en">When an act, event or situation began (or happened, if it has no duration). Year, year-month, date or date-time.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Quando um ato, evento ou situação começou (ou aconteceu, se não tem duração). Ano, ano-mês, data ou data-hora.</rdfs:comment>
    <rdfs:domain rdf:nodeID="Nd4e7ce8d42a247f89bd3c233ee3af69a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CreativeRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">creative role</rdfs:label>
    <rdfs:label xml:lang="pt-BR">papel criativo</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: type; foundation: UFO role type; operationalized as skos:Concept; dependency: controlled vocabulary membership</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: type; fundamentação: tipo de papel UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado</rdfs:comment>
    <skos:definition xml:lang="en">Role qualifying a creative contribution (composer, performer, translator, remixer...).</skos:definition>
    <skos:definition xml:lang="pt-BR">Papel que qualifica uma contribuição criativa (compositor, intérprete, tradutor, remixador...).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#aspectDerivedSelection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">aspect points to derived selection</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aspecto aponta recorte derivado</rdfs:label>
    <skos:definition xml:lang="en">Points a transformation aspect to the excerpt of the derived entity where the transformed dimension can be observed.</skos:definition>
    <skos:definition xml:lang="pt-BR">Aponta um aspecto de transformação para o trecho da entidade derivada em que a dimensão transformada pode ser observada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#TransformationAspect"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Selection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TempoDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">tempo</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">andamento</skos:prefLabel>
    <skos:definition xml:lang="en">Speed and its changes.</skos:definition>
    <skos:definition xml:lang="pt-BR">Velocidade e suas variações.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#AnalyticalRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">analytical record</rdfs:label>
    <rdfs:label xml:lang="pt-BR">registro analítico</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: kind; foundation: UFO-C information object; the single kind supplying the identity of every analytical record (ADR-026); dependency: historically on the act or agent that recorded it</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; o único kind que fornece a identidade de todo registro analítico (ADR-026); dependência: historicamente do ato ou agente que o registrou</rdfs:comment>
    <skos:definition xml:lang="en">Information object recorded by an agent in the course of an analysis: the common sort of interpretations, descriptions, patterns, cases, evidence items, claims, justifications and assessments. Two records with the same text by different agents or acts are different records.</skos:definition>
    <skos:definition xml:lang="pt-BR">Objeto informacional registrado por um agente no curso de uma análise: o tipo comum de interpretações, descrições, padrões, casos, itens de evidência, alegações, justificativas e avaliações. Dois registros com o mesmo texto feitos por agentes ou atos diferentes são registros diferentes.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <owl:disjointUnionOf rdf:nodeID="N8dbd5cd8c5e04962b8cedaae0c2bb228"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#MusicalTextureDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">musical texture</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">textura musical</skos:prefLabel>
    <skos:definition xml:lang="en">Relation among simultaneous lines (monophony, homophony, polyphony).</skos:definition>
    <skos:definition xml:lang="pt-BR">Relação entre linhas simultâneas (monofonia, homofonia, polifonia).</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#usesCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assessment follows criteria</rdfs:label>
    <rdfs:label xml:lang="pt-BR">avaliação usa critérios</rdfs:label>
    <skos:definition xml:lang="en">Links a criteria assessment to the explicit criteria it applies, so that the basis of the judgment can be inspected and compared.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma avaliação por critérios aos critérios explícitos que ela aplica, para que a base do julgamento possa ser examinada e comparada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CriteriaAssessment"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#AssessmentCriterion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#IntentionalStateDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">intentional state description</rdfs:label>
    <rdfs:label xml:lang="pt-BR">descrição de estado intencional</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C intentional content attribution; dependency: inherits SituationDescription identity</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: atribuição de conteúdo intencional UFO-C; dependência: herda a identidade de SituationDescription</rdfs:comment>
    <skos:definition xml:lang="en">Situation description attributing desire, belief or intention to a depicted agent.</skos:definition>
    <skos:definition xml:lang="pt-BR">Descrição de situação que atribui desejo, crença ou intenção a agente representado.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/representation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#SituationDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#PatternCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pattern condition</rdfs:label>
    <rdfs:label xml:lang="pt-BR">condição de padrão</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: host pattern and logical specification</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: padrão hospedeiro e especificação lógica</rdfs:comment>
    <skos:definition xml:lang="en">Individuated mandatory or optional condition within a pattern.</skos:definition>
    <skos:definition xml:lang="pt-BR">Condição individualizada obrigatória ou opcional de um padrão.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/pattern"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#locatedInManifestation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">selection located in manifestation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">recorte localizado em manifestação</rdfs:label>
    <skos:definition xml:lang="en">Links a selection to the specific manifestation its selectors refer to, when the location depends on the edition (a page of a given book edition, a timestamp in a given release).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um recorte à manifestação específica a que seus seletores se referem, quando a localização depende da edição (página de uma edição do livro, minutagem de um lançamento).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Selection"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasDerivationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim is typed by derivation kind</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação tipificada por tipo de derivação</rdfs:label>
    <skos:definition xml:lang="en">Classifies a derivation claim with one or more concepts of the derivation-type vocabulary (cover, sampling, translation, parody...).</skos:definition>
    <skos:definition xml:lang="pt-BR">Classifica uma alegação de derivação com um ou mais conceitos do vocabulário de tipos de derivação (cover, sampling, tradução, paródia...).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#DerivationClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#caseAboutEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dossier describes real events</rdfs:label>
    <rdfs:label xml:lang="pt-BR">dossiê descreve evento</rdfs:label>
    <skos:definition xml:lang="en">Links an empirical case (a documented dossier) to the real-world events it documents.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um caso empírico (dossiê documentado) aos eventos do mundo real que ele documenta.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#EmpiricalCase"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#EmpiricalEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TransformationOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">transformation operation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">operação de transformação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado</rdfs:comment>
    <skos:definition xml:lang="en">What a derivation does to a dimension: retain, modify, add, remove or recontextualize.</skos:definition>
    <skos:definition xml:lang="pt-BR">O que a derivação faz com uma dimensão: manter, modificar, acrescentar, remover ou recontextualizar.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#IntermedialAdaptation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">intermedial adaptation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">adaptação intermidiática</skos:prefLabel>
    <skos:definition xml:lang="en">Adaptation across media (novel to film, film to game, song to music video, novelization).</skos:definition>
    <skos:definition xml:lang="pt-BR">Adaptação entre mídias (romance para filme, filme para jogo, canção para videoclipe, novelização).</skos:definition>
    <dcterms:source>Rajewsky 2005 (medial transposition); Hutcheon 2006</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Adaptation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Challenge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">challenge</rdfs:label>
    <rdfs:label xml:lang="pt-BR">contestação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: the challenged claim and its own argument</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: a alegação contestada e seu próprio argumento</rdfs:comment>
    <skos:definition xml:lang="en">Claim that criticizes another claim or offers an alternative to it; being a claim itself, it can be justified, assessed and challenged in turn.</skos:definition>
    <skos:definition xml:lang="pt-BR">Alegação que critica outra alegação ou propõe alternativa a ela; sendo também alegação, pode por sua vez ser justificada, avaliada e contestada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ValueCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">value criterion</rdfs:label>
    <rdfs:label xml:lang="pt-BR">critério de valor</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C normative information object (subkind of AssessmentCriterion); dependency: inherits AssessmentCriterion identity</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional normativo UFO-C (subkind de AssessmentCriterion); dependência: herda a identidade de AssessmentCriterion</rdfs:comment>
    <skos:definition xml:lang="en">Criterion about worth: whether a claim or reading is relevant, fair, original or ethically adequate, independently of being true.</skos:definition>
    <skos:definition xml:lang="pt-BR">Critério sobre mérito: se uma alegação ou leitura é relevante, justa, original ou eticamente adequada, independentemente de ser verdadeira.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AssessmentCriterion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#assessesClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assessment judges claims</rdfs:label>
    <rdfs:label xml:lang="pt-BR">avaliação julga alegações</rdfs:label>
    <skos:definition xml:lang="en">Links an assessment to the claims it judges: an interpretation, a derivation, a correspondence, an empirical claim, a hypothesis or a challenge. Usually one; several when the same evidence bears on closely related claims (e.g. an empirical claim and the correspondence that relies on it).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma avaliação às alegações que ela julga: interpretação, derivação, correspondência, afirmação empírica, hipótese ou contestação. Em geral uma; várias quando a mesma evidência incide sobre alegações intimamente relacionadas (ex.: uma afirmação empírica e a correspondência que nela se apoia).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Assessment"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#derivationRealizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">derivation carried out by creative act</rdfs:label>
    <rdfs:label xml:lang="pt-BR">derivação realizada por ato criativo</rdfs:label>
    <skos:definition xml:lang="en">Links a derivation claim to the creative act that carried out the derivation (the recording, writing or adaptation that produced the derived entity).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma alegação de derivação ao ato criativo que realizou a derivação (a gravação, escrita ou adaptação que produziu a entidade derivada).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#DerivationClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#CreativeAct"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CoverVersion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">cover version</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">versão cover</skos:prefLabel>
    <skos:definition xml:lang="en">Popular-music performance or recording of an existing song by other performers; the term is systematically ambiguous, so record dimensions too. The covering artist is a creator in their own right.</skos:definition>
    <skos:definition xml:lang="pt-BR">Interpretação ou gravação de canção popular existente por outros intérpretes; termo sistematicamente ambíguo, por isso registre também as dimensões. O artista do cover é criador por direito próprio.</skos:definition>
    <dcterms:source>Mosser 2008; Mag Uidhir, Magnus &amp; Magnus 2013</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Performance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DerivationRegimeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Derivation regimes</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Regimes de derivação</skos:prefLabel>
    <skos:definition xml:lang="en">Stance of a derivation toward its source, orthogonal to its type (after Genette's regimes).</skos:definition>
    <skos:definition xml:lang="pt-BR">Postura da derivação em relação à origem, ortogonal ao tipo (a partir dos regimes de Genette).</skos:definition>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#PlayfulRegime"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#SatiricalRegime"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#SeriousRegime"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#ReverentialRegime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CriteriaAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">criteria assessment</rdfs:label>
    <rdfs:label xml:lang="pt-BR">avaliação por critérios</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Assessment; dependency: the assessed claim and its criteria</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Assessment; dependência: a alegação avaliada e seus critérios</rdfs:comment>
    <skos:definition xml:lang="en">Assessment of a claim against explicit epistemic or value criteria (plausibility, coherence, fidelity...).</skos:definition>
    <skos:definition xml:lang="pt-BR">Avaliação de uma alegação segundo critérios epistêmicos ou de valor explícitos (plausibilidade, coerência, fidelidade...).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Assessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TransformationOperationScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Transformation operations</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Operações de transformação</skos:prefLabel>
    <skos:definition xml:lang="en">What a derivation does to one artistic dimension.</skos:definition>
    <skos:definition xml:lang="pt-BR">O que uma derivação faz com uma dimensão artística.</skos:definition>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Retained"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Modified"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Added"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Removed"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Recontextualized"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#IconographyDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">iconography / motif</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">iconografia / motivo</skos:prefLabel>
    <skos:definition xml:lang="en">Conventional subjects, motifs, symbols and attributes.</skos:definition>
    <skos:definition xml:lang="pt-BR">Temas convencionais, motivos, símbolos e atributos.</skos:definition>
    <dcterms:source>Panofsky 1939</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#VisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#confidenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">confidence score</rdfs:label>
    <rdfs:label xml:lang="pt-BR">grau de confiança</rdfs:label>
    <rdfs:comment xml:lang="en">Application-defined confidence in [0,1]; not a calibrated probability.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Confiança definida pela aplicação em [0,1]; não é probabilidade calibrada.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N108423024a9a4f33b3066ea484386a29">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#EvidenceAssessment"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Sequel">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">sequel</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">sequência</skos:prefLabel>
    <skos:definition xml:lang="en">Continuation set after the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Continuação situada depois da origem.</skos:definition>
    <dcterms:source>Tillett 1991</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Continuation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#contributionRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contribution qualified by role</rdfs:label>
    <rdfs:label xml:lang="pt-BR">contribuição qualificada por papel</rdfs:label>
    <skos:definition xml:lang="en">Qualifies a creative contribution with one or more roles of the creative-role vocabulary (composer, performer, translator, remixer...).</skos:definition>
    <skos:definition xml:lang="pt-BR">Qualifica uma contribuição criativa com um ou mais papéis do vocabulário de papéis criativos (compositor, intérprete, tradutor, remixador...).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CreativeContribution"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SeriousRegime">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationRegime"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
    <skos:prefLabel xml:lang="en">serious</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">sério</skos:prefLabel>
    <skos:definition xml:lang="en">Derivation without comic or critical aim.</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação sem objetivo cômico ou crítico.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Ekphrasis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">ekphrasis</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">écfrase</skos:prefLabel>
    <skos:definition xml:lang="en">Representation in one medium of a work from another medium (e.g. poem about a painting); an intermedial reference.</skos:definition>
    <skos:definition xml:lang="pt-BR">Representação, numa mídia, de obra de outra mídia (ex. poema sobre pintura); referência intermidiática.</skos:definition>
    <dcterms:source>Rajewsky 2005 (intermedial reference)</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Revision">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">revision</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">revisão / nova versão</skos:prefLabel>
    <skos:definition xml:lang="en">Successive version by the same or authorized agents (revised edition, director's cut, remaster).</skos:definition>
    <skos:definition xml:lang="pt-BR">Versão sucessiva pelos mesmos agentes ou autorizados (edição revista, director's cut, remasterização).</skos:definition>
    <dcterms:source>Smiraglia 2001 (successive derivations)</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Manifestation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">manifestation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">manifestação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: kind; foundation: UFO-C information artifact (carrier level); dependency: embodies at least one expression</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: kind; fundamentação: artefato informacional UFO-C (nível de suporte); dependência: materializa ao menos uma expressão</rdfs:comment>
    <skos:definition xml:lang="en">Publication or carrier that embodies one or more expressions: an album edition, a book edition, a broadcast, a digital release (the LRM manifestation level). Optional: record it when the edition matters, e.g. to locate a page or a track.</skos:definition>
    <skos:definition xml:lang="pt-BR">Publicação ou suporte que materializa uma ou mais expressões: edição de álbum, edição de livro, transmissão, lançamento digital (nível manifestação do LRM). Opcional: registre quando a edição importa, por exemplo para localizar uma página ou faixa.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
    <rdfs:seeAlso rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F3_Manifestation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DerivationTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Derivation types</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Tipos de derivação</skos:prefLabel>
    <skos:definition xml:lang="en">Non-exclusive kinds of derivation grouped in five families; one claim may carry several types. Grounded in Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon and Jenkins (see derivation-typology.md).</skos:definition>
    <skos:definition xml:lang="pt-BR">Tipos não exclusivos de derivação agrupados em cinco famílias; uma alegação pode ter vários tipos. Fundamentados em Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon e Jenkins (ver derivation-typology.md).</skos:definition>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Transformation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Imitation"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#Extension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasSelector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">selection located by W3C Web Annotation selector</rdfs:label>
    <rdfs:label xml:lang="pt-BR">recorte localizado por seletor W3C Web Annotation</rdfs:label>
    <skos:definition xml:lang="en">Links a selection to a W3C Web Annotation selector that locates it inside the manifestation (time fragment, text quote or position, image region, SVG shape).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um recorte a um seletor W3C Web Annotation que o localiza dentro da manifestação (fragmento de tempo, citação ou posição de texto, região de imagem, forma SVG).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Selection"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/oa#Selector"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Translation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">translation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">tradução</skos:prefLabel>
    <skos:definition xml:lang="en">Rendering of verbal content in another language. Genette also classes it as a serious transformation (transposition).</skos:definition>
    <skos:definition xml:lang="pt-BR">Transposição do conteúdo verbal para outra língua. Genette também a classifica como transformação séria (transposição).</skos:definition>
    <dcterms:source>Smiraglia 2001; Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ArtisticDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">artistic dimension</rdfs:label>
    <rdfs:label xml:lang="pt-BR">dimensão artística</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado</rdfs:comment>
    <skos:definition xml:lang="en">Aspect of a work along which derivation can be compared (melody, lyrics, plot, character, medium...).</skos:definition>
    <skos:definition xml:lang="pt-BR">Aspecto da obra segundo o qual a derivação pode ser comparada (melodia, letra, enredo, personagem, mídia...).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#LyricistRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">lyricist</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">letrista</skos:prefLabel>
    <skos:definition xml:lang="en">Author of lyrics.</skos:definition>
    <skos:definition xml:lang="pt-BR">Autor da letra.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EmpiricalClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">empirical claim</rdfs:label>
    <rdfs:label xml:lang="pt-BR">afirmação empírica</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: claim content and intended empirical reference</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: conteúdo da afirmação e referência empírica pretendida</rdfs:comment>
    <skos:definition xml:lang="en">Recorded testable claim about the empirical world.</skos:definition>
    <skos:definition xml:lang="pt-BR">Afirmação registrada e verificável acerca do mundo empírico.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EditingDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">editing / montage</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">montagem / edição</skos:prefLabel>
    <skos:definition xml:lang="en">Joining of shots: transitions, rhythm, continuity.</skos:definition>
    <skos:definition xml:lang="pt-BR">Junção de planos: transições, ritmo, continuidade.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#AudiovisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Claim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">claim</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object (propositional content as authored record, ADR-010); dependency: the act or agent that asserts it</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C (conteúdo proposicional como registro autoral, ADR-010); dependência: o ato ou agente que a afirma</rdfs:comment>
    <skos:definition xml:lang="en">Analytical record that asserts something contestable: it can be produced by an act, justified, supported by sources, assessed and challenged. ARO represents claims, never their truth.</skos:definition>
    <skos:definition xml:lang="pt-BR">Registro analítico que afirma algo contestável: pode ser produzido por um ato, justificado, apoiado em fontes, avaliado e contestado. A ARO representa alegações, nunca sua verdade.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Claim"/>
    <owl:disjointUnionOf rdf:nodeID="N56c39ab114d84434bfc225c5e6749df4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Allusion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">allusion</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">alusão</skos:prefLabel>
    <skos:definition xml:lang="en">Indirect reference whose full sense presupposes recognition of the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Referência indireta cujo sentido pleno pressupõe reconhecer a origem.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb0ad7b4ebb224b6ca2b3496fd468ce87">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <rdf:rest rdf:nodeID="N8ed8c6df8b1c4163b57b6cb7c46eb6b9"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N716d871aa91c429e922a468b51414ee9">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#InterpretationRecord"/>
    <rdf:rest rdf:nodeID="N33af1fea23c04da19c72f0c4ee8863f0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ToneDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">tone / mood</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">tom / atmosfera</skos:prefLabel>
    <skos:definition xml:lang="en">Affective colouring and mood.</skos:definition>
    <skos:definition xml:lang="pt-BR">Coloração afetiva e atmosfera.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#GeneralDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#PlayfulRegime">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationRegime"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
    <skos:prefLabel xml:lang="en">playful</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">lúdico</skos:prefLabel>
    <skos:definition xml:lang="en">Derivation aimed at play or amusement.</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação voltada ao jogo ou divertimento.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Amplification">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">amplification</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">ampliação</skos:prefLabel>
    <skos:definition xml:lang="en">Source reproduced with added material (annotated or illustrated edition, commentary track).</skos:definition>
    <skos:definition xml:lang="pt-BR">Origem reproduzida com material acrescentado (edição anotada ou ilustrada, faixa de comentário).</skos:definition>
    <dcterms:source>Smiraglia 2001 (amplifications)</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#AssessmentCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">assessment criterion</rdfs:label>
    <rdfs:label xml:lang="pt-BR">critério de avaliação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: specified normative meaning</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: significado normativo especificado</rdfs:comment>
    <skos:definition xml:lang="en">Explicit rule an assessment applies to judge a claim; epistemic criteria judge whether the claim is well grounded, value criteria judge its worth.</skos:definition>
    <skos:definition xml:lang="pt-BR">Regra explícita que uma avaliação aplica para julgar uma alegação; critérios epistêmicos julgam se a alegação é bem fundamentada, critérios de valor julgam seu mérito.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/artwork">
    <rdfs:label xml:lang="en">Artwork and selection</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Obra e recorte</rdfs:label>
    <dcterms:description xml:lang="en">What is analysed: artworks, their expressions (versions, performances, translations) and manifestations (editions, releases), as in IFLA LRM, and the addressable excerpts (selections) on which annotations are anchored.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">O que é analisado: obras, suas expressões (versões, interpretações, traduções) e manifestações (edições, lançamentos), como no IFLA LRM, e os trechos endereçáveis (recortes) em que as anotações se ancoram.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EvidenceItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">evidence item</rdfs:label>
    <rdfs:label xml:lang="pt-BR">item de evidência</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: reference source and observation content</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: fonte de referência e conteúdo observado</rdfs:comment>
    <skos:definition xml:lang="en">Extracted contextual assertion or observation from a reference source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Afirmação ou observação contextualizada extraída de uma fonte.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CreditsDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">credits / attribution</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">créditos / atribuição</skos:prefLabel>
    <skos:definition xml:lang="en">Stated authorship and credits.</skos:definition>
    <skos:definition xml:lang="pt-BR">Autoria declarada e créditos.</skos:definition>
    <dcterms:source>Genette 1987</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#ParatextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#StyleDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">style</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">estilo</skos:prefLabel>
    <skos:definition xml:lang="en">Recognizable manner of a creator, genre or period.</skos:definition>
    <skos:definition xml:lang="pt-BR">Maneira reconhecível de autor, gênero ou período.</skos:definition>
    <dcterms:source>Dyer 2007</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#GeneralDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/pattern">
    <rdfs:label xml:lang="en">Situation pattern</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Padrão situacional</rdfs:label>
    <dcterms:description xml:lang="en">Reusable abstractions of represented situations, defined by conditions, that can be compared with real-world cases.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">Abstrações reutilizáveis de situações representadas, definidas por condições, que podem ser comparadas com casos do mundo real.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasSourceAnchor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim names the source entity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação indica entidade de origem</rdfs:label>
    <skos:definition xml:lang="en">Links a derivation claim to the entity the derivation starts from (any artistic entity: artwork, expression, manifestation or selection): the source side of the claim.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma alegação de derivação à entidade de onde a derivação parte (qualquer entidade artística: obra, expressão, manifestação ou recorte): o lado de origem da alegação.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#DerivationClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Appropriation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">appropriation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">apropriação</skos:prefLabel>
    <skos:definition xml:lang="en">Re-presentation of an existing work or image, often whole, in a new context that changes its sense.</skos:definition>
    <skos:definition xml:lang="pt-BR">Reapresentação de obra ou imagem existente, frequentemente inteira, em novo contexto que altera seu sentido.</skos:definition>
    <dcterms:source>Navas 2012</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4b8f4635730b4e90822aacc0c028543e">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#EmpiricalEvent"/>
    <rdf:rest rdf:nodeID="N104b22b21aa14fa1b39a811d915a27ff"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#NarrativeTimeDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">narrative time</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">tempo narrativo</skos:prefLabel>
    <skos:definition xml:lang="en">Order, duration and frequency of events in the telling.</skos:definition>
    <skos:definition xml:lang="pt-BR">Ordem, duração e frequência dos eventos na narração.</skos:definition>
    <dcterms:source>Genette 1972</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0a3b63169d4c4632a39449b224043d39">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#AssessmentCriterion"/>
    <rdf:rest rdf:nodeID="N029dc25794d9486d846ee9a6267ae596"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Analyst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">analyst</rdfs:label>
    <rdfs:label xml:lang="pt-BR">analista</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: roleMixin; foundation: UFO-A anti-rigid non-sortal (roleMixin) specialized by PersonAnalyst and CollectiveAnalyst; dependency: relationally on participation in an InterpretiveAct; identity supplied by external kinds</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: roleMixin; fundamentação: não-sortal anti-rígido UFO-A (roleMixin) especializado por PersonAnalyst e CollectiveAnalyst; dependência: relacionalmente da participação num InterpretiveAct; identidade fornecida por tipos externos</rdfs:comment>
    <skos:definition xml:lang="en">Agent insofar as it takes part in an interpretive act (interprets, describes, assesses). Played by persons or collectives identified by external IRIs.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente enquanto participa de um ato interpretativo (interpreta, descreve, avalia). Desempenhado por pessoas ou coletivos identificados por IRIs externos.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Agent"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ExplanationHypothesis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">explanation hypothesis</rdfs:label>
    <rdfs:label xml:lang="pt-BR">hipótese explicativa</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: explicit explanandum and explanatory content</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: explanandum explícito e conteúdo explicativo</rdfs:comment>
    <skos:definition xml:lang="en">Proposed mechanism or factors explaining a represented or observed phenomenon.</skos:definition>
    <skos:definition xml:lang="pt-BR">Mecanismo ou fatores propostos para explicar fenômeno representado ou observado.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#PersonAnalyst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">person analyst</rdfs:label>
    <rdfs:label xml:lang="pt-BR">pessoa analista</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Person, specializing the roleMixin Analyst; dependency: relationally on participation in an interpretive act</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Person, especializando o roleMixin Analyst; dependência: relacionalmente da participação em um ato interpretativo</rdfs:comment>
    <skos:definition xml:lang="en">A person while taking part in an interpretive act; defined as Person and Analyst.</skos:definition>
    <skos:definition xml:lang="pt-BR">Pessoa enquanto participa de um ato interpretativo; definido como Person e Analyst.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Person"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Analyst"/>
    <owl:equivalentClass rdf:nodeID="Na375f490ce0e42d39518b40a9e3da1d0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#selectorExpression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">selector expression</rdfs:label>
    <rdfs:label xml:lang="pt-BR">expressão de seletor</rdfs:label>
    <rdfs:comment xml:lang="en">Compact selector shortcut; prefer hasSelector with W3C Web Annotation selectors.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Atalho compacto de seletor; prefira hasSelector com seletores W3C Web Annotation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Selection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasRegime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim records derivation regime</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação registra regime de derivação</rdfs:label>
    <skos:definition xml:lang="en">Qualifies a derivation claim with its regime: the stance taken toward the source (playful, satirical, serious, reverential).</skos:definition>
    <skos:definition xml:lang="pt-BR">Qualifica uma alegação de derivação com seu regime: a postura tomada diante da origem (lúdica, satírica, séria, reverente).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#DerivationClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#DerivationRegime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#AuthorRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">author</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">autor</skos:prefLabel>
    <skos:definition xml:lang="en">Originator of verbal or narrative content.</skos:definition>
    <skos:definition xml:lang="pt-BR">Criador do conteúdo verbal ou narrativo.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nad96a22e13164723942acbcbb9d70c71">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#EmpiricalEvent"/>
    <rdf:rest rdf:nodeID="N47bc47cac231464294cd305fb2bdb113"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Variation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">variation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">variação</skos:prefLabel>
    <skos:definition xml:lang="en">Successive transformations of a given theme or motif.</skos:definition>
    <skos:definition xml:lang="pt-BR">Transformações sucessivas de tema ou motivo dado.</skos:definition>
    <dcterms:source>Burkholder 1994</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Transformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ComposerRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">composer</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">compositor</skos:prefLabel>
    <skos:definition xml:lang="en">Originator of musical content.</skos:definition>
    <skos:definition xml:lang="pt-BR">Criador do conteúdo musical.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Crossover">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">crossover</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">crossover</skos:prefLabel>
    <skos:definition xml:lang="en">Work combining characters or worlds from two or more sources.</skos:definition>
    <skos:definition xml:lang="pt-BR">Obra que combina personagens ou mundos de duas ou mais origens.</skos:definition>
    <dcterms:source>Jenkins 1992</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Extension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DirectorRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">director</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">diretor</skos:prefLabel>
    <skos:definition xml:lang="en">Agent directing an audiovisual or stage work.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente que dirige obra audiovisual ou cênica.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N02cbb84d611249bca64d784c670c81de">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#CreativeAgent"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Extension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">extension</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">extensão</skos:prefLabel>
    <skos:definition xml:lang="en">New work extending the fictional world, timeline or cast of the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Obra nova que estende o mundo ficcional, a linha do tempo ou o elenco da origem.</skos:definition>
    <dcterms:source>Tillett 1991 (sequential); Jenkins 1992</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N046bd133d7aa44bc960cba87d26ab021">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="Nc4ee28aeb0f84439a39ea1e07d52f266"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#assessmentOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">assessment outcome</rdfs:label>
    <rdfs:label xml:lang="pt-BR">resultado da avaliação</rdfs:label>
    <rdfs:comment xml:lang="en">What the assessment concludes about the claim: supports, partiallySupports, challenges, inconclusive or irrelevant. It records the assessor's judgment, not the truth of the claim.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">O que a avaliação conclui sobre a alegação: supports (apoia), partiallySupports (apoia em parte), challenges (contesta), inconclusive (inconclusiva) ou irrelevant (irrelevante). Registra o julgamento de quem avalia, não a verdade da alegação.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Assessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CreativeAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">creative agent</rdfs:label>
    <rdfs:label xml:lang="pt-BR">agente criativo</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: roleMixin; foundation: UFO-A anti-rigid non-sortal (roleMixin) specialized by PersonCreator and CollectiveCreator; dependency: relationally on a CreativeContribution; identity supplied by external kinds</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: roleMixin; fundamentação: não-sortal anti-rígido UFO-A (roleMixin) especializado por PersonCreator e CollectiveCreator; dependência: relacionalmente de uma CreativeContribution; identidade fornecida por tipos externos</rdfs:comment>
    <skos:definition xml:lang="en">Agent insofar as it contributes to a creative act (composes, performs, translates, directs...). Played by persons or collectives identified by external IRIs.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente enquanto contribui para um ato criativo (compõe, interpreta, traduz, dirige...). Desempenhado por pessoas ou coletivos identificados por IRIs externos.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Agent"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Person"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#issuedDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="en">issued date</rdfs:label>
    <rdfs:label xml:lang="pt-BR">data de publicação</rdfs:label>
    <rdfs:comment xml:lang="en">Publication date when known.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Data de publicação quando conhecida.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#contributionBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contribution made by agent</rdfs:label>
    <rdfs:label xml:lang="pt-BR">contribuição feita por agente</rdfs:label>
    <skos:definition xml:lang="en">Links a creative contribution to the agent who made it, identified by an external IRI (Wikidata, ISNI, MusicBrainz, schema.org).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma contribuição criativa ao agente que a fez, identificado por um IRI externo (Wikidata, ISNI, MusicBrainz, schema.org).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CreativeContribution"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#CreativeAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">pattern specifies conditions</rdfs:label>
    <rdfs:label xml:lang="pt-BR">padrão especifica condições</rdfs:label>
    <skos:definition xml:lang="en">Links a situation pattern to the conditions that define it, each one individuated so that it can be marked as required or optional and compared with real cases.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um padrão situacional às condições que o definem, cada uma individualizada para poder ser marcada como obrigatória ou opcional e comparada com casos reais.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/pattern"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#SituationPattern"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#PatternCondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Medley">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">medley</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">medley / pot-pourri</skos:prefLabel>
    <skos:definition xml:lang="en">Succession of several existing pieces or excerpts.</skos:definition>
    <skos:definition xml:lang="pt-BR">Sucessão de várias peças ou excertos existentes.</skos:definition>
    <dcterms:source>Burkholder 1994</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#PoseGestureDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">pose and gesture</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">pose e gesto</skos:prefLabel>
    <skos:definition xml:lang="en">Bodily posture and gesture of represented figures.</skos:definition>
    <skos:definition xml:lang="pt-BR">Postura corporal e gesto de figuras representadas.</skos:definition>
    <dcterms:source>Panofsky 1939</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#VisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/derivation">
    <rdfs:label xml:lang="en">Derivation and creation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Derivação e criação</rdfs:label>
    <dcterms:description xml:lang="en">How works derive from other works (cover, sampling, adaptation, parody...): derivation claims with types, regimes and transformation aspects, and the creative acts and contributions behind them.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">Como obras derivam de outras (cover, sampling, adaptação, paródia...): alegações de derivação com tipos, regimes e aspectos de transformação, e os atos e contribuições criativas por trás delas.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#groupsSelection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">unit groups selections</rdfs:label>
    <rdfs:label xml:lang="pt-BR">unidade agrupa recortes</rdfs:label>
    <skos:definition xml:lang="en">Links an analysis unit to the selections it groups, so that several excerpts can be analysed together as one unit (a scene, a refrain, a motif).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma unidade de análise aos recortes que ela agrupa, para que vários trechos sejam analisados juntos como uma unidade (uma cena, um refrão, um motivo).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#AnalysisUnit"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Selection"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8ed8c6df8b1c4163b57b6cb7c46eb6b9">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#TransformationOperation"/>
    <rdf:rest rdf:nodeID="Ne13dc63bb13243b99195ab8258fc4935"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DictionDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">diction / register</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">dicção / registro</skos:prefLabel>
    <skos:definition xml:lang="en">Vocabulary, register and verbal style.</skos:definition>
    <skos:definition xml:lang="pt-BR">Vocabulário, registro e estilo verbal.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#TextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Quotation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">quotation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">citação</skos:prefLabel>
    <skos:definition xml:lang="en">Explicit, recognizable reproduction of an excerpt, verbal, musical or visual.</skos:definition>
    <skos:definition xml:lang="pt-BR">Reprodução explícita e reconhecível de excerto, verbal, musical ou visual.</skos:definition>
    <dcterms:source>Genette 1982; Burkholder 1994</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CostumeMakeupDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">costume and make-up</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">figurino e maquiagem</skos:prefLabel>
    <skos:definition xml:lang="en">Costume, make-up and hair.</skos:definition>
    <skos:definition xml:lang="pt-BR">Figurino, maquiagem e cabelo.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MiseEnSceneDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#explainsPattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">explanation addresses pattern</rdfs:label>
    <rdfs:label xml:lang="pt-BR">hipótese explica padrão</rdfs:label>
    <skos:definition xml:lang="en">Links an explanation hypothesis to the situation pattern it proposes to explain (mechanisms or factors behind the recurring configuration).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma hipótese explicativa ao padrão situacional que ela se propõe explicar (mecanismos ou fatores por trás da configuração recorrente).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#ExplanationHypothesis"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#SituationPattern"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#VocalDeliveryDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">vocal delivery</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">interpretação vocal</skos:prefLabel>
    <skos:definition xml:lang="en">Singing or speaking manner, phrasing, ornamentation.</skos:definition>
    <skos:definition xml:lang="pt-BR">Maneira de cantar ou falar, fraseado, ornamentação.</skos:definition>
    <dcterms:source>Mag Uidhir, Magnus &amp; Magnus 2013</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#assertsCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">correspondence references case</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação referencia caso</rdfs:label>
    <skos:definition xml:lang="en">Links a correspondence claim to the empirical case it compares with a pattern: the side of reality in the claim that art and reality correspond.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma alegação de correspondência ao caso empírico que ela compara com um padrão: o lado da realidade na alegação de que arte e realidade se correspondem.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CorrespondenceClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#EmpiricalCase"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/evidence">
    <rdfs:label xml:lang="en">Evidence and empirical world</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Evidência e mundo empírico</rdfs:label>
    <dcterms:description xml:lang="en">The empirical world and its grounds: real cases, situations and events, reference sources, evidence items, correspondence claims between art and reality, and their assessment.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">O mundo empírico e seus fundamentos: casos, situações e eventos reais, fontes de referência, itens de evidência, alegações de correspondência entre arte e realidade e sua avaliação.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#PersonCreator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">person creator</rdfs:label>
    <rdfs:label xml:lang="pt-BR">pessoa criadora</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Person, specializing the roleMixin CreativeAgent; dependency: relationally on participation in a creative act</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Person, especializando o roleMixin CreativeAgent; dependência: relacionalmente da participação em um ato criativo</rdfs:comment>
    <skos:definition xml:lang="en">A person while taking part in a creative act; defined as Person and CreativeAgent.</skos:definition>
    <skos:definition xml:lang="pt-BR">Pessoa enquanto participa de um ato criativo; definido como Person e CreativeAgent.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Person"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#CreativeAgent"/>
    <owl:equivalentClass rdf:nodeID="Na1a4e8438a7c458399efe57c798b0505"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TextDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">verbal text</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">texto verbal</skos:prefLabel>
    <skos:definition xml:lang="en">Verbal content in any medium.</skos:definition>
    <skos:definition xml:lang="pt-BR">Conteúdo verbal em qualquer mídia.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">assessment</rdfs:label>
    <rdfs:label xml:lang="pt-BR">avaliação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: the assessed claims</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: as alegações avaliadas</rdfs:comment>
    <skos:definition xml:lang="en">Analytical record judging one or more closely related claims: by explicit criteria, by evidence, or both. It records a judgment made by an agent; it does not settle the claim.</skos:definition>
    <skos:definition xml:lang="pt-BR">Registro analítico que julga uma ou mais alegações intimamente relacionadas: por critérios explícitos, por evidência, ou ambos. Registra um julgamento feito por um agente; não resolve a alegação.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/ClaimReview"/>
    <owl:disjointUnionOf rdf:nodeID="N53b1e05e8bbe4afc986de093e9fea52a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Paraphrase">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">paraphrase</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">paráfrase</skos:prefLabel>
    <skos:definition xml:lang="en">Source material reworked into a new line or passage while remaining traceable.</skos:definition>
    <skos:definition xml:lang="pt-BR">Material de origem reelaborado em nova linha ou passagem, ainda rastreável.</skos:definition>
    <dcterms:source>Burkholder 1994</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#PerformerRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">performer</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">intérprete</skos:prefLabel>
    <skos:definition xml:lang="en">Agent performing a manifestation.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente que executa uma manifestação.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#producedByAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">act produces record</rdfs:label>
    <rdfs:label xml:lang="pt-BR">ato produz registro</rdfs:label>
    <skos:definition xml:lang="en">Links an analytical record (a claim, an assessment, a description...) to the analytical act that produced it, recording who made it, and when, as a historical fact distinct from its content. Required for interpretation records.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um registro analítico (alegação, avaliação, descrição...) ao ato analítico que o produziu, registrando quem o fez, e quando, como fato histórico distinto de seu conteúdo. Obrigatória para registros de interpretação.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#InterpretiveAct"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb127767a2dcf479182925a2b549ce8d6">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Expression"/>
    <rdf:rest rdf:nodeID="Nfca3f13c555f441f987d1881a54b2b1b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#LightingDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">lighting</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">iluminação</skos:prefLabel>
    <skos:definition xml:lang="en">Quality, direction and source of light.</skos:definition>
    <skos:definition xml:lang="pt-BR">Qualidade, direção e fonte da luz.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MiseEnSceneDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Arrangement">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">arrangement</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">arranjo</skos:prefLabel>
    <skos:definition xml:lang="en">Reworking of instrumentation, harmony or form while keeping the piece recognizable.</skos:definition>
    <skos:definition xml:lang="pt-BR">Reelaboração de instrumentação, harmonia ou forma mantendo a peça reconhecível.</skos:definition>
    <dcterms:source>Burkholder 1994</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#AdapterRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">adapter</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">adaptador</skos:prefLabel>
    <skos:definition xml:lang="en">Agent producing an adaptation (e.g. screenwriter).</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente que produz uma adaptação (ex. roteirista).</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#externalLink">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">external link</rdfs:label>
    <rdfs:label xml:lang="pt-BR">link externo</rdfs:label>
    <rdfs:comment xml:lang="en">Web address where the represented entity can be consulted: an artwork page, a recording, the exact location of an evidence item, a case report. Usable on any resource; a link is not a credibility claim.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Endereço web onde a entidade representada pode ser consultada: página da obra, gravação, local exato de um item de evidência, relato de um caso. Usável em qualquer recurso; o link não é alegação de credibilidade.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SituationPattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">situation pattern</rdfs:label>
    <rdfs:label xml:lang="pt-BR">padrão situacional</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: defining conditions; not identical to universal</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: condições definidoras; não idêntico a universal</rdfs:comment>
    <skos:definition xml:lang="en">Reusable informational specification of situation conditions.</skos:definition>
    <skos:definition xml:lang="pt-BR">Especificação informacional reutilizável de condições situacionais.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/pattern"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#supportsInterpretation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">interpretation supports another</rdfs:label>
    <rdfs:label xml:lang="pt-BR">interpretação apoia outra</rdfs:label>
    <skos:definition xml:lang="en">Links an interpretation record to another interpretation that it supports, building chains of interpretations.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um registro de interpretação a outra interpretação que ele apoia, formando cadeias de interpretações.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#InterpretationRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#InterpretationRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EmpiricalCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">empirical case</rdfs:label>
    <rdfs:label xml:lang="pt-BR">caso empírico</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: case description and empirical referent</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: descrição do caso e referente empírico</rdfs:comment>
    <skos:definition xml:lang="en">Documented dossier about one real-world situation or occurrence.</skos:definition>
    <skos:definition xml:lang="pt-BR">Dossiê documentado sobre uma situação ou ocorrência real.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#LyricsDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">lyrics</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">letra</skos:prefLabel>
    <skos:definition xml:lang="en">Sung or spoken verbal text of a song.</skos:definition>
    <skos:definition xml:lang="pt-BR">Texto verbal cantado ou falado de canção.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#TextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#AudiovisualDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">audiovisual</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">audiovisual</skos:prefLabel>
    <skos:definition xml:lang="en">Stylistic systems of film, video and other moving-image media.</skos:definition>
    <skos:definition xml:lang="pt-BR">Sistemas estilísticos de cinema, vídeo e outras mídias de imagem em movimento.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CorrespondenceClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">correspondence claim</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação de correspondência</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim; not a UFO relator; dependency: compared pattern/case and dimensions</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim; não é relator UFO; dependência: padrão/caso comparados e dimensões</rdfs:comment>
    <skos:definition xml:lang="en">Contestable assertion of similarity, instantiation or explanatory relevance between pattern and empirical case.</skos:definition>
    <skos:definition xml:lang="pt-BR">Alegação contestável de similaridade, instanciação ou relevância explicativa entre padrão e caso empírico.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#mentionsDepictedElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">description mentions depicted element</rdfs:label>
    <rdfs:label xml:lang="pt-BR">descrição menciona elemento</rdfs:label>
    <skos:definition xml:lang="en">Links a situation description to the depicted elements it involves (characters, places, objects, groups represented in the work).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma descrição de situação aos elementos representados que ela envolve (personagens, lugares, objetos, grupos representados na obra).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/representation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#SituationDescription"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#DepictedElement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1e9246e56b964c6e8db3fccc44714d08">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#InterpretiveAct"/>
    <rdf:rest rdf:nodeID="N126913533f934c2296d03d9e729fec28"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#FocalizationDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">focalization / point of view</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">focalização / ponto de vista</skos:prefLabel>
    <skos:definition xml:lang="en">Whose perception or knowledge filters the story.</skos:definition>
    <skos:definition xml:lang="pt-BR">Percepção ou saber que filtra a história.</skos:definition>
    <dcterms:source>Genette 1972</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#derivedFromSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evidence obtained from source</rdfs:label>
    <rdfs:label xml:lang="pt-BR">evidência obtida de fonte</rdfs:label>
    <skos:definition xml:lang="en">Links an evidence item to the reference source it was extracted from, so that every piece of evidence can be traced back to a citable source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um item de evidência à fonte de referência de onde foi extraído, para que toda evidência possa ser rastreada até uma fonte citável.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#EvidenceItem"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#ReferenceSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ProductionDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">production / mix</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">produção / mixagem</skos:prefLabel>
    <skos:definition xml:lang="en">Studio processing, mix and sound design.</skos:definition>
    <skos:definition xml:lang="pt-BR">Processamento de estúdio, mixagem e desenho de som.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#RecordedSoundDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">recorded sound</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">som gravado</skos:prefLabel>
    <skos:definition xml:lang="en">The fixed sound recording itself (relevant to sampling).</skos:definition>
    <skos:definition xml:lang="pt-BR">A própria gravação sonora fixada (relevante para sample).</skos:definition>
    <dcterms:source>Schloss 2004</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CameraMovementDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">camera movement</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">movimento de câmera</skos:prefLabel>
    <skos:definition xml:lang="en">Pans, tilts, tracking and other mobile framing.</skos:definition>
    <skos:definition xml:lang="pt-BR">Panorâmicas, travellings e outros enquadramentos móveis.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#CinematographyDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Added">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#TransformationOperation"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
    <skos:prefLabel xml:lang="en">added</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">acrescentado</skos:prefLabel>
    <skos:definition xml:lang="en">Dimension content absent from the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Conteúdo da dimensão ausente na origem.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Travesty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">travesty</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">travestimento</skos:prefLabel>
    <skos:definition xml:lang="en">Satirical transformation that keeps the content but degrades its style or register.</skos:definition>
    <skos:definition xml:lang="pt-BR">Transformação satírica que mantém o conteúdo mas rebaixa estilo ou registro.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Transformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SeriousImitation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">serious imitation (forgerie)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">imitação séria (forgerie)</skos:prefLabel>
    <skos:definition xml:lang="en">Imitation aiming to be taken as in the manner of the source, e.g. apocryphal continuation; not necessarily fraud.</skos:definition>
    <skos:definition xml:lang="pt-BR">Imitação que pretende ser tomada como da maneira da origem, ex. continuação apócrifa; não necessariamente fraude.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Imitation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Artwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">artwork</rdfs:label>
    <rdfs:label xml:lang="pt-BR">obra</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: kind; foundation: UFO-C social/information object (domain commitment); dependency: historically on creation; not on a single copy</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: kind; fundamentação: objeto social/informacional UFO-C (compromisso de domínio); dependência: historicamente da criação; não de uma cópia específica</rdfs:comment>
    <skos:definition xml:lang="en">Identifiable artistic creation, considered independently of any particular version or copy (the LRM work level).</skos:definition>
    <skos:definition xml:lang="pt-BR">Criação artística identificável, considerada independentemente de qualquer versão ou cópia (nível obra do LRM).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
    <rdfs:seeAlso rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F1_Work"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Remake">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">remake</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">refilmagem / remake</skos:prefLabel>
    <skos:definition xml:lang="en">New audiovisual production based on an earlier production of the same story.</skos:definition>
    <skos:definition xml:lang="pt-BR">Nova produção audiovisual baseada em produção anterior da mesma história.</skos:definition>
    <dcterms:source>Verevis 2006</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#versionLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">version label</rdfs:label>
    <rdfs:label xml:lang="pt-BR">rótulo de versão</rdfs:label>
    <rdfs:comment xml:lang="en">Application version label.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Rótulo de versão da aplicação.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasPrimarySelection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">record is anchored in selection</rdfs:label>
    <rdfs:label xml:lang="pt-BR">interpretação se ancora em recorte</rdfs:label>
    <skos:definition xml:lang="en">Links an interpretation record to the one selection it is about: the excerpt of the work in which the interpretation is anchored.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um registro de interpretação ao único recorte de que ele trata: o trecho da obra em que a interpretação se ancora.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#InterpretationRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Selection"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/oa#hasTarget"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/interpretation">
    <rdfs:label xml:lang="en">Interpretation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Interpretação</rdfs:label>
    <dcterms:description xml:lang="en">Who interprets and how: interpretation records anchored in selections and produced by interpretive acts.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">Quem interpreta e como: registros de interpretação ancorados em recortes e produzidos por atos interpretativos.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ParatextDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">paratext</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">paratexto</skos:prefLabel>
    <skos:definition xml:lang="en">Thresholds around the work: title, credits, covers, prefaces.</skos:definition>
    <skos:definition xml:lang="pt-BR">Limiares em torno da obra: título, créditos, capas, prefácios.</skos:definition>
    <dcterms:source>Genette 1987</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DepictedElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">depicted element</rdfs:label>
    <rdfs:label xml:lang="pt-BR">elemento representado</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C representation (subkind of AnalyticalRecord); not a real-world entity; dependency: representational context</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: representação UFO-C (subkind de AnalyticalRecord); não é entidade do mundo real; dependência: contexto representacional</rdfs:comment>
    <skos:definition xml:lang="en">Information-level representation of a referent in an artwork.</skos:definition>
    <skos:definition xml:lang="pt-BR">Representação informacional de um referente na obra.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/representation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#languageTag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">language tag</rdfs:label>
    <rdfs:label xml:lang="pt-BR">etiqueta de idioma</rdfs:label>
    <rdfs:comment xml:lang="en">BCP 47 tag of the main language of a resource, e.g. en, pt-BR, es.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Etiqueta BCP 47 do idioma principal de um recurso, ex. en, pt-BR, es.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">aspect applies an operation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aspecto aplica operação</rdfs:label>
    <skos:definition xml:lang="en">States what was done to the dimension in a transformation aspect: retain, modify, add, remove or recontextualize.</skos:definition>
    <skos:definition xml:lang="pt-BR">Diz o que foi feito com a dimensão num aspecto de transformação: manter, modificar, adicionar, remover ou recontextualizar.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#TransformationAspect"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#TransformationOperation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Prequel">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">prequel</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">prequela</skos:prefLabel>
    <skos:definition xml:lang="en">Continuation set before the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Continuação situada antes da origem.</skos:definition>
    <dcterms:source>Tillett 1991</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Continuation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CreativeRoleScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Creative roles</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Papéis criativos</skos:prefLabel>
    <skos:definition xml:lang="en">Roles qualifying a creative contribution; extensible.</skos:definition>
    <skos:definition xml:lang="pt-BR">Papéis que qualificam uma contribuição criativa; extensível.</skos:definition>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#AuthorRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#ComposerRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#LyricistRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#PerformerRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#ArrangerRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#TranslatorRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#AdapterRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#ProducerRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#DirectorRole"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#RemixerRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EvidenceAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">evidence assessment</rdfs:label>
    <rdfs:label xml:lang="pt-BR">avaliação de evidência</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Assessment; dependency: the assessed claim and the evidence weighed</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Assessment; dependência: a alegação avaliada e a evidência ponderada</rdfs:comment>
    <skos:definition xml:lang="en">Assessment of whether evidence items support, challenge or are irrelevant to a claim.</skos:definition>
    <skos:definition xml:lang="pt-BR">Avaliação de se itens de evidência apoiam, contestam ou são irrelevantes para uma alegação.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Assessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#MusicalFormDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">musical form</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">forma musical</skos:prefLabel>
    <skos:definition xml:lang="en">Large-scale structure (verse–chorus, sonata, AABA).</skos:definition>
    <skos:definition xml:lang="pt-BR">Estrutura em larga escala (verso–refrão, sonata, AABA).</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#MediumDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">medium</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">mídia</skos:prefLabel>
    <skos:definition xml:lang="en">Material or technical medium of realization.</skos:definition>
    <skos:definition xml:lang="pt-BR">Meio material ou técnico de realização.</skos:definition>
    <dcterms:source>Rajewsky 2005</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#GeneralDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#caseAboutSituation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dossier describes real situations</rdfs:label>
    <rdfs:label xml:lang="pt-BR">dossiê descreve situação real</rdfs:label>
    <skos:definition xml:lang="en">Links an empirical case (a documented dossier) to the real-world situations it documents.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um caso empírico (dossiê documentado) às situações do mundo real que ele documenta.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#EmpiricalCase"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#EmpiricalSituation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#citesSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">record cites source</rdfs:label>
    <rdfs:label xml:lang="pt-BR">registro cita fonte</rdfs:label>
    <skos:definition xml:lang="en">Links any analytical record (a claim, a case, a description, a pattern) to a reference source it relies on or that documents it (criticism, interview, news, study, credits).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga qualquer registro analítico (alegação, caso, descrição, padrão) a uma fonte de referência em que se apoia ou que o documenta (crítica, entrevista, notícia, estudo, créditos).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#ReferenceSource"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/references"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd982f784127e4e41bde25f5849affd0f">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Expression"/>
    <rdf:rest rdf:nodeID="N24e17c7898884d378977428c3c30b901"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EmpiricalSituation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">empirical situation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">situação empírica</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: situation; foundation: UFO-B situation; separate from descriptions; dependency: real-world constituents</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: situation; fundamentação: situação UFO-B; separada de descrições; dependência: constituintes do mundo real</rdfs:comment>
    <skos:definition xml:lang="en">Configuration of entities and conditions in the real world.</skos:definition>
    <skos:definition xml:lang="pt-BR">Configuração de entidades e condições no mundo real.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#MusicDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">music and sound</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">música e som</skos:prefLabel>
    <skos:definition xml:lang="en">Musical and sonic parameters.</skos:definition>
    <skos:definition xml:lang="pt-BR">Parâmetros musicais e sonoros.</skos:definition>
    <dcterms:source>Burkholder 1994</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N47bc47cac231464294cd305fb2bdb113">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#EmpiricalSituation"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Remix">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">remix</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">remix</skos:prefLabel>
    <skos:definition xml:lang="en">Selective or reflexive recombination of an existing recording's elements into a new whole; the remixer is a creator in their own right.</skos:definition>
    <skos:definition xml:lang="pt-BR">Recombinação seletiva ou reflexiva dos elementos de gravação existente num novo todo; o remixador é criador por direito próprio.</skos:definition>
    <dcterms:source>Navas 2012 (selective and reflexive remix)</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#LanguageDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">language</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">língua</skos:prefLabel>
    <skos:definition xml:lang="en">Natural language of verbal content.</skos:definition>
    <skos:definition xml:lang="pt-BR">Língua natural do conteúdo verbal.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#TextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TimbreDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">timbre / instrumentation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">timbre / instrumentação</skos:prefLabel>
    <skos:definition xml:lang="en">Sound sources and their colour.</skos:definition>
    <skos:definition xml:lang="pt-BR">Fontes sonoras e sua cor.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SituationDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">situation description</rdfs:label>
    <rdfs:label xml:lang="pt-BR">descrição de situação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object (subkind of AnalyticalRecord), not gufo:Situation; dependency: interpretive support and conceptual content</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C (subkind de AnalyticalRecord), não gufo:Situation; dependência: suporte interpretativo e conteúdo conceitual</rdfs:comment>
    <skos:definition xml:lang="en">Recorded description of a represented situation.</skos:definition>
    <skos:definition xml:lang="pt-BR">Descrição registrada de situação representada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/representation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfefa0503a15e404084cf1de7be0a3930">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#DerivationRegime"/>
    <rdf:rest rdf:nodeID="Nb0ad7b4ebb224b6ca2b3496fd468ce87"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N166f03fa05e44f67be3db1aec9a8460b">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Collective"/>
    <rdf:rest rdf:nodeID="N7da9b2f6c0ce434887b0eec4a7a5e029"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Parody">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">parody</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">paródia</skos:prefLabel>
    <skos:definition xml:lang="en">Transformation of a source in a playful or critical regime; repetition with critical difference.</skos:definition>
    <skos:definition xml:lang="pt-BR">Transformação da origem em regime lúdico ou crítico; repetição com diferença crítica.</skos:definition>
    <dcterms:source>Genette 1982; Hutcheon 1985</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Transformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#describesSituation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">interpretation yields descriptions</rdfs:label>
    <rdfs:label xml:lang="pt-BR">interpretação descreve situação</rdfs:label>
    <skos:definition xml:lang="en">Links an interpretation record to the descriptions of represented situations it yields: what, according to the interpretation, happens in the excerpt.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um registro de interpretação às descrições de situações representadas que ele produz: o que, segundo a interpretação, acontece no trecho.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#InterpretationRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#SituationDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Incorporation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">incorporation / copresence</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">incorporação / copresença</skos:prefLabel>
    <skos:definition xml:lang="en">Material of, or explicit reference to, the source is present within a new whole.</skos:definition>
    <skos:definition xml:lang="pt-BR">Material da origem, ou referência explícita a ela, está presente num novo todo.</skos:definition>
    <dcterms:source>Genette 1982 (intertextuality); Burkholder 1994</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#aspectConcernsPattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">aspect concerns a situation pattern</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aspecto envolve padrão situacional</rdfs:label>
    <skos:definition xml:lang="en">Links a transformation aspect to a situation pattern it affects, when a derivation keeps, changes or relocates a represented situation.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um aspecto de transformação a um padrão situacional que ele afeta, quando a derivação mantém, altera ou desloca uma situação representada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#TransformationAspect"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#SituationPattern"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#UnacknowledgedBorrowing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">unacknowledged borrowing</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">empréstimo não declarado</skos:prefLabel>
    <skos:definition xml:lang="en">Literal borrowing presented without acknowledgment of the source (Genette's 'plagiat'); a descriptive textual relation, not a legal or moral judgment.</skos:definition>
    <skos:definition xml:lang="pt-BR">Empréstimo literal apresentado sem reconhecimento da origem (o 'plagiat' de Genette); relação textual descritiva, não julgamento jurídico ou moral.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CollectiveCreator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collective creator</rdfs:label>
    <rdfs:label xml:lang="pt-BR">coletivo criador</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Collective, specializing the roleMixin CreativeAgent; dependency: relationally on participation in a creative act</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Collective, especializando o roleMixin CreativeAgent; dependência: relacionalmente da participação em um ato criativo</rdfs:comment>
    <skos:definition xml:lang="en">A collective while taking part in a creative act; defined as Collective and CreativeAgent.</skos:definition>
    <skos:definition xml:lang="pt-BR">Coletivo enquanto participa de um ato criativo; definido como Collective e CreativeAgent.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Collective"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#CreativeAgent"/>
    <owl:equivalentClass rdf:nodeID="N675418d5678442628357c834af7c4c0e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SpaceDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">space and perspective</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">espaço e perspectiva</skos:prefLabel>
    <skos:definition xml:lang="en">Depth, perspective and scale.</skos:definition>
    <skos:definition xml:lang="pt-BR">Profundidade, perspectiva e escala.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#VisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ReferenceSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reference source</rdfs:label>
    <rdfs:label xml:lang="pt-BR">fonte de referência</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: kind; foundation: UFO-C information object; dependency: source provenance; not tied to one interpretation</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; dependência: proveniência da fonte; não vinculada a uma interpretação</rdfs:comment>
    <skos:definition xml:lang="en">Citable external resource: news, study, report, legal document, testimony, dataset, etc.</skos:definition>
    <skos:definition xml:lang="pt-BR">Recurso externo citável: notícia, estudo, relatório, documento legal, relato, conjunto de dados etc.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/CreativeWork"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Caricature">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">caricature (charge)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">caricatura (charge)</skos:prefLabel>
    <skos:definition xml:lang="en">Imitation of a style in a satirical regime.</skos:definition>
    <skos:definition xml:lang="pt-BR">Imitação de estilo em regime satírico.</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Imitation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ArrangerRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">arranger</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">arranjador</skos:prefLabel>
    <skos:definition xml:lang="en">Agent producing an arrangement.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente que produz um arranjo.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CreativeContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">creative contribution</rdfs:label>
    <rdfs:label xml:lang="pt-BR">contribuição criativa</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: relator; foundation: UFO-A relator mediating an agent and an artistic entity; role qualification via CreativeRole; dependency: existentially on the contributing agent and on the artistic entity contributed to; founded by the creative act</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: relator; fundamentação: relator UFO-A que media um agente e uma entidade artística; papel qualificado via CreativeRole; dependência: existencialmente do agente que contribui e da entidade artística para a qual contribui; fundada pelo ato criativo</rdfs:comment>
    <skos:definition xml:lang="en">Participation of one creative agent in one creative act under one or more roles.</skos:definition>
    <skos:definition xml:lang="pt-BR">Participação de um agente criativo num ato criativo sob um ou mais papéis.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N73b79ac69b6c49978416c85956702369">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
    <rdf:rest rdf:nodeID="N85661068b6864cc9a8459c25b8c4f5bf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DynamicsDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">dynamics</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">dinâmica</skos:prefLabel>
    <skos:definition xml:lang="en">Loudness and its changes.</skos:definition>
    <skos:definition xml:lang="pt-BR">Intensidade e suas variações.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6a17699394d84255a9e84d63b1edcc3b">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#CorrespondenceClaim"/>
    <rdf:rest rdf:nodeID="Ne7c7c540fa6a4422aaf6e16d5ce3e3bf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EmpiricalEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">empirical event</rdfs:label>
    <rdfs:label xml:lang="pt-BR">evento empírico</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: event; foundation: UFO-B event; dependency: real occurrence and participants</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: event; fundamentação: evento UFO-B; dependência: ocorrência real e participantes</rdfs:comment>
    <skos:definition xml:lang="en">Real-world temporally bounded occurrence.</skos:definition>
    <skos:definition xml:lang="pt-BR">Ocorrência do mundo real delimitada temporalmente.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#VisualCompositionDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">visual composition</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">composição visual</skos:prefLabel>
    <skos:definition xml:lang="en">Arrangement of elements in the frame or picture plane.</skos:definition>
    <skos:definition xml:lang="pt-BR">Disposição dos elementos no quadro ou plano pictórico.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#VisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SetDesignDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">set and props</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">cenário e objetos</skos:prefLabel>
    <skos:definition xml:lang="en">Sets, locations and props.</skos:definition>
    <skos:definition xml:lang="pt-BR">Cenários, locações e objetos de cena.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MiseEnSceneDimension"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N217499186d964c36af9259e77bcc3e75">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#SituationDescription"/>
    <rdf:rest rdf:nodeID="N6a2c4df123f240aeb1fc048b721567c8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasExpression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">artwork is realized through expression</rdfs:label>
    <rdfs:label xml:lang="pt-BR">obra se realiza por expressão</rdfs:label>
    <skos:definition xml:lang="en">Links an artwork to a realization of it with its own content (a performance, a recording, a translation, an arrangement, a text version). Use it to say through which expressions the work exists.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma obra a uma realização dela com conteúdo próprio (interpretação, gravação, tradução, arranjo, versão do texto). Use para dizer por quais expressões a obra existe.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Artwork"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Expression"/>
    <owl:inverseOf rdf:resource="https://w3id.org/aro/ontology#realizesArtwork"/>
    <rdfs:seeAlso rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Collage">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">collage / mashup</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">colagem / mashup</skos:prefLabel>
    <skos:definition xml:lang="en">Juxtaposition of several sources in one new whole.</skos:definition>
    <skos:definition xml:lang="pt-BR">Justaposição de várias origens num novo todo.</skos:definition>
    <dcterms:source>Burkholder 1994; Navas 2012</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#NarrationDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">narration / voice</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">narração / voz</skos:prefLabel>
    <skos:definition xml:lang="en">Who narrates and from which narrative level.</skos:definition>
    <skos:definition xml:lang="pt-BR">Quem narra e de qual nível narrativo.</skos:definition>
    <dcterms:source>Genette 1972</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Abridgment">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">abridgment / extraction</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">resumo / extração</skos:prefLabel>
    <skos:definition xml:lang="en">Derivation keeping a reduced part of the source (abridgment, excerpt, radio edit).</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação que mantém parte reduzida da origem (resumo, excerto, radio edit).</skos:definition>
    <dcterms:source>Smiraglia 2001 (extractions)</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#selectsFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">selection references expression</rdfs:label>
    <rdfs:label xml:lang="pt-BR">recorte referencia expressão</rdfs:label>
    <skos:definition xml:lang="en">Links a selection to the expression it is taken from. Every selection is cut from exactly one expression, so that its location (lines, seconds, region) is meaningful.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um recorte à expressão de onde ele é tirado. Todo recorte vem de exatamente uma expressão, para que sua localização (linhas, segundos, região) tenha sentido.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Selection"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Expression"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#GenreDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">genre</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">gênero</skos:prefLabel>
    <skos:definition xml:lang="en">Generic affiliation (architextuality).</skos:definition>
    <skos:definition xml:lang="pt-BR">Filiação genérica (arquitextualidade).</skos:definition>
    <dcterms:source>Genette 1982</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#GeneralDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ColorDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">colour</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">cor</skos:prefLabel>
    <skos:definition xml:lang="en">Hue, saturation, value and palette.</skos:definition>
    <skos:definition xml:lang="pt-BR">Matiz, saturação, valor e paleta.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#VisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#VisualDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">visual</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">visual</skos:prefLabel>
    <skos:definition xml:lang="en">Formal and iconographic properties of still or moving images.</skos:definition>
    <skos:definition xml:lang="pt-BR">Propriedades formais e iconográficas de imagens fixas ou em movimento.</skos:definition>
    <dcterms:source>Panofsky 1939</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1549c151a91d4612800f4240ae269eca">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#CreativeAct"/>
    <rdf:rest rdf:nodeID="Nad96a22e13164723942acbcbb9d70c71"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#producesCreation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">act brings about artistic entity</rdfs:label>
    <rdfs:label xml:lang="pt-BR">ato faz surgir entidade artística</rdfs:label>
    <skos:definition xml:lang="en">Links a creative act to the artistic entities it brings into existence (artworks, expressions, manifestations), including derivative ones.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um ato criativo às entidades artísticas que ele faz existir (obras, expressões, manifestações), inclusive as derivadas.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CreativeAct"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasManifestation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">expression is embodied in manifestation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">expressão se materializa em manifestação</rdfs:label>
    <skos:definition xml:lang="en">Links an expression to a publication or carrier that embodies it (an album edition, a book edition, a broadcast, a digital release). Optional: record it when the edition matters.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma expressão a uma publicação ou suporte que a materializa (edição de álbum, edição de livro, transmissão, lançamento digital). Opcional: registre quando a edição importa.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Expression"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Manifestation"/>
    <owl:inverseOf rdf:resource="https://w3id.org/aro/ontology#embodiesExpression"/>
    <rdfs:seeAlso rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R4_embodies"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#NarrativeDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">narrative</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">narrativa</skos:prefLabel>
    <skos:definition xml:lang="en">Story-level and discourse-level properties of narratives in any medium.</skos:definition>
    <skos:definition xml:lang="pt-BR">Propriedades de história e de discurso de narrativas em qualquer mídia.</skos:definition>
    <dcterms:source>Chatman 1978; Genette 1972</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#isRequiredCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">is required condition</rdfs:label>
    <rdfs:label xml:lang="pt-BR">é condição obrigatória</rdfs:label>
    <rdfs:comment xml:lang="en">Whether a pattern condition is mandatory (true) or contextual (false).</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Se uma condição de padrão é obrigatória (true) ou contextual (false).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#PatternCondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/agent">
    <rdfs:label xml:lang="en">Agents</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Agentes</rdfs:label>
    <dcterms:description xml:lang="en">Who acts: persons and collectives, identified by external IRIs, and the roles they play as analysts and creators.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">Quem age: pessoas e coletivos, identificados por IRIs externos, e os papéis que desempenham como analistas e criadores.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Sampling">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">sampling</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">sample</skos:prefLabel>
    <skos:definition xml:lang="en">Reuse of a portion of an existing recording.</skos:definition>
    <skos:definition xml:lang="pt-BR">Reuso de trecho de gravação existente.</skos:definition>
    <dcterms:source>Schloss 2004; Navas 2012</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na1a4e8438a7c458399efe57c798b0505">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="Nc964204ae47d4c359ab09d30f6b3fc22"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#FramingDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">framing / shot scale</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">enquadramento / escala de plano</skos:prefLabel>
    <skos:definition xml:lang="en">Frame, angle and shot scale.</skos:definition>
    <skos:definition xml:lang="pt-BR">Quadro, ângulo e escala do plano.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#CinematographyDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CollectiveAnalyst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">collective analyst</rdfs:label>
    <rdfs:label xml:lang="pt-BR">coletivo analista</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Collective, specializing the roleMixin Analyst; dependency: relationally on participation in an interpretive act</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Collective, especializando o roleMixin Analyst; dependência: relacionalmente da participação em um ato interpretativo</rdfs:comment>
    <skos:definition xml:lang="en">A collective while taking part in an interpretive act; defined as Collective and Analyst.</skos:definition>
    <skos:definition xml:lang="pt-BR">Coletivo enquanto participa de um ato interpretativo; definido como Collective e Analyst.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Collective"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Analyst"/>
    <owl:equivalentClass rdf:nodeID="N3dae652a52bf421192cab3da93feb49a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TitleDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">title</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">título</skos:prefLabel>
    <skos:definition xml:lang="en">Title and naming.</skos:definition>
    <skos:definition xml:lang="pt-BR">Título e nomeação.</skos:definition>
    <dcterms:source>Genette 1987</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#ParatextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasSupportingSelection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">record has supporting selection</rdfs:label>
    <rdfs:label xml:lang="pt-BR">interpretação usa recorte de apoio</rdfs:label>
    <skos:definition xml:lang="en">Links an interpretation record to further selections cited in its support, besides the primary one (other excerpts of the same or other works).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um registro de interpretação a outros recortes citados em seu apoio, além do principal (outros trechos da mesma obra ou de outras).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#InterpretationRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Selection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#GeneralDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">cross-media</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">transmidiática</skos:prefLabel>
    <skos:definition xml:lang="en">Dimensions applicable to any medium.</skos:definition>
    <skos:definition xml:lang="pt-BR">Dimensões aplicáveis a qualquer mídia.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#FanWork">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">fan work</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">obra de fã</skos:prefLabel>
    <skos:definition xml:lang="en">Non-official derivation by audience members; also type the mechanism (parody, continuation, crossover...).</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação não oficial feita pelo público; tipifique também o mecanismo (paródia, continuação, crossover...).</skos:definition>
    <dcterms:source>Jenkins 1992</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Extension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#TranslatorRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">translator</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">tradutor</skos:prefLabel>
    <skos:definition xml:lang="en">Agent producing a translation.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente que produz uma tradução.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CinematographyDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">cinematography</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">fotografia / cinematografia</skos:prefLabel>
    <skos:definition xml:lang="en">Photographic qualities of the shot.</skos:definition>
    <skos:definition xml:lang="pt-BR">Qualidades fotográficas do plano.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#AudiovisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DepictedAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">depicted agent</rdfs:label>
    <rdfs:label xml:lang="pt-BR">agente representado</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C representation; dependency: inherits DepictedElement identity</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: representação UFO-C; dependência: herda a identidade de DepictedElement</rdfs:comment>
    <skos:definition xml:lang="en">Depicted element referring to an agent or character.</skos:definition>
    <skos:definition xml:lang="pt-BR">Elemento representado que se refere a agente ou personagem.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/representation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#DepictedElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Performance">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">performance</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">performance / execução</skos:prefLabel>
    <skos:definition xml:lang="en">New performance of an existing work (recital, staging, recording).</skos:definition>
    <skos:definition xml:lang="pt-BR">Nova execução de obra existente (recital, encenação, gravação).</skos:definition>
    <dcterms:source>Smiraglia 2001</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#VersificationDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">versification</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">versificação</skos:prefLabel>
    <skos:definition xml:lang="en">Metre, rhyme and stanza form.</skos:definition>
    <skos:definition xml:lang="pt-BR">Métrica, rima e forma estrófica.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#TextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">agent</rdfs:label>
    <rdfs:label xml:lang="pt-BR">agente</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: category; foundation: UFO-A rigid non-sortal (category) over persons and collectives; agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: none of its own; identity from Person or Collective</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: category; fundamentação: não-sortal rígido UFO-A (category) sobre pessoas e coletivos; agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: nenhuma própria; identidade de Person ou Collective</rdfs:comment>
    <skos:definition xml:lang="en">Anything that can act intentionally: a person or a collective. Agents are identified by IRIs of external vocabularies (Wikidata, ORCID, ISNI, FOAF, schema.org).</skos:definition>
    <skos:definition xml:lang="pt-BR">Tudo o que pode agir intencionalmente: uma pessoa ou um coletivo. Agentes são identificados por IRIs de vocabulários externos (Wikidata, ORCID, ISNI, FOAF, schema.org).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <owl:disjointUnionOf rdf:nodeID="N30c36b8fea6f4302b06c9c8b96a29717"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ReverentialRegime">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationRegime"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
    <skos:prefLabel xml:lang="en">reverential / homage</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">reverencial / homenagem</skos:prefLabel>
    <skos:definition xml:lang="en">Derivation explicitly honouring the source (ARO addition, not in Genette).</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação que homenageia explicitamente a origem (acréscimo da ARO, não está em Genette).</skos:definition>
    <dcterms:source>ARO</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationRegimeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#realizesArtwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">expression realizes artwork</rdfs:label>
    <rdfs:label xml:lang="pt-BR">expressão realiza obra</rdfs:label>
    <skos:definition xml:lang="en">Links an expression to the artwork it realizes; read from the expression's side, it states which work this performance, recording, translation or version belongs to.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma expressão à obra que ela realiza; lida do lado da expressão, diz a qual obra pertence esta interpretação, gravação, tradução ou versão.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Expression"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Artwork"/>
    <owl:inverseOf rdf:resource="https://w3id.org/aro/ontology#hasExpression"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Transcription">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">transcription</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">transcrição</skos:prefLabel>
    <skos:definition xml:lang="en">Transfer to another notation or instrument.</skos:definition>
    <skos:definition xml:lang="pt-BR">Transferência para outra notação ou instrumento.</skos:definition>
    <dcterms:source>Burkholder 1994</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Justification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">justification</rdfs:label>
    <rdfs:label xml:lang="pt-BR">justificativa</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: the claim it supports and its articulated premises</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: a alegação que sustenta e suas premissas articuladas</rdfs:comment>
    <skos:definition xml:lang="en">Recorded argument connecting premises to a claim: why an interpretation, derivation, correspondence or hypothesis is asserted.</skos:definition>
    <skos:definition xml:lang="pt-BR">Argumento registrado que liga premissas a uma alegação: por que uma interpretação, derivação, correspondência ou hipótese é afirmada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#sourceURL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">source URL</rdfs:label>
    <rdfs:label xml:lang="pt-BR">URL da fonte</rdfs:label>
    <rdfs:comment xml:lang="en">Web address of a reference source (news page, article, dataset, video...). Availability is not guaranteed and a link is not a credibility claim.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Endereço web de uma fonte de referência (notícia, artigo, base de dados, vídeo...). A disponibilidade não é garantida e o link não é alegação de credibilidade.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#ReferenceSource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfca3f13c555f441f987d1881a54b2b1b">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Manifestation"/>
    <rdf:rest rdf:nodeID="N7795abd45195491583e9c4f0b7d707f8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3594298ce7a54ecd9402312fda26b4b3">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#EmpiricalCase"/>
    <rdf:rest rdf:nodeID="Na7da7be44eb74f1db581d9590c3a108f"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#embodiesExpression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">manifestation embodies expression</rdfs:label>
    <rdfs:label xml:lang="pt-BR">manifestação materializa expressão</rdfs:label>
    <skos:definition xml:lang="en">Links a manifestation to the expressions it embodies; an album edition embodies the recordings on it, a book edition the text version it prints.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma manifestação às expressões que ela materializa; uma edição de álbum materializa as gravações que contém, uma edição de livro a versão do texto que imprime.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Manifestation"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Expression"/>
    <owl:inverseOf rdf:resource="https://w3id.org/aro/ontology#hasManifestation"/>
    <rdfs:seeAlso rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/R4_embodies"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#AnalysisUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">analysis unit</rdfs:label>
    <rdfs:label xml:lang="pt-BR">unidade de análise</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: organizational reference to selections</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: referência organizacional a recortes</rdfs:comment>
    <skos:definition xml:lang="en">Intentional grouping of selections for analytical purposes.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agrupamento intencional de recortes com finalidade analítica.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AnalyticalRecord"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nedef9bbe287b475192db0b0591d6d66f">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#PatternCondition"/>
    <rdf:rest rdf:nodeID="N3594298ce7a54ecd9402312fda26b4b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#aspectSourceSelection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">aspect points to source selection</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aspecto aponta recorte de origem</rdfs:label>
    <skos:definition xml:lang="en">Points a transformation aspect to the excerpt of the source where the dimension can be observed.</skos:definition>
    <skos:definition xml:lang="pt-BR">Aponta um aspecto de transformação para o trecho da origem em que a dimensão pode ser observada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#TransformationAspect"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Selection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ThemeDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">theme</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">tema</skos:prefLabel>
    <skos:definition xml:lang="en">Topics and meanings foregrounded.</skos:definition>
    <skos:definition xml:lang="pt-BR">Assuntos e sentidos postos em evidência.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#GeneralDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ProducerRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">producer</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">produtor</skos:prefLabel>
    <skos:definition xml:lang="en">Agent responsible for producing a recording or production.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente responsável pela produção de gravação ou obra.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N675418d5678442628357c834af7c4c0e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="Nca4878fc26a6456582f7c2d91045a32e"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N33af1fea23c04da19c72f0c4ee8863f0">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#EmpiricalClaim"/>
    <rdf:rest rdf:nodeID="N6a17699394d84255a9e84d63b1edcc3b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#derivationExtent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">derivation extent</rdfs:label>
    <rdfs:label xml:lang="pt-BR">extensão da derivação</rdfs:label>
    <rdfs:comment xml:lang="en">Free-text extent of reuse (e.g. "4-second loop", "whole plot"); language-tagged.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Extensão livre do reaproveitamento (ex. "loop de 4 segundos", "enredo inteiro"); marcada por idioma.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#DerivationClaim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CreativeAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">creative act</rdfs:label>
    <rdfs:label xml:lang="pt-BR">ato criativo</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: event; foundation: UFO-B event; UFO-C intentional action; dependency: participating agents and temporal occurrence</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: event; fundamentação: evento UFO-B; ação intencional UFO-C; dependência: agentes participantes e ocorrência temporal</rdfs:comment>
    <skos:definition xml:lang="en">Intentional temporal activity that brings an artistic entity (artwork, expression or manifestation) into existence, including derivative ones.</skos:definition>
    <skos:definition xml:lang="pt-BR">Atividade intencional no tempo que faz existir uma entidade artística (obra, expressão ou manifestação), inclusive as derivadas.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:seeAlso rdf:resource="http://iflastandards.info/ns/lrm/lrmoo/F28_Expression_Creation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">aspect concerns a dimension</rdfs:label>
    <rdfs:label xml:lang="pt-BR">aspecto incide sobre dimensão</rdfs:label>
    <skos:definition xml:lang="en">States which artistic dimension (melody, lyrics, plot, character, medium...) a transformation aspect is about.</skos:definition>
    <skos:definition xml:lang="pt-BR">Diz de qual dimensão artística (melodia, letra, enredo, personagem, meio...) trata um aspecto de transformação.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#TransformationAspect"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#assessesEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assessment considers evidence</rdfs:label>
    <rdfs:label xml:lang="pt-BR">avaliação considera evidência</rdfs:label>
    <skos:definition xml:lang="en">Links an evidence assessment to the evidence items it weighs; every assessment considers at least one item.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma avaliação de evidência aos itens de evidência que ela pondera; toda avaliação considera pelo menos um item.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/evidence"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#EvidenceAssessment"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#EvidenceItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Rerealization">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">re-realization</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">re-realização</skos:prefLabel>
    <skos:definition xml:lang="en">New realization of substantially the same content; bibliographically often a new expression of the same work.</skos:definition>
    <skos:definition xml:lang="pt-BR">Nova realização de conteúdo substancialmente igual; na biblioteconomia, frequentemente nova expressão da mesma obra.</skos:definition>
    <dcterms:source>Tillett 1991; Smiraglia 2001; IFLA LRMoo 2024</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ExtendedRemix">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">extended remix</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">remix estendido</skos:prefLabel>
    <skos:definition xml:lang="en">Longer or re-edited version of the same recording that keeps its identity (e.g. club or extended mix).</skos:definition>
    <skos:definition xml:lang="pt-BR">Versão mais longa ou reeditada da mesma gravação que mantém sua identidade (ex. club mix, extended mix).</skos:definition>
    <dcterms:source>Navas 2012 (extended remix)</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Rerealization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SurfaceTextureDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">surface texture</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">textura de superfície</skos:prefLabel>
    <skos:definition xml:lang="en">Actual or represented surface quality.</skos:definition>
    <skos:definition xml:lang="pt-BR">Qualidade de superfície real ou representada.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#VisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Selection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">selection</rdfs:label>
    <rdfs:label xml:lang="pt-BR">recorte</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: kind; foundation: UFO-C information object; domain category; dependency: the expression it is taken from and its selectors</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; categoria de domínio; dependência: a expressão de onde é tirado e seus seletores</rdfs:comment>
    <skos:definition xml:lang="en">Addressable portion of an expression (lines, a time span, an image region), located by selectors; not a physical component.</skos:definition>
    <skos:definition xml:lang="pt-BR">Parte endereçável de uma expressão (linhas, trecho de tempo, região de imagem), localizada por seletores; não é componente físico.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/artwork"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#ArtisticEntity"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/oa#SpecificResource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N53b1e05e8bbe4afc986de093e9fea52a">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#CriteriaAssessment"/>
    <rdf:rest rdf:nodeID="N108423024a9a4f33b3066ea484386a29"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#FilmSoundDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">film sound</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">som fílmico</skos:prefLabel>
    <skos:definition xml:lang="en">Speech, music and effects and their relation to the image.</skos:definition>
    <skos:definition xml:lang="pt-BR">Fala, música e efeitos e sua relação com a imagem.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#AudiovisualDimension"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7da9b2f6c0ce434887b0eec4a7a5e029">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Analyst"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N30c36b8fea6f4302b06c9c8b96a29717">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Person"/>
    <rdf:rest rdf:nodeID="Nc0f0a748ebbf4bf884de63982372f123"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8b9c9df75a48455ea142b13fd4a07cb5">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#CreativeAct"/>
    <rdf:rest rdf:nodeID="Ne2d386e2ac764f8ba4f56ef5b5206b3c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ActingDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">acting / staging</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">atuação / marcação</skos:prefLabel>
    <skos:definition xml:lang="en">Performers' behaviour and movement in space.</skos:definition>
    <skos:definition xml:lang="pt-BR">Comportamento dos atores e movimento no espaço.</skos:definition>
    <dcterms:source>Bordwell &amp; Thompson, Film Art</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MiseEnSceneDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">person</rdfs:label>
    <rdfs:label xml:lang="pt-BR">pessoa</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: kind; foundation: UFO-A kind (substantial); agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: identity supplied by the person; ARO records only roles and contributions</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: kind; fundamentação: kind UFO-A (substancial); agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: identidade da própria pessoa; a ARO registra só papéis e contribuições</rdfs:comment>
    <skos:definition xml:lang="en">Individual human agent (author, performer, analyst, researcher).</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente humano individual (autor, intérprete, analista, pesquisador).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/agent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#Agent"/>
    <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Modified">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#TransformationOperation"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
    <skos:prefLabel xml:lang="en">modified</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">modificado</skos:prefLabel>
    <skos:definition xml:lang="en">Dimension present in both but changed.</skos:definition>
    <skos:definition xml:lang="pt-BR">Dimensão presente em ambas, mas alterada.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#challenges">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">challenge targets claim</rdfs:label>
    <rdfs:label xml:lang="pt-BR">contestação visa alegação</rdfs:label>
    <skos:definition xml:lang="en">Links a challenge to the claim it criticizes or offers an alternative to, so that disagreement is recorded rather than erased.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma contestação à alegação que ela critica ou para a qual propõe alternativa, de modo que a divergência fique registrada, e não apagada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Challenge"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Claim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#RemixerRole">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#CreativeRole"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
    <skos:prefLabel xml:lang="en">remixer</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">remixador</skos:prefLabel>
    <skos:definition xml:lang="en">Agent producing a remix or sample-based work.</skos:definition>
    <skos:definition xml:lang="pt-BR">Agente que produz remix ou obra baseada em samples.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#CreativeRoleScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne2d386e2ac764f8ba4f56ef5b5206b3c">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#CreativeContribution"/>
    <rdf:rest rdf:nodeID="N4bc05aaa0cc845319c09462b15a8e3ae"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Removed">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#TransformationOperation"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
    <skos:prefLabel xml:lang="en">removed</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">removido</skos:prefLabel>
    <skos:definition xml:lang="en">Source content omitted in the derivation.</skos:definition>
    <skos:definition xml:lang="pt-BR">Conteúdo da origem omitido na derivação.</skos:definition>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#TransformationOperationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/representation">
    <rdfs:label xml:lang="en">Representation</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Representação</rdfs:label>
    <dcterms:description xml:lang="en">What the work represents according to an interpretation: descriptions of situations, intentional states and depicted elements (characters, places, objects).</dcterms:description>
    <dcterms:description xml:lang="pt-BR">O que a obra representa segundo uma interpretação: descrições de situações, estados intencionais e elementos representados (personagens, lugares, objetos).</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#DerivationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">derivation type</rdfs:label>
    <rdfs:label xml:lang="pt-BR">tipo de derivação</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado</rdfs:comment>
    <skos:definition xml:lang="en">Kind of derivation (translation, cover, sampling, parody...); its instances are SKOS concepts.</skos:definition>
    <skos:definition xml:lang="pt-BR">Tipo de derivação (tradução, cover, sample, paródia...); suas instâncias são conceitos SKOS.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Interpolation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">interpolation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">interpolação</skos:prefLabel>
    <skos:definition xml:lang="en">Re-performance of a portion of the source inside a new work, without reusing the recording.</skos:definition>
    <skos:definition xml:lang="pt-BR">Reexecução de trecho da origem dentro de obra nova, sem reusar a gravação.</skos:definition>
    <dcterms:source>Schloss 2004</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Incorporation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#ArtisticDimensionScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Artistic dimensions</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">Dimensões artísticas</skos:prefLabel>
    <skos:definition xml:lang="en">Dimensions for annotation, grouped by medium family (narrative, verbal, music, visual, audiovisual, cross-media, paratext).</skos:definition>
    <skos:definition xml:lang="pt-BR">Dimensões para anotação, agrupadas por família de mídia (narrativa, verbal, música, visual, audiovisual, transmidiática, paratexto).</skos:definition>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#TextDimension"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#VisualDimension"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#AudiovisualDimension"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#GeneralDimension"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/aro/ontology#ParatextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">act includes contribution</rdfs:label>
    <rdfs:label xml:lang="pt-BR">ato inclui contribuição</rdfs:label>
    <skos:definition xml:lang="en">Links a creative act to the contributions that make it up, one per agent taking part.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um ato criativo às contribuições que o compõem, uma por agente participante.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#CreativeAct"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#CreativeContribution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SettingDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">setting</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">ambientação</skos:prefLabel>
    <skos:definition xml:lang="en">Represented time and place.</skos:definition>
    <skos:definition xml:lang="pt-BR">Tempo e lugar representados.</skos:definition>
    <dcterms:source>Chatman 1978</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#InterpretiveAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interpretive act</rdfs:label>
    <rdfs:label xml:lang="pt-BR">ato interpretativo</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: event; foundation: UFO-B event; UFO-C intentional action; dependency: participating agents and temporal occurrence</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: event; fundamentação: evento UFO-B; ação intencional UFO-C; dependência: agentes participantes e ocorrência temporal</rdfs:comment>
    <skos:definition xml:lang="en">Temporal intentional activity yielding interpretation records.</skos:definition>
    <skos:definition xml:lang="pt-BR">Atividade intencional temporal que produz interpretações registradas.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology/module/claim">
    <rdfs:label xml:lang="en">Claims and records</rdfs:label>
    <rdfs:label xml:lang="pt-BR">Alegações e registros</rdfs:label>
    <dcterms:description xml:lang="en">The common ground of every annotation: analytical records and, among them, claims, which can be produced by an act, justified, supported by sources, assessed and challenged.</dcterms:description>
    <dcterms:description xml:lang="pt-BR">A base comum de toda anotação: registros analíticos e, entre eles, alegações, que podem ser produzidas por um ato, justificadas, apoiadas em fontes, avaliadas e contestadas.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#RhythmDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">rhythm / groove</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">ritmo / groove</skos:prefLabel>
    <skos:definition xml:lang="en">Metric and rhythmic organization.</skos:definition>
    <skos:definition xml:lang="pt-BR">Organização métrica e rítmica.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne08218a1edc14fd0947b73dc46429dba">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#EmpiricalEvent"/>
    <rdf:rest rdf:nodeID="N8b9c9df75a48455ea142b13fd4a07cb5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N56c39ab114d84434bfc225c5e6749df4">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Challenge"/>
    <rdf:rest rdf:nodeID="N716d871aa91c429e922a468b51414ee9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#MelodyDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">melody</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">melodia</skos:prefLabel>
    <skos:definition xml:lang="en">Pitch–rhythm contour of a musical line.</skos:definition>
    <skos:definition xml:lang="pt-BR">Contorno de altura e ritmo de uma linha musical.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#MusicDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#CoverArtDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">cover art / poster</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">capa / cartaz</skos:prefLabel>
    <skos:definition xml:lang="en">Packaging, cover and promotional imagery.</skos:definition>
    <skos:definition xml:lang="pt-BR">Embalagem, capa e imagens promocionais.</skos:definition>
    <dcterms:source>Genette 1987</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#ParatextDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasTransformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim details a transformation aspect</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação detalha aspecto de transformação</rdfs:label>
    <skos:definition xml:lang="en">Links a derivation claim to the transformation aspects that detail it, one per artistic dimension that was retained, modified, added, removed or recontextualized.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma alegação de derivação aos aspectos de transformação que a detalham, um por dimensão artística mantida, modificada, adicionada, removida ou recontextualizada.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/derivation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#DerivationClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#TransformationAspect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SpinOff">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">spin-off</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">spin-off / derivado</skos:prefLabel>
    <skos:definition xml:lang="en">Work centred on secondary elements (characters, places) of the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Obra centrada em elementos secundários (personagens, lugares) da origem.</skos:definition>
    <dcterms:source>Jenkins 1992</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Extension"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N85661068b6864cc9a8459c25b8c4f5bf">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#Person"/>
    <rdf:rest rdf:nodeID="N65924889e25f45b68bf29ecbc63c5bf3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#SituationDimension">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#ArtisticDimension"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#ArtisticDimensionScheme"/>
    <skos:prefLabel xml:lang="en">represented situation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">situação representada</skos:prefLabel>
    <skos:definition xml:lang="en">Represented situations, comparable through SituationPattern.</skos:definition>
    <skos:definition xml:lang="pt-BR">Situações representadas, comparáveis via SituationPattern.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#NarrativeDimension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#EpistemicCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">epistemic criterion</rdfs:label>
    <rdfs:label xml:lang="pt-BR">critério epistêmico</rdfs:label>
    <rdfs:comment xml:lang="en">OntoUML stereotype: subkind; foundation: UFO-C normative information object (subkind of AssessmentCriterion); dependency: inherits AssessmentCriterion identity</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Estereótipo OntoUML: subkind; fundamentação: objeto informacional normativo UFO-C (subkind de AssessmentCriterion); dependência: herda a identidade de AssessmentCriterion</rdfs:comment>
    <skos:definition xml:lang="en">Criterion about knowledge: whether a claim is supported, coherent, plausible or well documented (textual evidence, source reliability, coherence with the work).</skos:definition>
    <skos:definition xml:lang="pt-BR">Critério sobre conhecimento: se uma alegação é apoiada, coerente, plausível ou bem documentada (evidência textual, confiabilidade da fonte, coerência com a obra).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aro/ontology#AssessmentCriterion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Imitation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">imitation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">imitação</skos:prefLabel>
    <skos:definition xml:lang="en">Derivation through imitating the manner or style of the source rather than reworking its content.</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação pela imitação da maneira ou estilo da origem, e não pela reelaboração do conteúdo.</skos:definition>
    <dcterms:source>Genette 1982 (hypertextuality)</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Transformation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">transformation</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">transformação</skos:prefLabel>
    <skos:definition xml:lang="en">Hypertextual derivation that changes content, form or context of the source.</skos:definition>
    <skos:definition xml:lang="pt-BR">Derivação hipertextual que altera conteúdo, forma ou contexto da origem.</skos:definition>
    <dcterms:source>Genette 1982 (hypertextuality)</dcterms:source>
    <skos:topConceptOf rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8dbd5cd8c5e04962b8cedaae0c2bb228">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#AnalysisUnit"/>
    <rdf:rest rdf:nodeID="N6f2313dfc53d4807a5c393da83d3b09c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N138ac48f1aeb4932bf420da647e73eb5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N1e9246e56b964c6e8db3fccc44714d08"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#Pastiche">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/aro/ontology#DerivationType"/>
    <skos:inScheme rdf:resource="https://w3id.org/aro/ontology#DerivationTypeScheme"/>
    <skos:prefLabel xml:lang="en">pastiche</skos:prefLabel>
    <skos:prefLabel xml:lang="pt-BR">pastiche</skos:prefLabel>
    <skos:definition xml:lang="en">Imitation of a style in a playful or affectionate regime.</skos:definition>
    <skos:definition xml:lang="pt-BR">Imitação de estilo em regime lúdico ou afetuoso.</skos:definition>
    <dcterms:source>Genette 1982; Dyer 2007</dcterms:source>
    <skos:broader rdf:resource="https://w3id.org/aro/ontology#Imitation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasJustification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim supported by justification</rdfs:label>
    <rdfs:label xml:lang="pt-BR">alegação sustentada por justificativa</rdfs:label>
    <skos:definition xml:lang="en">Links a claim to the argument that supports it: the premises and reasoning that lead to an interpretation, a derivation, a correspondence or a hypothesis.</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga uma alegação ao argumento que a sustenta: as premissas e o raciocínio que levam a uma interpretação, derivação, correspondência ou hipótese.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/claim"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#Claim"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Justification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">identifier</rdfs:label>
    <rdfs:label xml:lang="pt-BR">identificador</rdfs:label>
    <rdfs:comment xml:lang="en">Local identifier of a record; a stable URI is recommended. Not identity in the world.</rdfs:comment>
    <rdfs:comment xml:lang="pt-BR">Identificador local de um registro; recomenda-se URI estável. Não é identidade no mundo.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na039a77796d940189c4882fc3ef228e3">
    <rdf:first rdf:resource="https://w3id.org/aro/ontology#InterpretiveAct"/>
    <rdf:rest rdf:nodeID="N1549c151a91d4612800f4240ae269eca"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aro/ontology#hasParticipant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">agent participates in act</rdfs:label>
    <rdfs:label xml:lang="pt-BR">agente participa de ato</rdfs:label>
    <skos:definition xml:lang="en">Links an interpretive act to the agents (analysts) who took part in it. Agents are identified by external IRIs (Wikidata, ORCID, FOAF, schema.org).</skos:definition>
    <skos:definition xml:lang="pt-BR">Liga um ato interpretativo aos agentes (analistas) que participaram dele. Os agentes são identificados por IRIs externos (Wikidata, ORCID, FOAF, schema.org).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/aro/ontology/module/interpretation"/>
    <rdfs:domain rdf:resource="https://w3id.org/aro/ontology#InterpretiveAct"/>
    <rdfs:range rdf:resource="https://w3id.org/aro/ontology#Analyst"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
  </rdf:Description>
