      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Source reproduced with added material (annotated or illustrated edition, commentary track)."
      },
      {
        "@language": "pt-BR",
        "@value": "Origem reproduzida com material acrescentado (edição anotada ou ilustrada, faixa de comentário)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
