  {
    "@id": "https://w3id.org/aro/ontology/module/representation",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "What the work represents according to an interpretation: descriptions of situations, intentional states and depicted elements (characters, places, objects)."
      },
      {
        "@language": "pt-BR",
        "@value": "O que a obra representa segundo uma interpretação: descrições de situações, estados intencionais e elementos representados (personagens, lugares, objetos)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Representation"
      },
      {
        "@language": "pt-BR",
        "@value": "Representação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Variation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Burkholder 1994"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Transformation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Successive transformations of a given theme or motif."
      },
      {
        "@language": "pt-BR",
        "@value": "Transformações sucessivas de tema ou motivo dado."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "variation"
      },
      {
        "@language": "pt-BR",
        "@value": "variação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CriteriaAssessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Assessment; dependency: the assessed claim and its criteria"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Assessment; dependência: a alegação avaliada e seus critérios"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "criteria assessment"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação por critérios"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Assessment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Assessment of a claim against explicit epistemic or value criteria (plausibility, coherence, fidelity...)."
      },
      {
        "@language": "pt-BR",
        "@value": "Avaliação de uma alegação segundo critérios epistêmicos ou de valor explícitos (plausibilidade, coerência, fidelidade...)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology/module/artwork",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "What is analysed: artworks, their expressions (versions, performances, translations) and manifestations (editions, releases), as in IFLA LRM, and the addressable excerpts (selections) on which annotations are anchored."
      },
      {
        "@language": "pt-BR",
        "@value": "O que é analisado: obras, suas expressões (versões, interpretações, traduções) e manifestações (edições, lançamentos), como no IFLA LRM, e os trechos endereçáveis (recortes) em que as anotações se ancoram."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Artwork and selection"
      },
      {
        "@language": "pt-BR",
        "@value": "Obra e recorte"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#IntentionalStateDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C intentional content attribution; dependency: inherits SituationDescription identity"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: atribuição de conteúdo intencional UFO-C; dependência: herda a identidade de SituationDescription"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "intentional state description"
      },
      {
        "@language": "pt-BR",
        "@value": "descrição de estado intencional"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationDescription"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Situation description attributing desire, belief or intention to a depicted agent."
      },
      {
        "@language": "pt-BR",
        "@value": "Descrição de situação que atribui desejo, crença ou intenção a agente representado."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#caseAboutEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalCase"
      }
    ],
