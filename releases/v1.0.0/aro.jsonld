      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Successive version by the same or authorized agents (revised edition, director's cut, remaster)."
      },
      {
        "@language": "pt-BR",
        "@value": "Versão sucessiva pelos mesmos agentes ou autorizados (edição revista, director's cut, remasterização)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "revision"
      },
      {
        "@language": "pt-BR",
        "@value": "revisão / nova versão"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EvidenceAssessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Assessment; dependency: the assessed claim and the evidence weighed"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Assessment; dependência: a alegação avaliada e a evidência ponderada"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "evidence assessment"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação de evidência"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Assessment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Assessment of whether evidence items support, challenge or are irrelevant to a claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Avaliação de se itens de evidência apoiam, contestam ou são irrelevantes para uma alegação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Artwork",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: kind; foundation: UFO-C social/information object (domain commitment); dependency: historically on creation; not on a single copy"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: kind; fundamentação: objeto social/informacional UFO-C (compromisso de domínio); dependência: historicamente da criação; não de uma cópia específica"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artwork"
      },
      {
        "@language": "pt-BR",
        "@value": "obra"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iflastandards.info/ns/lrm/lrmoo/F1_Work"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticEntity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifiable artistic creation, considered independently of any particular version or copy (the LRM work level)."
      },
      {
        "@language": "pt-BR",
        "@value": "Criação artística identificável, considerada independentemente de qualquer versão ou cópia (nível obra do LRM)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#PlayfulRegime",
