      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A collective while taking part in an interpretive act; defined as Collective and Analyst."
      },
      {
        "@language": "pt-BR",
        "@value": "Coletivo enquanto participa de um ato interpretativo; definido como Collective e Analyst."
