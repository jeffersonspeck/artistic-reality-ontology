        "@language": "en",
        "@value": "Imitation of a style in a playful or affectionate regime."
      },
      {
        "@language": "pt-BR",
        "@value": "Imitação de estilo em regime lúdico ou afetuoso."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
