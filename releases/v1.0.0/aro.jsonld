      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "paraphrase"
      },
      {
        "@language": "pt-BR",
        "@value": "paráfrase"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ValueCriterion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C normative information object (subkind of AssessmentCriterion); dependency: inherits AssessmentCriterion identity"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional normativo UFO-C (subkind de AssessmentCriterion); dependência: herda a identidade de AssessmentCriterion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "value criterion"
      },
      {
        "@language": "pt-BR",
        "@value": "critério de valor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#AssessmentCriterion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Criterion about worth: whether a claim or reading is relevant, fair, original or ethically adequate, independently of being true."
      },
      {
        "@language": "pt-BR",
        "@value": "Critério sobre mérito: se uma alegação ou leitura é relevante, justa, original ou eticamente adequada, independentemente de ser verdadeira."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#assessmentOutcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "What the assessment concludes about the claim: supports, partiallySupports, challenges, inconclusive or irrelevant. It records the assessor's judgment, not the truth of the claim."
      },
      {
        "@language": "pt-BR",
        "@value": "O que a avaliação conclui sobre a alegação: supports (apoia), partiallySupports (apoia em parte), challenges (contesta), inconclusive (inconclusiva) ou irrelevant (irrelevante). Registra o julgamento de quem avalia, não a verdade da alegação."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Assessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment outcome"
      },
      {
        "@language": "pt-BR",
        "@value": "resultado da avaliação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#startDate",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "When an act, event or situation began (or happened, if it has no duration). Year, year-month, date or date-time."
      },
      {
        "@language": "pt-BR",
        "@value": "Quando um ato, evento ou situação começou (ou aconteceu, se não tem duração). Ano, ano-mês, data ou data-hora."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:Nd4e7ce8d42a247f89bd3c233ee3af69a"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "start date"
      },
      {
        "@language": "pt-BR",
        "@value": "data de início"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ]
  },
  {
    "@id": "_:Nd4e7ce8d42a247f89bd3c233ee3af69a",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aro/ontology#InterpretiveAct"
          },
          {
            "@id": "https://w3id.org/aro/ontology#CreativeAct"
          },
          {
            "@id": "https://w3id.org/aro/ontology#EmpiricalEvent"
          },
          {
            "@id": "https://w3id.org/aro/ontology#EmpiricalSituation"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#supportsInterpretation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretation supports another"
      },
      {
        "@language": "pt-BR",
        "@value": "interpretação apoia outra"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretation record to another interpretation that it supports, building chains of interpretations."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro de interpretação a outra interpretação que ele apoia, formando cadeias de interpretações."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#realizesArtwork",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Expression"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "expression realizes artwork"
      },
      {
        "@language": "pt-BR",
        "@value": "expressão realiza obra"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Artwork"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/aro/ontology#hasExpression"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an expression to the artwork it realizes; read from the expression's side, it states which work this performance, recording, translation or version belongs to."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma expressão à obra que ela realiza; lida do lado da expressão, diz a qual obra pertence esta interpretação, gravação, tradução ou versão."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Claim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object (propositional content as authored record, ADR-010); dependency: the act or agent that asserts it"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C (conteúdo proposicional como registro autoral, ADR-010); dependência: o ato ou agente que a afirma"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://schema.org/Claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalyticalRecord"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aro/ontology#Challenge"
          },
          {
            "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
          },
          {
            "@id": "https://w3id.org/aro/ontology#EmpiricalClaim"
          },
          {
            "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim"
          },
          {
            "@id": "https://w3id.org/aro/ontology#ExplanationHypothesis"
          },
          {
            "@id": "https://w3id.org/aro/ontology#DerivationClaim"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Analytical record that asserts something contestable: it can be produced by an act, justified, supported by sources, assessed and challenged. ARO represents claims, never their truth."
      },
      {
        "@language": "pt-BR",
        "@value": "Registro analítico que afirma algo contestável: pode ser produzido por um ato, justificado, apoiado em fontes, avaliado e contestado. A ARO representa alegações, nunca sua verdade."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#aspectDerivedSelection",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "aspect points to derived selection"
      },
      {
        "@language": "pt-BR",
        "@value": "aspecto aponta recorte derivado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Points a transformation aspect to the excerpt of the derived entity where the transformed dimension can be observed."
      },
      {
        "@language": "pt-BR",
        "@value": "Aponta um aspecto de transformação para o trecho da entidade derivada em que a dimensão transformada pode ser observada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#LightingDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MiseEnSceneDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Quality, direction and source of light."
      },
      {
        "@language": "pt-BR",
        "@value": "Qualidade, direção e fonte da luz."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "lighting"
      },
      {
        "@language": "pt-BR",
        "@value": "iluminação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SettingDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Chatman 1978"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#NarrativeDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Represented time and place."
      },
      {
        "@language": "pt-BR",
        "@value": "Tempo e lugar representados."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "setting"
      },
      {
        "@language": "pt-BR",
        "@value": "ambientação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MediumDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Rajewsky 2005"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#GeneralDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Material or technical medium of realization."
      },
      {
        "@language": "pt-BR",
        "@value": "Meio material ou técnico de realização."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "medium"
      },
      {
        "@language": "pt-BR",
        "@value": "mídia"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SituationDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object (subkind of AnalyticalRecord), not gufo:Situation; dependency: interpretive support and conceptual content"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C (subkind de AnalyticalRecord), não gufo:Situation; dependência: suporte interpretativo e conteúdo conceitual"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "situation description"
      },
      {
        "@language": "pt-BR",
        "@value": "descrição de situação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalyticalRecord"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Recorded description of a represented situation."
      },
      {
        "@language": "pt-BR",
        "@value": "Descrição registrada de situação representada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Agent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: category; foundation: UFO-A rigid non-sortal (category) over persons and collectives; agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: none of its own; identity from Person or Collective"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: category; fundamentação: não-sortal rígido UFO-A (category) sobre pessoas e coletivos; agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: nenhuma própria; identidade de Person ou Collective"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "agent"
      },
      {
        "@language": "pt-BR",
        "@value": "agente"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#Agent"
      },
      {
        "@id": "http://xmlns.com/foaf/0.1/Agent"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aro/ontology#Person"
          },
          {
            "@id": "https://w3id.org/aro/ontology#Collective"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Anything that can act intentionally: a person or a collective. Agents are identified by IRIs of external vocabularies (Wikidata, ORCID, ISNI, FOAF, schema.org)."
      },
      {
        "@language": "pt-BR",
        "@value": "Tudo o que pode agir intencionalmente: uma pessoa ou um coletivo. Agentes são identificados por IRIs de vocabulários externos (Wikidata, ORCID, ISNI, FOAF, schema.org)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#mentionsDepictedElement",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationDescription"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "description mentions depicted element"
      },
      {
        "@language": "pt-BR",
        "@value": "descrição menciona elemento"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#DepictedElement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a situation description to the depicted elements it involves (characters, places, objects, groups represented in the work)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma descrição de situação aos elementos representados que ela envolve (personagens, lugares, objetos, grupos representados na obra)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SpinOff",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Jenkins 1992"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Extension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Work centred on secondary elements (characters, places) of the source."
      },
      {
        "@language": "pt-BR",
        "@value": "Obra centrada em elementos secundários (personagens, lugares) da origem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "spin-off"
      },
      {
        "@language": "pt-BR",
        "@value": "spin-off / derivado"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#VisualDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Panofsky 1939"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Formal and iconographic properties of still or moving images."
      },
      {
        "@language": "pt-BR",
        "@value": "Propriedades formais e iconográficas de imagens fixas ou em movimento."
