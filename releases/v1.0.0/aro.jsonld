      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@value": "Roberto Pereira (UFPR) — doctoral supervisor"
      },
      {
        "@value": "Clodis Boscarioli (UNIOESTE) — doctoral co-supervisor"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Jefferson Rodrigo Speck (UFPR, PPGInf)"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Operational OWL vocabulary inspired by UFO; not a complete translation of the OntoUML reference model. It represents claims made by agents and their grounds; it asserts no claim as true. Terms are identified in English and fully labelled and defined in English and Brazilian Portuguese; textual content may be recorded in any language using language-tagged literals."
      },
      {
        "@language": "pt-BR",
        "@value": "Vocabulário OWL operacional inspirado na UFO; não é tradução completa do modelo de referência OntoUML. Representa alegações feitas por agentes e seus fundamentos; não afirma nenhuma alegação como verdadeira. Os termos são identificados em inglês e integralmente rotulados e definidos em inglês e português do Brasil; o conteúdo textual pode ser registrado em qualquer idioma com literais marcados por idioma."
      }
    ],
    "http://purl.org/dc/terms/hasPart": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/pattern"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/agent"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Artistic Reality Ontology"
      },
      {
        "@language": "pt-BR",
        "@value": "Ontologia de Arte e Realidade"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Integral part of the doctoral research of Jefferson Rodrigo Speck in the Graduate Program in Informatics (PPGInf) of the Federal University of Paraná (UFPR), supervised by Prof. Dr. Roberto Pereira (UFPR) and co-supervised by Prof. Dr. Clodis Boscarioli (UNIOESTE), linked to the Research Group on Technology and Innovation in Education (GTIE), UNIOESTE."
      },
      {
        "@language": "pt-BR",
        "@value": "Parte integrante da pesquisa de doutorado de Jefferson Rodrigo Speck no Programa de Pós-Graduação em Informática (PPGInf) da Universidade Federal do Paraná (UFPR), sob orientação do Prof. Dr. Roberto Pereira (UFPR) e coorientação do Prof. Dr. Clodis Boscarioli (UNIOESTE), com vinculação ao Grupo de Pesquisa em Tecnologia e Inovação na Educação (GTIE), UNIOESTE."
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "https://w3id.org/aro/ontology/0.3.0-beta"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/aro/ontology/1.0.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Stance of a derivation toward its source, orthogonal to its type (after Genette's regimes)."
      },
      {
        "@language": "pt-BR",
        "@value": "Postura da derivação em relação à origem, ortogonal ao tipo (a partir dos regimes de Genette)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/aro/ontology#PlayfulRegime"
      },
      {
        "@id": "https://w3id.org/aro/ontology#SatiricalRegime"
      },
      {
        "@id": "https://w3id.org/aro/ontology#SeriousRegime"
      },
      {
        "@id": "https://w3id.org/aro/ontology#ReverentialRegime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Derivation regimes"
      },
      {
        "@language": "pt-BR",
        "@value": "Regimes de derivação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MusicalTextureDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relation among simultaneous lines (monophony, homophony, polyphony)."
      },
      {
        "@language": "pt-BR",
        "@value": "Relação entre linhas simultâneas (monofonia, homofonia, polifonia)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "musical texture"
      },
      {
        "@language": "pt-BR",
        "@value": "textura musical"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EpistemicCriterion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C normative information object (subkind of AssessmentCriterion); dependency: inherits AssessmentCriterion identity"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional normativo UFO-C (subkind de AssessmentCriterion); dependência: herda a identidade de AssessmentCriterion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "epistemic criterion"
      },
      {
        "@language": "pt-BR",
        "@value": "critério epistêmico"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#AssessmentCriterion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Criterion about knowledge: whether a claim is supported, coherent, plausible or well documented (textual evidence, source reliability, coherence with the work)."
      },
      {
        "@language": "pt-BR",
        "@value": "Critério sobre conhecimento: se uma alegação é apoiada, coerente, plausível ou bem documentada (evidência textual, confiabilidade da fonte, coerência com a obra)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#FilmSoundDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#AudiovisualDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Speech, music and effects and their relation to the image."
      },
      {
        "@language": "pt-BR",
        "@value": "Fala, música e efeitos e sua relação com a imagem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "film sound"
      },
      {
        "@language": "pt-BR",
        "@value": "som fílmico"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CreativeAgent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: roleMixin; foundation: UFO-A anti-rigid non-sortal (roleMixin) specialized by PersonCreator and CollectiveCreator; dependency: relationally on a CreativeContribution; identity supplied by external kinds"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: roleMixin; fundamentação: não-sortal anti-rígido UFO-A (roleMixin) especializado por PersonCreator e CollectiveCreator; dependência: relacionalmente de uma CreativeContribution; identidade fornecida por tipos externos"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "creative agent"
      },
      {
        "@language": "pt-BR",
        "@value": "agente criativo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#Agent"
      },
      {
        "@id": "http://xmlns.com/foaf/0.1/Agent"
      },
      {
        "@id": "https://schema.org/Person"
      },
      {
        "@id": "https://schema.org/Organization"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Agent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Agent insofar as it contributes to a creative act (composes, performs, translates, directs...). Played by persons or collectives identified by external IRIs."
      },
      {
        "@language": "pt-BR",
        "@value": "Agente enquanto contribui para um ato criativo (compõe, interpreta, traduz, dirige...). Desempenhado por pessoas ou coletivos identificados por IRIs externos."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#assertsCase",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "correspondence references case"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação referencia caso"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalCase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a correspondence claim to the empirical case it compares with a pattern: the side of reality in the claim that art and reality correspond."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de correspondência ao caso empírico que ela compara com um padrão: o lado da realidade na alegação de que arte e realidade se correspondem."
      }
    ]
  },
