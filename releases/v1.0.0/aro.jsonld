      {
        "@language": "en",
        "@value": "character"
      },
      {
        "@language": "pt-BR",
        "@value": "personagem"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CreativeRole",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: type; foundation: UFO role type; operationalized as skos:Concept; dependency: controlled vocabulary membership"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: type; fundamentação: tipo de papel UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "creative role"
      },
      {
        "@language": "pt-BR",
        "@value": "papel criativo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Role qualifying a creative contribution (composer, performer, translator, remixer...)."
      },
      {
        "@language": "pt-BR",
        "@value": "Papel que qualifica uma contribuição criativa (compositor, intérprete, tradutor, remixador...)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ProducerRole",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#CreativeRole"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Agent responsible for producing a recording or production."
      },
      {
        "@language": "pt-BR",
        "@value": "Agente responsável pela produção de gravação ou obra."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "producer"
      },
      {
