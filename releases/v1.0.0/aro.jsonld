        "@language": "pt-BR",
        "@value": "Qualidade de superfície real ou representada."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "surface texture"
      },
      {
        "@language": "pt-BR",
        "@value": "textura de superfície"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#GeneralDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Dimensions applicable to any medium."
      },
      {
        "@language": "pt-BR",
        "@value": "Dimensões aplicáveis a qualquer mídia."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "cross-media"
      },
      {
        "@language": "pt-BR",
        "@value": "transmidiática"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EmpiricalEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: event; foundation: UFO-B event; dependency: real occurrence and participants"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: event; fundamentação: evento UFO-B; dependência: ocorrência real e participantes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "empirical event"
      },
      {
        "@language": "pt-BR",
        "@value": "evento empírico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Real-world temporally bounded occurrence."
      },
      {
        "@language": "pt-BR",
        "@value": "Ocorrência do mundo real delimitada temporalmente."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#textValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Human-readable text (labels, descriptions, explanations). Use language-tagged literals; the same resource may carry one value per language."
      },
      {
        "@language": "pt-BR",
        "@value": "Texto legível (rótulos, descrições, explicações). Use literais marcados por idioma; o mesmo recurso pode ter um valor por idioma."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "text value"
      },
      {
        "@language": "pt-BR",
        "@value": "valor textual"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Added",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#TransformationOperation"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Dimension content absent from the source."
      },
      {
        "@language": "pt-BR",
        "@value": "Conteúdo da dimensão ausente na origem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "added"
      },
      {
        "@language": "pt-BR",
        "@value": "acrescentado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#TimbreDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Sound sources and their colour."
      },
      {
        "@language": "pt-BR",
        "@value": "Fontes sonoras e sua cor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "timbre / instrumentation"
      },
      {
        "@language": "pt-BR",
        "@value": "timbre / instrumentação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasExpression",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artwork is realized through expression"
      },
      {
        "@language": "pt-BR",
        "@value": "obra se realiza por expressão"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Expression"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_in"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/aro/ontology#realizesArtwork"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an artwork to a realization of it with its own content (a performance, a recording, a translation, an arrangement, a text version). Use it to say through which expressions the work exists."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma obra a uma realização dela com conteúdo próprio (interpretação, gravação, tradução, arranjo, versão do texto). Use para dizer por quais expressões a obra existe."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Appropriation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Navas 2012"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Re-presentation of an existing work or image, often whole, in a new context that changes its sense."
      },
      {
        "@language": "pt-BR",
        "@value": "Reapresentação de obra ou imagem existente, frequentemente inteira, em novo contexto que altera seu sentido."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "appropriation"
      },
      {
        "@language": "pt-BR",
        "@value": "apropriação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasJustification",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim supported by justification"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação sustentada por justificativa"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Justification"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a claim to the argument that supports it: the premises and reasoning that lead to an interpretation, a derivation, a correspondence or a hypothesis."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação ao argumento que a sustenta: as premissas e o raciocínio que levam a uma interpretação, derivação, correspondência ou hipótese."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#caseAboutSituation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalCase"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "dossier describes real situations"
      },
      {
        "@language": "pt-BR",
        "@value": "dossiê descreve situação real"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalSituation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an empirical case (a documented dossier) to the real-world situations it documents."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um caso empírico (dossiê documentado) às situações do mundo real que ele documenta."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Rerealization",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Tillett 1991; Smiraglia 2001; IFLA LRMoo 2024"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "New realization of substantially the same content; bibliographically often a new expression of the same work."
      },
      {
        "@language": "pt-BR",
        "@value": "Nova realização de conteúdo substancialmente igual; na biblioteconomia, frequentemente nova expressão da mesma obra."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "re-realization"
      },
      {
        "@language": "pt-BR",
        "@value": "re-realização"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Person",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: kind; foundation: UFO-A kind (substantial); agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: identity supplied by the person; ARO records only roles and contributions"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: kind; fundamentação: kind UFO-A (substancial); agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: identidade da própria pessoa; a ARO registra só papéis e contribuições"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "person"
      },
      {
        "@language": "pt-BR",
        "@value": "pessoa"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      },
      {
        "@id": "https://schema.org/Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Agent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Individual human agent (author, performer, analyst, researcher)."
      },
      {
        "@language": "pt-BR",
        "@value": "Agente humano individual (autor, intérprete, analista, pesquisador)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#selectorExpression",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Compact selector shortcut; prefer hasSelector with W3C Web Annotation selectors."
      },
      {
        "@language": "pt-BR",
        "@value": "Atalho compacto de seletor; prefira hasSelector com seletores W3C Web Annotation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "selector expression"
      },
      {
        "@language": "pt-BR",
        "@value": "expressão de seletor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim; neither a UFO relator nor an asserted fact; dependency: exactly one source anchor and one derived anchor; typed by at least one derivation type"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim; nem relator UFO nem fato afirmado; dependência: exatamente uma âncora de origem e uma derivada; tipificada por ao menos um tipo de derivação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derivation claim"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação de derivação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#wasDerivedFrom"
      },
      {
        "@id": "https://schema.org/isBasedOn"
      },
      {
        "@id": "http://www.wikidata.org/prop/direct/P144"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Claim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Contestable assertion, made by an agent, that one artistic entity (artwork, expression, manifestation or selection) derives from another in specified ways. The derived entity is represented as a creation in its own right; legality and originality are outside the scope of the ontology."
      },
      {
        "@language": "pt-BR",
        "@value": "Alegação contestável, feita por um agente, de que uma entidade artística (obra, expressão, manifestação ou recorte) deriva de outra de modos especificados. A entidade derivada é representada como criação por direito próprio; legalidade e originalidade estão fora do escopo da ontologia."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#retrievedAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Capture provenance timestamp."
      },
      {
        "@language": "pt-BR",
        "@value": "Momento de captura, para proveniência."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "retrieved at"
      },
      {
        "@language": "pt-BR",
        "@value": "acessado em"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim; not a UFO relator; dependency: compared pattern/case and dimensions"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim; não é relator UFO; dependência: padrão/caso comparados e dimensões"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "correspondence claim"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação de correspondência"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Claim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Contestable assertion of similarity, instantiation or explanatory relevance between pattern and empirical case."
      },
      {
        "@language": "pt-BR",
        "@value": "Alegação contestável de similaridade, instanciação ou relevância explicativa entre padrão e caso empírico."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#TransformationOperation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transformation operation"
      },
      {
        "@language": "pt-BR",
        "@value": "operação de transformação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "What a derivation does to a dimension: retain, modify, add, remove or recontextualize."
      },
      {
        "@language": "pt-BR",
        "@value": "O que a derivação faz com uma dimensão: manter, modificar, acrescentar, remover ou recontextualizar."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#RecordedSoundDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Schloss 2004"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The fixed sound recording itself (relevant to sampling)."
      },
      {
        "@language": "pt-BR",
        "@value": "A própria gravação sonora fixada (relevante para sample)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "recorded sound"
      },
      {
        "@language": "pt-BR",
        "@value": "som gravado"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#PersonCreator",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Person, specializing the roleMixin CreativeAgent; dependency: relationally on participation in a creative act"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Person, especializando o roleMixin CreativeAgent; dependência: relacionalmente da participação em um ato criativo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "person creator"
      },
      {
        "@language": "pt-BR",
        "@value": "pessoa criadora"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Person"
      },
      {
        "@id": "https://w3id.org/aro/ontology#CreativeAgent"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:Na1a4e8438a7c458399efe57c798b0505"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A person while taking part in a creative act; defined as Person and CreativeAgent."
      },
      {
        "@language": "pt-BR",
        "@value": "Pessoa enquanto participa de um ato criativo; definido como Person e CreativeAgent."
      }
    ]
  },
  {
    "@id": "_:Na1a4e8438a7c458399efe57c798b0505",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#intersectionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aro/ontology#Person"
          },
          {
            "@id": "https://w3id.org/aro/ontology#CreativeAgent"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#producesCreation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeAct"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "act brings about artistic entity"
      },
      {
        "@language": "pt-BR",
        "@value": "ato faz surgir entidade artística"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticEntity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a creative act to the artistic entities it brings into existence (artworks, expressions, manifestations), including derivative ones."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um ato criativo às entidades artísticas que ele faz existir (obras, expressões, manifestações), inclusive as derivadas."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Abridgment",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Smiraglia 2001 (extractions)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation keeping a reduced part of the source (abridgment, excerpt, radio edit)."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação que mantém parte reduzida da origem (resumo, excerto, radio edit)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "abridgment / extraction"
      },
      {
        "@language": "pt-BR",
        "@value": "resumo / extração"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasManifestation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Expression"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "expression is embodied in manifestation"
      },
      {
        "@language": "pt-BR",
        "@value": "expressão se materializa em manifestação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Manifestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iflastandards.info/ns/lrm/lrmoo/R4_embodies"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/aro/ontology#embodiesExpression"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an expression to a publication or carrier that embodies it (an album edition, a book edition, a broadcast, a digital release). Optional: record it when the edition matters."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma expressão a uma publicação ou suporte que a materializa (edição de álbum, edição de livro, transmissão, lançamento digital). Opcional: registre quando a edição importa."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasParticipant",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretiveAct"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "agent participates in act"
      },
      {
        "@language": "pt-BR",
        "@value": "agente participa de ato"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Analyst"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#wasAssociatedWith"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretive act to the agents (analysts) who took part in it. Agents are identified by external IRIs (Wikidata, ORCID, FOAF, schema.org)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um ato interpretativo aos agentes (analistas) que participaram dele. Os agentes são identificados por IRIs externos (Wikidata, ORCID, FOAF, schema.org)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SeriousImitation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Imitation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Imitation aiming to be taken as in the manner of the source, e.g. apocryphal continuation; not necessarily fraud."
      },
      {
        "@language": "pt-BR",
        "@value": "Imitação que pretende ser tomada como da maneira da origem, ex. continuação apócrifa; não necessariamente fraude."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "serious imitation (forgerie)"
      },
      {
        "@language": "pt-BR",
        "@value": "imitação séria (forgerie)"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Transformation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982 (hypertextuality)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Hypertextual derivation that changes content, form or context of the source."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação hipertextual que altera conteúdo, forma ou contexto da origem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "transformation"
      },
      {
        "@language": "pt-BR",
        "@value": "transformação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#AudiovisualDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Stylistic systems of film, video and other moving-image media."
      },
      {
        "@language": "pt-BR",
        "@value": "Sistemas estilísticos de cinema, vídeo e outras mídias de imagem em movimento."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "audiovisual"
      },
      {
        "@language": "pt-BR",
        "@value": "audiovisual"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#InterpretiveAct",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: event; foundation: UFO-B event; UFO-C intentional action; dependency: participating agents and temporal occurrence"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: event; fundamentação: evento UFO-B; ação intencional UFO-C; dependência: agentes participantes e ocorrência temporal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretive act"
      },
      {
        "@language": "pt-BR",
        "@value": "ato interpretativo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Temporal intentional activity yielding interpretation records."
      },
      {
        "@language": "pt-BR",
        "@value": "Atividade intencional temporal que produz interpretações registradas."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CinematographyDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#AudiovisualDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Photographic qualities of the shot."
      },
      {
        "@language": "pt-BR",
        "@value": "Qualidades fotográficas do plano."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "cinematography"
      },
      {
        "@language": "pt-BR",
        "@value": "fotografia / cinematografia"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#RemixerRole",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#CreativeRole"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Agent producing a remix or sample-based work."
      },
      {
        "@language": "pt-BR",
        "@value": "Agente que produz remix ou obra baseada em samples."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "remixer"
      },
      {
        "@language": "pt-BR",
        "@value": "remixador"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ShapeDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#VisualDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Contours, lines, shapes and volumes."
      },
      {
        "@language": "pt-BR",
        "@value": "Contornos, linhas, formas e volumes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "line and shape"
      },
      {
        "@language": "pt-BR",
        "@value": "linha e forma"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#contributionTo",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeContribution"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contribution is to artistic entity"
      },
      {
        "@language": "pt-BR",
        "@value": "contribuição é para entidade artística"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticEntity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a creative contribution to the artistic entities the agent contributed to (the work, the recording, the edition). With contributionBy, it gives the relator its two mediated ends."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma contribuição criativa às entidades artísticas para as quais o agente contribuiu (a obra, a gravação, a edição). Com contributionBy, dá ao relator suas duas pontas mediadas."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#IconographyDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
