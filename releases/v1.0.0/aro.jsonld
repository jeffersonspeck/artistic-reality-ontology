  },
  {
    "@id": "https://w3id.org/aro/ontology#CollectiveCreator",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Collective, specializing the roleMixin CreativeAgent; dependency: relationally on participation in a creative act"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Collective, especializando o roleMixin CreativeAgent; dependência: relacionalmente da participação em um ato criativo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "collective creator"
      },
      {
        "@language": "pt-BR",
        "@value": "coletivo criador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Collective"
      },
      {
        "@id": "https://w3id.org/aro/ontology#CreativeAgent"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:N675418d5678442628357c834af7c4c0e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A collective while taking part in a creative act; defined as Collective and CreativeAgent."
      },
      {
        "@language": "pt-BR",
        "@value": "Coletivo enquanto participa de um ato criativo; definido como Collective e CreativeAgent."
      }
    ]
  },
  {
    "@id": "_:N675418d5678442628357c834af7c4c0e",
    "@type": [
