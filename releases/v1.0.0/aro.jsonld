  {
    "@id": "https://w3id.org/aro/ontology#hasDerivedAnchor",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim names the derived entity"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação indica entidade derivada"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticEntity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the entity said to derive from the source (any artistic entity): the derived side of the claim. It must differ from the source anchor."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação à entidade que se diz derivar da origem (qualquer entidade artística): o lado derivado da alegação. Deve ser diferente da âncora de origem."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Paraphrase",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Burkholder 1994"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
