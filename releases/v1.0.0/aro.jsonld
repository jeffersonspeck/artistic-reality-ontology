      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the entity the derivation starts from (any artistic entity: artwork, expression, manifestation or selection): the source side of the claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação à entidade de onde a derivação parte (qualquer entidade artística: obra, expressão, manifestação ou recorte): o lado de origem da alegação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#LyricsDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
