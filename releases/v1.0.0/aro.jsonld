  {
    "@id": "https://w3id.org/aro/ontology/module/derivation",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "How works derive from other works (cover, sampling, adaptation, parody...): derivation claims with types, regimes and transformation aspects, and the creative acts and contributions behind them."
      },
      {
        "@language": "pt-BR",
        "@value": "Como obras derivam de outras (cover, sampling, adaptação, paródia...): alegações de derivação com tipos, regimes e aspectos de transformação, e os atos e contribuições criativas por trás delas."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Derivation and creation"
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação e criação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CreditsDimension",
