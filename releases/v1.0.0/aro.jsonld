  },
  {
    "@id": "https://w3id.org/aro/ontology#hasTransformation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim details a transformation aspect"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação detalha aspecto de transformação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the transformation aspects that detail it, one per artistic dimension that was retained, modified, added, removed or recontextualized."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação aos aspectos de transformação que a detalham, um por dimensão artística mantida, modificada, adicionada, removida ou recontextualizada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#assessesEvidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EvidenceAssessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment considers evidence"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação considera evidência"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EvidenceItem"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an evidence assessment to the evidence items it weighs; every assessment considers at least one item."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma avaliação de evidência aos itens de evidência que ela pondera; toda avaliação considera pelo menos um item."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Retained",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#TransformationOperation"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
