      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Addressable portion of an expression (lines, a time span, an image region), located by selectors; not a physical component."
      },
      {
        "@language": "pt-BR",
        "@value": "Parte endereçável de uma expressão (linhas, trecho de tempo, região de imagem), localizada por seletores; não é componente físico."
      }
    ]
  },
