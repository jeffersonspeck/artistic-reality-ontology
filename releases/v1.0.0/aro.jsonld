      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "extension"
      },
      {
        "@language": "pt-BR",
        "@value": "extensão"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#challenges",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Challenge"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "challenge targets claim"
      },
      {
        "@language": "pt-BR",
        "@value": "contestação visa alegação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Claim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a challenge to the claim it criticizes or offers an alternative to, so that disagreement is recorded rather than erased."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma contestação à alegação que ela critica ou para a qual propõe alternativa, de modo que a divergência fique registrada, e não apagada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#selectsFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "selection references expression"
      },
      {
        "@language": "pt-BR",
        "@value": "recorte referencia expressão"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Expression"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a selection to the expression it is taken from. Every selection is cut from exactly one expression, so that its location (lines, seconds, region) is meaningful."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um recorte à expressão de onde ele é tirado. Todo recorte vem de exatamente uma expressão, para que sua localização (linhas, segundos, região) tenha sentido."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#PlotDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
