      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Remix",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Navas 2012 (selective and reflexive remix)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Selective or reflexive recombination of an existing recording's elements into a new whole; the remixer is a creator in their own right."
      },
      {
        "@language": "pt-BR",
        "@value": "Recombinação seletiva ou reflexiva dos elementos de gravação existente num novo todo; o remixador é criador por direito próprio."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "remix"
      },
      {
        "@language": "pt-BR",
        "@value": "remix"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Imitation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982 (hypertextuality)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation through imitating the manner or style of the source rather than reworking its content."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação pela imitação da maneira ou estilo da origem, e não pela reelaboração do conteúdo."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "imitation"
      },
      {
        "@language": "pt-BR",
        "@value": "imitação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ReverentialRegime",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationRegime"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "ARO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation explicitly honouring the source (ARO addition, not in Genette)."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação que homenageia explicitamente a origem (acréscimo da ARO, não está em Genette)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "reverential / homage"
      },
      {
        "@language": "pt-BR",
        "@value": "reverencial / homenagem"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Performance",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Smiraglia 2001"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "New performance of an existing work (recital, staging, recording)."
      },
      {
        "@language": "pt-BR",
        "@value": "Nova execução de obra existente (recital, encenação, gravação)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "performance"
      },
      {
        "@language": "pt-BR",
        "@value": "performance / execução"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#AnalyticalRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: kind; foundation: UFO-C information object; the single kind supplying the identity of every analytical record (ADR-026); dependency: historically on the act or agent that recorded it"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; o único kind que fornece a identidade de todo registro analítico (ADR-026); dependência: historicamente do ato ou agente que o registrou"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "analytical record"
      },
      {
        "@language": "pt-BR",
        "@value": "registro analítico"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aro/ontology#AnalysisUnit"
          },
          {
            "@id": "https://w3id.org/aro/ontology#Claim"
          },
          {
            "@id": "https://w3id.org/aro/ontology#Justification"
          },
          {
            "@id": "https://w3id.org/aro/ontology#Assessment"
          },
          {
            "@id": "https://w3id.org/aro/ontology#AssessmentCriterion"
          },
          {
            "@id": "https://w3id.org/aro/ontology#DepictedElement"
          },
          {
            "@id": "https://w3id.org/aro/ontology#SituationDescription"
          },
          {
            "@id": "https://w3id.org/aro/ontology#SituationPattern"
          },
          {
            "@id": "https://w3id.org/aro/ontology#PatternCondition"
          },
          {
            "@id": "https://w3id.org/aro/ontology#EmpiricalCase"
          },
          {
            "@id": "https://w3id.org/aro/ontology#EvidenceItem"
          },
          {
            "@id": "https://w3id.org/aro/ontology#TransformationAspect"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Information object recorded by an agent in the course of an analysis: the common sort of interpretations, descriptions, patterns, cases, evidence items, claims, justifications and assessments. Two records with the same text by different agents or acts are different records."
      },
      {
        "@language": "pt-BR",
        "@value": "Objeto informacional registrado por um agente no curso de uma análise: o tipo comum de interpretações, descrições, padrões, casos, itens de evidência, alegações, justificativas e avaliações. Dois registros com o mesmo texto feitos por agentes ou atos diferentes são registros diferentes."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology/module/evidence",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The empirical world and its grounds: real cases, situations and events, reference sources, evidence items, correspondence claims between art and reality, and their assessment."
      },
      {
        "@language": "pt-BR",
        "@value": "O mundo empírico e seus fundamentos: casos, situações e eventos reais, fontes de referência, itens de evidência, alegações de correspondência entre arte e realidade e sua avaliação."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Evidence and empirical world"
      },
      {
        "@language": "pt-BR",
        "@value": "Evidência e mundo empírico"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#sourceURL",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Web address of a reference source (news page, article, dataset, video...). Availability is not guaranteed and a link is not a credibility claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Endereço web de uma fonte de referência (notícia, artigo, base de dados, vídeo...). A disponibilidade não é garantida e o link não é alegação de credibilidade."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#ReferenceSource"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source URL"
      },
      {
        "@language": "pt-BR",
        "@value": "URL da fonte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MiseEnSceneDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#AudiovisualDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "What is placed before the camera."
      },
      {
        "@language": "pt-BR",
        "@value": "O que é posto diante da câmera."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "mise-en-scène"
      },
      {
        "@language": "pt-BR",
        "@value": "mise-en-scène"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#AuthorRole",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#CreativeRole"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Originator of verbal or narrative content."
      },
      {
        "@language": "pt-BR",
        "@value": "Criador do conteúdo verbal ou narrativo."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "author"
      },
      {
        "@language": "pt-BR",
        "@value": "autor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EvidenceItem",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: reference source and observation content"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: fonte de referência e conteúdo observado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "evidence item"
      },
      {
        "@language": "pt-BR",
        "@value": "item de evidência"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalyticalRecord"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Extracted contextual assertion or observation from a reference source."
      },
      {
        "@language": "pt-BR",
        "@value": "Afirmação ou observação contextualizada extraída de uma fonte."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#derivationRealizedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derivation carried out by creative act"
      },
      {
        "@language": "pt-BR",
        "@value": "derivação realizada por ato criativo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeAct"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the creative act that carried out the derivation (the recording, writing or adaptation that produced the derived entity)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação ao ato criativo que realizou a derivação (a gravação, escrita ou adaptação que produziu a entidade derivada)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Parody",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982; Hutcheon 1985"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Transformation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Transformation of a source in a playful or critical regime; repetition with critical difference."
      },
      {
        "@language": "pt-BR",
        "@value": "Transformação da origem em regime lúdico ou crítico; repetição com diferença crítica."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "parody"
      },
      {
        "@language": "pt-BR",
        "@value": "paródia"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Translation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Smiraglia 2001; Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Rendering of verbal content in another language. Genette also classes it as a serious transformation (transposition)."
      },
      {
        "@language": "pt-BR",
        "@value": "Transposição do conteúdo verbal para outra língua. Genette também a classifica como transformação séria (transposição)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "translation"
      },
      {
        "@language": "pt-BR",
        "@value": "tradução"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#InterpretationRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: anchor selection; the interpretive act that produced it"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: recorte de ancoragem; o ato interpretativo que o produziu"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretation record"
      },
      {
        "@language": "pt-BR",
        "@value": "registro de interpretação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/oa#Annotation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Claim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Persistent authored record of an interpretation of a selection."
      },
      {
        "@language": "pt-BR",
        "@value": "Registro autoral persistente de uma interpretação de recorte."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#generalizesAs",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationDescription"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "description motivates pattern abstraction"
      },
      {
        "@language": "pt-BR",
        "@value": "descrição motiva abstração"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationPattern"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a situation description to a situation pattern abstracted from it: the reusable configuration that the represented situation is taken to exemplify."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma descrição de situação a um padrão situacional abstraído dela: a configuração reutilizável que a situação representada é tomada como exemplo."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#VersificationDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#TextDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Metre, rhyme and stanza form."
      },
      {
        "@language": "pt-BR",
        "@value": "Métrica, rima e forma estrófica."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "versification"
      },
      {
        "@language": "pt-BR",
        "@value": "versificação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Non-exclusive kinds of derivation grouped in five families; one claim may carry several types. Grounded in Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon and Jenkins (see derivation-typology.md)."
      },
      {
        "@language": "pt-BR",
        "@value": "Tipos não exclusivos de derivação agrupados em cinco famílias; uma alegação pode ter vários tipos. Fundamentados em Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon e Jenkins (ver derivation-typology.md)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Transformation"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Imitation"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Extension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Derivation types"
      },
      {
        "@language": "pt-BR",
        "@value": "Tipos de derivação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasOperation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "aspect applies an operation"
      },
      {
        "@language": "pt-BR",
        "@value": "aspecto aplica operação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "States what was done to the dimension in a transformation aspect: retain, modify, add, remove or recontextualize."
      },
      {
        "@language": "pt-BR",
        "@value": "Diz o que foi feito com a dimensão num aspecto de transformação: manter, modificar, adicionar, remover ou recontextualizar."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#embodiesExpression",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Manifestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "manifestation embodies expression"
      },
      {
        "@language": "pt-BR",
        "@value": "manifestação materializa expressão"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Expression"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iflastandards.info/ns/lrm/lrmoo/R4_embodies"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/aro/ontology#hasManifestation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a manifestation to the expressions it embodies; an album edition embodies the recordings on it, a book edition the text version it prints."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma manifestação às expressões que ela materializa; uma edição de álbum materializa as gravações que contém, uma edição de livro a versão do texto que imprime."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MelodyDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Pitch–rhythm contour of a musical line."
      },
      {
        "@language": "pt-BR",
        "@value": "Contorno de altura e ritmo de uma linha musical."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "melody"
      },
      {
        "@language": "pt-BR",
        "@value": "melodia"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SetDesignDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MiseEnSceneDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Sets, locations and props."
      },
      {
        "@language": "pt-BR",
        "@value": "Cenários, locações e objetos de cena."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "set and props"
      },
      {
        "@language": "pt-BR",
        "@value": "cenário e objetos"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SituationDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#NarrativeDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Represented situations, comparable through SituationPattern."
      },
      {
        "@language": "pt-BR",
        "@value": "Situações representadas, comparáveis via SituationPattern."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "represented situation"
      },
      {
        "@language": "pt-BR",
        "@value": "situação representada"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SurfaceTextureDimension",
