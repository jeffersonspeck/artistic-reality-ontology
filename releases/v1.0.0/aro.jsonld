      {
        "@language": "en",
        "@value": "OntoUML stereotype: kind; foundation: UFO-C information object; domain category; dependency: the expression it is taken from and its selectors"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; categoria de domínio; dependência: a expressão de onde é tirado e seus seletores"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "selection"
      },
      {
        "@language": "pt-BR",
        "@value": "recorte"
      }
    ],
