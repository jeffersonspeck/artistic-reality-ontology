      {
        "@language": "pt-BR",
        "@value": "caso empírico"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalyticalRecord"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Documented dossier about one real-world situation or occurrence."
      },
      {
        "@language": "pt-BR",
        "@value": "Dossiê documentado sobre uma situação ou ocorrência real."
      }
    ]
  },
