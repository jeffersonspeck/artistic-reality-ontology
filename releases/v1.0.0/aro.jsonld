      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "dossier describes real events"
      },
      {
        "@language": "pt-BR",
        "@value": "dossiê descreve evento"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalEvent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an empirical case (a documented dossier) to the real-world events it documents."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um caso empírico (dossiê documentado) aos eventos do mundo real que ele documenta."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Recontextualized",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#TransformationOperation"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Content kept but placed in a different context that changes its sense."
      },
      {
        "@language": "pt-BR",
        "@value": "Conteúdo mantido, mas posto em contexto que altera seu sentido."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "recontextualized"
      },
      {
        "@language": "pt-BR",
        "@value": "recontextualizado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasPrimarySelection",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "record is anchored in selection"
      },
      {
        "@language": "pt-BR",
        "@value": "interpretação se ancora em recorte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/oa#hasTarget"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretation record to the one selection it is about: the excerpt of the work in which the interpretation is anchored."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro de interpretação ao único recorte de que ele trata: o trecho da obra em que a interpretação se ancora."
      }
    ]
  },
