      {
        "@language": "en",
        "@value": "pastiche"
      },
      {
        "@language": "pt-BR",
        "@value": "pastiche"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derivation type"
      },
      {
        "@language": "pt-BR",
        "@value": "tipo de derivação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Kind of derivation (translation, cover, sampling, parody...); its instances are SKOS concepts."
      },
      {
        "@language": "pt-BR",
        "@value": "Tipo de derivação (tradução, cover, sample, paródia...); suas instâncias são conceitos SKOS."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasContribution",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeAct"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "act includes contribution"
      },
      {
        "@language": "pt-BR",
        "@value": "ato inclui contribuição"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeContribution"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a creative act to the contributions that make it up, one per agent taking part."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um ato criativo às contribuições que o compõem, uma por agente participante."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#confidenceScore",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Application-defined confidence in [0,1]; not a calibrated probability."
      },
      {
        "@language": "pt-BR",
        "@value": "Confiança definida pela aplicação em [0,1]; não é probabilidade calibrada."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "confidence score"
      },
      {
        "@language": "pt-BR",
        "@value": "grau de confiança"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Dimensions for annotation, grouped by medium family (narrative, verbal, music, visual, audiovisual, cross-media, paratext)."
      },
      {
        "@language": "pt-BR",
        "@value": "Dimensões para anotação, agrupadas por família de mídia (narrativa, verbal, música, visual, audiovisual, transmidiática, paratexto)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/aro/ontology#NarrativeDimension"
      },
      {
        "@id": "https://w3id.org/aro/ontology#TextDimension"
      },
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      },
      {
        "@id": "https://w3id.org/aro/ontology#VisualDimension"
      },
      {
        "@id": "https://w3id.org/aro/ontology#AudiovisualDimension"
      },
      {
        "@id": "https://w3id.org/aro/ontology#GeneralDimension"
      },
      {
        "@id": "https://w3id.org/aro/ontology#ParatextDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Artistic dimensions"
      },
      {
        "@language": "pt-BR",
        "@value": "Dimensões artísticas"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#groupsSelection",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalysisUnit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "unit groups selections"
      },
      {
        "@language": "pt-BR",
        "@value": "unidade agrupa recortes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an analysis unit to the selections it groups, so that several excerpts can be analysed together as one unit (a scene, a refrain, a motif)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma unidade de análise aos recortes que ela agrupa, para que vários trechos sejam analisados juntos como uma unidade (uma cena, um refrão, um motivo)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#IntermedialAdaptation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Rajewsky 2005 (medial transposition); Hutcheon 2006"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Adaptation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Adaptation across media (novel to film, film to game, song to music video, novelization)."
      },
      {
        "@language": "pt-BR",
        "@value": "Adaptação entre mídias (romance para filme, filme para jogo, canção para videoclipe, novelização)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "intermedial adaptation"
      },
      {
        "@language": "pt-BR",
        "@value": "adaptação intermidiática"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ArtisticEntity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: category; foundation: UFO-A rigid non-sortal (category) generalizing kinds with different identity principles; dependency: none of its own; each instance takes the identity of its kind"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: category; fundamentação: não-sortal rígido UFO-A (category) que generaliza kinds com princípios de identidade diferentes; dependência: nenhuma própria; cada instância tem a identidade de seu kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artistic entity"
      },
      {
        "@language": "pt-BR",
        "@value": "entidade artística"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aro/ontology#Artwork"
          },
          {
            "@id": "https://w3id.org/aro/ontology#Expression"
          },
          {
            "@id": "https://w3id.org/aro/ontology#Manifestation"
          },
          {
            "@id": "https://w3id.org/aro/ontology#Selection"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Anything artistic that can be the origin or result of a derivation or a creative act: an artwork, an expression, a manifestation or a selection."
      },
      {
        "@language": "pt-BR",
        "@value": "Tudo o que é artístico e pode ser origem ou resultado de uma derivação ou de um ato criativo: obra, expressão, manifestação ou recorte."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CostumeMakeupDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MiseEnSceneDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Costume, make-up and hair."
      },
      {
        "@language": "pt-BR",
        "@value": "Figurino, maquiagem e cabelo."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "costume and make-up"
      },
      {
        "@language": "pt-BR",
        "@value": "figurino e maquiagem"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#producedByAct",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalyticalRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "act produces record"
      },
      {
        "@language": "pt-BR",
        "@value": "ato produz registro"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretiveAct"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#wasGeneratedBy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an analytical record (a claim, an assessment, a description...) to the analytical act that produced it, recording who made it, and when, as a historical fact distinct from its content. Required for interpretation records."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro analítico (alegação, avaliação, descrição...) ao ato analítico que o produziu, registrando quem o fez, e quando, como fato histórico distinto de seu conteúdo. Obrigatória para registros de interpretação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#describesSituation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretation yields descriptions"
      },
      {
        "@language": "pt-BR",
        "@value": "interpretação descreve situação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationDescription"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretation record to the descriptions of represented situations it yields: what, according to the interpretation, happens in the excerpt."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro de interpretação às descrições de situações representadas que ele produz: o que, segundo a interpretação, acontece no trecho."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Assessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: the assessed claims"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: as alegações avaliadas"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://schema.org/ClaimReview"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalyticalRecord"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aro/ontology#CriteriaAssessment"
          },
          {
            "@id": "https://w3id.org/aro/ontology#EvidenceAssessment"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Analytical record judging one or more closely related claims: by explicit criteria, by evidence, or both. It records a judgment made by an agent; it does not settle the claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Registro analítico que julga uma ou mais alegações intimamente relacionadas: por critérios explícitos, por evidência, ou ambos. Registra um julgamento feito por um agente; não resolve a alegação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Analyst",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype: roleMixin; foundation: UFO-A anti-rigid non-sortal (roleMixin) specialized by PersonAnalyst and CollectiveAnalyst; dependency: relationally on participation in an InterpretiveAct; identity supplied by external kinds"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML: roleMixin; fundamentação: não-sortal anti-rígido UFO-A (roleMixin) especializado por PersonAnalyst e CollectiveAnalyst; dependência: relacionalmente da participação num InterpretiveAct; identidade fornecida por tipos externos"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "analyst"
      },
      {
        "@language": "pt-BR",
        "@value": "analista"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#Agent"
      },
      {
        "@id": "http://xmlns.com/foaf/0.1/Person"
      },
      {
        "@id": "https://schema.org/Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#Agent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Agent insofar as it takes part in an interpretive act (interprets, describes, assesses). Played by persons or collectives identified by external IRIs."
      },
      {
        "@language": "pt-BR",
        "@value": "Agente enquanto participa de um ato interpretativo (interpreta, descreve, avalia). Desempenhado por pessoas ou coletivos identificados por IRIs externos."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CoverVersion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Mosser 2008; Mag Uidhir, Magnus & Magnus 2013"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Performance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Popular-music performance or recording of an existing song by other performers; the term is systematically ambiguous, so record dimensions too. The covering artist is a creator in their own right."
      },
      {
        "@language": "pt-BR",
        "@value": "Interpretação ou gravação de canção popular existente por outros intérpretes; termo sistematicamente ambíguo, por isso registre também as dimensões. O artista do cover é criador por direito próprio."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "cover version"
      },
      {
        "@language": "pt-BR",
        "@value": "versão cover"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#PoseGestureDimension",
