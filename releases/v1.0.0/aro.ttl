    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "amplification"@en,
        "ampliação"@pt-BR .

aro:Appropriation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Navas 2012" ;
    skos:broader aro:Incorporation ;
    skos:definition "Re-presentation of an existing work or image, often whole, in a new context that changes its sense."@en,
