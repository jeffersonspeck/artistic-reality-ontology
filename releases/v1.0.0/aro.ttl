    skos:broader aro:MusicDimension ;
    skos:definition "Large-scale structure (verse–chorus, sonata, AABA)."@en,
        "Estrutura em larga escala (verso–refrão, sonata, AABA)."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "musical form"@en,
        "forma musical"@pt-BR .

aro:MusicalTextureDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:MusicDimension ;
    skos:definition "Relation among simultaneous lines (monophony, homophony, polyphony)."@en,
        "Relação entre linhas simultâneas (monofonia, homofonia, polifonia)."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "musical texture"@en,
        "textura musical"@pt-BR .

aro:NarrationDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Genette 1972" ;
    skos:broader aro:NarrativeDimension ;
    skos:definition "Who narrates and from which narrative level."@en,
        "Quem narra e de qual nível narrativo."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "narration / voice"@en,
        "narração / voz"@pt-BR .

aro:NarrativeTimeDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Genette 1972" ;
    skos:broader aro:NarrativeDimension ;
    skos:definition "Order, duration and frequency of events in the telling."@en,
        "Ordem, duração e frequência dos eventos na narração."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "narrative time"@en,
        "tempo narrativo"@pt-BR .

aro:Paraphrase a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Burkholder 1994" ;
    skos:broader aro:Incorporation ;
    skos:definition "Source material reworked into a new line or passage while remaining traceable."@en,
        "Material de origem reelaborado em nova linha ou passagem, ainda rastreável."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "paraphrase"@en,
        "paráfrase"@pt-BR .

aro:Parody a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982; Hutcheon 1985" ;
    skos:broader aro:Transformation ;
    skos:definition "Transformation of a source in a playful or critical regime; repetition with critical difference."@en,
        "Transformação da origem em regime lúdico ou crítico; repetição com diferença crítica."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "parody"@en,
        "paródia"@pt-BR .

aro:Pastiche a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982; Dyer 2007" ;
    skos:broader aro:Imitation ;
    skos:definition "Imitation of a style in a playful or affectionate regime."@en,
        "Imitação de estilo em regime lúdico ou afetuoso."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "pastiche"@en,
        "pastiche"@pt-BR .

aro:PersonAnalyst a owl:Class ;
    rdfs:label "person analyst"@en,
        "pessoa analista"@pt-BR ;
    rdfs:comment "OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Person, specializing the roleMixin Analyst; dependency: relationally on participation in an interpretive act"@en,
        "Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Person, especializando o roleMixin Analyst; dependência: relacionalmente da participação em um ato interpretativo"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/agent> ;
    rdfs:subClassOf aro:Analyst,
        aro:Person ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( aro:Person aro:Analyst ) ] ;
    skos:definition "A person while taking part in an interpretive act; defined as Person and Analyst."@en,
        "Pessoa enquanto participa de um ato interpretativo; definido como Person e Analyst."@pt-BR .

aro:PersonCreator a owl:Class ;
    rdfs:label "person creator"@en,
        "pessoa criadora"@pt-BR ;
    rdfs:comment "OntoUML stereotype: role; foundation: UFO-A anti-rigid sortal (role) of Person, specializing the roleMixin CreativeAgent; dependency: relationally on participation in a creative act"@en,
        "Estereótipo OntoUML: role; fundamentação: sortal anti-rígido UFO-A (role) de Person, especializando o roleMixin CreativeAgent; dependência: relacionalmente da participação em um ato criativo"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/agent> ;
    rdfs:subClassOf aro:CreativeAgent,
        aro:Person ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( aro:Person aro:CreativeAgent ) ] ;
    skos:definition "A person while taking part in a creative act; defined as Person and CreativeAgent."@en,
        "Pessoa enquanto participa de um ato criativo; definido como Person e CreativeAgent."@pt-BR .

aro:PlotDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Chatman 1978" ;
    skos:broader aro:NarrativeDimension ;
    skos:definition "Sequence of represented events."@en,
        "Sequência de eventos representados."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "plot"@en,
        "enredo"@pt-BR .

aro:PoseGestureDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Panofsky 1939" ;
    skos:broader aro:VisualDimension ;
    skos:definition "Bodily posture and gesture of represented figures."@en,
        "Postura corporal e gesto de figuras representadas."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "pose and gesture"@en,
        "pose e gesto"@pt-BR .

aro:Prequel a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Tillett 1991" ;
    skos:broader aro:Continuation ;
    skos:definition "Continuation set before the source."@en,
        "Continuação situada antes da origem."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "prequel"@en,
        "prequela"@pt-BR .

aro:ProductionDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:MusicDimension ;
    skos:definition "Studio processing, mix and sound design."@en,
        "Processamento de estúdio, mixagem e desenho de som."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "production / mix"@en,
        "produção / mixagem"@pt-BR .

aro:Quotation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982; Burkholder 1994" ;
    skos:broader aro:Incorporation ;
    skos:definition "Explicit, recognizable reproduction of an excerpt, verbal, musical or visual."@en,
        "Reprodução explícita e reconhecível de excerto, verbal, musical ou visual."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "quotation"@en,
        "citação"@pt-BR .

aro:RecordedSoundDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Schloss 2004" ;
    skos:broader aro:MusicDimension ;
    skos:definition "The fixed sound recording itself (relevant to sampling)."@en,
        "A própria gravação sonora fixada (relevante para sample)."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "recorded sound"@en,
        "som gravado"@pt-BR .

aro:Remake a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Verevis 2006" ;
    skos:broader aro:Rerealization ;
    skos:definition "New audiovisual production based on an earlier production of the same story."@en,
        "Nova produção audiovisual baseada em produção anterior da mesma história."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "remake"@en,
        "refilmagem / remake"@pt-BR .

aro:Remix a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Navas 2012 (selective and reflexive remix)" ;
    skos:broader aro:Incorporation ;
    skos:definition "Selective or reflexive recombination of an existing recording's elements into a new whole; the remixer is a creator in their own right."@en,
        "Recombinação seletiva ou reflexiva dos elementos de gravação existente num novo todo; o remixador é criador por direito próprio."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "remix"@en,
        "remix"@pt-BR .

aro:Revision a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Smiraglia 2001 (successive derivations)" ;
    skos:broader aro:Rerealization ;
    skos:definition "Successive version by the same or authorized agents (revised edition, director's cut, remaster)."@en,
        "Versão sucessiva pelos mesmos agentes ou autorizados (edição revista, director's cut, remasterização)."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "revision"@en,
        "revisão / nova versão"@pt-BR .

aro:RhythmDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:MusicDimension ;
    skos:definition "Metric and rhythmic organization."@en,
        "Organização métrica e rítmica."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "rhythm / groove"@en,
        "ritmo / groove"@pt-BR .

aro:Sampling a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Schloss 2004; Navas 2012" ;
    skos:broader aro:Incorporation ;
    skos:definition "Reuse of a portion of an existing recording."@en,
        "Reuso de trecho de gravação existente."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "sampling"@en,
        "sample"@pt-BR .

aro:Sequel a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Tillett 1991" ;
    skos:broader aro:Continuation ;
    skos:definition "Continuation set after the source."@en,
        "Continuação situada depois da origem."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "sequel"@en,
        "sequência"@pt-BR .

aro:SeriousImitation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982" ;
    skos:broader aro:Imitation ;
    skos:definition "Imitation aiming to be taken as in the manner of the source, e.g. apocryphal continuation; not necessarily fraud."@en,
        "Imitação que pretende ser tomada como da maneira da origem, ex. continuação apócrifa; não necessariamente fraude."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "serious imitation (forgerie)"@en,
        "imitação séria (forgerie)"@pt-BR .

aro:SetDesignDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Bordwell & Thompson, Film Art" ;
    skos:broader aro:MiseEnSceneDimension ;
    skos:definition "Sets, locations and props."@en,
        "Cenários, locações e objetos de cena."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "set and props"@en,
        "cenário e objetos"@pt-BR .

aro:SettingDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Chatman 1978" ;
    skos:broader aro:NarrativeDimension ;
    skos:definition "Represented time and place."@en,
        "Tempo e lugar representados."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "setting"@en,
        "ambientação"@pt-BR .

aro:ShapeDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:VisualDimension ;
    skos:definition "Contours, lines, shapes and volumes."@en,
        "Contornos, linhas, formas e volumes."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "line and shape"@en,
        "linha e forma"@pt-BR .

aro:SituationDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:NarrativeDimension ;
    skos:definition "Represented situations, comparable through SituationPattern."@en,
        "Situações representadas, comparáveis via SituationPattern."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "represented situation"@en,
        "situação representada"@pt-BR .

aro:SpaceDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:VisualDimension ;
    skos:definition "Depth, perspective and scale."@en,
        "Profundidade, perspectiva e escala."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "space and perspective"@en,
        "espaço e perspectiva"@pt-BR .

aro:SpinOff a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Jenkins 1992" ;
    skos:broader aro:Extension ;
    skos:definition "Work centred on secondary elements (characters, places) of the source."@en,
        "Obra centrada em elementos secundários (personagens, lugares) da origem."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "spin-off"@en,
        "spin-off / derivado"@pt-BR .

aro:StyleDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Dyer 2007" ;
    skos:broader aro:GeneralDimension ;
    skos:definition "Recognizable manner of a creator, genre or period."@en,
        "Maneira reconhecível de autor, gênero ou período."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "style"@en,
        "estilo"@pt-BR .

aro:SurfaceTextureDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:VisualDimension ;
    skos:definition "Actual or represented surface quality."@en,
        "Qualidade de superfície real ou representada."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "surface texture"@en,
        "textura de superfície"@pt-BR .

aro:TempoDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:MusicDimension ;
    skos:definition "Speed and its changes."@en,
        "Velocidade e suas variações."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "tempo"@en,
        "andamento"@pt-BR .

aro:ThemeDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:GeneralDimension ;
    skos:definition "Topics and meanings foregrounded."@en,
        "Assuntos e sentidos postos em evidência."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "theme"@en,
        "tema"@pt-BR .

aro:TimbreDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:MusicDimension ;
    skos:definition "Sound sources and their colour."@en,
        "Fontes sonoras e sua cor."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "timbre / instrumentation"@en,
        "timbre / instrumentação"@pt-BR .

aro:TitleDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Genette 1987" ;
    skos:broader aro:ParatextDimension ;
    skos:definition "Title and naming."@en,
        "Título e nomeação."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "title"@en,
        "título"@pt-BR .

aro:ToneDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:GeneralDimension ;
    skos:definition "Affective colouring and mood."@en,
        "Coloração afetiva e atmosfera."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "tone / mood"@en,
        "tom / atmosfera"@pt-BR .

aro:Transcription a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Burkholder 1994" ;
    skos:broader aro:Rerealization ;
    skos:definition "Transfer to another notation or instrument."@en,
        "Transferência para outra notação ou instrumento."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "transcription"@en,
        "transcrição"@pt-BR .

aro:Translation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Smiraglia 2001; Genette 1982" ;
    skos:broader aro:Rerealization ;
    skos:definition "Rendering of verbal content in another language. Genette also classes it as a serious transformation (transposition)."@en,
        "Transposição do conteúdo verbal para outra língua. Genette também a classifica como transformação séria (transposição)."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "translation"@en,
        "tradução"@pt-BR .

aro:Travesty a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982" ;
    skos:broader aro:Transformation ;
    skos:definition "Satirical transformation that keeps the content but degrades its style or register."@en,
        "Transformação satírica que mantém o conteúdo mas rebaixa estilo ou registro."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "travesty"@en,
        "travestimento"@pt-BR .

aro:UnacknowledgedBorrowing a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982" ;
    skos:broader aro:Incorporation ;
    skos:definition "Literal borrowing presented without acknowledgment of the source (Genette's 'plagiat'); a descriptive textual relation, not a legal or moral judgment."@en,
        "Empréstimo literal apresentado sem reconhecimento da origem (o 'plagiat' de Genette); relação textual descritiva, não julgamento jurídico ou moral."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "unacknowledged borrowing"@en,
        "empréstimo não declarado"@pt-BR .

aro:Variation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Burkholder 1994" ;
    skos:broader aro:Transformation ;
    skos:definition "Successive transformations of a given theme or motif."@en,
        "Transformações sucessivas de tema ou motivo dado."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "variation"@en,
        "variação"@pt-BR .

aro:VersificationDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:TextDimension ;
    skos:definition "Metre, rhyme and stanza form."@en,
        "Métrica, rima e forma estrófica."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "versification"@en,
        "versificação"@pt-BR .

aro:VisualCompositionDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:broader aro:VisualDimension ;
    skos:definition "Arrangement of elements in the frame or picture plane."@en,
        "Disposição dos elementos no quadro ou plano pictórico."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "visual composition"@en,
        "composição visual"@pt-BR .

aro:VocalDeliveryDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Mag Uidhir, Magnus & Magnus 2013" ;
    skos:broader aro:MusicDimension ;
    skos:definition "Singing or speaking manner, phrasing, ornamentation."@en,
        "Maneira de cantar ou falar, fraseado, ornamentação."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "vocal delivery"@en,
        "interpretação vocal"@pt-BR .

aro:aspectConcernsPattern a owl:ObjectProperty ;
    rdfs:label "aspect concerns a situation pattern"@en,
        "aspecto envolve padrão situacional"@pt-BR ;
    rdfs:domain aro:TransformationAspect ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:SituationPattern ;
    skos:definition "Links a transformation aspect to a situation pattern it affects, when a derivation keeps, changes or relocates a represented situation."@en,
        "Liga um aspecto de transformação a um padrão situacional que ele afeta, quando a derivação mantém, altera ou desloca uma situação representada."@pt-BR .

aro:aspectDerivedSelection a owl:ObjectProperty ;
    rdfs:label "aspect points to derived selection"@en,
        "aspecto aponta recorte derivado"@pt-BR ;
    rdfs:domain aro:TransformationAspect ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:Selection ;
    skos:definition "Points a transformation aspect to the excerpt of the derived entity where the transformed dimension can be observed."@en,
        "Aponta um aspecto de transformação para o trecho da entidade derivada em que a dimensão transformada pode ser observada."@pt-BR .

aro:aspectSourceSelection a owl:ObjectProperty ;
    rdfs:label "aspect points to source selection"@en,
        "aspecto aponta recorte de origem"@pt-BR ;
    rdfs:domain aro:TransformationAspect ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:Selection ;
    skos:definition "Points a transformation aspect to the excerpt of the source where the dimension can be observed."@en,
        "Aponta um aspecto de transformação para o trecho da origem em que a dimensão pode ser observada."@pt-BR .

aro:assertsCase a owl:ObjectProperty ;
    rdfs:label "correspondence references case"@en,
        "alegação referencia caso"@pt-BR ;
    rdfs:domain aro:CorrespondenceClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:range aro:EmpiricalCase ;
    skos:definition "Links a correspondence claim to the empirical case it compares with a pattern: the side of reality in the claim that art and reality correspond."@en,
        "Liga uma alegação de correspondência ao caso empírico que ela compara com um padrão: o lado da realidade na alegação de que arte e realidade se correspondem."@pt-BR .

aro:assertsPattern a owl:ObjectProperty ;
    rdfs:label "correspondence references pattern"@en,
        "alegação referencia padrão"@pt-BR ;
    rdfs:domain aro:CorrespondenceClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:range aro:SituationPattern ;
    skos:definition "Links a correspondence claim to the situation pattern it compares with a real case: the side of art in the claim that art and reality correspond."@en,
        "Liga uma alegação de correspondência ao padrão situacional que ela compara com um caso real: o lado da arte na alegação de que arte e realidade se correspondem."@pt-BR .

aro:assessesClaim a owl:ObjectProperty ;
    rdfs:label "assessment judges claims"@en,
        "avaliação julga alegações"@pt-BR ;
    rdfs:domain aro:Assessment ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:range aro:Claim ;
    skos:definition "Links an assessment to the claims it judges: an interpretation, a derivation, a correspondence, an empirical claim, a hypothesis or a challenge. Usually one; several when the same evidence bears on closely related claims (e.g. an empirical claim and the correspondence that relies on it)."@en,
        "Liga uma avaliação às alegações que ela julga: interpretação, derivação, correspondência, afirmação empírica, hipótese ou contestação. Em geral uma; várias quando a mesma evidência incide sobre alegações intimamente relacionadas (ex.: uma afirmação empírica e a correspondência que nela se apoia)."@pt-BR .

aro:assessesEvidence a owl:ObjectProperty ;
    rdfs:label "assessment considers evidence"@en,
        "avaliação considera evidência"@pt-BR ;
    rdfs:domain aro:EvidenceAssessment ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:range aro:EvidenceItem ;
    skos:definition "Links an evidence assessment to the evidence items it weighs; every assessment considers at least one item."@en,
        "Liga uma avaliação de evidência aos itens de evidência que ela pondera; toda avaliação considera pelo menos um item."@pt-BR .

aro:assessmentOutcome a owl:DatatypeProperty ;
    rdfs:label "assessment outcome"@en,
        "resultado da avaliação"@pt-BR ;
    rdfs:comment "What the assessment concludes about the claim: supports, partiallySupports, challenges, inconclusive or irrelevant. It records the assessor's judgment, not the truth of the claim."@en,
        "O que a avaliação conclui sobre a alegação: supports (apoia), partiallySupports (apoia em parte), challenges (contesta), inconclusive (inconclusiva) ou irrelevant (irrelevante). Registra o julgamento de quem avalia, não a verdade da alegação."@pt-BR ;
    rdfs:domain aro:Assessment ;
    rdfs:range xsd:string .

aro:caseAboutEvent a owl:ObjectProperty ;
    rdfs:label "dossier describes real events"@en,
        "dossiê descreve evento"@pt-BR ;
    rdfs:domain aro:EmpiricalCase ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:range aro:EmpiricalEvent ;
    skos:definition "Links an empirical case (a documented dossier) to the real-world events it documents."@en,
        "Liga um caso empírico (dossiê documentado) aos eventos do mundo real que ele documenta."@pt-BR .

aro:caseAboutSituation a owl:ObjectProperty ;
    rdfs:label "dossier describes real situations"@en,
        "dossiê descreve situação real"@pt-BR ;
    rdfs:domain aro:EmpiricalCase ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:range aro:EmpiricalSituation ;
    skos:definition "Links an empirical case (a documented dossier) to the real-world situations it documents."@en,
        "Liga um caso empírico (dossiê documentado) às situações do mundo real que ele documenta."@pt-BR .

aro:challenges a owl:ObjectProperty ;
    rdfs:label "challenge targets claim"@en,
        "contestação visa alegação"@pt-BR ;
    rdfs:domain aro:Challenge ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:range aro:Claim ;
    skos:definition "Links a challenge to the claim it criticizes or offers an alternative to, so that disagreement is recorded rather than erased."@en,
        "Liga uma contestação à alegação que ela critica ou para a qual propõe alternativa, de modo que a divergência fique registrada, e não apagada."@pt-BR .

aro:citesSource a owl:ObjectProperty ;
    rdfs:label "record cites source"@en,
        "registro cita fonte"@pt-BR ;
    rdfs:domain aro:AnalyticalRecord ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:range aro:ReferenceSource ;
    rdfs:seeAlso dcterms:references ;
    skos:definition "Links any analytical record (a claim, a case, a description, a pattern) to a reference source it relies on or that documents it (criticism, interview, news, study, credits)."@en,
        "Liga qualquer registro analítico (alegação, caso, descrição, padrão) a uma fonte de referência em que se apoia ou que o documenta (crítica, entrevista, notícia, estudo, créditos)."@pt-BR .

aro:confidenceScore a owl:DatatypeProperty ;
    rdfs:label "confidence score"@en,
        "grau de confiança"@pt-BR ;
    rdfs:comment "Application-defined confidence in [0,1]; not a calibrated probability."@en,
        "Confiança definida pela aplicação em [0,1]; não é probabilidade calibrada."@pt-BR ;
    rdfs:range xsd:decimal .

aro:contributionBy a owl:ObjectProperty ;
    rdfs:label "contribution made by agent"@en,
        "contribuição feita por agente"@pt-BR ;
    rdfs:domain aro:CreativeContribution ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:CreativeAgent ;
    skos:definition "Links a creative contribution to the agent who made it, identified by an external IRI (Wikidata, ISNI, MusicBrainz, schema.org)."@en,
        "Liga uma contribuição criativa ao agente que a fez, identificado por um IRI externo (Wikidata, ISNI, MusicBrainz, schema.org)."@pt-BR .

aro:contributionRole a owl:ObjectProperty ;
    rdfs:label "contribution qualified by role"@en,
        "contribuição qualificada por papel"@pt-BR ;
    rdfs:domain aro:CreativeContribution ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:CreativeRole ;
    skos:definition "Qualifies a creative contribution with one or more roles of the creative-role vocabulary (composer, performer, translator, remixer...)."@en,
        "Qualifica uma contribuição criativa com um ou mais papéis do vocabulário de papéis criativos (compositor, intérprete, tradutor, remixador...)."@pt-BR .

aro:contributionTo a owl:ObjectProperty ;
    rdfs:label "contribution is to artistic entity"@en,
        "contribuição é para entidade artística"@pt-BR ;
    rdfs:domain aro:CreativeContribution ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:ArtisticEntity ;
    skos:definition "Links a creative contribution to the artistic entities the agent contributed to (the work, the recording, the edition). With contributionBy, it gives the relator its two mediated ends."@en,
        "Liga uma contribuição criativa às entidades artísticas para as quais o agente contribuiu (a obra, a gravação, a edição). Com contributionBy, dá ao relator suas duas pontas mediadas."@pt-BR .

aro:derivationExtent a owl:DatatypeProperty ;
    rdfs:label "derivation extent"@en,
        "extensão da derivação"@pt-BR ;
    rdfs:comment "Free-text extent of reuse (e.g. \"4-second loop\", \"whole plot\"); language-tagged."@en,
        "Extensão livre do reaproveitamento (ex. \"loop de 4 segundos\", \"enredo inteiro\"); marcada por idioma."@pt-BR ;
    rdfs:domain aro:DerivationClaim ;
    rdfs:range rdf:langString .

aro:derivationRealizedBy a owl:ObjectProperty ;
    rdfs:label "derivation carried out by creative act"@en,
        "derivação realizada por ato criativo"@pt-BR ;
    rdfs:domain aro:DerivationClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:CreativeAct ;
    skos:definition "Links a derivation claim to the creative act that carried out the derivation (the recording, writing or adaptation that produced the derived entity)."@en,
        "Liga uma alegação de derivação ao ato criativo que realizou a derivação (a gravação, escrita ou adaptação que produziu a entidade derivada)."@pt-BR .

aro:derivedFromSource a owl:ObjectProperty ;
    rdfs:label "evidence obtained from source"@en,
        "evidência obtida de fonte"@pt-BR ;
    rdfs:domain aro:EvidenceItem ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:range aro:ReferenceSource ;
    skos:definition "Links an evidence item to the reference source it was extracted from, so that every piece of evidence can be traced back to a citable source."@en,
        "Liga um item de evidência à fonte de referência de onde foi extraído, para que toda evidência possa ser rastreada até uma fonte citável."@pt-BR .

aro:describesSituation a owl:ObjectProperty ;
    rdfs:label "interpretation yields descriptions"@en,
        "interpretação descreve situação"@pt-BR ;
    rdfs:domain aro:InterpretationRecord ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/interpretation> ;
    rdfs:range aro:SituationDescription ;
    skos:definition "Links an interpretation record to the descriptions of represented situations it yields: what, according to the interpretation, happens in the excerpt."@en,
        "Liga um registro de interpretação às descrições de situações representadas que ele produz: o que, segundo a interpretação, acontece no trecho."@pt-BR .

aro:endDate a owl:DatatypeProperty ;
    rdfs:label "end date"@en,
        "data de término"@pt-BR ;
    rdfs:comment "When an act, event or situation ended. Year, year-month, date or date-time."@en,
        "Quando um ato, evento ou situação terminou. Ano, ano-mês, data ou data-hora."@pt-BR ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( aro:InterpretiveAct aro:CreativeAct aro:EmpiricalEvent aro:EmpiricalSituation ) ] ;
    rdfs:range rdfs:Literal .

aro:explainsPattern a owl:ObjectProperty ;
    rdfs:label "explanation addresses pattern"@en,
        "hipótese explica padrão"@pt-BR ;
    rdfs:domain aro:ExplanationHypothesis ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:range aro:SituationPattern ;
    skos:definition "Links an explanation hypothesis to the situation pattern it proposes to explain (mechanisms or factors behind the recurring configuration)."@en,
        "Liga uma hipótese explicativa ao padrão situacional que ela se propõe explicar (mecanismos ou fatores por trás da configuração recorrente)."@pt-BR .

aro:externalLink a owl:DatatypeProperty ;
    rdfs:label "external link"@en,
        "link externo"@pt-BR ;
    rdfs:comment "Web address where the represented entity can be consulted: an artwork page, a recording, the exact location of an evidence item, a case report. Usable on any resource; a link is not a credibility claim."@en,
        "Endereço web onde a entidade representada pode ser consultada: página da obra, gravação, local exato de um item de evidência, relato de um caso. Usável em qualquer recurso; o link não é alegação de credibilidade."@pt-BR ;
    rdfs:range xsd:anyURI .

aro:generalizesAs a owl:ObjectProperty ;
    rdfs:label "description motivates pattern abstraction"@en,
        "descrição motiva abstração"@pt-BR ;
    rdfs:domain aro:SituationDescription ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/representation> ;
    rdfs:range aro:SituationPattern ;
    skos:definition "Links a situation description to a situation pattern abstracted from it: the reusable configuration that the represented situation is taken to exemplify."@en,
        "Liga uma descrição de situação a um padrão situacional abstraído dela: a configuração reutilizável que a situação representada é tomada como exemplo."@pt-BR .

aro:groupsSelection a owl:ObjectProperty ;
    rdfs:label "unit groups selections"@en,
        "unidade agrupa recortes"@pt-BR ;
    rdfs:domain aro:AnalysisUnit ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range aro:Selection ;
    skos:definition "Links an analysis unit to the selections it groups, so that several excerpts can be analysed together as one unit (a scene, a refrain, a motif)."@en,
        "Liga uma unidade de análise aos recortes que ela agrupa, para que vários trechos sejam analisados juntos como uma unidade (uma cena, um refrão, um motivo)."@pt-BR .

aro:hasCondition a owl:ObjectProperty ;
    rdfs:label "pattern specifies conditions"@en,
        "padrão especifica condições"@pt-BR ;
    rdfs:domain aro:SituationPattern ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/pattern> ;
    rdfs:range aro:PatternCondition ;
    skos:definition "Links a situation pattern to the conditions that define it, each one individuated so that it can be marked as required or optional and compared with real cases."@en,
        "Liga um padrão situacional às condições que o definem, cada uma individualizada para poder ser marcada como obrigatória ou opcional e comparada com casos reais."@pt-BR .

aro:hasContribution a owl:ObjectProperty ;
    rdfs:label "act includes contribution"@en,
        "ato inclui contribuição"@pt-BR ;
    rdfs:domain aro:CreativeAct ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:CreativeContribution ;
    skos:definition "Links a creative act to the contributions that make it up, one per agent taking part."@en,
        "Liga um ato criativo às contribuições que o compõem, uma por agente participante."@pt-BR .

aro:hasDerivationType a owl:ObjectProperty ;
    rdfs:label "claim is typed by derivation kind"@en,
        "alegação tipificada por tipo de derivação"@pt-BR ;
    rdfs:domain aro:DerivationClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:DerivationType ;
    skos:definition "Classifies a derivation claim with one or more concepts of the derivation-type vocabulary (cover, sampling, translation, parody...)."@en,
        "Classifica uma alegação de derivação com um ou mais conceitos do vocabulário de tipos de derivação (cover, sampling, tradução, paródia...)."@pt-BR .

aro:hasDerivedAnchor a owl:ObjectProperty ;
    rdfs:label "claim names the derived entity"@en,
        "alegação indica entidade derivada"@pt-BR ;
    rdfs:domain aro:DerivationClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:ArtisticEntity ;
    skos:definition "Links a derivation claim to the entity said to derive from the source (any artistic entity): the derived side of the claim. It must differ from the source anchor."@en,
        "Liga uma alegação de derivação à entidade que se diz derivar da origem (qualquer entidade artística): o lado derivado da alegação. Deve ser diferente da âncora de origem."@pt-BR .

aro:hasDimension a owl:ObjectProperty ;
    rdfs:label "aspect concerns a dimension"@en,
        "aspecto incide sobre dimensão"@pt-BR ;
    rdfs:domain aro:TransformationAspect ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:ArtisticDimension ;
    skos:definition "States which artistic dimension (melody, lyrics, plot, character, medium...) a transformation aspect is about."@en,
        "Diz de qual dimensão artística (melodia, letra, enredo, personagem, meio...) trata um aspecto de transformação."@pt-BR .

aro:hasJustification a owl:ObjectProperty ;
    rdfs:label "claim supported by justification"@en,
        "alegação sustentada por justificativa"@pt-BR ;
    rdfs:domain aro:Claim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:range aro:Justification ;
    skos:definition "Links a claim to the argument that supports it: the premises and reasoning that lead to an interpretation, a derivation, a correspondence or a hypothesis."@en,
        "Liga uma alegação ao argumento que a sustenta: as premissas e o raciocínio que levam a uma interpretação, derivação, correspondência ou hipótese."@pt-BR .

aro:hasOperation a owl:ObjectProperty ;
    rdfs:label "aspect applies an operation"@en,
        "aspecto aplica operação"@pt-BR ;
    rdfs:domain aro:TransformationAspect ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:TransformationOperation ;
    skos:definition "States what was done to the dimension in a transformation aspect: retain, modify, add, remove or recontextualize."@en,
        "Diz o que foi feito com a dimensão num aspecto de transformação: manter, modificar, adicionar, remover ou recontextualizar."@pt-BR .

aro:hasParticipant a owl:ObjectProperty ;
    rdfs:label "agent participates in act"@en,
        "agente participa de ato"@pt-BR ;
    rdfs:domain aro:InterpretiveAct ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/interpretation> ;
    rdfs:range aro:Analyst ;
    rdfs:seeAlso prov:wasAssociatedWith ;
    skos:definition "Links an interpretive act to the agents (analysts) who took part in it. Agents are identified by external IRIs (Wikidata, ORCID, FOAF, schema.org)."@en,
        "Liga um ato interpretativo aos agentes (analistas) que participaram dele. Os agentes são identificados por IRIs externos (Wikidata, ORCID, FOAF, schema.org)."@pt-BR .

aro:hasPrimarySelection a owl:ObjectProperty ;
    rdfs:label "record is anchored in selection"@en,
        "interpretação se ancora em recorte"@pt-BR ;
    rdfs:domain aro:InterpretationRecord ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/interpretation> ;
    rdfs:range aro:Selection ;
    rdfs:seeAlso oa:hasTarget ;
    skos:definition "Links an interpretation record to the one selection it is about: the excerpt of the work in which the interpretation is anchored."@en,
        "Liga um registro de interpretação ao único recorte de que ele trata: o trecho da obra em que a interpretação se ancora."@pt-BR .

aro:hasRegime a owl:ObjectProperty ;
    rdfs:label "claim records derivation regime"@en,
        "alegação registra regime de derivação"@pt-BR ;
    rdfs:domain aro:DerivationClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:DerivationRegime ;
    skos:definition "Qualifies a derivation claim with its regime: the stance taken toward the source (playful, satirical, serious, reverential)."@en,
        "Qualifica uma alegação de derivação com seu regime: a postura tomada diante da origem (lúdica, satírica, séria, reverente)."@pt-BR .

aro:hasSelector a owl:ObjectProperty ;
    rdfs:label "selection located by W3C Web Annotation selector"@en,
        "recorte localizado por seletor W3C Web Annotation"@pt-BR ;
    rdfs:domain aro:Selection ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range oa:Selector ;
    skos:definition "Links a selection to a W3C Web Annotation selector that locates it inside the manifestation (time fragment, text quote or position, image region, SVG shape)."@en,
        "Liga um recorte a um seletor W3C Web Annotation que o localiza dentro da manifestação (fragmento de tempo, citação ou posição de texto, região de imagem, forma SVG)."@pt-BR .

aro:hasSourceAnchor a owl:ObjectProperty ;
    rdfs:label "claim names the source entity"@en,
        "alegação indica entidade de origem"@pt-BR ;
    rdfs:domain aro:DerivationClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:ArtisticEntity ;
    skos:definition "Links a derivation claim to the entity the derivation starts from (any artistic entity: artwork, expression, manifestation or selection): the source side of the claim."@en,
        "Liga uma alegação de derivação à entidade de onde a derivação parte (qualquer entidade artística: obra, expressão, manifestação ou recorte): o lado de origem da alegação."@pt-BR .

aro:hasSupportingSelection a owl:ObjectProperty ;
    rdfs:label "record has supporting selection"@en,
        "interpretação usa recorte de apoio"@pt-BR ;
    rdfs:domain aro:InterpretationRecord ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/interpretation> ;
    rdfs:range aro:Selection ;
    skos:definition "Links an interpretation record to further selections cited in its support, besides the primary one (other excerpts of the same or other works)."@en,
        "Liga um registro de interpretação a outros recortes citados em seu apoio, além do principal (outros trechos da mesma obra ou de outras)."@pt-BR .

aro:hasTransformation a owl:ObjectProperty ;
    rdfs:label "claim details a transformation aspect"@en,
        "alegação detalha aspecto de transformação"@pt-BR ;
    rdfs:domain aro:DerivationClaim ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:TransformationAspect ;
    skos:definition "Links a derivation claim to the transformation aspects that detail it, one per artistic dimension that was retained, modified, added, removed or recontextualized."@en,
        "Liga uma alegação de derivação aos aspectos de transformação que a detalham, um por dimensão artística mantida, modificada, adicionada, removida ou recontextualizada."@pt-BR .

aro:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en,
        "identificador"@pt-BR ;
    rdfs:comment "Local identifier of a record; a stable URI is recommended. Not identity in the world."@en,
        "Identificador local de um registro; recomenda-se URI estável. Não é identidade no mundo."@pt-BR ;
    rdfs:range xsd:string .

aro:isRequiredCondition a owl:DatatypeProperty ;
    rdfs:label "is required condition"@en,
        "é condição obrigatória"@pt-BR ;
    rdfs:comment "Whether a pattern condition is mandatory (true) or contextual (false)."@en,
        "Se uma condição de padrão é obrigatória (true) ou contextual (false)."@pt-BR ;
    rdfs:domain aro:PatternCondition ;
    rdfs:range xsd:boolean .

aro:issuedDate a owl:DatatypeProperty ;
    rdfs:label "issued date"@en,
        "data de publicação"@pt-BR ;
    rdfs:comment "Publication date when known."@en,
        "Data de publicação quando conhecida."@pt-BR ;
    rdfs:range xsd:date .

aro:languageTag a owl:DatatypeProperty ;
    rdfs:label "language tag"@en,
        "etiqueta de idioma"@pt-BR ;
    rdfs:comment "BCP 47 tag of the main language of a resource, e.g. en, pt-BR, es."@en,
        "Etiqueta BCP 47 do idioma principal de um recurso, ex. en, pt-BR, es."@pt-BR ;
    rdfs:range xsd:string .

aro:locatedInManifestation a owl:ObjectProperty ;
    rdfs:label "selection located in manifestation"@en,
        "recorte localizado em manifestação"@pt-BR ;
    rdfs:domain aro:Selection ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range aro:Manifestation ;
    skos:definition "Links a selection to the specific manifestation its selectors refer to, when the location depends on the edition (a page of a given book edition, a timestamp in a given release)."@en,
        "Liga um recorte à manifestação específica a que seus seletores se referem, quando a localização depende da edição (página de uma edição do livro, minutagem de um lançamento)."@pt-BR .

aro:mentionsDepictedElement a owl:ObjectProperty ;
    rdfs:label "description mentions depicted element"@en,
        "descrição menciona elemento"@pt-BR ;
    rdfs:domain aro:SituationDescription ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/representation> ;
    rdfs:range aro:DepictedElement ;
    skos:definition "Links a situation description to the depicted elements it involves (characters, places, objects, groups represented in the work)."@en,
        "Liga uma descrição de situação aos elementos representados que ela envolve (personagens, lugares, objetos, grupos representados na obra)."@pt-BR .

aro:producedByAct a owl:ObjectProperty ;
    rdfs:label "act produces record"@en,
        "ato produz registro"@pt-BR ;
    rdfs:domain aro:AnalyticalRecord ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:range aro:InterpretiveAct ;
    rdfs:seeAlso prov:wasGeneratedBy ;
    skos:definition "Links an analytical record (a claim, an assessment, a description...) to the analytical act that produced it, recording who made it, and when, as a historical fact distinct from its content. Required for interpretation records."@en,
        "Liga um registro analítico (alegação, avaliação, descrição...) ao ato analítico que o produziu, registrando quem o fez, e quando, como fato histórico distinto de seu conteúdo. Obrigatória para registros de interpretação."@pt-BR .

aro:producesCreation a owl:ObjectProperty ;
    rdfs:label "act brings about artistic entity"@en,
        "ato faz surgir entidade artística"@pt-BR ;
    rdfs:domain aro:CreativeAct ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:range aro:ArtisticEntity ;
    skos:definition "Links a creative act to the artistic entities it brings into existence (artworks, expressions, manifestations), including derivative ones."@en,
        "Liga um ato criativo às entidades artísticas que ele faz existir (obras, expressões, manifestações), inclusive as derivadas."@pt-BR .

aro:retrievedAt a owl:DatatypeProperty ;
    rdfs:label "retrieved at"@en,
        "acessado em"@pt-BR ;
    rdfs:comment "Capture provenance timestamp."@en,
        "Momento de captura, para proveniência."@pt-BR ;
    rdfs:range xsd:dateTime .

aro:selectorExpression a owl:DatatypeProperty ;
    rdfs:label "selector expression"@en,
        "expressão de seletor"@pt-BR ;
    rdfs:comment "Compact selector shortcut; prefer hasSelector with W3C Web Annotation selectors."@en,
        "Atalho compacto de seletor; prefira hasSelector com seletores W3C Web Annotation."@pt-BR ;
    rdfs:domain aro:Selection ;
    rdfs:range xsd:string .

aro:selectsFrom a owl:ObjectProperty ;
    rdfs:label "selection references expression"@en,
        "recorte referencia expressão"@pt-BR ;
    rdfs:domain aro:Selection ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range aro:Expression ;
    skos:definition "Links a selection to the expression it is taken from. Every selection is cut from exactly one expression, so that its location (lines, seconds, region) is meaningful."@en,
        "Liga um recorte à expressão de onde ele é tirado. Todo recorte vem de exatamente uma expressão, para que sua localização (linhas, segundos, região) tenha sentido."@pt-BR .

aro:sourceURL a owl:DatatypeProperty ;
    rdfs:label "source URL"@en,
        "URL da fonte"@pt-BR ;
    rdfs:comment "Web address of a reference source (news page, article, dataset, video...). Availability is not guaranteed and a link is not a credibility claim."@en,
        "Endereço web de uma fonte de referência (notícia, artigo, base de dados, vídeo...). A disponibilidade não é garantida e o link não é alegação de credibilidade."@pt-BR ;
    rdfs:domain aro:ReferenceSource ;
    rdfs:range xsd:anyURI .

aro:startDate a owl:DatatypeProperty ;
    rdfs:label "start date"@en,
        "data de início"@pt-BR ;
    rdfs:comment "When an act, event or situation began (or happened, if it has no duration). Year, year-month, date or date-time."@en,
        "Quando um ato, evento ou situação começou (ou aconteceu, se não tem duração). Ano, ano-mês, data ou data-hora."@pt-BR ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( aro:InterpretiveAct aro:CreativeAct aro:EmpiricalEvent aro:EmpiricalSituation ) ] ;
    rdfs:range rdfs:Literal .

aro:supportsInterpretation a owl:ObjectProperty ;
    rdfs:label "interpretation supports another"@en,
        "interpretação apoia outra"@pt-BR ;
    rdfs:domain aro:InterpretationRecord ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/interpretation> ;
    rdfs:range aro:InterpretationRecord ;
    skos:definition "Links an interpretation record to another interpretation that it supports, building chains of interpretations."@en,
        "Liga um registro de interpretação a outra interpretação que ele apoia, formando cadeias de interpretações."@pt-BR .

aro:textValue a owl:DatatypeProperty ;
    rdfs:label "text value"@en,
        "valor textual"@pt-BR ;
    rdfs:comment "Human-readable text (labels, descriptions, explanations). Use language-tagged literals; the same resource may carry one value per language."@en,
        "Texto legível (rótulos, descrições, explicações). Use literais marcados por idioma; o mesmo recurso pode ter um valor por idioma."@pt-BR ;
    rdfs:range rdf:langString .

aro:usesCriterion a owl:ObjectProperty ;
    rdfs:label "assessment follows criteria"@en,
        "avaliação usa critérios"@pt-BR ;
    rdfs:domain aro:CriteriaAssessment ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:range aro:AssessmentCriterion ;
    skos:definition "Links a criteria assessment to the explicit criteria it applies, so that the basis of the judgment can be inspected and compared."@en,
        "Liga uma avaliação por critérios aos critérios explícitos que ela aplica, para que a base do julgamento possa ser examinada e comparada."@pt-BR .

aro:versionLabel a owl:DatatypeProperty ;
    rdfs:label "version label"@en,
        "rótulo de versão"@pt-BR ;
    rdfs:comment "Application version label."@en,
        "Rótulo de versão da aplicação."@pt-BR ;
    rdfs:range xsd:string .

aro:Adaptation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Hutcheon 2006; Genette 1982" ;
    skos:broader aro:Transformation ;
    skos:definition "Acknowledged, extended transposition of a work for another form, audience or context (Genette's serious transformation)."@en,
        "Transposição declarada e extensa de obra para outra forma, público ou contexto (transformação séria de Genette)."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "adaptation"@en,
        "adaptação"@pt-BR .

aro:AdapterRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Agent producing an adaptation (e.g. screenwriter)."@en,
        "Agente que produz uma adaptação (ex. roteirista)."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "adapter"@en,
        "adaptador"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:Added a skos:Concept,
        aro:TransformationOperation ;
    skos:definition "Dimension content absent from the source."@en,
        "Conteúdo da dimensão ausente na origem."@pt-BR ;
    skos:inScheme aro:TransformationOperationScheme ;
    skos:prefLabel "added"@en,
        "acrescentado"@pt-BR ;
    skos:topConceptOf aro:TransformationOperationScheme .

aro:ArrangerRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Agent producing an arrangement."@en,
        "Agente que produz um arranjo."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "arranger"@en,
        "arranjador"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:AuthorRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Originator of verbal or narrative content."@en,
        "Criador do conteúdo verbal ou narrativo."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "author"@en,
        "autor"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:ComposerRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Originator of musical content."@en,
        "Criador do conteúdo musical."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "composer"@en,
        "compositor"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:DirectorRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Agent directing an audiovisual or stage work."@en,
        "Agente que dirige obra audiovisual ou cênica."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "director"@en,
        "diretor"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:EmpiricalClaim a owl:Class ;
    rdfs:label "empirical claim"@en,
        "afirmação empírica"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: claim content and intended empirical reference"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: conteúdo da afirmação e referência empírica pretendida"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:subClassOf aro:Claim ;
    skos:definition "Recorded testable claim about the empirical world."@en,
        "Afirmação registrada e verificável acerca do mundo empírico."@pt-BR .

aro:EpistemicCriterion a owl:Class ;
    rdfs:label "epistemic criterion"@en,
        "critério epistêmico"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C normative information object (subkind of AssessmentCriterion); dependency: inherits AssessmentCriterion identity"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional normativo UFO-C (subkind de AssessmentCriterion); dependência: herda a identidade de AssessmentCriterion"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:subClassOf aro:AssessmentCriterion ;
    skos:definition "Criterion about knowledge: whether a claim is supported, coherent, plausible or well documented (textual evidence, source reliability, coherence with the work)."@en,
        "Critério sobre conhecimento: se uma alegação é apoiada, coerente, plausível ou bem documentada (evidência textual, confiabilidade da fonte, coerência com a obra)."@pt-BR .

aro:LyricistRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Author of lyrics."@en,
        "Autor da letra."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "lyricist"@en,
        "letrista"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:Modified a skos:Concept,
        aro:TransformationOperation ;
    skos:definition "Dimension present in both but changed."@en,
        "Dimensão presente em ambas, mas alterada."@pt-BR ;
    skos:inScheme aro:TransformationOperationScheme ;
    skos:prefLabel "modified"@en,
        "modificado"@pt-BR ;
    skos:topConceptOf aro:TransformationOperationScheme .

aro:Performance a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Smiraglia 2001" ;
    skos:broader aro:Rerealization ;
    skos:definition "New performance of an existing work (recital, staging, recording)."@en,
        "Nova execução de obra existente (recital, encenação, gravação)."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "performance"@en,
        "performance / execução"@pt-BR .

aro:PerformerRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Agent performing a manifestation."@en,
        "Agente que executa uma manifestação."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "performer"@en,
        "intérprete"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:PlayfulRegime a skos:Concept,
        aro:DerivationRegime ;
    dcterms:source "Genette 1982" ;
    skos:definition "Derivation aimed at play or amusement."@en,
        "Derivação voltada ao jogo ou divertimento."@pt-BR ;
    skos:inScheme aro:DerivationRegimeScheme ;
    skos:prefLabel "playful"@en,
        "lúdico"@pt-BR ;
    skos:topConceptOf aro:DerivationRegimeScheme .

aro:ProducerRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Agent responsible for producing a recording or production."@en,
        "Agente responsável pela produção de gravação ou obra."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "producer"@en,
        "produtor"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:Recontextualized a skos:Concept,
        aro:TransformationOperation ;
    skos:definition "Content kept but placed in a different context that changes its sense."@en,
        "Conteúdo mantido, mas posto em contexto que altera seu sentido."@pt-BR ;
    skos:inScheme aro:TransformationOperationScheme ;
    skos:prefLabel "recontextualized"@en,
        "recontextualizado"@pt-BR ;
    skos:topConceptOf aro:TransformationOperationScheme .

aro:RemixerRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Agent producing a remix or sample-based work."@en,
        "Agente que produz remix ou obra baseada em samples."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "remixer"@en,
        "remixador"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:Removed a skos:Concept,
        aro:TransformationOperation ;
    skos:definition "Source content omitted in the derivation."@en,
        "Conteúdo da origem omitido na derivação."@pt-BR ;
    skos:inScheme aro:TransformationOperationScheme ;
    skos:prefLabel "removed"@en,
        "removido"@pt-BR ;
    skos:topConceptOf aro:TransformationOperationScheme .

aro:Retained a skos:Concept,
        aro:TransformationOperation ;
    skos:definition "Dimension kept substantially as in the source."@en,
        "Dimensão mantida substancialmente como na origem."@pt-BR ;
    skos:inScheme aro:TransformationOperationScheme ;
    skos:prefLabel "retained"@en,
        "mantido"@pt-BR ;
    skos:topConceptOf aro:TransformationOperationScheme .

aro:ReverentialRegime a skos:Concept,
        aro:DerivationRegime ;
    dcterms:source "ARO" ;
    skos:definition "Derivation explicitly honouring the source (ARO addition, not in Genette)."@en,
        "Derivação que homenageia explicitamente a origem (acréscimo da ARO, não está em Genette)."@pt-BR ;
    skos:inScheme aro:DerivationRegimeScheme ;
    skos:prefLabel "reverential / homage"@en,
        "reverencial / homenagem"@pt-BR ;
    skos:topConceptOf aro:DerivationRegimeScheme .

aro:SatiricalRegime a skos:Concept,
        aro:DerivationRegime ;
    dcterms:source "Genette 1982; Hutcheon 1985" ;
    skos:definition "Derivation aimed at mocking or criticizing the source or its world."@en,
        "Derivação voltada a zombar ou criticar a origem ou seu mundo."@pt-BR ;
    skos:inScheme aro:DerivationRegimeScheme ;
    skos:prefLabel "satirical / critical"@en,
        "satírico / crítico"@pt-BR ;
    skos:topConceptOf aro:DerivationRegimeScheme .

aro:SeriousRegime a skos:Concept,
        aro:DerivationRegime ;
    dcterms:source "Genette 1982" ;
    skos:definition "Derivation without comic or critical aim."@en,
        "Derivação sem objetivo cômico ou crítico."@pt-BR ;
    skos:inScheme aro:DerivationRegimeScheme ;
    skos:prefLabel "serious"@en,
        "sério"@pt-BR ;
    skos:topConceptOf aro:DerivationRegimeScheme .

aro:TranslatorRole a skos:Concept,
        aro:CreativeRole ;
    skos:definition "Agent producing a translation."@en,
        "Agente que produz uma tradução."@pt-BR ;
    skos:inScheme aro:CreativeRoleScheme ;
    skos:prefLabel "translator"@en,
        "tradutor"@pt-BR ;
    skos:topConceptOf aro:CreativeRoleScheme .

aro:ValueCriterion a owl:Class ;
    rdfs:label "value criterion"@en,
        "critério de valor"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C normative information object (subkind of AssessmentCriterion); dependency: inherits AssessmentCriterion identity"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional normativo UFO-C (subkind de AssessmentCriterion); dependência: herda a identidade de AssessmentCriterion"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:subClassOf aro:AssessmentCriterion ;
    skos:definition "Criterion about worth: whether a claim or reading is relevant, fair, original or ethically adequate, independently of being true."@en,
        "Critério sobre mérito: se uma alegação ou leitura é relevante, justa, original ou eticamente adequada, independentemente de ser verdadeira."@pt-BR .

aro:embodiesExpression a owl:ObjectProperty ;
    rdfs:label "manifestation embodies expression"@en,
        "manifestação materializa expressão"@pt-BR ;
    rdfs:domain aro:Manifestation ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range aro:Expression ;
    rdfs:seeAlso lrmoo:R4_embodies ;
    owl:inverseOf aro:hasManifestation ;
    skos:definition "Links a manifestation to the expressions it embodies; an album edition embodies the recordings on it, a book edition the text version it prints."@en,
        "Liga uma manifestação às expressões que ela materializa; uma edição de álbum materializa as gravações que contém, uma edição de livro a versão do texto que imprime."@pt-BR .

aro:hasExpression a owl:ObjectProperty ;
    rdfs:label "artwork is realized through expression"@en,
        "obra se realiza por expressão"@pt-BR ;
    rdfs:domain aro:Artwork ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range aro:Expression ;
    rdfs:seeAlso lrmoo:R3_is_realised_in ;
    owl:inverseOf aro:realizesArtwork ;
    skos:definition "Links an artwork to a realization of it with its own content (a performance, a recording, a translation, an arrangement, a text version). Use it to say through which expressions the work exists."@en,
        "Liga uma obra a uma realização dela com conteúdo próprio (interpretação, gravação, tradução, arranjo, versão do texto). Use para dizer por quais expressões a obra existe."@pt-BR .

aro:hasManifestation a owl:ObjectProperty ;
    rdfs:label "expression is embodied in manifestation"@en,
        "expressão se materializa em manifestação"@pt-BR ;
    rdfs:domain aro:Expression ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range aro:Manifestation ;
    rdfs:seeAlso lrmoo:R4_embodies ;
    owl:inverseOf aro:embodiesExpression ;
    skos:definition "Links an expression to a publication or carrier that embodies it (an album edition, a book edition, a broadcast, a digital release). Optional: record it when the edition matters."@en,
        "Liga uma expressão a uma publicação ou suporte que a materializa (edição de álbum, edição de livro, transmissão, lançamento digital). Opcional: registre quando a edição importa."@pt-BR .

aro:realizesArtwork a owl:ObjectProperty ;
    rdfs:label "expression realizes artwork"@en,
        "expressão realiza obra"@pt-BR ;
    rdfs:domain aro:Expression ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:range aro:Artwork ;
    owl:inverseOf aro:hasExpression ;
    skos:definition "Links an expression to the artwork it realizes; read from the expression's side, it states which work this performance, recording, translation or version belongs to."@en,
        "Liga uma expressão à obra que ela realiza; lida do lado da expressão, diz a qual obra pertence esta interpretação, gravação, tradução ou versão."@pt-BR .

aro:AnalysisUnit a owl:Class ;
    rdfs:label "analysis unit"@en,
        "unidade de análise"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: organizational reference to selections"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: referência organizacional a recortes"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Intentional grouping of selections for analytical purposes."@en,
        "Agrupamento intencional de recortes com finalidade analítica."@pt-BR .

aro:Challenge a owl:Class ;
    rdfs:label "challenge"@en,
        "contestação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: the challenged claim and its own argument"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: a alegação contestada e seu próprio argumento"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:subClassOf aro:Claim ;
    skos:definition "Claim that criticizes another claim or offers an alternative to it; being a claim itself, it can be justified, assessed and challenged in turn."@en,
        "Alegação que critica outra alegação ou propõe alternativa a ela; sendo também alegação, pode por sua vez ser justificada, avaliada e contestada."@pt-BR .

aro:CinematographyDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Bordwell & Thompson, Film Art" ;
    skos:broader aro:AudiovisualDimension ;
    skos:definition "Photographic qualities of the shot."@en,
        "Qualidades fotográficas do plano."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "cinematography"@en,
        "fotografia / cinematografia"@pt-BR .

aro:Continuation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Tillett 1991" ;
    skos:broader aro:Extension ;
    skos:definition "Work continuing the story of the source."@en,
        "Obra que continua a história da origem."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "continuation"@en,
        "continuação"@pt-BR .

aro:CriteriaAssessment a owl:Class ;
    rdfs:label "criteria assessment"@en,
        "avaliação por critérios"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Assessment; dependency: the assessed claim and its criteria"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Assessment; dependência: a alegação avaliada e seus critérios"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:subClassOf aro:Assessment ;
    skos:definition "Assessment of a claim against explicit epistemic or value criteria (plausibility, coherence, fidelity...)."@en,
        "Avaliação de uma alegação segundo critérios epistêmicos ou de valor explícitos (plausibilidade, coerência, fidelidade...)."@pt-BR .

aro:EvidenceAssessment a owl:Class ;
    rdfs:label "evidence assessment"@en,
        "avaliação de evidência"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Assessment; dependency: the assessed claim and the evidence weighed"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Assessment; dependência: a alegação avaliada e a evidência ponderada"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:subClassOf aro:Assessment ;
    skos:definition "Assessment of whether evidence items support, challenge or are irrelevant to a claim."@en,
        "Avaliação de se itens de evidência apoiam, contestam ou são irrelevantes para uma alegação."@pt-BR .

aro:ExplanationHypothesis a owl:Class ;
    rdfs:label "explanation hypothesis"@en,
        "hipótese explicativa"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: explicit explanandum and explanatory content"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: explanandum explícito e conteúdo explicativo"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:subClassOf aro:Claim ;
    skos:definition "Proposed mechanism or factors explaining a represented or observed phenomenon."@en,
        "Mecanismo ou fatores propostos para explicar fenômeno representado ou observado."@pt-BR .

aro:Justification a owl:Class ;
    rdfs:label "justification"@en,
        "justificativa"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: the claim it supports and its articulated premises"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: a alegação que sustenta e suas premissas articuladas"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Recorded argument connecting premises to a claim: why an interpretation, derivation, correspondence or hypothesis is asserted."@en,
        "Argumento registrado que liga premissas a uma alegação: por que uma interpretação, derivação, correspondência ou hipótese é afirmada."@pt-BR .

aro:CorrespondenceClaim a owl:Class ;
    rdfs:label "correspondence claim"@en,
        "alegação de correspondência"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim; not a UFO relator; dependency: compared pattern/case and dimensions"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim; não é relator UFO; dependência: padrão/caso comparados e dimensões"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:subClassOf aro:Claim ;
    skos:definition "Contestable assertion of similarity, instantiation or explanatory relevance between pattern and empirical case."@en,
        "Alegação contestável de similaridade, instanciação ou relevância explicativa entre padrão e caso empírico."@pt-BR .

aro:DepictedElement a owl:Class ;
    rdfs:label "depicted element"@en,
        "elemento representado"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C representation (subkind of AnalyticalRecord); not a real-world entity; dependency: representational context"@en,
        "Estereótipo OntoUML: subkind; fundamentação: representação UFO-C (subkind de AnalyticalRecord); não é entidade do mundo real; dependência: contexto representacional"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/representation> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Information-level representation of a referent in an artwork."@en,
        "Representação informacional de um referente na obra."@pt-BR .

aro:EvidenceItem a owl:Class ;
    rdfs:label "evidence item"@en,
        "item de evidência"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: reference source and observation content"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: fonte de referência e conteúdo observado"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Extracted contextual assertion or observation from a reference source."@en,
        "Afirmação ou observação contextualizada extraída de uma fonte."@pt-BR .

aro:PatternCondition a owl:Class ;
    rdfs:label "pattern condition"@en,
        "condição de padrão"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: host pattern and logical specification"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: padrão hospedeiro e especificação lógica"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/pattern> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Individuated mandatory or optional condition within a pattern."@en,
        "Condição individualizada obrigatória ou opcional de um padrão."@pt-BR .

aro:Agent a owl:Class ;
    rdfs:label "agent"@en,
        "agente"@pt-BR ;
    rdfs:comment "OntoUML stereotype: category; foundation: UFO-A rigid non-sortal (category) over persons and collectives; agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: none of its own; identity from Person or Collective"@en,
        "Estereótipo OntoUML: category; fundamentação: não-sortal rígido UFO-A (category) sobre pessoas e coletivos; agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: nenhuma própria; identidade de Person ou Collective"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/agent> ;
    rdfs:seeAlso prov:Agent,
        foaf:Agent ;
    owl:disjointUnionOf ( aro:Person aro:Collective ) ;
    skos:definition "Anything that can act intentionally: a person or a collective. Agents are identified by IRIs of external vocabularies (Wikidata, ORCID, ISNI, FOAF, schema.org)."@en,
        "Tudo o que pode agir intencionalmente: uma pessoa ou um coletivo. Agentes são identificados por IRIs de vocabulários externos (Wikidata, ORCID, ISNI, FOAF, schema.org)."@pt-BR .

aro:Artwork a owl:Class ;
    rdfs:label "artwork"@en,
        "obra"@pt-BR ;
    rdfs:comment "OntoUML stereotype: kind; foundation: UFO-C social/information object (domain commitment); dependency: historically on creation; not on a single copy"@en,
        "Estereótipo OntoUML: kind; fundamentação: objeto social/informacional UFO-C (compromisso de domínio); dependência: historicamente da criação; não de uma cópia específica"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:seeAlso lrmoo:F1_Work ;
    rdfs:subClassOf aro:ArtisticEntity ;
    skos:definition "Identifiable artistic creation, considered independently of any particular version or copy (the LRM work level)."@en,
        "Criação artística identificável, considerada independentemente de qualquer versão ou cópia (nível obra do LRM)."@pt-BR .

aro:AssessmentCriterion a owl:Class ;
    rdfs:label "assessment criterion"@en,
        "critério de avaliação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: specified normative meaning"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: significado normativo especificado"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Explicit rule an assessment applies to judge a claim; epistemic criteria judge whether the claim is well grounded, value criteria judge its worth."@en,
        "Regra explícita que uma avaliação aplica para julgar uma alegação; critérios epistêmicos julgam se a alegação é bem fundamentada, critérios de valor julgam seu mérito."@pt-BR .

aro:EmpiricalCase a owl:Class ;
    rdfs:label "empirical case"@en,
        "caso empírico"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: case description and empirical referent"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: descrição do caso e referente empírico"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Documented dossier about one real-world situation or occurrence."@en,
        "Dossiê documentado sobre uma situação ou ocorrência real."@pt-BR .

aro:EmpiricalEvent a owl:Class ;
    rdfs:label "empirical event"@en,
        "evento empírico"@pt-BR ;
    rdfs:comment "OntoUML stereotype: event; foundation: UFO-B event; dependency: real occurrence and participants"@en,
        "Estereótipo OntoUML: event; fundamentação: evento UFO-B; dependência: ocorrência real e participantes"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    skos:definition "Real-world temporally bounded occurrence."@en,
        "Ocorrência do mundo real delimitada temporalmente."@pt-BR .

aro:EmpiricalSituation a owl:Class ;
    rdfs:label "empirical situation"@en,
        "situação empírica"@pt-BR ;
    rdfs:comment "OntoUML stereotype: situation; foundation: UFO-B situation; separate from descriptions; dependency: real-world constituents"@en,
        "Estereótipo OntoUML: situation; fundamentação: situação UFO-B; separada de descrições; dependência: constituintes do mundo real"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    skos:definition "Configuration of entities and conditions in the real world."@en,
        "Configuração de entidades e condições no mundo real."@pt-BR .

aro:Imitation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982 (hypertextuality)" ;
    skos:definition "Derivation through imitating the manner or style of the source rather than reworking its content."@en,
        "Derivação pela imitação da maneira ou estilo da origem, e não pela reelaboração do conteúdo."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "imitation"@en,
        "imitação"@pt-BR ;
    skos:topConceptOf aro:DerivationTypeScheme .

aro:MiseEnSceneDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Bordwell & Thompson, Film Art" ;
    skos:broader aro:AudiovisualDimension ;
    skos:definition "What is placed before the camera."@en,
        "O que é posto diante da câmera."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "mise-en-scène"@en,
        "mise-en-scène"@pt-BR .

aro:ParatextDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Genette 1987" ;
    skos:definition "Thresholds around the work: title, credits, covers, prefaces."@en,
        "Limiares em torno da obra: título, créditos, capas, prefácios."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "paratext"@en,
        "paratexto"@pt-BR ;
    skos:topConceptOf aro:ArtisticDimensionScheme .

aro:ReferenceSource a owl:Class ;
    rdfs:label "reference source"@en,
        "fonte de referência"@pt-BR ;
    rdfs:comment "OntoUML stereotype: kind; foundation: UFO-C information object; dependency: source provenance; not tied to one interpretation"@en,
        "Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; dependência: proveniência da fonte; não vinculada a uma interpretação"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/evidence> ;
    rdfs:seeAlso dcterms:BibliographicResource,
        schema:CreativeWork ;
    skos:definition "Citable external resource: news, study, report, legal document, testimony, dataset, etc."@en,
        "Recurso externo citável: notícia, estudo, relatório, documento legal, relato, conjunto de dados etc."@pt-BR .

<https://w3id.org/aro/ontology/module/pattern> rdfs:label "Situation pattern"@en,
        "Padrão situacional"@pt-BR ;
    dcterms:description "Reusable abstractions of represented situations, defined by conditions, that can be compared with real-world cases."@en,
        "Abstrações reutilizáveis de situações representadas, definidas por condições, que podem ser comparadas com casos do mundo real."@pt-BR .

aro:Analyst a owl:Class ;
    rdfs:label "analyst"@en,
        "analista"@pt-BR ;
    rdfs:comment "OntoUML stereotype: roleMixin; foundation: UFO-A anti-rigid non-sortal (roleMixin) specialized by PersonAnalyst and CollectiveAnalyst; dependency: relationally on participation in an InterpretiveAct; identity supplied by external kinds"@en,
        "Estereótipo OntoUML: roleMixin; fundamentação: não-sortal anti-rígido UFO-A (roleMixin) especializado por PersonAnalyst e CollectiveAnalyst; dependência: relacionalmente da participação num InterpretiveAct; identidade fornecida por tipos externos"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/agent> ;
    rdfs:seeAlso prov:Agent,
        foaf:Person,
        schema:Person ;
    rdfs:subClassOf aro:Agent ;
    skos:definition "Agent insofar as it takes part in an interpretive act (interprets, describes, assesses). Played by persons or collectives identified by external IRIs."@en,
        "Agente enquanto participa de um ato interpretativo (interpreta, descreve, avalia). Desempenhado por pessoas ou coletivos identificados por IRIs externos."@pt-BR .

aro:Assessment a owl:Class ;
    rdfs:label "assessment"@en,
        "avaliação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: the assessed claims"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: as alegações avaliadas"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:seeAlso schema:ClaimReview ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    owl:disjointUnionOf ( aro:CriteriaAssessment aro:EvidenceAssessment ) ;
    skos:definition "Analytical record judging one or more closely related claims: by explicit criteria, by evidence, or both. It records a judgment made by an agent; it does not settle the claim."@en,
        "Registro analítico que julga uma ou mais alegações intimamente relacionadas: por critérios explícitos, por evidência, ou ambos. Registra um julgamento feito por um agente; não resolve a alegação."@pt-BR .

aro:AudiovisualDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Bordwell & Thompson, Film Art" ;
    skos:definition "Stylistic systems of film, video and other moving-image media."@en,
        "Sistemas estilísticos de cinema, vídeo e outras mídias de imagem em movimento."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "audiovisual"@en,
        "audiovisual"@pt-BR ;
    skos:topConceptOf aro:ArtisticDimensionScheme .

aro:CreativeAgent a owl:Class ;
    rdfs:label "creative agent"@en,
        "agente criativo"@pt-BR ;
    rdfs:comment "OntoUML stereotype: roleMixin; foundation: UFO-A anti-rigid non-sortal (roleMixin) specialized by PersonCreator and CollectiveCreator; dependency: relationally on a CreativeContribution; identity supplied by external kinds"@en,
        "Estereótipo OntoUML: roleMixin; fundamentação: não-sortal anti-rígido UFO-A (roleMixin) especializado por PersonCreator e CollectiveCreator; dependência: relacionalmente de uma CreativeContribution; identidade fornecida por tipos externos"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/agent> ;
    rdfs:seeAlso prov:Agent,
        foaf:Agent,
        schema:Organization,
        schema:Person ;
    rdfs:subClassOf aro:Agent ;
    skos:definition "Agent insofar as it contributes to a creative act (composes, performs, translates, directs...). Played by persons or collectives identified by external IRIs."@en,
        "Agente enquanto contribui para um ato criativo (compõe, interpreta, traduz, dirige...). Desempenhado por pessoas ou coletivos identificados por IRIs externos."@pt-BR .

aro:CreativeContribution a owl:Class ;
    rdfs:label "creative contribution"@en,
        "contribuição criativa"@pt-BR ;
    rdfs:comment "OntoUML stereotype: relator; foundation: UFO-A relator mediating an agent and an artistic entity; role qualification via CreativeRole; dependency: existentially on the contributing agent and on the artistic entity contributed to; founded by the creative act"@en,
        "Estereótipo OntoUML: relator; fundamentação: relator UFO-A que media um agente e uma entidade artística; papel qualificado via CreativeRole; dependência: existencialmente do agente que contribui e da entidade artística para a qual contribui; fundada pelo ato criativo"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    skos:definition "Participation of one creative agent in one creative act under one or more roles."@en,
        "Participação de um agente criativo num ato criativo sob um ou mais papéis."@pt-BR .

aro:Extension a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Tillett 1991 (sequential); Jenkins 1992" ;
    skos:definition "New work extending the fictional world, timeline or cast of the source."@en,
        "Obra nova que estende o mundo ficcional, a linha do tempo ou o elenco da origem."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "extension"@en,
        "extensão"@pt-BR ;
    skos:topConceptOf aro:DerivationTypeScheme .

aro:InterpretiveAct a owl:Class ;
    rdfs:label "interpretive act"@en,
        "ato interpretativo"@pt-BR ;
    rdfs:comment "OntoUML stereotype: event; foundation: UFO-B event; UFO-C intentional action; dependency: participating agents and temporal occurrence"@en,
        "Estereótipo OntoUML: event; fundamentação: evento UFO-B; ação intencional UFO-C; dependência: agentes participantes e ocorrência temporal"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/interpretation> ;
    rdfs:seeAlso prov:Activity ;
    skos:definition "Temporal intentional activity yielding interpretation records."@en,
        "Atividade intencional temporal que produz interpretações registradas."@pt-BR .

aro:Manifestation a owl:Class ;
    rdfs:label "manifestation"@en,
        "manifestação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: kind; foundation: UFO-C information artifact (carrier level); dependency: embodies at least one expression"@en,
        "Estereótipo OntoUML: kind; fundamentação: artefato informacional UFO-C (nível de suporte); dependência: materializa ao menos uma expressão"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:seeAlso lrmoo:F3_Manifestation ;
    rdfs:subClassOf aro:ArtisticEntity ;
    skos:definition "Publication or carrier that embodies one or more expressions: an album edition, a book edition, a broadcast, a digital release (the LRM manifestation level). Optional: record it when the edition matters, e.g. to locate a page or a track."@en,
        "Publicação ou suporte que materializa uma ou mais expressões: edição de álbum, edição de livro, transmissão, lançamento digital (nível manifestação do LRM). Opcional: registre quando a edição importa, por exemplo para localizar uma página ou faixa."@pt-BR .

aro:SituationDescription a owl:Class ;
    rdfs:label "situation description"@en,
        "descrição de situação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object (subkind of AnalyticalRecord), not gufo:Situation; dependency: interpretive support and conceptual content"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C (subkind de AnalyticalRecord), não gufo:Situation; dependência: suporte interpretativo e conteúdo conceitual"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/representation> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Recorded description of a represented situation."@en,
        "Descrição registrada de situação representada."@pt-BR .

aro:Transformation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982 (hypertextuality)" ;
    skos:definition "Hypertextual derivation that changes content, form or context of the source."@en,
        "Derivação hipertextual que altera conteúdo, forma ou contexto da origem."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "transformation"@en,
        "transformação"@pt-BR ;
    skos:topConceptOf aro:DerivationTypeScheme .

aro:Collective a owl:Class ;
    rdfs:label "collective"@en,
        "coletivo"@pt-BR ;
    rdfs:comment "OntoUML stereotype: collective; foundation: UFO-A collective; agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: its members, under a unifying relation"@en,
        "Estereótipo OntoUML: collective; fundamentação: coletivo UFO-A; agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: seus membros, sob uma relação unificadora"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/agent> ;
    rdfs:seeAlso foaf:Group,
        schema:MusicGroup,
        schema:Organization ;
    rdfs:subClassOf aro:Agent ;
    skos:definition "Group of agents acting as one: a band, a company, a research group, a film crew, a publisher."@en,
        "Grupo de agentes que age como um: banda, companhia, grupo de pesquisa, equipe de filmagem, editora."@pt-BR .

aro:CreativeAct a owl:Class ;
    rdfs:label "creative act"@en,
        "ato criativo"@pt-BR ;
    rdfs:comment "OntoUML stereotype: event; foundation: UFO-B event; UFO-C intentional action; dependency: participating agents and temporal occurrence"@en,
        "Estereótipo OntoUML: event; fundamentação: evento UFO-B; ação intencional UFO-C; dependência: agentes participantes e ocorrência temporal"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:seeAlso lrmoo:F28_Expression_Creation,
        prov:Activity ;
    skos:definition "Intentional temporal activity that brings an artistic entity (artwork, expression or manifestation) into existence, including derivative ones."@en,
        "Atividade intencional no tempo que faz existir uma entidade artística (obra, expressão ou manifestação), inclusive as derivadas."@pt-BR .

aro:DerivationRegime a owl:Class ;
    rdfs:label "derivation regime"@en,
        "regime de derivação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership"@en,
        "Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    skos:definition "Stance of a derivation toward its source (playful, satirical, serious, reverential); its instances are SKOS concepts."@en,
        "Postura da derivação em relação à origem (lúdica, satírica, séria, reverencial); suas instâncias são conceitos SKOS."@pt-BR .

aro:GeneralDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:definition "Dimensions applicable to any medium."@en,
        "Dimensões aplicáveis a qualquer mídia."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "cross-media"@en,
        "transmidiática"@pt-BR ;
    skos:topConceptOf aro:ArtisticDimensionScheme .

aro:InterpretationRecord a owl:Class ;
    rdfs:label "interpretation record"@en,
        "registro de interpretação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim (assessable, justifiable, citable, challengeable); dependency: anchor selection; the interpretive act that produced it"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim (avaliável, justificável, citável, contestável); dependência: recorte de ancoragem; o ato interpretativo que o produziu"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/interpretation> ;
    rdfs:seeAlso oa:Annotation ;
    rdfs:subClassOf aro:Claim ;
    skos:definition "Persistent authored record of an interpretation of a selection."@en,
        "Registro autoral persistente de uma interpretação de recorte."@pt-BR .

aro:Person a owl:Class ;
    rdfs:label "person"@en,
        "pessoa"@pt-BR ;
    rdfs:comment "OntoUML stereotype: kind; foundation: UFO-A kind (substantial); agents are identified by external IRIs; ARO declares only what OntoUML needs; dependency: identity supplied by the person; ARO records only roles and contributions"@en,
        "Estereótipo OntoUML: kind; fundamentação: kind UFO-A (substancial); agentes são identificados por IRIs externos; a ARO declara só o que a OntoUML exige; dependência: identidade da própria pessoa; a ARO registra só papéis e contribuições"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/agent> ;
    rdfs:seeAlso foaf:Person,
        schema:Person ;
    rdfs:subClassOf aro:Agent ;
    skos:definition "Individual human agent (author, performer, analyst, researcher)."@en,
        "Agente humano individual (autor, intérprete, analista, pesquisador)."@pt-BR .

aro:SituationPattern a owl:Class ;
    rdfs:label "situation pattern"@en,
        "padrão situacional"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: defining conditions; not identical to universal"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: condições definidoras; não idêntico a universal"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/pattern> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Reusable informational specification of situation conditions."@en,
        "Especificação informacional reutilizável de condições situacionais."@pt-BR .

aro:TextDimension a skos:Concept,
        aro:ArtisticDimension ;
    skos:definition "Verbal content in any medium."@en,
        "Conteúdo verbal em qualquer mídia."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "verbal text"@en,
        "texto verbal"@pt-BR ;
    skos:topConceptOf aro:ArtisticDimensionScheme .

aro:Expression a owl:Class ;
    rdfs:label "expression"@en,
        "expressão"@pt-BR ;
    rdfs:comment "OntoUML stereotype: kind; foundation: UFO-C information object (content level); dependency: realizes exactly one artwork"@en,
        "Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C (nível de conteúdo); dependência: realiza exatamente uma obra"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:seeAlso lrmoo:F2_Expression ;
    rdfs:subClassOf aro:ArtisticEntity ;
    skos:definition "Specific realization of an artwork with its own content: a performance or recording, a translation, an arrangement, a text version, a film cut (the LRM expression level)."@en,
        "Realização específica de uma obra com conteúdo próprio: uma interpretação ou gravação, uma tradução, um arranjo, uma versão do texto, uma montagem de filme (nível expressão do LRM)."@pt-BR .

aro:TransformationAspect a owl:Class ;
    rdfs:label "transformation aspect"@en,
        "aspecto de transformação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of AnalyticalRecord, whose identity it inherits; dependency: host derivation claim; one dimension and one operation"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de AnalyticalRecord, cuja identidade herda; dependência: alegação de derivação hospedeira; uma dimensão e uma operação"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    skos:definition "Recorded statement of what happened to one artistic dimension in a derivation (retained, modified, added, removed or recontextualized)."@en,
        "Registro do que ocorreu com uma dimensão artística numa derivação (mantida, modificada, acrescentada, removida ou recontextualizada)."@pt-BR .

aro:TransformationOperation a owl:Class ;
    rdfs:label "transformation operation"@en,
        "operação de transformação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership"@en,
        "Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    skos:definition "What a derivation does to a dimension: retain, modify, add, remove or recontextualize."@en,
        "O que a derivação faz com uma dimensão: manter, modificar, acrescentar, remover ou recontextualizar."@pt-BR .

<https://w3id.org/aro/ontology/module/representation> rdfs:label "Representation"@en,
        "Representação"@pt-BR ;
    dcterms:description "What the work represents according to an interpretation: descriptions of situations, intentional states and depicted elements (characters, places, objects)."@en,
        "O que a obra representa segundo uma interpretação: descrições de situações, estados intencionais e elementos representados (personagens, lugares, objetos)."@pt-BR .

aro:ArtisticEntity a owl:Class ;
    rdfs:label "artistic entity"@en,
        "entidade artística"@pt-BR ;
    rdfs:comment "OntoUML stereotype: category; foundation: UFO-A rigid non-sortal (category) generalizing kinds with different identity principles; dependency: none of its own; each instance takes the identity of its kind"@en,
        "Estereótipo OntoUML: category; fundamentação: não-sortal rígido UFO-A (category) que generaliza kinds com princípios de identidade diferentes; dependência: nenhuma própria; cada instância tem a identidade de seu kind"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    owl:disjointUnionOf ( aro:Artwork aro:Expression aro:Manifestation aro:Selection ) ;
    skos:definition "Anything artistic that can be the origin or result of a derivation or a creative act: an artwork, an expression, a manifestation or a selection."@en,
        "Tudo o que é artístico e pode ser origem ou resultado de uma derivação ou de um ato criativo: obra, expressão, manifestação ou recorte."@pt-BR .

aro:DerivationClaim a owl:Class ;
    rdfs:label "derivation claim"@en,
        "alegação de derivação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object; subkind of Claim; neither a UFO relator nor an asserted fact; dependency: exactly one source anchor and one derived anchor; typed by at least one derivation type"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C; subkind de Claim; nem relator UFO nem fato afirmado; dependência: exatamente uma âncora de origem e uma derivada; tipificada por ao menos um tipo de derivação"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    rdfs:seeAlso prov:wasDerivedFrom,
        wdt:P144,
        schema:isBasedOn ;
    rdfs:subClassOf aro:Claim ;
    skos:definition "Contestable assertion, made by an agent, that one artistic entity (artwork, expression, manifestation or selection) derives from another in specified ways. The derived entity is represented as a creation in its own right; legality and originality are outside the scope of the ontology."@en,
        "Alegação contestável, feita por um agente, de que uma entidade artística (obra, expressão, manifestação ou recorte) deriva de outra de modos especificados. A entidade derivada é representada como criação por direito próprio; legalidade e originalidade estão fora do escopo da ontologia."@pt-BR .

aro:DerivationRegimeScheme a skos:ConceptScheme ;
    skos:definition "Stance of a derivation toward its source, orthogonal to its type (after Genette's regimes)."@en,
        "Postura da derivação em relação à origem, ortogonal ao tipo (a partir dos regimes de Genette)."@pt-BR ;
    skos:hasTopConcept aro:PlayfulRegime,
        aro:ReverentialRegime,
        aro:SatiricalRegime,
        aro:SeriousRegime ;
    skos:prefLabel "Derivation regimes"@en,
        "Regimes de derivação"@pt-BR .

aro:NarrativeDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Chatman 1978; Genette 1972" ;
    skos:definition "Story-level and discourse-level properties of narratives in any medium."@en,
        "Propriedades de história e de discurso de narrativas em qualquer mídia."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "narrative"@en,
        "narrativa"@pt-BR ;
    skos:topConceptOf aro:ArtisticDimensionScheme .

<https://w3id.org/aro/ontology/module/interpretation> rdfs:label "Interpretation"@en,
        "Interpretação"@pt-BR ;
    dcterms:description "Who interprets and how: interpretation records anchored in selections and produced by interpretive acts."@en,
        "Quem interpreta e como: registros de interpretação ancorados em recortes e produzidos por atos interpretativos."@pt-BR .

aro:VisualDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Panofsky 1939" ;
    skos:definition "Formal and iconographic properties of still or moving images."@en,
        "Propriedades formais e iconográficas de imagens fixas ou em movimento."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "visual"@en,
        "visual"@pt-BR ;
    skos:topConceptOf aro:ArtisticDimensionScheme .

aro:Claim a owl:Class ;
    rdfs:label "claim"@en,
        "alegação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: subkind; foundation: UFO-C information object (propositional content as authored record, ADR-010); dependency: the act or agent that asserts it"@en,
        "Estereótipo OntoUML: subkind; fundamentação: objeto informacional UFO-C (conteúdo proposicional como registro autoral, ADR-010); dependência: o ato ou agente que a afirma"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    rdfs:seeAlso schema:Claim ;
    rdfs:subClassOf aro:AnalyticalRecord ;
    owl:disjointUnionOf ( aro:Challenge aro:InterpretationRecord aro:EmpiricalClaim aro:CorrespondenceClaim aro:ExplanationHypothesis aro:DerivationClaim ) ;
    skos:definition "Analytical record that asserts something contestable: it can be produced by an act, justified, supported by sources, assessed and challenged. ARO represents claims, never their truth."@en,
        "Registro analítico que afirma algo contestável: pode ser produzido por um ato, justificado, apoiado em fontes, avaliado e contestado. A ARO representa alegações, nunca sua verdade."@pt-BR .

aro:Rerealization a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Tillett 1991; Smiraglia 2001; IFLA LRMoo 2024" ;
    skos:definition "New realization of substantially the same content; bibliographically often a new expression of the same work."@en,
        "Nova realização de conteúdo substancialmente igual; na biblioteconomia, frequentemente nova expressão da mesma obra."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "re-realization"@en,
        "re-realização"@pt-BR ;
    skos:topConceptOf aro:DerivationTypeScheme .

aro:TransformationOperationScheme a skos:ConceptScheme ;
    skos:definition "What a derivation does to one artistic dimension."@en,
        "O que uma derivação faz com uma dimensão artística."@pt-BR ;
    skos:hasTopConcept aro:Added,
        aro:Modified,
        aro:Recontextualized,
        aro:Removed,
        aro:Retained ;
    skos:prefLabel "Transformation operations"@en,
        "Operações de transformação"@pt-BR .

<https://w3id.org/aro/ontology/module/agent> rdfs:label "Agents"@en,
        "Agentes"@pt-BR ;
    dcterms:description "Who acts: persons and collectives, identified by external IRIs, and the roles they play as analysts and creators."@en,
        "Quem age: pessoas e coletivos, identificados por IRIs externos, e os papéis que desempenham como analistas e criadores."@pt-BR .

aro:Selection a owl:Class ;
    rdfs:label "selection"@en,
        "recorte"@pt-BR ;
    rdfs:comment "OntoUML stereotype: kind; foundation: UFO-C information object; domain category; dependency: the expression it is taken from and its selectors"@en,
        "Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; categoria de domínio; dependência: a expressão de onde é tirado e seus seletores"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/artwork> ;
    rdfs:seeAlso oa:SpecificResource ;
    rdfs:subClassOf aro:ArtisticEntity ;
    skos:definition "Addressable portion of an expression (lines, a time span, an image region), located by selectors; not a physical component."@en,
        "Parte endereçável de uma expressão (linhas, trecho de tempo, região de imagem), localizada por seletores; não é componente físico."@pt-BR .

aro:CreativeRole a owl:Class ;
    rdfs:label "creative role"@en,
        "papel criativo"@pt-BR ;
    rdfs:comment "OntoUML stereotype: type; foundation: UFO role type; operationalized as skos:Concept; dependency: controlled vocabulary membership"@en,
        "Estereótipo OntoUML: type; fundamentação: tipo de papel UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    skos:definition "Role qualifying a creative contribution (composer, performer, translator, remixer...)."@en,
        "Papel que qualifica uma contribuição criativa (compositor, intérprete, tradutor, remixador...)."@pt-BR .

aro:Incorporation a skos:Concept,
        aro:DerivationType ;
    dcterms:source "Genette 1982 (intertextuality); Burkholder 1994" ;
    skos:definition "Material of, or explicit reference to, the source is present within a new whole."@en,
        "Material da origem, ou referência explícita a ela, está presente num novo todo."@pt-BR ;
    skos:inScheme aro:DerivationTypeScheme ;
    skos:prefLabel "incorporation / copresence"@en,
        "incorporação / copresença"@pt-BR ;
    skos:topConceptOf aro:DerivationTypeScheme .

aro:MusicDimension a skos:Concept,
        aro:ArtisticDimension ;
    dcterms:source "Burkholder 1994" ;
    skos:definition "Musical and sonic parameters."@en,
        "Parâmetros musicais e sonoros."@pt-BR ;
    skos:inScheme aro:ArtisticDimensionScheme ;
    skos:prefLabel "music and sound"@en,
        "música e som"@pt-BR ;
    skos:topConceptOf aro:ArtisticDimensionScheme .

aro:AnalyticalRecord a owl:Class ;
    rdfs:label "analytical record"@en,
        "registro analítico"@pt-BR ;
    rdfs:comment "OntoUML stereotype: kind; foundation: UFO-C information object; the single kind supplying the identity of every analytical record (ADR-026); dependency: historically on the act or agent that recorded it"@en,
        "Estereótipo OntoUML: kind; fundamentação: objeto informacional UFO-C; o único kind que fornece a identidade de todo registro analítico (ADR-026); dependência: historicamente do ato ou agente que o registrou"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/claim> ;
    owl:disjointUnionOf ( aro:AnalysisUnit aro:Claim aro:Justification aro:Assessment aro:AssessmentCriterion aro:DepictedElement aro:SituationDescription aro:SituationPattern aro:PatternCondition aro:EmpiricalCase aro:EvidenceItem aro:TransformationAspect ) ;
    skos:definition "Information object recorded by an agent in the course of an analysis: the common sort of interpretations, descriptions, patterns, cases, evidence items, claims, justifications and assessments. Two records with the same text by different agents or acts are different records."@en,
        "Objeto informacional registrado por um agente no curso de uma análise: o tipo comum de interpretações, descrições, padrões, casos, itens de evidência, alegações, justificativas e avaliações. Dois registros com o mesmo texto feitos por agentes ou atos diferentes são registros diferentes."@pt-BR .

<https://w3id.org/aro/ontology/module/artwork> rdfs:label "Artwork and selection"@en,
        "Obra e recorte"@pt-BR ;
    dcterms:description "What is analysed: artworks, their expressions (versions, performances, translations) and manifestations (editions, releases), as in IFLA LRM, and the addressable excerpts (selections) on which annotations are anchored."@en,
        "O que é analisado: obras, suas expressões (versões, interpretações, traduções) e manifestações (edições, lançamentos), como no IFLA LRM, e os trechos endereçáveis (recortes) em que as anotações se ancoram."@pt-BR .

<https://w3id.org/aro/ontology/module/claim> rdfs:label "Claims and records"@en,
        "Alegações e registros"@pt-BR ;
    dcterms:description "The common ground of every annotation: analytical records and, among them, claims, which can be produced by an act, justified, supported by sources, assessed and challenged."@en,
        "A base comum de toda anotação: registros analíticos e, entre eles, alegações, que podem ser produzidas por um ato, justificadas, apoiadas em fontes, avaliadas e contestadas."@pt-BR .

<https://w3id.org/aro/ontology/module/evidence> rdfs:label "Evidence and empirical world"@en,
        "Evidência e mundo empírico"@pt-BR ;
    dcterms:description "The empirical world and its grounds: real cases, situations and events, reference sources, evidence items, correspondence claims between art and reality, and their assessment."@en,
        "O mundo empírico e seus fundamentos: casos, situações e eventos reais, fontes de referência, itens de evidência, alegações de correspondência entre arte e realidade e sua avaliação."@pt-BR .

aro:CreativeRoleScheme a skos:ConceptScheme ;
    skos:definition "Roles qualifying a creative contribution; extensible."@en,
        "Papéis que qualificam uma contribuição criativa; extensível."@pt-BR ;
    skos:hasTopConcept aro:AdapterRole,
        aro:ArrangerRole,
        aro:AuthorRole,
        aro:ComposerRole,
        aro:DirectorRole,
        aro:LyricistRole,
        aro:PerformerRole,
        aro:ProducerRole,
        aro:RemixerRole,
        aro:TranslatorRole ;
    skos:prefLabel "Creative roles"@en,
        "Papéis criativos"@pt-BR .

<https://w3id.org/aro/ontology/module/derivation> rdfs:label "Derivation and creation"@en,
        "Derivação e criação"@pt-BR ;
    dcterms:description "How works derive from other works (cover, sampling, adaptation, parody...): derivation claims with types, regimes and transformation aspects, and the creative acts and contributions behind them."@en,
        "Como obras derivam de outras (cover, sampling, adaptação, paródia...): alegações de derivação com tipos, regimes e aspectos de transformação, e os atos e contribuições criativas por trás delas."@pt-BR .

aro:DerivationType a owl:Class ;
    rdfs:label "derivation type"@en,
        "tipo de derivação"@pt-BR ;
    rdfs:comment "OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership"@en,
        "Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    skos:definition "Kind of derivation (translation, cover, sampling, parody...); its instances are SKOS concepts."@en,
        "Tipo de derivação (tradução, cover, sample, paródia...); suas instâncias são conceitos SKOS."@pt-BR .

aro:DerivationTypeScheme a skos:ConceptScheme ;
    skos:definition "Non-exclusive kinds of derivation grouped in five families; one claim may carry several types. Grounded in Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon and Jenkins (see derivation-typology.md)."@en,
        "Tipos não exclusivos de derivação agrupados em cinco famílias; uma alegação pode ter vários tipos. Fundamentados em Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon e Jenkins (ver derivation-typology.md)."@pt-BR ;
    skos:hasTopConcept aro:Extension,
        aro:Imitation,
        aro:Incorporation,
        aro:Rerealization,
        aro:Transformation ;
    skos:prefLabel "Derivation types"@en,
        "Tipos de derivação"@pt-BR .

aro:ArtisticDimension a owl:Class ;
    rdfs:label "artistic dimension"@en,
        "dimensão artística"@pt-BR ;
    rdfs:comment "OntoUML stereotype: type; foundation: UFO high-order type; operationalized as skos:Concept; dependency: controlled vocabulary membership"@en,
        "Estereótipo OntoUML: type; fundamentação: tipo de alta ordem UFO; operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"@pt-BR ;
    rdfs:isDefinedBy <https://w3id.org/aro/ontology/module/derivation> ;
    skos:definition "Aspect of a work along which derivation can be compared (melody, lyrics, plot, character, medium...)."@en,
        "Aspecto da obra segundo o qual a derivação pode ser comparada (melodia, letra, enredo, personagem, mídia...)."@pt-BR .

aro:ArtisticDimensionScheme a skos:ConceptScheme ;
    skos:definition "Dimensions for annotation, grouped by medium family (narrative, verbal, music, visual, audiovisual, cross-media, paratext)."@en,
        "Dimensões para anotação, agrupadas por família de mídia (narrativa, verbal, música, visual, audiovisual, transmidiática, paratexto)."@pt-BR ;
    skos:hasTopConcept aro:AudiovisualDimension,
        aro:GeneralDimension,
        aro:MusicDimension,
        aro:NarrativeDimension,
        aro:ParatextDimension,
        aro:TextDimension,
        aro:VisualDimension ;
    skos:prefLabel "Artistic dimensions"@en,
        "Dimensões artísticas"@pt-BR .

[] a owl:AllDisjointClasses ;
    owl:members ( aro:EpistemicCriterion aro:ValueCriterion ) .

[] a owl:AllDisjointClasses ;
    owl:members ( aro:Artwork aro:Expression aro:Manifestation aro:Selection aro:AnalyticalRecord aro:Person aro:Collective aro:InterpretiveAct aro:ReferenceSource aro:EmpiricalSituation aro:EmpiricalEvent aro:CreativeAct aro:CreativeContribution aro:DerivationType aro:DerivationRegime aro:ArtisticDimension aro:TransformationOperation aro:CreativeRole ) .

