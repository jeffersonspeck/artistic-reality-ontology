[
  {
    "@id": "https://w3id.org/aro/ontology#EmpiricalSituation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): situation; foundation: UFO-B situation; separate from descriptions"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EmpiricalSituation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Configuration of entities and conditions in the real world."
      },
      {
        "@language": "pt-BR",
        "@value": "Configuração de entidades e condições no mundo real."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; not UFO relator"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "CorrespondenceClaim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Contestable assertion of similarity, instantiation or explanatory relevance between pattern and empirical case."
      },
      {
        "@language": "pt-BR",
        "@value": "Alegação contestável de similaridade, instanciação ou relevância explicativa entre padrão e caso empírico."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#InterpretiveAct",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): event; foundation: UFO-B event; UFO-C intentional action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "InterpretiveAct"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Temporal intentional activity yielding interpretation records."
      },
      {
        "@language": "pt-BR",
        "@value": "Atividade intencional temporal que produz interpretações registradas."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ExplanationHypothesis",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ExplanationHypothesis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Proposed mechanism or factors explaining a represented or observed phenomenon."
      },
      {
        "@language": "pt-BR",
        "@value": "Mecanismo ou fatores propostos para explicar fenômeno representado ou observado."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EmpiricalCase",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EmpiricalCase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Documented dossier about one real-world situation or occurrence."
      },
      {
        "@language": "pt-BR",
        "@value": "Dossiê documentado sobre uma situação ou ocorrência real."
      }
    ]
  },
