aro:DerivationAnchorKindConstraint a sh:SPARQLConstraint ;
    sh:message "Derivation anchors must be an Artwork, Manifestation or Selection."@en,
        "As âncoras da derivação devem ser Artwork, Manifestation ou Selection."@pt-BR ;
    sh:prefixes aro:prefixes ;
    sh:select "SELECT $this ?value WHERE { $this aro:hasSourceAnchor|aro:hasDerivedAnchor ?value . FILTER NOT EXISTS { ?value a ?t . FILTER(?t IN (aro:Artwork, aro:Manifestation, aro:Selection)) } }" .

aro:DerivationClaimhasDerivationTypePropertyShape sh:class aro:DerivationType ;
    sh:minCount 1 ;
