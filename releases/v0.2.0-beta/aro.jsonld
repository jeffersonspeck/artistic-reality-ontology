        "@language": "en",
        "@value": "Information-level representation of a referent in an artwork."
      },
      {
        "@language": "pt-BR",
        "@value": "Representação informacional de um referente na obra."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ArtisticDimension",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): type; foundation: UFO high-order type (provisional); operationalized as skos:Concept; dependency: controlled vocabulary membership"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): type; fundamentação: tipo de alta ordem UFO (provisório); operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artistic dimension"
      },
      {
        "@language": "pt-BR",
        "@value": "dimensão artística"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Aspect of a work along which derivation can be compared (melody, lyrics, plot, character, medium...)."
      },
      {
        "@language": "pt-BR",
        "@value": "Aspecto da obra segundo o qual a derivação pode ser comparada (melodia, letra, enredo, personagem, mídia...)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#externalLink",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Web address where the represented entity can be consulted: an artwork page, a recording, the exact location of an evidence item, a case report. Usable on any resource; a link is not a credibility claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Endereço web onde a entidade representada pode ser consultada: página da obra, gravação, local exato de um item de evidência, relato de um caso. Usável em qualquer recurso; o link não é alegação de credibilidade."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "external link"
      },
      {
        "@language": "pt-BR",
        "@value": "link externo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
