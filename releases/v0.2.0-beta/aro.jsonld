    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Local identifier of a record; a stable URI is recommended. Not identity in the world."
      },
      {
        "@language": "pt-BR",
        "@value": "Identificador local de um registro; recomenda-se URI estável. Não é identidade no mundo."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identifier"
      },
      {
        "@language": "pt-BR",
        "@value": "identificador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Artwork",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C social/information object (domain commitment); dependency: historically on creation; not on a single copy"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto social/informacional UFO-C (compromisso de domínio); dependência: historicamente da criação; não de uma cópia específica"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artwork"
      },
      {
        "@language": "pt-BR",
        "@value": "obra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifiable artistic creation across media and manifestations."
      },
      {
        "@language": "pt-BR",
        "@value": "Criação artística identificável em diversas mídias e manifestações."
      }
    ]
  },
  {
