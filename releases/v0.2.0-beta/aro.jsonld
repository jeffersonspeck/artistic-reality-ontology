        "@id": "https://w3id.org/aro/ontology#Imitation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Imitation of a style in a satirical regime."
      },
      {
        "@language": "pt-BR",
        "@value": "Imitação de estilo em regime satírico."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "caricature (charge)"
      },
      {
        "@language": "pt-BR",
        "@value": "caricatura (charge)"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#isRequiredCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether a pattern condition is mandatory (true) or contextual (false)."
      },
      {
        "@language": "pt-BR",
        "@value": "Se uma condição de padrão é obrigatória (true) ou contextual (false)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#PatternCondition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is required condition"
      },
      {
        "@language": "pt-BR",
        "@value": "é condição obrigatória"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EvidenceItem",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; dependency: reference source and observation content"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; dependência: fonte de referência e conteúdo observado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "evidence item"
      },
      {
        "@language": "pt-BR",
        "@value": "item de evidência"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Extracted contextual assertion or observation from a reference source."
      },
      {
        "@language": "pt-BR",
        "@value": "Afirmação ou observação contextualizada extraída de uma fonte."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationRegime",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): type; foundation: UFO high-order type (provisional); operationalized as skos:Concept; dependency: controlled vocabulary membership"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): type; fundamentação: tipo de alta ordem UFO (provisório); operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derivation regime"
      },
      {
        "@language": "pt-BR",
        "@value": "regime de derivação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Stance of a derivation toward its source (playful, satirical, serious, reverential); its instances are SKOS concepts."
      },
      {
        "@language": "pt-BR",
        "@value": "Postura da derivação em relação à origem (lúdica, satírica, séria, reverencial); suas instâncias são conceitos SKOS."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SeriousRegime",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationRegime"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation without comic or critical aim."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação sem objetivo cômico ou crítico."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "serious"
      },
      {
        "@language": "pt-BR",
        "@value": "sério"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#FanWork",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
