      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#sourceURL",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Web address of a reference source (news page, article, dataset, video...). Availability is not guaranteed and a link is not a credibility claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Endereço web de uma fonte de referência (notícia, artigo, base de dados, vídeo...). A disponibilidade não é garantida e o link não é alegação de credibilidade."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#ReferenceSource"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source URL"
      },
      {
        "@language": "pt-BR",
        "@value": "URL da fonte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SatiricalRegime",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationRegime"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982; Hutcheon 1985"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation aimed at mocking or criticizing the source or its world."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação voltada a zombar ou criticar a origem ou seu mundo."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "satirical / critical"
      },
      {
        "@language": "pt-BR",
        "@value": "satírico / crítico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ]
  },
