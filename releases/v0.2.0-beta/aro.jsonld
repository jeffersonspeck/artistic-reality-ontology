  {
    "@id": "https://w3id.org/aro/ontology",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@value": "Roberto Pereira (UFPR) — doctoral supervisor"
      },
      {
        "@value": "Clodis Boscarioli (UNIOESTE) — doctoral co-supervisor"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Jefferson Rodrigo Speck (UFPR, PPGInf)"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Operational OWL vocabulary inspired by UFO; not a complete translation of the OntoUML reference model. It represents claims made by agents and their grounds; it asserts no claim as true. Terms are identified in English and fully labelled and defined in English and Brazilian Portuguese; textual content may be recorded in any language using language-tagged literals."
      },
      {
        "@language": "pt-BR",
        "@value": "Vocabulário OWL operacional inspirado na UFO; não é tradução completa do modelo de referência OntoUML. Representa alegações feitas por agentes e seus fundamentos; não afirma nenhuma alegação como verdadeira. Os termos são identificados em inglês e integralmente rotulados e definidos em inglês e português do Brasil; o conteúdo textual pode ser registrado em qualquer idioma com literais marcados por idioma."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Artistic Reality Ontology"
      },
      {
        "@language": "pt-BR",
        "@value": "Ontologia de Arte e Realidade"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Integral part of the doctoral research of Jefferson Rodrigo Speck in the Graduate Program in Informatics (PPGInf) of the Federal University of Paraná (UFPR), supervised by Prof. Dr. Roberto Pereira (UFPR) and co-supervised by Prof. Dr. Clodis Boscarioli (UNIOESTE), linked to the Research Group on Technology and Innovation in Education (GTIE), UNIOESTE."
      },
      {
        "@language": "pt-BR",
        "@value": "Parte integrante da pesquisa de doutorado de Jefferson Rodrigo Speck no Programa de Pós-Graduação em Informática (PPGInf) da Universidade Federal do Paraná (UFPR), sob orientação do Prof. Dr. Roberto Pereira (UFPR) e coorientação do Prof. Dr. Clodis Boscarioli (UNIOESTE), com vinculação ao Grupo de Pesquisa em Tecnologia e Inovação na Educação (GTIE), UNIOESTE."
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "https://w3id.org/aro/ontology/0.1.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/aro/ontology/0.2.0-beta"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.2.0-beta"
      }
    ]
  },
