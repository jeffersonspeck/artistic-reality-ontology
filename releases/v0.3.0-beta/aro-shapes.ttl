aro:CreativeContributioncontributionRolePropertyShape sh:class aro:CreativeRole ;
    sh:minCount 1 ;
    sh:path aro:contributionRole .

aro:CreativeContributioncontributionToPropertyShape sh:minCount 1 ;
    sh:path aro:contributionTo .

aro:CriteriaAssessmentusesCriterionPropertyShape sh:minCount 1 ;
    sh:path aro:usesCriterion .

aro:DerivationAnchorKindConstraint a sh:SPARQLConstraint ;
    sh:message "Derivation anchors must be an artistic entity: Artwork, Expression, Manifestation or Selection."@en,
        "As âncoras da derivação devem ser uma entidade artística: Artwork, Expression, Manifestation ou Selection."@pt-BR ;
    sh:prefixes aro:prefixes ;
    sh:select "SELECT $this ?value WHERE { $this aro:hasSourceAnchor|aro:hasDerivedAnchor ?value . FILTER NOT EXISTS { ?value a ?t . FILTER(?t IN (aro:Artwork, aro:Expression, aro:Manifestation, aro:Selection)) } }" .

aro:DerivationClaimhasDerivationTypePropertyShape sh:class aro:DerivationType ;
    sh:minCount 1 ;
    sh:path aro:hasDerivationType .

aro:DerivationClaimhasDerivedAnchorPropertyShape sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:hasDerivedAnchor .

aro:DerivationClaimhasRegimePropertyShape sh:class aro:DerivationRegime ;
    sh:path aro:hasRegime .

aro:DerivationClaimhasSourceAnchorPropertyShape sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:hasSourceAnchor .

aro:DerivationDistinctAnchorsConstraint a sh:SPARQLConstraint ;
    sh:message "Source and derived anchors must differ."@en,
        "As âncoras de origem e derivada devem ser diferentes."@pt-BR ;
    sh:prefixes aro:prefixes ;
    sh:select "SELECT $this ?value WHERE { $this aro:hasSourceAnchor ?value ; aro:hasDerivedAnchor ?value . }" .

aro:EvidenceAssessmentassessesEvidencePropertyShape sh:minCount 1 ;
    sh:path aro:assessesEvidence .

aro:EvidenceItemderivedFromSourcePropertyShape sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:derivedFromSource .

aro:ExpressionrealizesArtworkPropertyShape sh:maxCount 1 ;
