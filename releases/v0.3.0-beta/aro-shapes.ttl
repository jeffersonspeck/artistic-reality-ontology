aro:CriteriaAssessmentShape a sh:NodeShape ;
    sh:property aro:CriteriaAssessmentusesCriterionPropertyShape ;
    sh:targetClass aro:CriteriaAssessment .

aro:DerivationClaimShape a sh:NodeShape ;
