aro:textValueLanguageShape a sh:NodeShape ;
    sh:property aro:textValueDatatypePropertyShape ;
    sh:targetSubjectsOf aro:textValue .

aro:AnalyticalRecordproducedByActPropertyShape sh:maxCount 1 ;
    sh:path aro:producedByAct .

aro:AssessmentGroundsConstraint a sh:SPARQLConstraint ;
    sh:message "An evidence assessment must weigh at least one evidence item."@en,
        "Uma avaliação de evidência deve ponderar ao menos um item de evidência."@pt-BR ;
    sh:prefixes aro:prefixes ;
    sh:select "SELECT $this WHERE { FILTER NOT EXISTS { $this aro:assessesEvidence ?e } }" .

aro:AssessmentassessesClaimPropertyShape sh:minCount 1 ;
    sh:path aro:assessesClaim .

aro:ChallengechallengesPropertyShape sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:challenges .

aro:CorrespondenceClaimassertsCasePropertyShape sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:assertsCase .

aro:CorrespondenceClaimassertsPatternPropertyShape sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:assertsPattern .

aro:CreationNotSelectionConstraint a sh:SPARQLConstraint ;
    sh:message "A creative act produces artworks, expressions or manifestations, not selections."@en,
        "Um ato criativo produz obras, expressões ou manifestações, não recortes."@pt-BR ;
    sh:prefixes aro:prefixes ;
    sh:select "SELECT $this ?value WHERE { $this aro:producesCreation ?value . ?value a aro:Selection . }" .

aro:CreativeActproducesCreationPropertyShape sh:minCount 1 ;
    sh:path aro:producesCreation .

aro:CreativeContributioncontributionByPropertyShape sh:maxCount 1 ;
