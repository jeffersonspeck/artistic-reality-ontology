    sh:path aro:hasParticipant .

aro:ManifestationembodiesExpressionPropertyShape sh:minCount 1 ;
    sh:path aro:embodiesExpression .

aro:SelectionlocatedInManifestationPropertyShape sh:maxCount 1 ;
    sh:path aro:locatedInManifestation .

aro:SelectionselectsFromPropertyShape sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:selectsFrom .

aro:SituationPatternhasConditionPropertyShape sh:minCount 1 ;
    sh:path aro:hasCondition .

aro:TransformationAspecthasDimensionPropertyShape sh:class aro:ArtisticDimension ;
