    sh:minCount 1 ;
    sh:path aro:hasDimension .

aro:TransformationAspecthasOperationPropertyShape sh:class aro:TransformationOperation ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path aro:hasOperation .

aro:assessmentOutcomeValuesPropertyShape sh:in ( "supports" "partiallySupports" "challenges" "inconclusive" "irrelevant" ) ;
    sh:maxCount 1 ;
    sh:message "assessmentOutcome must be one of: supports, partiallySupports, challenges, inconclusive, irrelevant."@en,
        "assessmentOutcome deve ser um destes valores: supports, partiallySupports, challenges, inconclusive, irrelevant."@pt-BR ;
    sh:path aro:assessmentOutcome .

aro:derivationExtentDatatypePropertyShape sh:datatype rdf:langString ;
    sh:message "derivationExtent values must be language-tagged literals."@en,
        "Valores de derivationExtent devem ser literais marcados por idioma."@pt-BR ;
    sh:path aro:derivationExtent .

aro:endDateDatatypesPropertyShape sh:message "endDate values must be one of: xsd:gYear, xsd:gYearMonth, xsd:date, xsd:dateTime."@en,
        "Valores de endDate devem ser de um destes tipos: xsd:gYear, xsd:gYearMonth, xsd:date, xsd:dateTime."@pt-BR ;
    sh:or ( [ sh:datatype xsd:gYear ] [ sh:datatype xsd:gYearMonth ] [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
    sh:path aro:endDate .

aro:startDateDatatypesPropertyShape sh:message "startDate values must be one of: xsd:gYear, xsd:gYearMonth, xsd:date, xsd:dateTime."@en,
        "Valores de startDate devem ser de um destes tipos: xsd:gYear, xsd:gYearMonth, xsd:date, xsd:dateTime."@pt-BR ;
    sh:or ( [ sh:datatype xsd:gYear ] [ sh:datatype xsd:gYearMonth ] [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
    sh:path aro:startDate .

aro:textValueDatatypePropertyShape sh:datatype rdf:langString ;
    sh:message "textValue values must be language-tagged literals."@en,
        "Valores de textValue devem ser literais marcados por idioma."@pt-BR ;
    sh:path aro:textValue .

aro:prefixes sh:declare [ sh:namespace "https://w3id.org/aro/ontology#"^^xsd:anyURI ;
            sh:prefix "aro" ] .

