      {
        "@language": "en",
        "@value": "empirical claim"
      },
      {
        "@language": "pt-BR",
        "@value": "afirmação empírica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Recorded testable claim about the empirical world."
      },
      {
        "@language": "pt-BR",
        "@value": "Afirmação registrada e verificável acerca do mundo empírico."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EvidenceAssessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; dependency: claim and evidence and criteria"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; dependência: afirmação, evidência e critérios"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
