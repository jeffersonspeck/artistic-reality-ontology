      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalCase"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "dossier describes real situations"
      },
      {
        "@language": "pt-BR",
        "@value": "dossiê descreve situação real"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalSituation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an empirical case (a documented dossier) to the real-world situations it documents."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um caso empírico (dossiê documentado) às situações do mundo real que ele documenta."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#contributionRole",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeContribution"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "contribution qualified by role"
      },
      {
        "@language": "pt-BR",
        "@value": "contribuição qualificada por papel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRole"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Qualifies a creative contribution with one or more roles of the creative-role vocabulary (composer, performer, translator, remixer...)."
      },
      {
        "@language": "pt-BR",
        "@value": "Qualifica uma contribuição criativa com um ou mais papéis do vocabulário de papéis criativos (compositor, intérprete, tradutor, remixador...)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SituationDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object, not gufo:Situation; dependency: interpretive support and conceptual content"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C, não gufo:Situation; dependência: suporte interpretativo e conteúdo conceitual"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "situation description"
      },
      {
        "@language": "pt-BR",
        "@value": "descrição de situação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Recorded description of a represented situation."
      },
      {
        "@language": "pt-BR",
        "@value": "Descrição registrada de situação representada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Added",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#TransformationOperation"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Dimension content absent from the source."
      },
      {
        "@language": "pt-BR",
        "@value": "Conteúdo da dimensão ausente na origem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "added"
      },
      {
        "@language": "pt-BR",
        "@value": "acrescentado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Adaptation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Hutcheon 2006; Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Transformation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Acknowledged, extended transposition of a work for another form, audience or context (Genette's serious transformation)."
      },
      {
        "@language": "pt-BR",
        "@value": "Transposição declarada e extensa de obra para outra forma, público ou contexto (transformação séria de Genette)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "adaptation"
      },
      {
        "@language": "pt-BR",
        "@value": "adaptação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MaterialTechniqueDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#VisualDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Physical materials and making techniques (oil, fresco, photographic process)."
      },
      {
        "@language": "pt-BR",
        "@value": "Materiais e técnicas de feitura (óleo, afresco, processo fotográfico)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "material and technique"
      },
      {
        "@language": "pt-BR",
        "@value": "material e técnica"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ShapeDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#VisualDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Contours, lines, shapes and volumes."
      },
      {
        "@language": "pt-BR",
        "@value": "Contornos, linhas, formas e volumes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "line and shape"
      },
      {
        "@language": "pt-BR",
        "@value": "linha e forma"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#producedByAct",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretive act historically produces record"
      },
      {
        "@language": "pt-BR",
        "@value": "ato produz registro"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretiveAct"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretation record to the interpretive act that produced it, recording who interpreted, and when, as a historical fact distinct from the content of the interpretation."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro de interpretação ao ato interpretativo que o produziu, registrando quem interpretou, e quando, como fato histórico distinto do conteúdo da interpretação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#TextDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Verbal content in any medium."
      },
      {
        "@language": "pt-BR",
        "@value": "Conteúdo verbal em qualquer mídia."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "verbal text"
      },
      {
        "@language": "pt-BR",
        "@value": "texto verbal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#referencesSource",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "correspondence directly cites source"
      },
      {
        "@language": "pt-BR",
        "@value": "correspondência cita fonte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#ReferenceSource"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a correspondence claim directly to a reference source it relies on."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de correspondência diretamente a uma fonte de referência em que se apoia."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Stance of a derivation toward its source, orthogonal to its type (after Genette's regimes)."
      },
      {
        "@language": "pt-BR",
        "@value": "Postura da derivação em relação à origem, ortogonal ao tipo (a partir dos regimes de Genette)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/aro/ontology#PlayfulRegime"
      },
      {
        "@id": "https://w3id.org/aro/ontology#SatiricalRegime"
      },
      {
        "@id": "https://w3id.org/aro/ontology#SeriousRegime"
      },
      {
        "@id": "https://w3id.org/aro/ontology#ReverentialRegime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Derivation regimes"
      },
      {
        "@language": "pt-BR",
        "@value": "Regimes de derivação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Non-exclusive kinds of derivation grouped in five families; one claim may carry several types. Grounded in Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon and Jenkins (see derivation-typology.md)."
      },
      {
        "@language": "pt-BR",
        "@value": "Tipos não exclusivos de derivação agrupados em cinco famílias; uma alegação pode ter vários tipos. Fundamentados em Genette, Tillett/Smiraglia, Burkholder, Rajewsky, Hutcheon e Jenkins (ver derivation-typology.md)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Transformation"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Imitation"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Extension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Derivation types"
      },
      {
        "@language": "pt-BR",
        "@value": "Tipos de derivação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Interpolation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Schloss 2004"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Re-performance of a portion of the source inside a new work, without reusing the recording."
      },
      {
        "@language": "pt-BR",
        "@value": "Reexecução de trecho da origem dentro de obra nova, sem reusar a gravação."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "interpolation"
      },
      {
        "@language": "pt-BR",
        "@value": "interpolação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#externalLink",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Web address where the represented entity can be consulted: an artwork page, a recording, the exact location of an evidence item, a case report. Usable on any resource; a link is not a credibility claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Endereço web onde a entidade representada pode ser consultada: página da obra, gravação, local exato de um item de evidência, relato de um caso. Usável em qualquer recurso; o link não é alegação de credibilidade."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "external link"
      },
      {
        "@language": "pt-BR",
        "@value": "link externo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DepictedElement",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C representation; not a real-world entity; dependency: representational context"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: representação UFO-C; não é entidade do mundo real; dependência: contexto representacional"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "depicted element"
      },
      {
        "@language": "pt-BR",
        "@value": "elemento representado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Information-level representation of a referent in an artwork."
      },
      {
        "@language": "pt-BR",
        "@value": "Representação informacional de um referente na obra."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CostumeMakeupDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MiseEnSceneDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Costume, make-up and hair."
      },
      {
        "@language": "pt-BR",
        "@value": "Figurino, maquiagem e cabelo."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "costume and make-up"
      },
      {
        "@language": "pt-BR",
        "@value": "figurino e maquiagem"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Artwork",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C social/information object (domain commitment); dependency: historically on creation; not on a single copy"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto social/informacional UFO-C (compromisso de domínio); dependência: historicamente da criação; não de uma cópia específica"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artwork"
      },
      {
        "@language": "pt-BR",
        "@value": "obra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifiable artistic creation across media and manifestations."
      },
      {
        "@language": "pt-BR",
        "@value": "Criação artística identificável em diversas mídias e manifestações."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Travesty",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
