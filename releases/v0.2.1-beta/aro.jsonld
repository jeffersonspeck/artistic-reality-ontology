        "@language": "pt-BR",
        "@value": "contribuição criativa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Participation of one creative agent in one creative act under one or more roles."
      },
      {
        "@language": "pt-BR",
        "@value": "Participação de um agente criativo num ato criativo sob um ou mais papéis."
      }
    ]
  },
