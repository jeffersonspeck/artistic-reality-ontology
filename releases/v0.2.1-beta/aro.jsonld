  {
    "@id": "https://w3id.org/aro/ontology#CreativeAct",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): event; foundation: UFO-B event; UFO-C intentional action; dependency: participating agents and temporal occurrence"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): event; fundamentação: evento UFO-B; ação intencional UFO-C; dependência: agentes participantes e ocorrência temporal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "creative act"
      },
      {
        "@language": "pt-BR",
        "@value": "ato criativo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Intentional temporal activity that brings an artwork or manifestation into existence, including derivative ones."
      },
      {
        "@language": "pt-BR",
        "@value": "Atividade intencional temporal que dá origem a uma obra ou manifestação, inclusive derivadas."
      }
    ]
  },
