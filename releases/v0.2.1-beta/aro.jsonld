      {
        "@language": "pt-BR",
        "@value": "Temas convencionais, motivos, símbolos e atributos."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "iconography / motif"
      },
      {
        "@language": "pt-BR",
        "@value": "iconografia / motivo"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology/module/interpretation",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Who interprets and how: interpretation records produced by interpretive acts of analysts, with their justifications, challenges and assessments."
      },
      {
        "@language": "pt-BR",
        "@value": "Quem interpreta e como: registros de interpretação produzidos por atos interpretativos de analistas, com justificativas, contestações e avaliações."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Interpretation"
      },
      {
        "@language": "pt-BR",
        "@value": "Interpretação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#HarmonyDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Chordal and tonal organization."
