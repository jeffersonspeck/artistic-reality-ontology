      {
        "@language": "en",
        "@value": "empirical event"
      },
      {
        "@language": "pt-BR",
        "@value": "evento empírico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Real-world temporally bounded occurrence."
      },
      {
        "@language": "pt-BR",
        "@value": "Ocorrência do mundo real delimitada temporalmente."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#aspectDerivedSelection",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "aspect points to derived selection"
      },
      {
        "@language": "pt-BR",
        "@value": "aspecto aponta recorte derivado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Points a transformation aspect to the excerpt of the derived entity where the transformed dimension can be observed."
      },
      {
        "@language": "pt-BR",
        "@value": "Aponta um aspecto de transformação para o trecho da entidade derivada em que a dimensão transformada pode ser observada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SeriousImitation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Imitation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Imitation aiming to be taken as in the manner of the source, e.g. apocryphal continuation; not necessarily fraud."
      },
      {
        "@language": "pt-BR",
        "@value": "Imitação que pretende ser tomada como da maneira da origem, ex. continuação apócrifa; não necessariamente fraude."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "serious imitation (forgerie)"
      },
      {
        "@language": "pt-BR",
        "@value": "imitação séria (forgerie)"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasSupportingSelection",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "record has supporting selection"
      },
      {
        "@language": "pt-BR",
        "@value": "interpretação usa recorte de apoio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretation record to further selections cited in its support, besides the primary one (other excerpts of the same or other works)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro de interpretação a outros recortes citados em seu apoio, além do principal (outros trechos da mesma obra ou de outras)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#realizesArtwork",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Manifestation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "manifestation realizes artwork"
      },
      {
        "@language": "pt-BR",
        "@value": "manifestação realiza obra"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Artwork"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a manifestation to the artwork it realizes; read from the manifestation's side, it states which work this recording, edition or performance is a version of."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma manifestação à obra que ela realiza; lida do lado da manifestação, diz de qual obra esta gravação, edição ou apresentação é versão."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#VocalDeliveryDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
