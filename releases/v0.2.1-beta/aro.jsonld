      {
        "@id": "https://w3id.org/aro/ontology/module/pattern"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "pattern specifies conditions"
      },
      {
        "@language": "pt-BR",
        "@value": "padrão especifica condições"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
