  },
  {
    "@id": "https://w3id.org/aro/ontology#Pastiche",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982; Dyer 2007"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Imitation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Imitation of a style in a playful or affectionate regime."
      },
      {
        "@language": "pt-BR",
        "@value": "Imitação de estilo em regime lúdico ou afetuoso."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "pastiche"
      },
      {
        "@language": "pt-BR",
        "@value": "pastiche"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasTransformation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim details a transformation aspect"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação detalha aspecto de transformação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the transformation aspects that detail it, one per artistic dimension that was retained, modified, added, removed or recontextualized."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação aos aspectos de transformação que a detalham, um por dimensão artística mantida, modificada, adicionada, removida ou recontextualizada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology/module/derivation",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "How works derive from other works (cover, sampling, adaptation, parody...): derivation claims with types, regimes and transformation aspects, and the creative acts and contributions behind them."
      },
      {
        "@language": "pt-BR",
        "@value": "Como obras derivam de outras (cover, sampling, adaptação, paródia...): alegações de derivação com tipos, regimes e aspectos de transformação, e os atos e contribuições criativas por trás delas."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Derivation and creation"
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação e criação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Incorporation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982 (intertextuality); Burkholder 1994"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Material of, or explicit reference to, the source is present within a new whole."
      },
      {
        "@language": "pt-BR",
        "@value": "Material da origem, ou referência explícita a ela, está presente num novo todo."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "incorporation / copresence"
      },
      {
        "@language": "pt-BR",
        "@value": "incorporação / copresença"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; not UFO relator; dependency: compared pattern/case and dimensions"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; não é relator UFO; dependência: padrão/caso comparados e dimensões"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "correspondence claim"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação de correspondência"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Contestable assertion of similarity, instantiation or explanatory relevance between pattern and empirical case."
      },
      {
        "@language": "pt-BR",
        "@value": "Alegação contestável de similaridade, instanciação ou relevância explicativa entre padrão e caso empírico."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#explainsPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#ExplanationHypothesis"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "explanation addresses pattern"
      },
      {
        "@language": "pt-BR",
        "@value": "hipótese explica padrão"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationPattern"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an explanation hypothesis to the situation pattern it proposes to explain (mechanisms or factors behind the recurring configuration)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma hipótese explicativa ao padrão situacional que ela se propõe explicar (mecanismos ou fatores por trás da configuração recorrente)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CreativeContribution",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): relator; foundation: UFO-A relator; role qualification via CreativeRole; dependency: existentially on the act and the agent"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): relator; fundamentação: relator UFO-A; papel qualificado via CreativeRole; dependência: existencialmente do ato e do agente"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
