    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "vocal delivery"
      },
      {
        "@language": "pt-BR",
        "@value": "interpretação vocal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ExplanationHypothesis",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; dependency: explicit explanandum and explanatory content"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; dependência: explanandum explícito e conteúdo explicativo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "explanation hypothesis"
      },
      {
        "@language": "pt-BR",
        "@value": "hipótese explicativa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Proposed mechanism or factors explaining a represented or observed phenomenon."
      },
      {
        "@language": "pt-BR",
        "@value": "Mecanismo ou fatores propostos para explicar fenômeno representado ou observado."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SeriousRegime",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationRegime"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation without comic or critical aim."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação sem objetivo cômico ou crítico."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "serious"
      },
      {
        "@language": "pt-BR",
        "@value": "sério"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#PlayfulRegime",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationRegime"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation aimed at play or amusement."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação voltada ao jogo ou divertimento."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "playful"
      },
      {
        "@language": "pt-BR",
        "@value": "lúdico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationRegimeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#derivationRealizedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derivation carried out by creative act"
      },
      {
        "@language": "pt-BR",
        "@value": "derivação realizada por ato criativo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeAct"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the creative act that carried out the derivation (the recording, writing or adaptation that produced the derived entity)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação ao ato criativo que realizou a derivação (a gravação, escrita ou adaptação que produziu a entidade derivada)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Amplification",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Smiraglia 2001 (amplifications)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Source reproduced with added material (annotated or illustrated edition, commentary track)."
      },
      {
        "@language": "pt-BR",
        "@value": "Origem reproduzida com material acrescentado (edição anotada ou ilustrada, faixa de comentário)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "amplification"
      },
      {
        "@language": "pt-BR",
        "@value": "ampliação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasContribution",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeAct"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "act includes contribution"
      },
      {
        "@language": "pt-BR",
        "@value": "ato inclui contribuição"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeContribution"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a creative act to the contributions that make it up, one per agent taking part."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um ato criativo às contribuições que o compõem, uma por agente participante."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasJustification",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretation supported by argument"
      },
      {
        "@language": "pt-BR",
        "@value": "interpretação tem fundamentação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretiveJustification"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretation record to the argument that supports it: the premises and reasoning that lead from the excerpt to the interpretation."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro de interpretação ao argumento que o sustenta: as premissas e o raciocínio que levam do trecho à interpretação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#AnalysisUnit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; dependency: organizational reference to selections"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; dependência: referência organizacional a recortes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "analysis unit"
      },
      {
        "@language": "pt-BR",
        "@value": "unidade de análise"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Intentional grouping of selections for analytical purposes."
      },
      {
        "@language": "pt-BR",
        "@value": "Agrupamento intencional de recortes com finalidade analítica."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#NarrationDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1972"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#NarrativeDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Who narrates and from which narrative level."
      },
      {
        "@language": "pt-BR",
        "@value": "Quem narra e de qual nível narrativo."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "narration / voice"
      },
      {
        "@language": "pt-BR",
        "@value": "narração / voz"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#TransformationAspect",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; dependency: host derivation claim; one dimension and one operation"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; dependência: alegação de derivação hospedeira; uma dimensão e uma operação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transformation aspect"
      },
      {
        "@language": "pt-BR",
        "@value": "aspecto de transformação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Recorded statement of what happened to one artistic dimension in a derivation (retained, modified, added, removed or recontextualized)."
      },
      {
        "@language": "pt-BR",
        "@value": "Registro do que ocorreu com uma dimensão artística numa derivação (mantida, modificada, acrescentada, removida ou recontextualizada)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#StyleDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Dyer 2007"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#GeneralDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Recognizable manner of a creator, genre or period."
      },
      {
        "@language": "pt-BR",
        "@value": "Maneira reconhecível de autor, gênero ou período."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "style"
      },
      {
        "@language": "pt-BR",
        "@value": "estilo"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#caseHasReference",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalCase"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "case cites sources"
      },
      {
        "@language": "pt-BR",
        "@value": "caso cita fontes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#ReferenceSource"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an empirical case to the reference sources that document it (news, reports, studies, testimonies)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um caso empírico às fontes de referência que o documentam (notícias, relatórios, estudos, depoimentos)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#TimbreDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Sound sources and their colour."
      },
      {
        "@language": "pt-BR",
        "@value": "Fontes sonoras e sua cor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "timbre / instrumentation"
      },
      {
        "@language": "pt-BR",
        "@value": "timbre / instrumentação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@value": "Roberto Pereira (UFPR) — doctoral supervisor"
      },
      {
        "@value": "Clodis Boscarioli (UNIOESTE) — doctoral co-supervisor"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Jefferson Rodrigo Speck (UFPR, PPGInf)"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Operational OWL vocabulary inspired by UFO; not a complete translation of the OntoUML reference model. It represents claims made by agents and their grounds; it asserts no claim as true. Terms are identified in English and fully labelled and defined in English and Brazilian Portuguese; textual content may be recorded in any language using language-tagged literals."
      },
      {
        "@language": "pt-BR",
        "@value": "Vocabulário OWL operacional inspirado na UFO; não é tradução completa do modelo de referência OntoUML. Representa alegações feitas por agentes e seus fundamentos; não afirma nenhuma alegação como verdadeira. Os termos são identificados em inglês e integralmente rotulados e definidos em inglês e português do Brasil; o conteúdo textual pode ser registrado em qualquer idioma com literais marcados por idioma."
      }
    ],
    "http://purl.org/dc/terms/hasPart": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/pattern"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      },
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Artistic Reality Ontology"
      },
      {
        "@language": "pt-BR",
        "@value": "Ontologia de Arte e Realidade"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Integral part of the doctoral research of Jefferson Rodrigo Speck in the Graduate Program in Informatics (PPGInf) of the Federal University of Paraná (UFPR), supervised by Prof. Dr. Roberto Pereira (UFPR) and co-supervised by Prof. Dr. Clodis Boscarioli (UNIOESTE), linked to the Research Group on Technology and Innovation in Education (GTIE), UNIOESTE."
      },
      {
        "@language": "pt-BR",
        "@value": "Parte integrante da pesquisa de doutorado de Jefferson Rodrigo Speck no Programa de Pós-Graduação em Informática (PPGInf) da Universidade Federal do Paraná (UFPR), sob orientação do Prof. Dr. Roberto Pereira (UFPR) e coorientação do Prof. Dr. Clodis Boscarioli (UNIOESTE), com vinculação ao Grupo de Pesquisa em Tecnologia e Inovação na Educação (GTIE), UNIOESTE."
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "https://w3id.org/aro/ontology/0.2.0-beta"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/aro/ontology/0.2.1-beta"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.2.1-beta"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology/module/representation",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "What the work represents according to an interpretation: descriptions of situations, intentional states and depicted elements (characters, places, objects)."
      },
      {
        "@language": "pt-BR",
        "@value": "O que a obra representa segundo uma interpretação: descrições de situações, estados intencionais e elementos representados (personagens, lugares, objetos)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Representation"
      },
      {
        "@language": "pt-BR",
        "@value": "Representação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CreativeRole",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): type; foundation: UFO role type (provisional); operationalized as skos:Concept; dependency: controlled vocabulary membership"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): type; fundamentação: tipo de papel UFO (provisório); operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "creative role"
      },
      {
        "@language": "pt-BR",
        "@value": "papel criativo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Role qualifying a creative contribution (composer, performer, translator, remixer...)."
      },
      {
        "@language": "pt-BR",
        "@value": "Papel que qualifica uma contribuição criativa (compositor, intérprete, tradutor, remixador...)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasManifestation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artwork realizes through manifestation"
      },
      {
        "@language": "pt-BR",
        "@value": "obra se realiza por manifestação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Manifestation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an artwork to a concrete expression, version or realization of it (a recording, an edition, a performance, a film cut). Use it to say through which manifestations the work exists."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma obra a uma expressão, versão ou realização concreta dela (gravação, edição, apresentação, montagem de filme). Use para dizer por quais manifestações a obra existe."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#AdapterRole",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#CreativeRole"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Agent producing an adaptation (e.g. screenwriter)."
      },
      {
        "@language": "pt-BR",
        "@value": "Agente que produz uma adaptação (ex. roteirista)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "adapter"
      },
      {
        "@language": "pt-BR",
        "@value": "adaptador"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology/module/evidence",
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The empirical world and its grounds: real cases, situations and events, reference sources, evidence items, correspondence claims between art and reality, and their assessment."
      },
      {
        "@language": "pt-BR",
        "@value": "O mundo empírico e seus fundamentos: casos, situações e eventos reais, fontes de referência, itens de evidência, alegações de correspondência entre arte e realidade e sua avaliação."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Evidence and empirical world"
      },
      {
        "@language": "pt-BR",
        "@value": "Evidência e mundo empírico"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DerivationClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; not a UFO relator nor an asserted fact; dependency: exactly one source anchor and one derived anchor; typed by at least one derivation type"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; nem relator UFO nem fato afirmado; dependência: exatamente uma âncora de origem e uma derivada; tipificada por ao menos um tipo de derivação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derivation claim"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação de derivação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#wasDerivedFrom"
      },
      {
        "@id": "https://schema.org/isBasedOn"
      },
      {
        "@id": "http://www.wikidata.org/prop/direct/P144"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Contestable assertion, made by an agent, that one artistic entity (artwork, manifestation or selection) derives from another in specified ways. The derived entity is represented as a creation in its own right; legality and originality are outside the scope of the ontology."
      },
      {
        "@language": "pt-BR",
        "@value": "Alegação contestável, feita por um agente, de que uma entidade artística (obra, manifestação ou recorte) deriva de outra de modos especificados. A entidade derivada é representada como criação por direito próprio; legalidade e originalidade estão fora do escopo da ontologia."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#GeneralDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Dimensions applicable to any medium."
      },
      {
        "@language": "pt-BR",
        "@value": "Dimensões aplicáveis a qualquer mídia."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "cross-media"
      },
      {
        "@language": "pt-BR",
        "@value": "transmidiática"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#assertsPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "correspondence references pattern"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação referencia padrão"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationPattern"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a correspondence claim to the situation pattern it compares with a real case: the side of art in the claim that art and reality correspond."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de correspondência ao padrão situacional que ela compara com um caso real: o lado da arte na alegação de que arte e realidade se correspondem."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasDerivationType",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim is typed by derivation kind"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação tipificada por tipo de derivação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Classifies a derivation claim with one or more concepts of the derivation-type vocabulary (cover, sampling, translation, parody...)."
      },
      {
        "@language": "pt-BR",
        "@value": "Classifica uma alegação de derivação com um ou mais conceitos do vocabulário de tipos de derivação (cover, sampling, tradução, paródia...)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#AudiovisualDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
