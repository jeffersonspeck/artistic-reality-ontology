      {
        "@language": "en",
        "@value": "cover art / poster"
      },
      {
        "@language": "pt-BR",
        "@value": "capa / cartaz"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#InterpretiveJustification",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; dependency: target interpretation, articulated premises"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; dependência: interpretação ou alegação-alvo, premissas articuladas"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretive justification"
      },
      {
        "@language": "pt-BR",
        "@value": "justificativa interpretativa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Recorded argument connecting premises to an interpretation or to a derivation claim."
      },
      {
        "@language": "pt-BR",
        "@value": "Argumento registrado que liga premissas a uma interpretação ou a uma alegação de derivação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#assessesCorrespondence",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EvidenceAssessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment evaluates correspondence"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação examina correspondência"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#CorrespondenceClaim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an evidence assessment to the correspondence claim (pattern ↔ case) whose support it evaluates."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma avaliação de evidência à alegação de correspondência (padrão ↔ caso) cujo apoio ela avalia."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#CoverVersion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Mosser 2008; Mag Uidhir, Magnus & Magnus 2013"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Performance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Popular-music performance or recording of an existing song by other performers; the term is systematically ambiguous, so record dimensions too. The covering artist is a creator in their own right."
      },
      {
        "@language": "pt-BR",
        "@value": "Interpretação ou gravação de canção popular existente por outros intérpretes; termo sistematicamente ambíguo, por isso registre também as dimensões. O artista do cover é criador por direito próprio."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "cover version"
      },
      {
        "@language": "pt-BR",
        "@value": "versão cover"
      }
    ]
  },
