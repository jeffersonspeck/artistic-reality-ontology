    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "harmony"
      },
      {
        "@language": "pt-BR",
        "@value": "harmonia"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#assessesEvidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EvidenceAssessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment considers evidence"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação considera evidência"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EvidenceItem"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an evidence assessment to the evidence items it weighs; every assessment considers at least one item."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma avaliação de evidência aos itens de evidência que ela pondera; toda avaliação considera pelo menos um item."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Allusion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Indirect reference whose full sense presupposes recognition of the source."
      },
      {
        "@language": "pt-BR",
        "@value": "Referência indireta cujo sentido pleno pressupõe reconhecer a origem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
