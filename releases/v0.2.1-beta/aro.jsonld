      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): event; foundation: UFO-B event; dependency: real occurrence and participants"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): event; fundamentação: evento UFO-B; dependência: ocorrência real e participantes"
