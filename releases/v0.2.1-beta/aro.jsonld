        "@value": "Compact selector shortcut; prefer hasSelector with W3C Web Annotation selectors."
      },
      {
        "@language": "pt-BR",
        "@value": "Atalho compacto de seletor; prefira hasSelector com seletores W3C Web Annotation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
