  {
    "@id": "https://w3id.org/aro/ontology#UnacknowledgedBorrowing",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Literal borrowing presented without acknowledgment of the source (Genette's 'plagiat'); a descriptive textual relation, not a legal or moral judgment."
      },
      {
        "@language": "pt-BR",
        "@value": "Empréstimo literal apresentado sem reconhecimento da origem (o 'plagiat' de Genette); relação textual descritiva, não julgamento jurídico ou moral."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "unacknowledged borrowing"
      },
      {
        "@language": "pt-BR",
        "@value": "empréstimo não declarado"
      }
    ]
  },
