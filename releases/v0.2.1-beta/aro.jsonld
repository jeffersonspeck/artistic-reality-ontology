        "@language": "pt-BR",
        "@value": "contestação de interpretação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Recorded criticism or alternative reasoning about an interpretation."
      },
      {
        "@language": "pt-BR",
