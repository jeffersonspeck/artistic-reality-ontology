      },
      {
        "@language": "pt-BR",
        "@value": "tom / atmosfera"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#supportsInterpretation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
