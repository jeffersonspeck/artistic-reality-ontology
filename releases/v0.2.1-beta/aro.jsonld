      {
        "@language": "en",
        "@value": "manifestation"
      },
      {
        "@language": "pt-BR",
        "@value": "manifestação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Specific expression, version or realization of an artwork."
      },
      {
        "@language": "pt-BR",
        "@value": "Expressão, versão ou realização específica de uma obra."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Ekphrasis",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Rajewsky 2005 (intermedial reference)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Representation in one medium of a work from another medium (e.g. poem about a painting); an intermedial reference."
      },
      {
        "@language": "pt-BR",
        "@value": "Representação, numa mídia, de obra de outra mídia (ex. poema sobre pintura); referência intermidiática."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "ekphrasis"
      },
      {
        "@language": "pt-BR",
        "@value": "écfrase"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Prequel",
