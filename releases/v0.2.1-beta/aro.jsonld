  {
    "@id": "https://w3id.org/aro/ontology#citesSource",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretationRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretation directly cites source (optional)"
      },
      {
        "@language": "pt-BR",
        "@value": "interpretação cita fonte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#ReferenceSource"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an interpretation record directly to a reference source it relies on (criticism, interview, study), when no separate evidence item is recorded."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um registro de interpretação diretamente a uma fonte de referência em que se apoia (crítica, entrevista, estudo), quando não se registra um item de evidência separado."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Abridgment",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Smiraglia 2001 (extractions)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derivation keeping a reduced part of the source (abridgment, excerpt, radio edit)."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação que mantém parte reduzida da origem (resumo, excerto, radio edit)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "abridgment / extraction"
      },
      {
        "@language": "pt-BR",
        "@value": "resumo / extração"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#supportsClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EvidenceAssessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment evaluates claim"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação examina afirmação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalClaim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an evidence assessment to the empirical claim whose support it evaluates."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma avaliação de evidência à afirmação empírica cujo apoio ela avalia."
      }
    ]
  },
  {
