        "@id": "https://w3id.org/aro/ontology#PatternCondition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a situation pattern to the conditions that define it, each one individuated so that it can be marked as required or optional and compared with real cases."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um padrão situacional às condições que o definem, cada uma individualizada para poder ser marcada como obrigatória ou opcional e comparada com casos reais."
      }
    ]
  },
