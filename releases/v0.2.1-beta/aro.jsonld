  },
  {
    "@id": "https://w3id.org/aro/ontology#derivationExtent",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Free-text extent of reuse (e.g. \"4-second loop\", \"whole plot\"); language-tagged."
      },
      {
        "@language": "pt-BR",
        "@value": "Extensão livre do reaproveitamento (ex. \"loop de 4 segundos\", \"enredo inteiro\"); marcada por idioma."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
