[
  {
    "@id": "https://w3id.org/aro/ontology#aspectConcernsPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "aspect concerns a situation pattern"
      },
      {
        "@language": "pt-BR",
        "@value": "aspecto envolve padrão situacional"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationPattern"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a transformation aspect to a situation pattern it affects, when a derivation keeps, changes or relocates a represented situation."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um aspecto de transformação a um padrão situacional que ele afeta, quando a derivação mantém, altera ou desloca uma situação representada."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Appropriation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Navas 2012"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Re-presentation of an existing work or image, often whole, in a new context that changes its sense."
      },
      {
        "@language": "pt-BR",
        "@value": "Reapresentação de obra ou imagem existente, frequentemente inteira, em novo contexto que altera seu sentido."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "appropriation"
      },
      {
        "@language": "pt-BR",
        "@value": "apropriação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#identifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Local identifier of a record; a stable URI is recommended. Not identity in the world."
      },
      {
        "@language": "pt-BR",
        "@value": "Identificador local de um registro; recomenda-se URI estável. Não é identidade no mundo."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "identifier"
      },
      {
        "@language": "pt-BR",
        "@value": "identificador"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "What a derivation does to one artistic dimension."
      },
      {
        "@language": "pt-BR",
        "@value": "O que uma derivação faz com uma dimensão artística."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/aro/ontology#Retained"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Modified"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Added"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Removed"
      },
      {
        "@id": "https://w3id.org/aro/ontology#Recontextualized"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Transformation operations"
      },
      {
        "@language": "pt-BR",
        "@value": "Operações de transformação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#assessesDerivation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#EvidenceAssessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment evaluates derivation claim"
      },
      {
        "@language": "pt-BR",
        "@value": "avaliação examina alegação de derivação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an evidence assessment to the derivation claim whose support it evaluates."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma avaliação de evidência à alegação de derivação cujo apoio ela avalia."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Remix",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Navas 2012 (selective and reflexive remix)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Incorporation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Selective or reflexive recombination of an existing recording's elements into a new whole; the remixer is a creator in their own right."
      },
      {
        "@language": "pt-BR",
        "@value": "Recombinação seletiva ou reflexiva dos elementos de gravação existente num novo todo; o remixador é criador por direito próprio."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "remix"
      },
      {
        "@language": "pt-BR",
        "@value": "remix"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#groupsSelection",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#AnalysisUnit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "unit groups selections"
      },
      {
        "@language": "pt-BR",
        "@value": "unidade agrupa recortes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links an analysis unit to the selections it groups, so that several excerpts can be analysed together as one unit (a scene, a refrain, a motif)."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma unidade de análise aos recortes que ela agrupa, para que vários trechos sejam analisados juntos como uma unidade (uma cena, um refrão, um motivo)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#SetDesignDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MiseEnSceneDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Sets, locations and props."
      },
      {
        "@language": "pt-BR",
        "@value": "Cenários, locações e objetos de cena."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "set and props"
      },
      {
        "@language": "pt-BR",
        "@value": "cenário e objetos"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Modified",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#TransformationOperation"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Dimension present in both but changed."
      },
      {
        "@language": "pt-BR",
        "@value": "Dimensão presente em ambas, mas alterada."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "modified"
      },
      {
        "@language": "pt-BR",
        "@value": "modificado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MiseEnSceneDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Bordwell & Thompson, Film Art"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#AudiovisualDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "What is placed before the camera."
      },
      {
        "@language": "pt-BR",
        "@value": "O que é posto diante da câmera."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "mise-en-scène"
      },
      {
        "@language": "pt-BR",
        "@value": "mise-en-scène"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#claimProducedByAct",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "analytical act that recorded the claim"
      },
      {
        "@language": "pt-BR",
        "@value": "ato analítico que registrou a alegação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#InterpretiveAct"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the analytical act that recorded it, so that the claim has an author and a date like any interpretation."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação ao ato analítico que a registrou, para que a alegação tenha autor e data como qualquer interpretação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#FanWork",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Jenkins 1992"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Extension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Non-official derivation by audience members; also type the mechanism (parody, continuation, crossover...)."
      },
      {
        "@language": "pt-BR",
        "@value": "Derivação não oficial feita pelo público; tipifique também o mecanismo (paródia, continuação, crossover...)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "fan work"
      },
      {
        "@language": "pt-BR",
        "@value": "obra de fã"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#selectsFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#Selection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/artwork"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "selection references manifestation"
      },
      {
        "@language": "pt-BR",
        "@value": "recorte referencia manifestação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#Manifestation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a selection to the manifestation it is taken from. Every selection is cut from exactly one manifestation, so that its location (lines, seconds, region) is meaningful."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga um recorte à manifestação de onde ele é tirado. Todo recorte vem de exatamente uma manifestação, para que sua localização (linhas, segundos, região) tenha sentido."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#InterpretationRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; not an event; dependency: anchor selection; historical interpretive act"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; não é evento; dependência: recorte de ancoragem; ato interpretativo histórico"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/interpretation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "interpretation record"
      },
      {
        "@language": "pt-BR",
        "@value": "registro de interpretação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Persistent authored record of an interpretation of a selection."
      },
      {
        "@language": "pt-BR",
        "@value": "Registro autoral persistente de uma interpretação de recorte."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Extension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Tillett 1991 (sequential); Jenkins 1992"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "New work extending the fictional world, timeline or cast of the source."
      },
      {
        "@language": "pt-BR",
        "@value": "Obra nova que estende o mundo ficcional, a linha do tempo ou o elenco da origem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "extension"
      },
      {
        "@language": "pt-BR",
        "@value": "extensão"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Caricature",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Imitation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Imitation of a style in a satirical regime."
      },
      {
        "@language": "pt-BR",
        "@value": "Imitação de estilo em regime satírico."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "caricature (charge)"
      },
      {
        "@language": "pt-BR",
        "@value": "caricatura (charge)"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#TransformationOperation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): type; foundation: UFO high-order type (provisional); operationalized as skos:Concept; dependency: controlled vocabulary membership"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): type; fundamentação: tipo de alta ordem UFO (provisório); operacionalizado como skos:Concept; dependência: pertencimento a vocabulário controlado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transformation operation"
      },
      {
        "@language": "pt-BR",
        "@value": "operação de transformação"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "What a derivation does to a dimension: retain, modify, add, remove or recontextualize."
      },
      {
        "@language": "pt-BR",
        "@value": "O que a derivação faz com uma dimensão: manter, modificar, acrescentar, remover ou recontextualizar."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#generalizesAs",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationDescription"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "description motivates pattern abstraction"
      },
      {
        "@language": "pt-BR",
        "@value": "descrição motiva abstração"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#SituationPattern"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a situation description to a situation pattern abstracted from it: the reusable configuration that the represented situation is taken to exemplify."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma descrição de situação a um padrão situacional abstraído dela: a configuração reutilizável que a situação representada é tomada como exemplo."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasDerivedAnchor",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim names the derived entity"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação indica entidade derivada"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "_:N5ce4c38b61ed4175a85ec4d73d92cd1e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a derivation claim to the entity said to derive from the source (artwork, manifestation or selection): the derived side of the claim. It must differ from the source anchor."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de derivação à entidade que se diz derivar da origem (obra, manifestação ou recorte): o lado derivado da alegação. Deve ser diferente da âncora de origem."
      }
    ]
  },
  {
    "@id": "_:N5ce4c38b61ed4175a85ec4d73d92cd1e",
