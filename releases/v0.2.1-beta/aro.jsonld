        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "lighting"
      },
      {
        "@language": "pt-BR",
        "@value": "iluminação"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EmpiricalSituation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): situation; foundation: UFO-B situation; separate from descriptions; dependency: real-world constituents"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): situation; fundamentação: situação UFO-B; separada de descrições; dependência: constituintes do mundo real"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "empirical situation"
      },
      {
        "@language": "pt-BR",
        "@value": "situação empírica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
