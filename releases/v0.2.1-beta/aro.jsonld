        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#NarrativeDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Chatman 1978; Genette 1972"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Story-level and discourse-level properties of narratives in any medium."
      },
      {
        "@language": "pt-BR",
        "@value": "Propriedades de história e de discurso de narrativas em qualquer mídia."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "narrative"
      },
      {
        "@language": "pt-BR",
        "@value": "narrativa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MusicalTextureDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#MusicDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relation among simultaneous lines (monophony, homophony, polyphony)."
      },
      {
        "@language": "pt-BR",
        "@value": "Relação entre linhas simultâneas (monofonia, homofonia, polifonia)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimensionScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "musical texture"
      },
      {
        "@language": "pt-BR",
        "@value": "textura musical"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasOperation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "aspect applies an operation"
      },
      {
        "@language": "pt-BR",
        "@value": "aspecto aplica operação"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "States what was done to the dimension in a transformation aspect: retain, modify, add, remove or recontextualize."
      },
      {
        "@language": "pt-BR",
        "@value": "Diz o que foi feito com a dimensão num aspecto de transformação: manter, modificar, adicionar, remover ou recontextualizar."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#EmpiricalEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
