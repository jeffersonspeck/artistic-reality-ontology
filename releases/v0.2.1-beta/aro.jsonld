      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#DepictedAgent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): subkind; foundation: UFO-C representation; dependency: inherits DepictedElement identity"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): subkind; fundamentação: representação UFO-C; dependência: herda a identidade de DepictedElement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/representation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "depicted agent"
      },
      {
        "@language": "pt-BR",
        "@value": "agente representado"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aro/ontology#DepictedElement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Depicted element referring to an agent or character."
      },
      {
        "@language": "pt-BR",
        "@value": "Elemento representado que se refere a agente ou personagem."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Recontextualized",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#TransformationOperation"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Content kept but placed in a different context that changes its sense."
      },
      {
        "@language": "pt-BR",
        "@value": "Conteúdo mantido, mas posto em contexto que altera seu sentido."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "recontextualized"
      },
      {
        "@language": "pt-BR",
        "@value": "recontextualizado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationOperationScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#PatternCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "OntoUML stereotype (provisional): kind; foundation: UFO-C information object; dependency: host pattern and logical specification"
      },
      {
        "@language": "pt-BR",
        "@value": "Estereótipo OntoUML (provisório): kind; fundamentação: objeto informacional UFO-C; dependência: padrão hospedeiro e especificação lógica"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/pattern"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "pattern condition"
      },
      {
        "@language": "pt-BR",
        "@value": "condição de padrão"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Individuated mandatory or optional condition within a pattern."
      },
      {
        "@language": "pt-BR",
        "@value": "Condição individualizada obrigatória ou opcional de um padrão."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#ComposerRole",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#CreativeRole"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Originator of musical content."
      },
      {
        "@language": "pt-BR",
        "@value": "Criador do conteúdo musical."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "composer"
      },
      {
        "@language": "pt-BR",
        "@value": "compositor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/aro/ontology#CreativeRoleScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Translation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Smiraglia 2001; Genette 1982"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Rerealization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Rendering of verbal content in another language. Genette also classes it as a serious transformation (transposition)."
      },
      {
        "@language": "pt-BR",
        "@value": "Transposição do conteúdo verbal para outra língua. Genette também a classifica como transformação séria (transposição)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "translation"
      },
      {
        "@language": "pt-BR",
        "@value": "tradução"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#Sequel",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#DerivationType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "Tillett 1991"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/aro/ontology#Continuation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Continuation set after the source."
      },
      {
        "@language": "pt-BR",
        "@value": "Continuação situada depois da origem."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/aro/ontology#DerivationTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "sequel"
      },
      {
        "@language": "pt-BR",
        "@value": "sequência"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#hasDimension",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aro/ontology#TransformationAspect"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aro/ontology/module/derivation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "aspect concerns a dimension"
      },
      {
        "@language": "pt-BR",
        "@value": "aspecto incide sobre dimensão"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#ArtisticDimension"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "States which artistic dimension (melody, lyrics, plot, character, medium...) a transformation aspect is about."
      },
      {
        "@language": "pt-BR",
        "@value": "Diz de qual dimensão artística (melodia, letra, enredo, personagem, meio...) trata um aspecto de transformação."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#LightingDimension",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://w3id.org/aro/ontology#ArtisticDimension"
    ],
    "http://purl.org/dc/terms/source": [
