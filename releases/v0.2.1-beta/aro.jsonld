      {
        "@id": "https://w3id.org/aro/ontology/module/evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "correspondence references case"
      },
      {
        "@language": "pt-BR",
        "@value": "alegação referencia caso"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aro/ontology#EmpiricalCase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a correspondence claim to the empirical case it compares with a pattern: the side of reality in the claim that art and reality correspond."
      },
      {
        "@language": "pt-BR",
        "@value": "Liga uma alegação de correspondência ao caso empírico que ela compara com um padrão: o lado da realidade na alegação de que arte e realidade se correspondem."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aro/ontology#MusicDimension",
