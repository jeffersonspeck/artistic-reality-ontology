# CQ-17: How is a derivation claim explained: which justifications, cited sources and
# evidence assessments bear on it?
# Explanations are represented as justifications, sources and assessments made by agents;
# legality is out of scope (ADR-014).
# Justification texts are language-tagged; one row is returned per language available.
PREFIX aro: <https://w3id.org/aro/ontology#>
SELECT ?claim ?justification ?source ?assessment WHERE {
  ?claim a aro:DerivationClaim .
  OPTIONAL { ?claim aro:derivationJustifiedBy/aro:textValue ?justification }
  OPTIONAL { ?claim aro:derivationReferencesSource ?source }
  OPTIONAL { ?assessment aro:assessesDerivation ?claim }
  # Keep only claims that have at least one element of explanation
  FILTER(BOUND(?justification) || BOUND(?source) || BOUND(?assessment))
}
