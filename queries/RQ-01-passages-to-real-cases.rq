# RQ-01: Which passages of a work represent situations that have been claimed to correspond
# to documented real cases, and where can the supporting source be consulted?
# Chain: work <- expression <- selection <- interpretation -> situation -> pattern
#        <- correspondence claim -> empirical case -> source URL.
# Language: texts are shown in ?lang (scripts/query.py --lang and the annotator replace it);
# a text that does not exist in that language is shown in the language it has.
PREFIX aro: <https://w3id.org/aro/ontology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?work ?passage ?situation ?pattern ?case ?sourceURL WHERE {
  VALUES ?lang { "en" }
  ?reading aro:hasPrimarySelection ?sel ;
           aro:describesSituation ?sd .
  ?sel aro:selectsFrom/aro:realizesArtwork ?w ;
       aro:selectorExpression ?passage .
  ?w aro:textValue ?work .
  ?sd aro:generalizesAs ?p ;
      aro:textValue ?situation .
  ?p aro:textValue ?pattern .
  ?claim a aro:CorrespondenceClaim ;
         aro:assertsPattern ?p ;
         aro:assertsCase ?c .
  ?c aro:textValue ?case .
  OPTIONAL { ?claim aro:citesSource/aro:sourceURL ?sourceURL }
  # Narrative position: first number in the selector expression ("lines 22-26", "chapter 3")
  BIND(xsd:integer(REPLACE(?passage, "^[^0-9]*([0-9]+).*$", "$1")) AS ?position)
  # each text in the preferred language, or in any language when that one is missing
  FILTER(langMatches(lang(?work), ?lang) || NOT EXISTS { ?w aro:textValue ?x1 FILTER(langMatches(lang(?x1), ?lang)) })
  FILTER(langMatches(lang(?situation), ?lang) || NOT EXISTS { ?sd aro:textValue ?x2 FILTER(langMatches(lang(?x2), ?lang)) })
  FILTER(langMatches(lang(?pattern), ?lang) || NOT EXISTS { ?p aro:textValue ?x3 FILTER(langMatches(lang(?x3), ?lang)) })
  FILTER(langMatches(lang(?case), ?lang) || NOT EXISTS { ?c aro:textValue ?x4 FILTER(langMatches(lang(?x4), ?lang)) })
}
ORDER BY ?work ?position
