# CQ-13: Which entities are claimed to derive from a given artwork, at which level
# (artwork, manifestation or selection) and by which derivation type?
# Source anchors at manifestation/selection level are normalized up to their artwork,
# so a sample taken from one recording is still listed under the song it realizes.
PREFIX aro: <https://w3id.org/aro/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?sourceWork ?derived ?derivedLevel ?typeLabel WHERE {
  ?claim a aro:DerivationClaim ;
         aro:hasSourceAnchor ?src ;
         aro:hasDerivedAnchor ?derived ;
         aro:hasDerivationType ?type .
  # Optional steps: Selection -selectsFrom-> Manifestation -realizesArtwork-> Artwork.
  # For an artwork anchor both steps match zero times and ?sourceWork = ?src.
  ?src aro:selectsFrom?/aro:realizesArtwork? ?sourceWork .
  ?sourceWork a aro:Artwork .
  # Level of the derived entity
  ?derived a ?derivedLevel .
  VALUES ?derivedLevel { aro:Artwork aro:Manifestation aro:Selection }
  # Human-readable type label; change "en" to "pt-BR" for Portuguese
  ?type skos:prefLabel ?typeLabel .
  FILTER(lang(?typeLabel) = "en")
}
ORDER BY ?sourceWork ?derived
