# CQ-13: Which entities are claimed to derive from a given artwork, at which level
# (artwork, expression, manifestation or selection) and by which derivation type?
# Source anchors below the artwork level are normalized up to their artwork, so a sample
# taken from one recording is still listed under the song it realizes.
# Language: ?lang is the preferred language of labels (scripts/query.py --lang and the
# annotator replace it); when a label is missing in that language, another one is used.
PREFIX aro: <https://w3id.org/aro/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?sourceWork ?derived ?derivedLevel ?typeLabel WHERE {
  VALUES ?lang { "en" }
  ?claim a aro:DerivationClaim ;
         aro:hasSourceAnchor ?src ;
         aro:hasDerivedAnchor ?derived ;
         aro:hasDerivationType ?type .
  # Optional steps (IFLA LRM levels): Selection -selectsFrom-> Expression -realizesArtwork-> Artwork,
  # Manifestation -embodiesExpression-> Expression. For an artwork anchor every step matches
  # zero times and ?sourceWork = ?src.
  ?src aro:selectsFrom?/aro:embodiesExpression?/aro:realizesArtwork? ?sourceWork .
  ?sourceWork a aro:Artwork .
  # Level of the derived entity
  ?derived a ?derivedLevel .
  VALUES ?derivedLevel { aro:Artwork aro:Expression aro:Manifestation aro:Selection }
  # Type label in the preferred language (or in another one if that one is missing)
  ?type skos:prefLabel ?typeLabel .
  FILTER(langMatches(lang(?typeLabel), ?lang)
         || NOT EXISTS { ?type skos:prefLabel ?l FILTER(langMatches(lang(?l), ?lang)) })
}
ORDER BY ?sourceWork ?derived
