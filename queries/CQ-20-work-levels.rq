# CQ-20: Through which expressions and manifestations does an artwork exist?
# IFLA LRM levels (ADR-028): an artwork is realized in expressions (a recording, a text version,
# a translation), which may be embodied in manifestations (an album, an edition).
# Language: texts in ?lang, or in the language they have when ?lang is missing.
PREFIX aro: <https://w3id.org/aro/ontology#>
SELECT ?work ?expression ?manifestation WHERE {
  VALUES ?lang { "en" }
  ?e aro:realizesArtwork ?w .
  ?w aro:textValue ?work .
  ?e aro:textValue ?expression .
  OPTIONAL { ?e aro:hasManifestation|^aro:embodiesExpression ?m .
             ?m aro:textValue ?manifestation .
             FILTER(langMatches(lang(?manifestation), ?lang) || NOT EXISTS { ?m aro:textValue ?x3 FILTER(langMatches(lang(?x3), ?lang)) }) }
  FILTER(langMatches(lang(?work), ?lang) || NOT EXISTS { ?w aro:textValue ?x1 FILTER(langMatches(lang(?x1), ?lang)) })
  FILTER(langMatches(lang(?expression), ?lang) || NOT EXISTS { ?e aro:textValue ?x2 FILTER(langMatches(lang(?x2), ?lang)) })
}
ORDER BY ?work ?expression
