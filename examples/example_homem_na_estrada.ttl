ex:hyp-selective-policing a aro:ExplanationHypothesis ;
    aro:explainsPattern ex:pattern-state-violence ;
    aro:textValue "Hypothesis: selective policing of poor and Black populations increases their exposure to state violence."@en,
        "Hipótese: o policiamento seletivo de populações pobres e negras aumenta sua exposição à violência do Estado."@pt-BR .

dbr:Mano_Brown a schema:Person ;
    schema:name "Mano Brown" .

<http://dbpedia.org/resource/Racionais_MC's> a schema:MusicGroup ;
    schema:name "Racionais MC's" .

ex:analyst a schema:Person ;
    schema:name "Example analyst" .

ex:c-dt a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A young retail drug seller from the periphery is killed while wealthier actors profit."@en,
        "Um jovem vendedor de drogas da periferia é morto enquanto atores mais ricos lucram."@pt-BR .

ex:c-hu a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Children lack regular food and rely on scraps or school meals."@en,
        "Crianças não têm alimentação regular e dependem de restos ou da merenda escolar."@pt-BR .

ex:c-ly a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Residents collectively attack a person accused of a crime, without any legal process."@en,
        "Moradores atacam coletivamente uma pessoa acusada de crime, sem processo legal."@pt-BR .

ex:c-ph a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Households lack sewage collection or other basic services."@en,
        "Domicílios sem coleta de esgoto ou outros serviços básicos."@pt-BR .

ex:c-ri-barrier a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Work or social acceptance is denied because of the criminal record."@en,
        "Trabalho ou aceitação social são negados por causa dos antecedentes."@pt-BR .

ex:c-ri-released a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A person has left prison."@en,
        "Uma pessoa saiu da prisão."@pt-BR .

ex:c-sa a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A public service (census, forensics, water, health) is absent or arrives very late in a poor neighbourhood."@en,
        "Um serviço público (censo, perícia, água, saúde) está ausente ou chega muito atrasado num bairro pobre."@pt-BR .

ex:c-sv-agent a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The aggressor acts as an agent of state security (police, soldier)."@en,
        "O agressor age como agente de segurança do Estado (polícia, soldado)."@pt-BR .

ex:c-sv-framing a aro:PatternCondition ;
    aro:isRequiredCondition false ;
    aro:textValue "The victim is framed as an offender."@en,
        "A vítima é retratada como infratora."@pt-BR .

ex:c-sv-lethal a aro:PatternCondition ;
    aro:isRequiredCondition false ;
    aro:textValue "The violence is lethal."@en,
        "A violência é letal."@pt-BR .

ex:c-sv-victim a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The victim is poor or socially marginalized."@en,
        "A vítima é pobre ou socialmente marginalizada."@pt-BR .

ex:c-yd a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A poor child or adolescent is held in a juvenile detention institution."@en,
        "Uma criança ou adolescente pobre é mantida numa instituição de internação."@pt-BR .

ex:case-carandiru a aro:EmpiricalCase ;
    aro:caseAboutEvent ex:event-carandiru ;
    aro:caseHasReference ex:src-carandiru ;
    aro:textValue "Carandiru massacre, São Paulo, 2 October 1992"@en,
        "Massacre do Carandiru, São Paulo, 2 de outubro de 1992"@pt-BR .

ex:case-police-lethality a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-police-lethality ;
    aro:caseHasReference ex:src-fbsp-2020 ;
    aro:textValue "Deaths resulting from police interventions in Brazil (national statistics)"@en,
        "Mortes decorrentes de intervenção policial no Brasil (estatísticas nacionais)"@pt-BR .

ex:case-reintegration a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-reintegration ;
    aro:caseHasReference ex:src-ipea-2015 ;
    aro:textValue "Criminal recidivism and reintegration of former prisoners in Brazil"@en,
        "Reincidência criminal e reintegração de egressos do sistema prisional no Brasil"@pt-BR .

ex:case-sanitation a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-sanitation ;
    aro:caseHasReference ex:src-sanitation ;
    aro:textValue "Lack of household sewage collection in Brazil"@en,
        "Falta de coleta de esgoto domiciliar no Brasil"@pt-BR .

ex:corr-carandiru a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-carandiru ;
    aro:assertsPattern ex:pattern-state-violence ;
    aro:referencesSource ex:src-carandiru ;
    aro:textValue "A documented, large-scale instance of lethal state violence against marginalized men, one year before the song."@en,
        "Instância documentada e de grande escala de violência letal do Estado contra homens marginalizados, um ano antes da canção."@pt-BR .

ex:corr-hne-police a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-police-lethality ;
    aro:assertsPattern ex:pattern-state-violence ;
    aro:referencesSource ex:src-fbsp-2020 ;
    aro:textValue "The pattern represented in the song is similar to documented, recurrent police lethality in Brazil."@en,
        "O padrão representado na canção é semelhante à letalidade policial documentada e recorrente no Brasil."@pt-BR .

ex:corr-reintegration a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-reintegration ;
    aro:assertsPattern ex:pattern-reintegration ;
    aro:referencesSource ex:src-ipea-2015 ;
    aro:textValue "The difficulties represented in the song correspond to a documented field of research on reintegration and recidivism."@en,
        "As dificuldades representadas na canção correspondem a um campo documentado de pesquisa sobre reintegração e reincidência."@pt-BR .

ex:corr-sanitation a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-sanitation ;
    aro:assertsPattern ex:pattern-precarious-housing ;
    aro:referencesSource ex:src-sanitation ;
    aro:textValue "The precarious housing represented in the song is similar to a widespread, measured lack of sanitation."@en,
        "A moradia precária representada na canção é semelhante a uma falta de saneamento ampla e medida."@pt-BR .

ex:deriv-hne-sound a aro:TransformationAspect ;
    aro:hasDimension aro:RecordedSoundDimension ;
    aro:hasOperation aro:Recontextualized .

ex:ela-partiu a aro:Artwork ;
    aro:textValue "Ela Partiu (Tim Maia)"@en,
        "Ela Partiu (Tim Maia)"@pt-BR .

ex:ev-carandiru a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-carandiru ;
    aro:textValue "Military Police intervention in the Carandiru prison that left 111 prisoners dead."@en,
        "Intervenção da Polícia Militar no presídio do Carandiru que deixou 111 presos mortos."@pt-BR .

ex:ev-fbsp a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-fbsp-2020 ;
    aro:externalLink "https://forumseguranca.org.br/wp-content/uploads/2021/07/4-as-mortes-decorrentes-de-intervencao-policial-no-brasil-em-2020.pdf"^^xsd:anyURI ;
    aro:textValue "The report presents national and state counts of deaths resulting from police interventions and the profile of the victims."@en,
        "O relatório apresenta contagens nacionais e estaduais de mortes decorrentes de intervenção policial e o perfil das vítimas."@pt-BR .

ex:ev-ipea a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-ipea-2015 ;
    aro:textValue "The report estimates recidivism from data of several states, describes the profile of recidivists and warns against the widely repeated but unsupported 70% figure."@en,
        "O relatório estima a reincidência a partir de dados de vários estados, descreve o perfil dos reincidentes e alerta contra o número de 70%, repetido sem fundamento."@pt-BR .

ex:ev-sanitation a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-sanitation ;
    aro:textValue "About 100 million Brazilians (47.6% of the population) had no household sewage collection in 2017, according to SNIS data."@en,
        "Cerca de 100 milhões de brasileiros (47,6% da população) não tinham coleta de esgoto em casa em 2017, segundo dados do SNIS."@pt-BR .

ex:event-carandiru a aro:EmpiricalEvent .

