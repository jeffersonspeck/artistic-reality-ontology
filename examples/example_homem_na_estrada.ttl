ex:hne-febem a aro:DepictedElement ;
    aro:textValue "FEBEM (juvenile detention system of São Paulo)"@en,
        "FEBEM (sistema de internação de menores de São Paulo)"@pt-BR .

ex:hne-ibge a aro:DepictedElement ;
    aro:textValue "IBGE (Brazilian census bureau)"@en,
        "IBGE"@pt-BR .

ex:hne-iml a aro:DepictedElement ;
    aro:textValue "IML (forensic medical institute)"@en,
        "IML (Instituto Médico Legal)"@pt-BR .

ex:hne-just15 a aro:InterpretiveJustification ;
    aro:textValue "The narrative sequence (police raid at dawn, then the man's death) contrasts with the closing report attributing the death to rival gangs; the reading takes the report as the official version that criminalizes the victim."@en,
        "A sequência narrativa (invasão policial de madrugada e depois a morte do homem) contrasta com o relato final que atribui a morte a quadrilhas rivais; a leitura toma o relato como versão oficial que criminaliza a vítima."@pt-BR .

ex:hne-mboi a aro:DepictedElement ;
    aro:textValue "Estrada do M'Boi Mirim (road in the south of São Paulo)"@en,
        "Estrada do M'Boi Mirim (zona sul de São Paulo)"@pt-BR .

ex:hne-performer a aro:CreativeContribution ;
    aro:contributionBy <http://dbpedia.org/resource/Racionais_MC's> ;
    aro:contributionRole aro:PerformerRole .

ex:hne-r15 a aro:InterpretationRecord ;
    aro:citesSource ex:src-ufpb ;
    aro:confidenceScore 0.85 ;
    aro:describesSituation ex:hne-s15 ;
    aro:hasJustification ex:hne-just15 ;
    aro:hasPrimarySelection ex:hne-e15 ;
    aro:producedByAct ex:reading-act .

ex:hne-s01 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-reintegration ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "A man leaves prison and restarts his life, wanting to prove he has changed and to leave crime behind."@en,
        "Um homem sai da prisão e recomeça a vida, querendo provar que mudou e deixar o crime para trás."@pt-BR .

ex:hne-s02 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-youth-detention ;
    aro:mentionsDepictedElement ex:hne-febem,
        ex:hne-man ;
    aro:textValue "His childhood included painful memories of the juvenile detention system (FEBEM)."@en,
        "Sua infância incluiu lembranças dolorosas do sistema de internação de menores (FEBEM)."@pt-BR .

ex:hne-s03 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-precarious-housing ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "His only home is a poorly built shack on an unstable slope, with sewage smell in the yard and risk of collapse when it rains."@en,
        "Seu único lar é um barraco mal acabado num barranco instável, com cheiro de esgoto no quintal e risco de desabar quando chove."@pt-BR .

ex:hne-s04 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-state-absence ;
    aro:mentionsDepictedElement ex:hne-ibge ;
    aro:textValue "The census bureau (IBGE) came once, numbered the shacks and never returned."@en,
        "O IBGE esteve lá uma única vez, contou os barracos e não retornou."@pt-BR .

ex:hne-s05 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-state-absence ;
    aro:mentionsDepictedElement ex:hne-iml ;
    aro:textValue "The body of a murdered woman stays in the street for hours; the forensic service (IML) arrives ten hours late."@en,
        "O corpo de uma mulher assassinada fica horas na rua; o IML chega dez horas atrasado."@pt-BR .

ex:hne-s06 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-reintegration ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "Unemployed, with a bad reputation for having been in prison, nobody trusts him."@en,
        "Desempregado e com má reputação por ter passado pela detenção, ninguém confia nele."@pt-BR .

ex:hne-s07 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-precarious-housing ;
    aro:textValue "Water supply has failed for five days and the shortage is routine."@en,
        "Falta água há cinco dias e a falta já é rotina."@pt-BR .

ex:hne-s08 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-lynching ;
    aro:textValue "A drunk man who attacked his own mother is dragged through the street and lynched by neighbours."@en,
        "Um homem embriagado que agrediu a própria mãe é arrastado pela rua e linchado pelos vizinhos."@pt-BR .

ex:hne-s09 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-hunger ;
    aro:textValue "Children compete with animals for food scraps at the street market and go to school only to eat."@en,
        "Crianças disputam restos de comida com animais na feira e só vão à escola para comer."@pt-BR .

ex:hne-s10 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-drug-trade-violence ;
    aro:textValue "A young friend who sold cocaine to rich youths is shot dead at school and becomes sensational news."@en,
        "Um amigo jovem que vendia cocaína para jovens ricos é fuzilado na escola e vira notícia sensacionalista."@pt-BR .

ex:hne-s11 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-reintegration,
        ex:pattern-state-violence ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "After robberies nearby, the favela is blamed and his name appears on a list of suspects."@en,
        "Depois de assaltos na região, a favela é acusada e o nome dele aparece numa lista de suspeitos."@pt-BR .

ex:hne-s12 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-reintegration ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "His record (a tattoo, a past robbery conviction) is exposed; he will always be called an ex-convict."@en,
        "Seus antecedentes (uma tatuagem, uma condenação por roubo) são expostos; será sempre chamado de ex-presidiário."@pt-BR .

ex:hne-s13 a aro:IntentionalStateDescription ;
    aro:generalizesAs ex:pattern-state-violence ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-police ;
    aro:textValue "He distrusts the police, expects to be abused rather than helped if found wounded, and provides his own security."@en,
        "Ele não confia na polícia, espera ser agredido e não socorrido se for encontrado ferido, e faz a própria segurança."@pt-BR .

ex:hne-s14 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-state-violence ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-police ;
    aro:textValue "At dawn the police invade his shack, already set on killing him although he had no part in the crime."@en,
        "De madrugada a polícia invade seu barraco, decidida a matá-lo embora ele não tivesse participado do crime."@pt-BR .

ex:hne-s15 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-state-violence ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-mboi,
        ex:hne-police ;
    aro:textValue "A news-style report: a mixed-race man is found dead on the M'Boi Mirim road; the police attribute it to rival gangs and cite his long criminal record."@en,
        "Um relato em tom de notícia: um homem mulato é encontrado morto na estrada do M'Boi Mirim; a polícia atribui a morte a quadrilhas rivais e destaca seus antecedentes criminais."@pt-BR .

ex:homem-na-estrada-1993 a aro:Manifestation ;
    aro:realizesArtwork ex:homem-na-estrada ;
    aro:textValue "Recording on the album Raio X do Brasil (1993)"@en,
        "Gravação no álbum Raio X do Brasil (1993)"@pt-BR .

ex:homem-na-estrada-creation a aro:CreativeAct ;
    aro:hasContribution ex:hne-author,
        ex:hne-performer ;
    aro:producesCreation ex:homem-na-estrada,
        ex:homem-na-estrada-1993 .

ex:pattern-drug-trade-violence a aro:SituationPattern ;
    aro:hasCondition ex:c-dt ;
    aro:textValue "Lethal violence linked to the retail drug trade, with profits concentrated outside the periphery"@en,
        "Violência letal ligada ao varejo de drogas, com lucros concentrados fora da periferia"@pt-BR .

ex:pattern-hunger a aro:SituationPattern ;
    aro:hasCondition ex:c-hu ;
    aro:textValue "Child hunger and dependence on school meals"@en,
        "Fome infantil e dependência da merenda escolar"@pt-BR .

ex:pattern-lynching a aro:SituationPattern ;
    aro:hasCondition ex:c-ly ;
    aro:textValue "Lynching as popular punishment in a neighbourhood"@en,
        "Linchamento como punição popular no bairro"@pt-BR .

ex:pattern-youth-detention a aro:SituationPattern ;
    aro:hasCondition ex:c-yd ;
    aro:textValue "Institutionalization of poor youth in juvenile detention"@en,
        "Institucionalização de jovens pobres em internação de menores"@pt-BR .

ex:sit-police-lethality a aro:EmpiricalSituation .

ex:sit-reintegration a aro:EmpiricalSituation .

ex:sit-sanitation a aro:EmpiricalSituation .

