    aro:selectorExpression "chapter 10 «Contas»" ;
    aro:selectsFrom ex:vidas-secas-1938 .

ex:vs-fuga a aro:Selection ;
    aro:selectorExpression "chapter 13 «Fuga»" ;
    aro:selectsFrom ex:vidas-secas-1938 .

ex:vs-mudanca a aro:Selection ;
    aro:selectorExpression "chapter 1 «Mudança»" ;
    aro:selectsFrom ex:vidas-secas-1938 .

ex:vs-s1 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-drought-migration ;
    aro:mentionsDepictedElement ex:vs-fabiano ;
    aro:textValue "A family of rural workers walks across the drought-stricken backlands looking for somewhere to survive."@en,
        "Uma família de trabalhadores rurais atravessa o sertão castigado pela seca em busca de onde sobreviver."@pt-BR .

ex:vs-s2 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-state-violence ;
    aro:mentionsDepictedElement ex:vs-fabiano,
        ex:vs-soldier ;
    aro:textValue "In town, a soldier provokes Fabiano, who is arrested, beaten and spends the night in jail without having committed a crime."@en,
        "Na cidade, um soldado provoca Fabiano, que é preso, espancado e passa a noite na cadeia sem ter cometido crime."@pt-BR .

ex:vs-s3 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-debt-exploitation ;
    aro:mentionsDepictedElement ex:vs-fabiano ;
    aro:textValue "The landowner's accounts, with interest Fabiano cannot check, leave him always in debt."@en,
        "As contas do patrão, com juros que Fabiano não consegue conferir, o deixam sempre endividado."@pt-BR .

ex:vs-s4 a aro:IntentionalStateDescription ;
    aro:generalizesAs ex:pattern-drought-migration ;
    aro:mentionsDepictedElement ex:vs-fabiano ;
    aro:textValue "With a new drought, the family leaves again, hoping for a better life in the cities of the south."@en,
        "Com uma nova seca, a família parte de novo, esperando uma vida melhor nas cidades do sul."@pt-BR .

ex:vs-soldier a aro:DepictedAgent ;
    aro:textValue "the yellow soldier"@en,
        "o soldado amarelo"@pt-BR .

ex:vsf-director a aro:CreativeContribution ;
    aro:contributionBy dbr:Nelson_Pereira_dos_Santos ;
    aro:contributionRole aro:AdapterRole,
        aro:DirectorRole ;
    aro:contributionTo ex:vidas-secas-film .

ex:ev-fbsp a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-fbsp-2020 ;
    aro:externalLink "https://forumseguranca.org.br/wp-content/uploads/2021/07/4-as-mortes-decorrentes-de-intervencao-policial-no-brasil-em-2020.pdf"^^xsd:anyURI ;
    aro:textValue "The report presents national and state counts of deaths resulting from police interventions and the profile of the victims."@en,
        "O relatório apresenta contagens nacionais e estaduais de mortes decorrentes de intervenção policial e o perfil das vítimas."@pt-BR .

