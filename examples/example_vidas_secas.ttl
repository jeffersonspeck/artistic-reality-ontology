# example_vidas_secas.ttl — Vidas Secas
# Generated by scripts/split_examples.py from examples/case-studies.ttl (all works).
# Do not edit by hand: edit case-studies.ttl and run the script again.
# Lyrics and novel text are not stored; see docs/*/case-studies.md for the method.
@prefix aro: <https://w3id.org/aro/ontology#> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix ex: <https://example.org/aro-cases/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:assess-carandiru a aro:EvidenceAssessment ;
    aro:assessesClaim ex:corr-carandiru ;
    aro:assessesEvidence ex:ev-carandiru ;
    aro:assessmentOutcome "supports" ;
    aro:producedByAct ex:reading-act ;
    aro:textValue "Supports the pattern as historically documented; no work is claimed to describe this event."@en,
        "Apoia o padrão como historicamente documentado; não se alega que alguma obra descreva este evento."@pt-BR .

ex:assess-drought a aro:EvidenceAssessment ;
    aro:assessesClaim ex:corr-drought ;
    aro:assessesEvidence ex:ev-ceara-camps,
        ex:ev-patu ;
    aro:assessmentOutcome "supports" ;
    aro:producedByAct ex:reading-act ;
    aro:textValue "Supports the pattern as historically documented; no fictional family is claimed to have been in these camps."@en,
        "Apoia o padrão como historicamente documentado; não se alega que alguma família ficcional tenha estado nesses campos."@pt-BR .

ex:assess-hyp-policing a aro:EvidenceAssessment ;
    aro:assessesClaim ex:hyp-selective-policing ;
    aro:assessesEvidence ex:ev-fbsp ;
    aro:assessmentOutcome "inconclusive" ;
    aro:producedByAct ex:review-act ;
    aro:textValue "The report shows who the victims are (a correlation), not why: insufficient to infer selective policing as the cause."@en,
        "O relatório mostra quem são as vítimas (uma correlação), não por quê: insuficiente para inferir o policiamento seletivo como causa."@pt-BR .

ex:assess-police-lethality a aro:EvidenceAssessment ;
    aro:assessesClaim ex:corr-police-lethality ;
    aro:assessesEvidence ex:ev-fbsp ;
    aro:assessmentOutcome "supports" ;
    aro:producedByAct ex:reading-act ;
    aro:textValue "Supports that the pattern is real and recurrent; does not show that any work narrates a specific real event, nor any cause."@en,
        "Apoia que o padrão é real e recorrente; não mostra que alguma obra narre um evento real específico, nem causa alguma."@pt-BR .

ex:deriv-vs-film a aro:DerivationClaim ;
    aro:citesSource ex:src-barren-lives-wiki ;
    aro:derivationRealizedBy ex:vidas-secas-film-production ;
    aro:hasDerivationType aro:IntermedialAdaptation ;
    aro:hasDerivedAnchor ex:vidas-secas-film ;
    aro:hasRegime aro:SeriousRegime ;
    aro:hasSourceAnchor ex:vidas-secas ;
    aro:hasTransformation ex:deriv-vs-medium,
        ex:deriv-vs-situation ;
    aro:producedByAct ex:reading-act .

ex:vidas-secas-creation a aro:CreativeAct ;
    aro:hasContribution ex:vs-author ;
    aro:producesCreation ex:vidas-secas,
        ex:vidas-secas-1938 ;
    aro:startDate "1938"^^xsd:gYear .

ex:vs-r1 a aro:InterpretationRecord ;
    aro:confidenceScore 0.95 ;
    aro:describesSituation ex:vs-s1 ;
    aro:hasPrimarySelection ex:vs-mudanca ;
    aro:producedByAct ex:reading-act .

