ex:pattern-drought-migration a aro:SituationPattern ;
    aro:hasCondition ex:c-dm ;
    aro:textValue "Drought-driven forced migration of rural families"@en,
        "Migração forçada de famílias rurais causada pela seca"@pt-BR .

ex:vidas-secas a aro:Artwork ;
    aro:externalLink "https://pt.wikipedia.org/wiki/Vidas_Secas"^^xsd:anyURI ;
    aro:textValue "Vidas Secas (Barren Lives)"@en,
        "Vidas Secas"@pt-BR .

ex:vs-fabiano a aro:DepictedAgent ;
    aro:textValue "Fabiano"@en,
        "Fabiano"@pt-BR .

ex:pattern-state-violence a aro:SituationPattern ;
    aro:hasCondition ex:c-sv-agent,
        ex:c-sv-framing,
        ex:c-sv-lethal,
        ex:c-sv-victim ;
    aro:textValue "Arbitrary or lethal violence by state security agents against a poor man"@en,
        "Violência arbitrária ou letal de agentes de segurança do Estado contra um homem pobre"@pt-BR .

