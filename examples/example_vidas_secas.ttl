    aro:hasContribution ex:vsf-director ;
    aro:producesCreation ex:vidas-secas-film ;
    aro:startDate "1963"^^xsd:gYear .

ex:vidas-secas-first-edition a aro:Manifestation ;
    aro:embodiesExpression ex:vidas-secas-1938 ;
    aro:textValue "First edition of the novel (1938)"@en,
        "Primeira edição do romance (1938)"@pt-BR .

ex:vs-author a aro:CreativeContribution ;
    aro:contributionBy dbr:Graciliano_Ramos ;
