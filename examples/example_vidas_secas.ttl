    aro:languageTag "pt-BR" ;
    aro:sourceURL "https://pt.wikipedia.org/wiki/Massacre_do_Carandiru"^^xsd:anyURI ;
    aro:textValue "Massacre do Carandiru (encyclopedic article)"@en .

