    aro:confidenceScore 0.95 ;
    aro:describesSituation ex:vs-s2 ;
    aro:hasPrimarySelection ex:vs-cadeia ;
    aro:producedByAct ex:reading-act .

ex:vs-r3 a aro:InterpretationRecord ;
    aro:confidenceScore 0.9 ;
    aro:describesSituation ex:vs-s3 ;
    aro:hasPrimarySelection ex:vs-contas ;
    aro:producedByAct ex:reading-act .

ex:vs-r4 a aro:InterpretationRecord ;
    aro:confidenceScore 0.95 ;
    aro:describesSituation ex:vs-s4 ;
    aro:hasPrimarySelection ex:vs-fuga ;
    aro:producedByAct ex:reading-act .

dbr:Graciliano_Ramos a schema:Person,
        aro:Person ;
    schema:name "Graciliano Ramos" .

dbr:Nelson_Pereira_dos_Santos a schema:Person,
        aro:Person ;
    schema:name "Nelson Pereira dos Santos" .

ex:analyst a schema:Person,
        aro:Person ;
    schema:name "Example analyst" .

ex:c-de a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The worker's earnings are controlled by the employer's accounts and debts."@en,
        "Os ganhos do trabalhador são controlados pelas contas e dívidas do empregador."@pt-BR .

ex:c-dm a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A family leaves its place of living because drought makes survival impossible."@en,
        "Uma família deixa seu lugar porque a seca torna a sobrevivência impossível."@pt-BR .

ex:c-sv-agent a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The aggressor acts as an agent of state security (police, soldier)."@en,
        "O agressor age como agente de segurança do Estado (polícia, soldado)."@pt-BR .

ex:c-sv-framing a aro:PatternCondition ;
    aro:isRequiredCondition false ;
    aro:textValue "The victim is framed as an offender."@en,
        "A vítima é retratada como infratora."@pt-BR .

ex:c-sv-lethal a aro:PatternCondition ;
    aro:isRequiredCondition false ;
    aro:textValue "The violence is lethal."@en,
        "A violência é letal."@pt-BR .

ex:c-sv-victim a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The victim is poor or socially marginalized."@en,
        "A vítima é pobre ou socialmente marginalizada."@pt-BR .

ex:case-carandiru a aro:EmpiricalCase ;
    aro:caseAboutEvent ex:event-carandiru ;
    aro:citesSource ex:src-carandiru ;
    aro:textValue "Carandiru massacre, São Paulo, 2 October 1992"@en,
        "Massacre do Carandiru, São Paulo, 2 de outubro de 1992"@pt-BR .

ex:case-ceara-1932 a aro:EmpiricalCase ;
    aro:caseAboutEvent ex:event-ceara-1932 ;
    aro:citesSource ex:src-fapesp-seca,
        ex:src-patu ;
    aro:textValue "Concentration camps for drought refugees in Ceará, 1932"@en,
        "Campos de concentração para retirantes da seca no Ceará, 1932"@pt-BR .

ex:case-police-lethality a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-police-lethality ;
    aro:citesSource ex:src-fbsp-2020 ;
    aro:textValue "Deaths resulting from police interventions in Brazil (national statistics)"@en,
        "Mortes decorrentes de intervenção policial no Brasil (estatísticas nacionais)"@pt-BR .

ex:corr-carandiru a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-carandiru ;
    aro:assertsPattern ex:pattern-state-violence ;
    aro:citesSource ex:src-carandiru ;
    aro:producedByAct ex:reading-act ;
    aro:textValue "A documented, large-scale instance of the pattern: lethal violence by state security agents against marginalized men (São Paulo, 1992)."@en,
        "Instância documentada e de grande escala do padrão: violência letal de agentes de segurança do Estado contra homens marginalizados (São Paulo, 1992)."@pt-BR .

ex:corr-drought a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-ceara-1932 ;
    aro:assertsPattern ex:pattern-drought-migration ;
    aro:citesSource ex:src-fapesp-seca ;
    aro:producedByAct ex:reading-act ;
    aro:textValue "The forced migration of the pattern corresponds to documented drought migrations (Ceará, 1932)."@en,
        "A migração forçada do padrão corresponde a migrações documentadas por seca (Ceará, 1932)."@pt-BR .

ex:corr-police-lethality a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-police-lethality ;
    aro:assertsPattern ex:pattern-state-violence ;
    aro:citesSource ex:src-fbsp-2020 ;
    aro:producedByAct ex:reading-act ;
    aro:textValue "The pattern is similar to documented, recurrent police lethality in Brazil."@en,
        "O padrão é semelhante à letalidade policial documentada e recorrente no Brasil."@pt-BR .

ex:deriv-vs-medium a aro:TransformationAspect ;
    aro:hasDimension aro:MediumDimension ;
    aro:hasOperation aro:Modified .

ex:deriv-vs-situation a aro:TransformationAspect ;
    aro:aspectConcernsPattern ex:pattern-drought-migration,
        ex:pattern-state-violence ;
    aro:confidenceScore 0.7 ;
    aro:hasDimension aro:SituationDimension ;
    aro:hasOperation aro:Retained .

ex:ev-carandiru a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-carandiru ;
    aro:textValue "Military Police intervention in the Carandiru prison that left 111 prisoners dead."@en,
        "Intervenção da Polícia Militar no presídio do Carandiru que deixou 111 presos mortos."@pt-BR .

ex:ev-ceara-camps a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-fapesp-seca ;
    aro:textValue "During the 1932 drought the Ceará government set up camps along the railways to keep migrants from reaching Fortaleza."@en,
        "Durante a seca de 1932 o governo do Ceará instalou campos junto às ferrovias para impedir que os retirantes chegassem a Fortaleza."@pt-BR .

ex:ev-patu a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-patu ;
    aro:externalLink "https://diariodonordeste.verdesmares.com.br/ceara/campo-de-concentracao-que-abrigou-16-mil-retirantes-no-ceara-deve-ter-predios-e-ruinas-tombados-1.3258221"^^xsd:anyURI ;
    aro:textValue "The Patu camp in Senador Pompeu, whose remains are being preserved as heritage."@en,
        "O campo do Patu, em Senador Pompeu, cujas ruínas estão sendo tombadas como patrimônio."@pt-BR .

ex:event-carandiru a aro:EmpiricalEvent .

ex:event-ceara-1932 a aro:EmpiricalEvent .

ex:hyp-selective-policing a aro:ExplanationHypothesis ;
    aro:explainsPattern ex:pattern-state-violence ;
    aro:producedByAct ex:reading-act ;
    aro:textValue "Hypothesis: selective policing of poor and Black populations increases their exposure to state violence."@en,
        "Hipótese: o policiamento seletivo de populações pobres e negras aumenta sua exposição à violência do Estado."@pt-BR .

ex:pattern-debt-exploitation a aro:SituationPattern ;
    aro:hasCondition ex:c-de ;
    aro:textValue "Exploitation of rural workers through debt and opaque accounts"@en,
        "Exploração de trabalhadores rurais por dívidas e contas opacas"@pt-BR .

ex:review-act a aro:InterpretiveAct ;
    aro:hasParticipant ex:reviewer ;
    aro:startDate "2026-11"^^xsd:gYearMonth .

ex:reviewer a schema:Person,
        aro:Person ;
    schema:name "Example reviewer" .

ex:sit-police-lethality a aro:EmpiricalSituation .

ex:src-barren-lives-wiki a aro:ReferenceSource ;
    aro:languageTag "en" ;
    aro:sourceURL "https://en.wikipedia.org/wiki/Barren_Lives_(film)"^^xsd:anyURI ;
    aro:textValue "Barren Lives (film) — encyclopedic article on the 1963 adaptation"@en .

