hnr:criacao1993 a aro:CreativeAct ;
    aro:startDate "1993"^^xsd:gYear ;
    aro:endDate "1993-12-21"^^xsd:date ;
    aro:hasContribution hnr:contribuicaoAutoria, hnr:contribuicaoInterpretacao, hnc:contribuicaoVozManoBrown,
        hnc:contribuicaoVozEdiRock, hnc:contribuicaoVozWander, hnc:contribuicaoKLJay,
        hnc:contribuicaoProducaoNewtonCarneiro, hnc:contribuicaoProducaoVanderCarneiro, hnc:contribuicaoProducaoRacionais ;
    aro:producesCreation hnr:homemNaEstrada, hnr:gravacao1993, hnr:letra, hnr:albumRaioXDoBrasil ;
    aro:textValue "Composição e gravação de Homem na Estrada, lançada no álbum Raio X Brasil em 21 de dezembro de 1993"@pt-BR, "Composition and recording of Homem na Estrada, released on the album Raio X Brasil on 21 December 1993"@en .

hnr:contribuicaoAutoria a aro:CreativeContribution ;
    aro:contributionBy dbr:Mano_Brown ;
    aro:contributionRole aro:AuthorRole, aro:LyricistRole, aro:ComposerRole ;
    aro:contributionTo hnr:homemNaEstrada, hnr:letra .

hnr:contribuicaoInterpretacao a aro:CreativeContribution ;
    aro:contributionBy <http://dbpedia.org/resource/Racionais_MC's> ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .

# voz principal
hnc:contribuicaoVozManoBrown a aro:CreativeContribution ;
    aro:contributionBy dbr:Mano_Brown ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .

# vozes adicionais
hnc:contribuicaoVozEdiRock a aro:CreativeContribution ;
    aro:contributionBy hnc:ediRock ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .

hnc:contribuicaoVozWander a aro:CreativeContribution ;
    aro:contributionBy hnc:wander ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .


# sampler (inclusive o de Ela Partiu), efeitos sonoros e programação da bateria
hnc:contribuicaoKLJay a aro:CreativeContribution ;
    aro:contributionBy hnc:klJay ;
    aro:contributionRole aro:PerformerRole, aro:ArrangerRole ;
    aro:contributionTo hnr:gravacao1993 .

# produção do álbum Raio X Brasil
hnc:contribuicaoProducaoNewtonCarneiro a aro:CreativeContribution ;
