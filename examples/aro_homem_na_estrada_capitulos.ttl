    aro:contributionBy dbr:Mano_Brown ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .

# vozes adicionais
hnc:contribuicaoVozEdiRock a aro:CreativeContribution ;
    aro:contributionBy hnc:ediRock ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .

hnc:contribuicaoVozWander a aro:CreativeContribution ;
    aro:contributionBy hnc:wander ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .


# sampler (inclusive o de Ela Partiu), efeitos sonoros e programação da bateria
hnc:contribuicaoKLJay a aro:CreativeContribution ;
