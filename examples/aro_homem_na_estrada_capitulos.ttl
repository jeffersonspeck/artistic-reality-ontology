# aro_homem_na_estrada_capitulos.ttl — ARO 1.0.0
# Homem na Estrada (Racionais MC's, 1993): anotação por capítulos.
#
# A narrativa é dividida em oito capítulos, cada um com um recorte maior e recortes
# menores dentro dele, seguindo a análise do pesquisador (situação, análise e eixo de
# pesquisa). Os recortes são coordenadas de linha (RFC 5147) na transcrição da letra
# publicada pelo LyricFind; nenhum verso é reproduzido aqui. A letra fica fora do
# repositório (private/).
#
# Cada situação é generalizada num padrão, e cada padrão é confrontado com fontes
# externas: fonte → evidência → afirmação empírica e caso → correspondência →
# avaliação. A avaliação registra também as dimensões do caso real que a letra não
# representa. Obra, expressões, agentes e as fontes já usadas na anotação de
# 2026-11-05 reaproveitam os IRIs de aro_homem_na_estrada_realidade_social.ttl.

@prefix aro: <https://w3id.org/aro/ontology#> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hnc: <https://example.org/aro-homem-na-estrada-capitulos/> .
@prefix hnr: <https://example.org/aro-homem-na-estrada-realidade/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Metadados
# -----------------------------------------------------------------------------

hnc:anotacao a schema:Dataset ;
    dcterms:title "Homem na Estrada — anotação por capítulos"@pt-BR, "Homem na Estrada — annotation by chapters"@en ;
    dcterms:created "2026-11-19"^^xsd:date ;
    dcterms:conformsTo <https://w3id.org/aro/ontology/1.0.0> ;
    dcterms:creator hnr:analistaPesquisador ;
    dcterms:source <https://lyrics.lyricfind.com/lyrics/racionais-mcs-homem-na-estrada> ;
    dcterms:description "Anotação em oito capítulos, com um recorte maior por capítulo e recortes menores dentro dele. Cada situação narrada é generalizada num padrão social, e cada padrão é confrontado com fontes externas que mostram que esse tipo de situação existe no Brasil. As avaliações indicam o alcance de cada correspondência e as dimensões do caso real que a letra não representa."@pt-BR, "Annotation in eight chapters, with one larger passage per chapter and smaller passages inside it. Each narrated situation is generalised as a social pattern, and each pattern is confronted with external sources showing that this kind of situation exists in Brazil. The assessments state the scope of each correspondence and the dimensions of the real case that the lyric does not represent."@en .

# -----------------------------------------------------------------------------
# Agentes
# -----------------------------------------------------------------------------

hnr:analistaPesquisador a schema:Person, aro:Person, aro:PersonAnalyst ;
    schema:name "Jefferson Rodrigo Speck" ;
    schema:affiliation "Programa de Pós-Graduação em Informática (PPGInf), Universidade Federal do Paraná (UFPR)"@pt-BR, "Graduate Program in Informatics (PPGInf), Federal University of Paraná (UFPR)"@en .

dbr:Mano_Brown a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "Pedro Paulo Soares Pereira" ;
    schema:alternateName "Mano Brown" .

<http://dbpedia.org/resource/Racionais_MC's> a schema:MusicGroup, aro:Collective, aro:CollectiveCreator ;
    schema:name "Racionais MC's" ;
    schema:member dbr:Mano_Brown, hnc:iceBlue, hnc:ediRock, hnc:klJay .

hnc:iceBlue a schema:Person, aro:Person ;
    schema:name "Ice Blue" ;
    schema:description "vocalista dos Racionais MC's"@pt-BR, "vocalist of Racionais MC's"@en .

hnc:ediRock a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "Edi Rock" ;
    schema:description "vocalista dos Racionais MC's; vozes adicionais em Homem na Estrada"@pt-BR, "vocalist of Racionais MC's; extra vocals on Homem na Estrada"@en .

hnc:klJay a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "KL Jay" ;
    schema:description "DJ dos Racionais MC's; sampler, efeitos e programação de bateria em Homem na Estrada"@pt-BR, "DJ of Racionais MC's; sampler, effects and drum programming on Homem na Estrada"@en .

hnc:wander a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "Wander" ;
    schema:description "vozes adicionais em Homem na Estrada"@pt-BR, "extra vocals on Homem na Estrada"@en .

hnc:newtonCarneiro a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "Newton Carneiro" ;
    schema:description "produtor e tecladista do álbum Raio X Brasil"@pt-BR, "producer and keyboard player of the album Raio X Brasil"@en .

hnc:vanderCarneiro a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "Vander Carneiro" ;
    schema:description "produtor e baixista do álbum Raio X Brasil"@pt-BR, "producer and bass player of the album Raio X Brasil"@en .

dbr:Tim_Maia a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "Tim Maia" ;
    schema:description "cantor e compositor; intérprete e coautor de Ela Partiu"@pt-BR, "singer and songwriter; performer and co-author of Ela Partiu"@en .

hnc:betoCajueiro a schema:Person, aro:Person, aro:PersonCreator ;
    schema:name "Beto Cajueiro" ;
    schema:description "coautor de Ela Partiu"@pt-BR, "co-author of Ela Partiu"@en .

# -----------------------------------------------------------------------------
# Obra, expressões e manifestações (IFLA LRM)
# -----------------------------------------------------------------------------

hnr:homemNaEstrada a aro:Artwork ;
    aro:externalLink "https://en.wikipedia.org/wiki/Raio-X_do_Brasil"^^xsd:anyURI ;
    aro:textValue "Homem na Estrada — Racionais MC's"@pt-BR, "Homem na Estrada — Racionais MC's"@en .

hnr:gravacao1993 a aro:Expression ;
    aro:realizesArtwork hnr:homemNaEstrada ;
    aro:hasManifestation hnr:albumRaioXDoBrasil ;
    aro:textValue "Gravação de 1993 dos Racionais MC's"@pt-BR, "1993 recording by Racionais MC's"@en .

hnr:letra a aro:Expression ;
    aro:realizesArtwork hnr:homemNaEstrada ;
    aro:hasManifestation hnr:transcricaoLyricFind ;
    aro:textValue "Texto da letra de Homem na Estrada (compositor: Pedro Paulo Soares Pereira)"@pt-BR, "Text of the lyric of Homem na Estrada (composer: Pedro Paulo Soares Pereira)"@en .

hnr:albumRaioXDoBrasil a aro:Manifestation ;
    aro:embodiesExpression hnr:gravacao1993 ;
    aro:externalLink "https://en.wikipedia.org/wiki/Raio-X_do_Brasil"^^xsd:anyURI ;
    aro:issuedDate "1993-12-21"^^xsd:date ;
    dcterms:publisher "Zimbabwe Records" ;
    aro:textValue "Álbum Raio X do Brasil (1993), lançado pela Zimbabwe Records; Homem na Estrada abre o lado B"@pt-BR, "The album Raio X do Brasil (1993), released by Zimbabwe Records; Homem na Estrada opens side B"@en .

# A letra usada na análise vem desta transcrição; a numeração de linhas dos recortes é a dela.
hnr:transcricaoLyricFind a aro:Manifestation ;
    aro:embodiesExpression hnr:letra ;
    aro:externalLink "https://lyrics.lyricfind.com/lyrics/racionais-mcs-homem-na-estrada"^^xsd:anyURI ;
    aro:retrievedAt "2026-11-19T00:00:00"^^xsd:dateTime ;
    aro:textValue "Transcrição da letra publicada pelo LyricFind, de onde vem a letra analisada; os recortes indicam linhas desta transcrição"@pt-BR, "Transcription of the lyric published by LyricFind, the source of the lyric analysed; the passages point to lines of this transcription"@en .

# -----------------------------------------------------------------------------
# Criação de Homem na Estrada: autoria, vozes, DJ e produção do álbum
# (créditos: verbetes da Wikipédia sobre a canção e sobre o álbum Raio X Brasil)
