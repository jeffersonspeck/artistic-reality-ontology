hnc:situacao1-06 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pSocioeducacao ;
    aro:mentionsDepictedElement hnr:protagonista, hnr:febem ;
    aro:textValue "A internação na FEBEM durante a adolescência deixou lembranças de sofrimento."@pt-BR, "Being held in the FEBEM as an adolescent left memories of suffering."@en .

hnc:justificativa1-06 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A instituição é nomeada; a leitura a toma como memória de privação, sem aplicar ao passado as categorias jurídicas do sistema socioeducativo atual."@pt-BR, "The institution is named; the reading takes it as a memory of deprivation, without applying to the past the legal categories of the current juvenile justice system."@en .

