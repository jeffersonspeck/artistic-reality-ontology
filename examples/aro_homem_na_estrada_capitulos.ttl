hnc:situacao1-07 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pEconomiaIlicita ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Ganhar dinheiro e enriquecer aparece como aspiração central do homem."@pt-BR, "Making money and getting rich appear as the man's central aspiration."@en .

hnc:justificativa1-07 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A aspiração não é ilícita em si; a narrativa mostra que, com poucas oportunidades, ela pode se ligar a atividades ilícitas."@pt-BR, "The aspiration is not unlawful in itself; the narrative shows that, with few opportunities, it can become tied to unlawful activities."@en .

