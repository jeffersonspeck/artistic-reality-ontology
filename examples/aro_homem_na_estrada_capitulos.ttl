    aro:contributionRole aro:ProducerRole ;
    aro:contributionTo hnr:gravacao1993, hnr:albumRaioXDoBrasil .

hnc:contribuicaoProducaoVanderCarneiro a aro:CreativeContribution ;
    aro:contributionBy hnc:vanderCarneiro ;
    aro:contributionRole aro:ProducerRole ;
    aro:contributionTo hnr:gravacao1993, hnr:albumRaioXDoBrasil .

hnc:contribuicaoProducaoRacionais a aro:CreativeContribution ;
    aro:contributionBy <http://dbpedia.org/resource/Racionais_MC's> ;
    aro:contributionRole aro:ProducerRole ;
    aro:contributionTo hnr:gravacao1993, hnr:albumRaioXDoBrasil .


# -----------------------------------------------------------------------------
# Ela Partiu (Tim Maia), fonte do sample
# (créditos: verbete da Wikipédia sobre a canção)
# -----------------------------------------------------------------------------

hnr:elaPartiu a aro:Artwork ;
    aro:externalLink "https://pt.wikipedia.org/wiki/Ela_Partiu"^^xsd:anyURI ;
    aro:textValue "Ela Partiu — Tim Maia"@pt-BR, "Ela Partiu — Tim Maia"@en .

hnc:gravacaoElaPartiu a aro:Expression ;
    aro:realizesArtwork hnr:elaPartiu ;
    aro:hasManifestation hnc:compactoElaPartiu ;
    aro:textValue "Gravação de Ela Partiu na voz de Tim Maia (1976)"@pt-BR, "Recording of Ela Partiu sung by Tim Maia (1976)"@en .

hnc:compactoElaPartiu a aro:Manifestation ;
    aro:embodiesExpression hnc:gravacaoElaPartiu ;
    dcterms:issued "1976"^^xsd:gYear ;
    aro:textValue "Compacto de 1976 (Seroma, ligada à Vitória Régia Discos), com Meus Inimigos no lado B"@pt-BR, "1976 single (Seroma, linked to Vitória Régia Discos), with Meus Inimigos on the B-side"@en .

hnc:criacaoElaPartiu a aro:CreativeAct ;
    aro:startDate "1976"^^xsd:gYear ;
    aro:hasContribution hnc:contribuicaoComposicaoTimMaia, hnc:contribuicaoComposicaoBetoCajueiro, hnc:contribuicaoVozTimMaia ;
    aro:producesCreation hnr:elaPartiu, hnc:gravacaoElaPartiu, hnc:compactoElaPartiu ;
    aro:textValue "Composição e gravação de Ela Partiu, lançada em compacto em 1976"@pt-BR, "Composition and recording of Ela Partiu, released as a single in 1976"@en .

hnc:contribuicaoComposicaoTimMaia a aro:CreativeContribution ;
    aro:contributionBy dbr:Tim_Maia ;
    aro:contributionRole aro:ComposerRole, aro:AuthorRole ;
    aro:contributionTo hnr:elaPartiu .

hnc:contribuicaoComposicaoBetoCajueiro a aro:CreativeContribution ;
    aro:contributionBy hnc:betoCajueiro ;
    aro:contributionRole aro:ComposerRole, aro:AuthorRole ;
    aro:contributionTo hnr:elaPartiu .


hnc:contribuicaoVozTimMaia a aro:CreativeContribution ;
    aro:contributionBy dbr:Tim_Maia ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnc:gravacaoElaPartiu .

# -----------------------------------------------------------------------------
# Derivação: duas ligações entre Homem na Estrada e Ela Partiu
# 1. entre as gravações: o som da gravação de Tim Maia é sampleado na de 1993;
# 2. entre as obras: Homem na Estrada incorpora material de Ela Partiu.
# -----------------------------------------------------------------------------

hnc:derivacaoSampleElaPartiu a aro:DerivationClaim ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasSourceAnchor hnc:gravacaoElaPartiu ;
    aro:hasDerivedAnchor hnr:gravacao1993 ;
    aro:hasDerivationType aro:Sampling ;
    aro:hasRegime aro:SeriousRegime ;
    aro:hasTransformation hnc:aspectoBaseElaPartiu, hnc:aspectoVozTimMaia ;
    aro:derivationRealizedBy hnr:criacao1993 ;
    aro:hasJustification hnc:justificativaSampleElaPartiu ;
    aro:citesSource hnr:fonteRaioXWiki, hnc:fonteWikiHomemNaEstrada, hnc:fonteWikiElaPartiu ;
    aro:derivationExtent "base musical da faixa e voz de Tim Maia no refrão"@pt-BR, "the track's backing music and Tim Maia's voice in the chorus"@en ;
    aro:textValue "A gravação de Homem na Estrada (1993) sampleia a gravação de Ela Partiu feita por Tim Maia: a base musical e, no refrão, a voz dele."@pt-BR, "The recording of Homem na Estrada (1993) samples Tim Maia's recording of Ela Partiu: the backing track and, in the chorus, his voice."@en .

hnc:aspectoBaseElaPartiu a aro:TransformationAspect ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasDimension aro:RecordedSoundDimension ;
    aro:hasOperation aro:Recontextualized ;
    aro:textValue "O som de uma canção romântica de soul passa a acompanhar a história de um egresso da prisão ameaçado de morte."@pt-BR, "The sound of a romantic soul song comes to accompany the story of a former prisoner threatened with death."@en .

hnc:aspectoVozTimMaia a aro:TransformationAspect ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasDimension aro:VocalDeliveryDimension ;
    aro:hasOperation aro:Retained ;
    aro:textValue "A voz de Tim Maia é mantida no refrão da faixa de 1993."@pt-BR, "Tim Maia's voice is kept in the chorus of the 1993 track."@en .

hnc:derivacaoObraElaPartiu a aro:DerivationClaim ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasSourceAnchor hnr:elaPartiu ;
    aro:hasDerivedAnchor hnr:homemNaEstrada ;
    aro:hasDerivationType aro:Sampling ;
    aro:hasRegime aro:SeriousRegime ;
    aro:derivationRealizedBy hnr:criacao1993 ;
    aro:hasJustification hnc:justificativaSampleElaPartiu ;
    aro:citesSource hnc:fonteWikiHomemNaEstrada, hnc:fonteWikiElaPartiu ;
    aro:textValue "No nível das obras, Homem na Estrada, de Mano Brown, incorpora por sample material de Ela Partiu, de Tim Maia e Beto Cajueiro."@pt-BR, "At the level of works, Homem na Estrada, by Mano Brown, incorporates by sampling material from Ela Partiu, by Tim Maia and Beto Cajueiro."@en .

hnc:justificativaSampleElaPartiu a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:citesSource hnr:fonteRaioXWiki, hnc:fonteWikiRaioXBrasil, hnc:fonteWikiHomemNaEstrada, hnc:fonteWikiElaPartiu ;
    aro:textValue "Os créditos e o sample vêm dos verbetes sobre o álbum, sobre Homem na Estrada (base musical com Ela Partiu, refrão com a voz de Tim Maia) e sobre Ela Partiu (lista Homem na Estrada entre as gravações que a samplearam). A leitura de que o sentido do som muda com o novo contexto é interpretativa; a anotação não avalia autorização nem licenciamento do sample."@pt-BR, "The credits and the sample come from the entries on the album, on Homem na Estrada (backing track with Ela Partiu, chorus with Tim Maia's voice) and on Ela Partiu (which lists Homem na Estrada among the recordings that sampled it). The reading that the meaning of the sound changes with the new context is interpretive; the annotation does not assess authorisation or licensing of the sample."@en .

# -----------------------------------------------------------------------------
# Atos interpretativos
# -----------------------------------------------------------------------------

hnc:atoLeitura a aro:InterpretiveAct ;
    aro:hasParticipant hnr:analistaPesquisador ;
    aro:startDate "2026-11-19"^^xsd:date ;
    aro:textValue "Divisão da letra em capítulos e situações, registro das interpretações, das situações e dos padrões"@pt-BR, "Division of the lyric into chapters and situations, and recording of the interpretations, situations and patterns"@en .

hnc:atoAvaliacao a aro:InterpretiveAct ;
    aro:hasParticipant hnr:analistaPesquisador ;
    aro:startDate "2026-11-19"^^xsd:date ;
    aro:textValue "Levantamento de fontes, formulação das afirmações empíricas e das correspondências, avaliação das evidências e revisão crítica"@pt-BR, "Search for sources, wording of the empirical claims and correspondences, assessment of the evidence and critical review"@en .

