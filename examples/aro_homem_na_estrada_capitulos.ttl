    aro:producedByAct hnc:atoLeitura ;
    aro:groupsSelection hnc:cap5, hnc:rec5-01, hnc:rec5-02, hnc:rec5-03, hnc:rec5-04, hnc:rec5-05, hnc:rec5-06, hnc:rec5-07, hnc:rec5-08, hnc:rec5-09 ;
    aro:textValue "Capítulo 5: O tráfico, o dinheiro e a exploração da violência"@pt-BR, "Chapter 5: Drug trafficking, money and the exploitation of violence"@en .

hnc:interpretacaoCap5 a aro:InterpretationRecord ;
    aro:hasPrimarySelection hnc:cap5 ;
    aro:hasSupportingSelection hnc:rec5-01, hnc:rec5-02, hnc:rec5-03, hnc:rec5-04, hnc:rec5-05, hnc:rec5-06, hnc:rec5-07, hnc:rec5-08, hnc:rec5-09 ;
