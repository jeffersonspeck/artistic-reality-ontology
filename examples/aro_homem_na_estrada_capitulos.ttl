    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pSuspeicao ;
    aro:mentionsDepictedElement hnc:moradores, hnc:favela ;
    aro:textValue "Depois de assaltos na região, a suspeita recai de imediato sobre os moradores da favela."@pt-BR, "After robberies in the area, suspicion falls at once on the residents of the favela."@en .

hnc:justificativa6-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "Morar no território passa a funcionar como indício informal de crime."@pt-BR, "Living in the territory comes to work as an informal sign of crime."@en .

