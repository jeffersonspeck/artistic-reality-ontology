    aro:hasJustification hnc:justificativa7-02 ;
    aro:supportsInterpretation hnc:interpretacaoCap7 ;
    aro:confidenceScore 0.90 .

hnc:situacao7-02 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pViolenciaPolicial ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Sem confiar na proteção institucional, ele decide garantir a própria segurança."@pt-BR, "Not trusting institutional protection, he decides to ensure his own safety."@en .

hnc:justificativa7-02 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A decisão mostra a falta de mecanismos confiáveis de proteção; a autodefesa armada também pode aumentar a violência."@pt-BR, "The decision shows the lack of reliable means of protection; armed self-defence can also increase violence."@en .

