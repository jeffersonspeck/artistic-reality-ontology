hnc:situacao1-08 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pEconomiaIlicita ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Outros homens morreram tentando alcançar o mesmo objetivo de enriquecer."@pt-BR, "Other men died trying to reach the same goal of getting rich."@en .

hnc:justificativa1-08 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A linha contrapõe a promessa de ganho ao risco de morte presente em certas trajetórias ligadas ao crime."@pt-BR, "The line sets the promise of gain against the risk of death present in certain paths linked to crime."@en .

