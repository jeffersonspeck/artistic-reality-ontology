# -----------------------------------------------------------------------------
# Capítulo 1. A liberdade, o passado e a promessa de mudança (linhas 1–16)
# -----------------------------------------------------------------------------

hnc:cap1 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linhas 1–16: capítulo 1, a liberdade, o passado e a promessa de mudança" ;
    aro:textValue "linhas 1–16: capítulo 1, a liberdade, o passado e a promessa de mudança"@pt-BR, "lines 1–16: chapter 1, freedom, the past and the promise of change"@en ;
    aro:hasSelector hnc:cap1-sel .
hnc:cap1-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=0,16" .

hnc:unidadeCap1 a aro:AnalysisUnit ;
    aro:producedByAct hnc:atoLeitura ;
    aro:groupsSelection hnc:cap1, hnc:rec1-01, hnc:rec1-02, hnc:rec1-03, hnc:rec1-04, hnc:rec1-05, hnc:rec1-06, hnc:rec1-07, hnc:rec1-08, hnc:rec1-09, hnc:rec1-10 ;
    aro:textValue "Capítulo 1: A liberdade, o passado e a promessa de mudança"@pt-BR, "Chapter 1: Freedom, the past and the promise of change"@en .

hnc:interpretacaoCap1 a aro:InterpretationRecord ;
    aro:hasPrimarySelection hnc:cap1 ;
    aro:hasSupportingSelection hnc:rec1-01, hnc:rec1-02, hnc:rec1-03, hnc:rec1-04, hnc:rec1-05, hnc:rec1-06, hnc:rec1-07, hnc:rec1-08, hnc:rec1-09, hnc:rec1-10 ;
    aro:producedByAct hnc:atoLeitura ;
    aro:describesSituation hnc:situacaoCap1 ;
    aro:hasJustification hnc:justificativaCap1 ;
    aro:confidenceScore 0.9 .

hnc:situacaoCap1 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "O capítulo apresenta a saída da prisão como promessa de recomeço e, em seguida, reúne o que pesa sobre ela: a infância difícil, a FEBEM, a busca por dinheiro, as mortes de quem tentou o mesmo caminho e a pobreza que já alcança os filhos."@pt-BR, "The chapter presents leaving prison as a promise of a fresh start and then gathers what weighs on it: the hard childhood, the FEBEM, the search for money, the deaths of those who tried the same path and the poverty that already reaches the children."@en .

hnc:justificativaCap1 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A ordem das linhas vai do desejo de mudança às condições que o limitam; a leitura acompanha essa ordem e trata cada condição como um problema distinto."@pt-BR, "The order of the lines goes from the wish to change to the conditions that limit it; the reading follows that order and treats each condition as a distinct problem."@en .

hnc:rec1-01 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linhas 1–2: recomeçar a vida" ;
    aro:textValue "linhas 1–2: recomeçar a vida"@pt-BR, "lines 1–2: starting life again"@en ;
    aro:hasSelector hnc:rec1-01-sel .
hnc:rec1-01-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=0,2" .

hnc:interpretacao1-01 a aro:InterpretationRecord ;
    aro:hasPrimarySelection hnc:rec1-01 ;
    aro:producedByAct hnc:atoLeitura ;
    aro:describesSituation hnc:situacao1-01 ;
    aro:hasJustification hnc:justificativa1-01 ;
    aro:supportsInterpretation hnc:interpretacaoCap1 ;
    aro:confidenceScore 0.95 .

hnc:situacao1-01 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pReinsercao ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Ao sair da prisão, o homem deseja recomeçar e viver a liberdade de outro modo."@pt-BR, "On leaving prison, the man wishes to start again and to live his freedom in another way."@en .

hnc:justificativa1-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "O recomeço aparece como projeto declarado, não como resultado alcançado; o restante da letra põe esse projeto à prova."@pt-BR, "The fresh start appears as a stated plan, not as an achieved result; the rest of the lyric puts that plan to the test."@en .

hnc:rec1-02 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linha 3: liberdade perdida e subtraída" ;
    aro:textValue "linha 3: liberdade perdida e subtraída"@pt-BR, "line 3: freedom lost and taken away"@en ;
    aro:hasSelector hnc:rec1-02-sel .
hnc:rec1-02-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=2,3" .

hnc:interpretacao1-02 a aro:InterpretationRecord ;
    aro:hasPrimarySelection hnc:rec1-02 ;
    aro:producedByAct hnc:atoLeitura ;
    aro:describesSituation hnc:situacao1-02 ;
    aro:hasJustification hnc:justificativa1-02 ;
    aro:supportsInterpretation hnc:interpretacaoCap1 ;
    aro:confidenceScore 0.85 .

hnc:situacao1-02 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pEncarceramento ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "A liberdade é apresentada ao mesmo tempo como perdida pela trajetória no crime e como tirada por circunstâncias sociais e institucionais."@pt-BR, "Freedom is presented both as lost through his life in crime and as taken away by social and institutional circumstances."@en .

hnc:justificativa1-02 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A linha mantém juntas a responsabilidade individual e os condicionamentos sociais; a leitura não escolhe uma das duas."@pt-BR, "The line holds individual responsibility and social conditioning together; the reading does not choose between them."@en .

hnc:rec1-03 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linhas 4–5: provar a própria mudança" ;
    aro:textValue "linhas 4–5: provar a própria mudança"@pt-BR, "lines 4–5: proving his own change"@en ;
    aro:hasSelector hnc:rec1-03-sel .
hnc:rec1-03-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=3,5" .

hnc:interpretacao1-03 a aro:InterpretationRecord ;
    aro:hasPrimarySelection hnc:rec1-03 ;
    aro:producedByAct hnc:atoLeitura ;
    aro:describesSituation hnc:situacao1-03 ;
    aro:hasJustification hnc:justificativa1-03 ;
    aro:supportsInterpretation hnc:interpretacaoCap1 ;
    aro:confidenceScore 0.90 .

hnc:situacao1-03 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pReinsercao ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "O homem quer demonstrar aos outros e a si mesmo que mudou."@pt-BR, "The man wants to show others and himself that he has changed."@en .

hnc:justificativa1-03 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A mudança depende de reconhecimento: reconstruir a identidade e acreditar nela, não apenas parar de cometer crimes."@pt-BR, "Change depends on recognition: rebuilding his identity and believing in it, not only stopping committing crimes."@en .

