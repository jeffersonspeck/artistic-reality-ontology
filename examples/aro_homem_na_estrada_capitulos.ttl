hnc:situacaoCap6 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "O capítulo mostra como a suspeita chega ao protagonista: a favela é culpada pelos assaltos, o nome dele vai para uma lista num bar, seus antecedentes circulam, o passado vira marca, ele fica sozinho e a punição continua depois da pena."@pt-BR, "The chapter shows how suspicion reaches the protagonist: the favela is blamed for the robberies, his name goes on a list in a bar, his record circulates, his past becomes a mark, he is left alone and the punishment goes on after the sentence."@en .

hnc:justificativaCap6 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A sequência vai da suspeita coletiva à suspeita individual; a leitura registra cada passo como uma forma diferente de estigma."@pt-BR, "The sequence goes from collective suspicion to individual suspicion; the reading records each step as a different form of stigma."@en .

hnc:rec6-01 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linhas 103–104: criminalização coletiva da favela" ;
    aro:textValue "linhas 103–104: criminalização coletiva da favela"@pt-BR, "lines 103–104: collective criminalisation of the favela"@en ;
    aro:hasSelector hnc:rec6-01-sel .
hnc:rec6-01-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=102,104" .

