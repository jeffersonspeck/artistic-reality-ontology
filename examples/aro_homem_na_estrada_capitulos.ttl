    aro:contributionRole aro:ComposerRole, aro:AuthorRole ;
    aro:contributionTo hnr:elaPartiu .

hnc:contribuicaoComposicaoBetoCajueiro a aro:CreativeContribution ;
    aro:contributionBy hnc:betoCajueiro ;
    aro:contributionRole aro:ComposerRole, aro:AuthorRole ;
    aro:contributionTo hnr:elaPartiu .


hnc:contribuicaoVozTimMaia a aro:CreativeContribution ;
    aro:contributionBy dbr:Tim_Maia ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnc:gravacaoElaPartiu .

# -----------------------------------------------------------------------------
# Derivação: duas ligações entre Homem na Estrada e Ela Partiu
# 1. entre as gravações: o som da gravação de Tim Maia é sampleado na de 1993;
# 2. entre as obras: Homem na Estrada incorpora material de Ela Partiu.
# -----------------------------------------------------------------------------

hnc:derivacaoSampleElaPartiu a aro:DerivationClaim ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasSourceAnchor hnc:gravacaoElaPartiu ;
    aro:hasDerivedAnchor hnr:gravacao1993 ;
    aro:hasDerivationType aro:Sampling ;
    aro:hasRegime aro:SeriousRegime ;
    aro:hasTransformation hnc:aspectoBaseElaPartiu, hnc:aspectoVozTimMaia ;
    aro:derivationRealizedBy hnr:criacao1993 ;
    aro:hasJustification hnc:justificativaSampleElaPartiu ;
    aro:citesSource hnr:fonteRaioXWiki, hnc:fonteWikiHomemNaEstrada, hnc:fonteWikiElaPartiu ;
    aro:derivationExtent "base musical da faixa e voz de Tim Maia no refrão"@pt-BR ;
    aro:textValue "A gravação de Homem na Estrada (1993) sampleia a gravação de Ela Partiu feita por Tim Maia: a base musical e, no refrão, a voz dele."@pt-BR .

hnc:aspectoBaseElaPartiu a aro:TransformationAspect ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasDimension aro:RecordedSoundDimension ;
    aro:hasOperation aro:Recontextualized ;
    aro:aspectConcernsPattern hnc:pViolenciaPolicial, hnc:pReinsercao ;
    aro:textValue "O som de uma canção romântica de soul passa a acompanhar a história de um egresso da prisão ameaçado de morte."@pt-BR .

hnc:aspectoVozTimMaia a aro:TransformationAspect ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasDimension aro:VocalDeliveryDimension ;
    aro:hasOperation aro:Retained ;
    aro:textValue "A voz de Tim Maia é mantida no refrão da faixa de 1993."@pt-BR .

hnc:derivacaoObraElaPartiu a aro:DerivationClaim ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasSourceAnchor hnr:elaPartiu ;
    aro:hasDerivedAnchor hnr:homemNaEstrada ;
    aro:hasDerivationType aro:Sampling ;
    aro:hasRegime aro:SeriousRegime ;
    aro:derivationRealizedBy hnr:criacao1993 ;
    aro:hasJustification hnc:justificativaSampleElaPartiu ;
    aro:citesSource hnc:fonteWikiHomemNaEstrada, hnc:fonteWikiElaPartiu ;
    aro:textValue "No nível das obras, Homem na Estrada, de Mano Brown, incorpora por sample material de Ela Partiu, de Tim Maia e Beto Cajueiro."@pt-BR .

hnc:justificativaSampleElaPartiu a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:citesSource hnr:fonteRaioXWiki, hnc:fonteWikiRaioXBrasil, hnc:fonteWikiHomemNaEstrada, hnc:fonteWikiElaPartiu ;
    aro:textValue "Os créditos e o sample vêm dos verbetes sobre o álbum, sobre Homem na Estrada (base musical com Ela Partiu, refrão com a voz de Tim Maia) e sobre Ela Partiu (lista Homem na Estrada entre as gravações que a samplearam). A leitura de que o sentido do som muda com o novo contexto é interpretativa; a anotação não avalia autorização nem licenciamento do sample."@pt-BR .

# -----------------------------------------------------------------------------
# Atos interpretativos
# -----------------------------------------------------------------------------

hnc:atoLeitura a aro:InterpretiveAct ;
    aro:hasParticipant hnr:analistaPesquisador ;
    aro:startDate "2026-11-19"^^xsd:date ;
    aro:textValue "Divisão da letra em capítulos e situações, registro das interpretações, das situações e dos padrões"@pt-BR .

hnc:atoAvaliacao a aro:InterpretiveAct ;
    aro:hasParticipant hnr:analistaPesquisador ;
    aro:startDate "2026-11-19"^^xsd:date ;
    aro:textValue "Levantamento de fontes, formulação das afirmações empíricas e das correspondências, avaliação das evidências e revisão crítica"@pt-BR .

