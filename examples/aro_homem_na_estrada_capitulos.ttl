    aro:generalizesAs hnc:pEncarceramento ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "A justiça criminal tirou a liberdade do homem, comprometeu sua reputação e enfraqueceu seus laços familiares."@pt-BR, "The criminal justice system took the man's freedom, damaged his reputation and weakened his family ties."@en .

hnc:justificativa6-06 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "Os efeitos da pena ultrapassam o tempo de prisão e alcançam a família."@pt-BR, "The effects of the sentence go beyond the time in prison and reach the family."@en .

