hnc:situacao5-01 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pEconomiaIlicita ;
    aro:mentionsDepictedElement hnc:conhecidoEnriquecido ;
    aro:textValue "Um conhecido do narrador ganha dinheiro com o tráfico e passa a exibir bens de prestígio."@pt-BR, "An acquaintance of the narrator makes money from trafficking and starts showing off prestige goods."@en .

hnc:justificativa5-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A trajetória mostra a promessa de ascensão que torna o mercado ilícito atraente em certos contextos."@pt-BR, "His path shows the promise of upward mobility that makes the illicit market attractive in certain contexts."@en .

