hnc:situacao4-01 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pDesigualdadeTerritorial ;
    aro:mentionsDepictedElement hnc:moradores, hnc:favela ;
    aro:textValue "Mais um dia começa com as mesmas dificuldades e com calor."@pt-BR, "Another day begins with the same difficulties and with heat."@en .

hnc:justificativa4-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A repetição sem mudança e o desconforto físico compõem uma rotina de privações."@pt-BR, "Repetition without change and physical discomfort make up a routine of deprivation."@en .

