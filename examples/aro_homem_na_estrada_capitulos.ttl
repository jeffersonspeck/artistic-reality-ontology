hnc:situacao3-06 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pReinsercao ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Ele sente que o passado causou danos irreversíveis à sua vida."@pt-BR, "He feels that his past has done irreversible damage to his life."@en .

hnc:justificativa3-06 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A ideia de recuperação entra em conflito com uma sociedade que não oferece condições efetivas de recomeço."@pt-BR, "The idea of recovery clashes with a society that offers no real conditions for a fresh start."@en .

