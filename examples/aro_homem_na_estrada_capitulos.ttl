    aro:mentionsDepictedElement hnc:jovemMorto, hnc:ricos ;
    aro:textValue "Um jovem é morto a tiros enquanto entregava drogas a consumidores de renda alta."@pt-BR, "A young man is shot dead while delivering drugs to high-income customers."@en .

hnc:justificativa5-02 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "Quem ocupa a ponta do comércio ilegal fica diretamente exposto à violência."@pt-BR, "Those at the bottom of the illegal trade are directly exposed to violence."@en .

