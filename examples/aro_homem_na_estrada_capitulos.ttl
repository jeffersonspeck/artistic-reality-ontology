    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pMidiaViolencia ;
    aro:mentionsDepictedElement hnc:jovemMorto, hnc:imprensa ;
    aro:textValue "A morte do jovem ganha destaque na imprensa e vira notícia de grande circulação."@pt-BR, "The young man's death is given prominence in the press and becomes widely circulated news."@en .

hnc:justificativa5-03 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A crítica é à exploração comercial da violência: a morte de uma pessoa se torna audiência e receita."@pt-BR, "The criticism is of the commercial exploitation of violence: a person's death becomes audience and revenue."@en .

