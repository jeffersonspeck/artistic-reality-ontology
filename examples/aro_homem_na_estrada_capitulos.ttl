    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pVersaoOficial ;
    aro:mentionsDepictedElement hnr:protagonista, hnr:mboiMirim, hnc:imprensa ;
    aro:textValue "O homem morto passa a ser descrito por características físicas, idade aproximada e local da morte."@pt-BR, "The dead man comes to be described by physical features, approximate age and place of death."@en .

hnc:justificativa8-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A perspectiva íntima desaparece; a história e os desejos do homem somem da descrição."@pt-BR, "The intimate perspective disappears; the man's story and wishes vanish from the description."@en .

hnc:rec8-02 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linha 150: a morte atribuída a um acerto de contas" ;
    aro:textValue "linha 150: a morte atribuída a um acerto de contas"@pt-BR, "line 150: the death attributed to a settling of scores"@en ;
    aro:hasSelector hnc:rec8-02-sel .
hnc:rec8-02-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=149,150" .

hnc:interpretacao8-02 a aro:InterpretationRecord ;
    aro:hasPrimarySelection hnc:rec8-02 ;
    aro:producedByAct hnc:atoLeitura ;
    aro:describesSituation hnc:situacao8-02 ;
    aro:hasJustification hnc:justificativa8-02 ;
    aro:supportsInterpretation hnc:interpretacaoCap8 ;
    aro:confidenceScore 0.88 .

hnc:situacao8-02 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pVersaoOficial ;
    aro:mentionsDepictedElement hnc:imprensa ;
    aro:textValue "A notícia apresenta como explicação provável um acerto de contas entre grupos criminosos."@pt-BR, "The news report gives a settling of scores between criminal groups as the likely explanation."@en .

hnc:justificativa8-02 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A versão contrasta com a sequência narrada antes e mostra a distância entre uma explicação oficial e as circunstâncias da morte."@pt-BR, "The version contrasts with the sequence narrated before and shows the distance between an official explanation and the circumstances of the death."@en .

hnc:rec8-03 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linha 151: a ficha criminal define a vítima" ;
    aro:textValue "linha 151: a ficha criminal define a vítima"@pt-BR, "line 151: the criminal record defines the victim"@en ;
    aro:hasSelector hnc:rec8-03-sel .
hnc:rec8-03-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=150,151" .

hnc:interpretacao8-03 a aro:InterpretationRecord ;
    aro:hasPrimarySelection hnc:rec8-03 ;
    aro:producedByAct hnc:atoLeitura ;
    aro:describesSituation hnc:situacao8-03 ;
    aro:hasJustification hnc:justificativa8-03 ;
    aro:supportsInterpretation hnc:interpretacaoCap8 ;
    aro:confidenceScore 0.90 .

hnc:situacao8-03 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pVersaoOficial ;
    aro:mentionsDepictedElement hnr:protagonista, hnc:imprensa ;
    aro:textValue "A ficha criminal encerra a notícia e define publicamente quem era o morto."@pt-BR, "The criminal record closes the news report and publicly defines who the dead man was."@en .

hnc:justificativa8-03 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "O antecedente pode influenciar como a morte é interpretada e o empenho dado à investigação."@pt-BR, "The record may influence how the death is interpreted and the effort put into the investigation."@en .

# -----------------------------------------------------------------------------
# Unidade de análise da letra inteira
# -----------------------------------------------------------------------------

hnc:unidadeLetra a aro:AnalysisUnit ;
    aro:producedByAct hnc:atoLeitura ;
    aro:groupsSelection hnc:cap1, hnc:cap2, hnc:cap3, hnc:cap4, hnc:cap5, hnc:cap6, hnc:cap7, hnc:cap8 ;
    aro:textValue "Os oito capítulos da análise, na ordem da letra"@pt-BR, "The eight chapters of the analysis, in the order of the lyric"@en .

# -----------------------------------------------------------------------------
# Padrões de situação e condições
# -----------------------------------------------------------------------------

hnc:pReinsercao a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condEgresso, hnc:condBarreiraTrabalho, hnc:condRotuloPermanente ;
    aro:textValue "Reinserção social de egressos dificultada por estigma, desconfiança e falta de trabalho"@pt-BR, "Social reintegration of former prisoners hindered by stigma, distrust and lack of work"@en .

hnc:condEgresso a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Pessoa retorna à vida social depois de cumprir pena de prisão."@pt-BR, "A person returns to social life after serving a prison sentence."@en .

hnc:condBarreiraTrabalho a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Antecedentes, estigma ou oferta insuficiente de serviços restringem o acesso a trabalho e a reintegração."@pt-BR, "Criminal records, stigma or insufficient services restrict access to work and reintegration."@en .

hnc:condRotuloPermanente a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "O rótulo de ex-presidiário continua orientando a forma como a pessoa é tratada."@pt-BR, "The ex-convict label keeps guiding how the person is treated."@en .

hnc:pEncarceramento a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condPrisao, hnc:condCustoFamilia ;
    aro:textValue "Privação de liberdade com efeitos que alcançam a família"@pt-BR, "Deprivation of liberty with effects that reach the family"@en .

hnc:condPrisao a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Pessoa tem a liberdade restringida pela justiça criminal."@pt-BR, "A person has their freedom restricted by the criminal justice system."@en .

hnc:condCustoFamilia a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Familiares, sobretudo mulheres, assumem custos materiais, afetivos e de reputação da prisão."@pt-BR, "Relatives, above all women, bear the material, emotional and reputational costs of imprisonment."@en .

hnc:pSocioeducacao a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condPrivacaoJuvenil, hnc:condLacunaDireitos ;
    aro:textValue "Institucionalização de adolescentes com acesso incompleto a direitos"@pt-BR, "Institutionalisation of adolescents with incomplete access to rights"@en .

hnc:condPrivacaoJuvenil a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Adolescente cumpre medida com restrição ou privação de liberdade."@pt-BR, "An adolescent serves a measure with restriction or deprivation of liberty."@en .

hnc:condLacunaDireitos a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Escolarização, profissionalização ou acompanhamento apresentam lacunas relevantes."@pt-BR, "Schooling, vocational training or follow-up have significant gaps."@en .

hnc:pPobrezaInfantil a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condPrivacaoInfancia, hnc:condReproducao ;
    aro:textValue "Pobreza na infância e sua reprodução entre gerações"@pt-BR, "Poverty in childhood and its reproduction across generations"@en .

hnc:condPrivacaoInfancia a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Crianças vivem privações de renda, alimentação, moradia, educação ou proteção."@pt-BR, "Children live with deprivations of income, food, housing, education or protection."@en .

hnc:condReproducao a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "A condição social dos pais condiciona as oportunidades dos filhos."@pt-BR, "Parents' social condition shapes their children's opportunities."@en .

hnc:pEconomiaIlicita a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condFaltaRenda, hnc:condRecrutamentoIlicito, hnc:condRiscoDeMorte ;
    aro:textValue "Mercado ilícito como promessa de renda onde faltam oportunidades"@pt-BR, "The illicit market as a promise of income where opportunities are lacking"@en .

hnc:condFaltaRenda a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Jovens com pouca escolaridade e renda baixa têm acesso limitado a trabalho estável."@pt-BR, "Young people with little schooling and low income have limited access to stable work."@en .

hnc:condRecrutamentoIlicito a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "O comércio ilegal oferece renda imediata e recruta nesses contextos."@pt-BR, "The illegal trade offers immediate income and recruits in these contexts."@en .

hnc:condRiscoDeMorte a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Quem trabalha no comércio ilegal fica exposto ao risco de ser morto."@pt-BR, "Those who work in the illegal trade are exposed to the risk of being killed."@en .

hnc:pMorteJovem a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condLetalidadeJuvenil ;
    aro:textValue "Violência letal concentrada sobre jovens, sobretudo jovens negros"@pt-BR, "Lethal violence concentrated on young people, above all young Black people"@en .

hnc:condLetalidadeJuvenil a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Jovens são vítimas de homicídio em grande número e de forma racialmente desigual."@pt-BR, "Young people are homicide victims in large numbers and in a racially unequal way."@en .

hnc:pDesigualdadeTerritorial a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condFaltaEquipamentos, hnc:condDesigualdadeVida ;
    aro:textValue "Desigualdade territorial de equipamentos, lazer e condições de vida"@pt-BR, "Territorial inequality of facilities, leisure and living conditions"@en .

hnc:condFaltaEquipamentos a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Bairros populares têm poucos ou nenhum equipamento público de cultura e lazer."@pt-BR, "Working-class neighbourhoods have few or no public cultural and leisure facilities."@en .

hnc:condDesigualdadeVida a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Indicadores de condições de vida variam fortemente entre bairros ricos e periféricos."@pt-BR, "Living-condition indicators vary strongly between rich and peripheral neighbourhoods."@en .

hnc:pReligiosidade a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condPraticaReligiosa, hnc:condIntolerancia ;
    aro:textValue "Religiosidade de matriz africana como amparo e como alvo de discriminação"@pt-BR, "Afro-Brazilian religiosity as support and as a target of discrimination"@en .

hnc:condPraticaReligiosa a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Pessoas recorrem a religiões de matriz africana na vida cotidiana e em momentos de crise."@pt-BR, "People turn to Afro-Brazilian religions in daily life and in moments of crisis."@en .

hnc:condIntolerancia a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Praticantes e espaços dessas religiões sofrem discriminação e violência."@pt-BR, "Followers and places of these religions suffer discrimination and violence."@en .

hnc:pMoradiaRisco a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condMoradiaPrecaria, hnc:condSaneamento, hnc:condAreaRisco ;
    aro:textValue "Moradia precária, sem saneamento e exposta a desastres"@pt-BR, "Precarious housing, without sanitation and exposed to disasters"@en .

hnc:condMoradiaPrecaria a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Moradia autoconstruída ou malconservada em território popular."@pt-BR, "Self-built or run-down housing in a working-class territory."@en .

hnc:condSaneamento a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Falta ou insuficiência de esgotamento sanitário."@pt-BR, "Lack or inadequacy of sewage disposal."@en .

hnc:condAreaRisco a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Exposição a deslizamentos, enchentes ou desabamentos com chuvas."@pt-BR, "Exposure to landslides, floods or collapses with the rains."@en .

hnc:pPrecariedadeConhecida a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condTerritorioMedido, hnc:condRespostaInsuficiente ;
    aro:textValue "Precariedade conhecida por dados públicos sem resposta suficiente"@pt-BR, "Precariousness known through public data without a sufficient response"@en .

hnc:condTerritorioMedido a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "O território é recenseado e sua precariedade é registrada em dados públicos."@pt-BR, "The territory is counted in the census and its precariousness is recorded in public data."@en .

hnc:condRespostaInsuficiente a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Políticas e serviços não superam os déficits registrados."@pt-BR, "Policies and services do not overcome the recorded deficits."@en .

hnc:pViolenciaMulher a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condViolenciaGenero, hnc:condProtecaoInsuficiente ;
    aro:textValue "Violência sexual e letal contra mulheres"@pt-BR, "Sexual and lethal violence against women"@en .

hnc:condViolenciaGenero a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Mulher sofre violência física, sexual ou letal."@pt-BR, "A woman suffers physical, sexual or lethal violence."@en .

hnc:condProtecaoInsuficiente a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Prevenção, denúncia ou resposta institucional são ausentes ou insuficientes."@pt-BR, "Prevention, reporting or institutional response are absent or insufficient."@en .

hnc:pCorpoIndigno a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condMorteViolenta, hnc:condServicoFalho ;
    aro:textValue "Demora, descaso e falta de identificação no tratamento de mortos"@pt-BR, "Delay, neglect and lack of identification in the handling of the dead"@en .

hnc:condMorteViolenta a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Uma pessoa morre em via pública ou em circunstância violenta."@pt-BR, "A person dies in the street or in violent circumstances."@en .

hnc:condServicoFalho a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "A remoção, a perícia ou a identificação do corpo são tardias ou falham."@pt-BR, "The removal, the forensic examination or the identification of the body come late or fail."@en .

hnc:pAgua a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condIntermitencia ;
    aro:textValue "Interrupção recorrente do abastecimento de água"@pt-BR, "Recurrent interruption of the water supply"@en .

hnc:condIntermitencia a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "O abastecimento de água é interrompido de modo prolongado ou frequente."@pt-BR, "The water supply is interrupted for long periods or frequently."@en .

hnc:pViolenciaIntrafamiliar a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condAgressaoFamiliar, hnc:condAlcool ;
    aro:textValue "Violência de filhos contra mães e pais, associada ao álcool"@pt-BR, "Violence by sons against their mothers and fathers, associated with alcohol"@en .

hnc:condAgressaoFamiliar a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Filho agride mãe ou pai no ambiente doméstico."@pt-BR, "A son attacks his mother or father at home."@en .

hnc:condAlcool a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "O agressor está sob efeito de álcool."@pt-BR, "The aggressor is under the influence of alcohol."@en .

hnc:pLinchamento a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condPunicaoColetiva ;
    aro:textValue "Linchamento como punição coletiva fora da lei"@pt-BR, "Lynching as collective punishment outside the law"@en .

hnc:condPunicaoColetiva a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Grupo agride ou mata pessoa acusada, no lugar do processo legal."@pt-BR, "A group attacks or kills an accused person in place of due process."@en .

hnc:pDrogasSeletivas a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condDanoLicito, hnc:condPunicaoSeletiva ;
    aro:textValue "Seletividade no tratamento das drogas: o álcool lucra, o varejo pobre é punido"@pt-BR, "Selectivity in the treatment of drugs: alcohol profits, the poor retail end is punished"@en .

hnc:condDanoLicito a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Substâncias lícitas, como o álcool, causam danos graves e geram lucro."@pt-BR, "Legal substances, such as alcohol, cause serious harm and generate profit."@en .

hnc:condPunicaoSeletiva a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "A repressão às drogas ilícitas recai sobre jovens pobres e negros da ponta do comércio."@pt-BR, "The repression of illicit drugs falls on poor and Black young people at the bottom of the trade."@en .

hnc:pFomeEscola a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condFomeInfantil, hnc:condAlimentacaoEscolar ;
    aro:textValue "Fome infantil e escola como parte da proteção alimentar"@pt-BR, "Child hunger and school as part of food protection"@en .

hnc:condFomeInfantil a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Crianças passam por restrição grave de alimentos."@pt-BR, "Children go through severe food shortage."@en .

hnc:condAlimentacaoEscolar a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "A alimentação escolar integra a rede de proteção das crianças."@pt-BR, "School meals are part of the protection network for children."@en .

hnc:pAprendizagemDesigual a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condCondicoesAprendizagem ;
    aro:textValue "Aprendizagem desigual conforme as condições sociais das crianças"@pt-BR, "Unequal learning according to children's social conditions"@en .

hnc:condCondicoesAprendizagem a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Falta de condições materiais, saúde, segurança ou apoio prejudica a aprendizagem."@pt-BR, "Lack of material conditions, health, safety or support harms learning."@en .

hnc:pMidiaViolencia a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condExposicao ;
    aro:textValue "Exploração da violência pela mídia"@pt-BR, "Exploitation of violence by the media"@en .

hnc:condExposicao a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Mortes e suspeitos são expostos como espetáculo em programas e notícias."@pt-BR, "Deaths and suspects are exposed as spectacle in programmes and news."@en .

hnc:pCrack a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condUsoCrack ;
    aro:textValue "Expansão do crack em territórios vulneráveis"@pt-BR, "Spread of crack in vulnerable territories"@en .

hnc:condUsoCrack a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "O consumo de crack se instala em comunidades pobres e atinge também menores de idade."@pt-BR, "Crack use takes hold in poor communities and also reaches minors."@en .

hnc:pSuspeicao a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condSuspeitaTerritorio, hnc:condAcusacaoSemProva ;
    aro:textValue "Suspeição territorial e racial e exposição pública de suspeitos"@pt-BR, "Territorial and racial suspicion and public exposure of suspects"@en .

hnc:condSuspeitaTerritorio a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "Morar em certo território, a cor ou o antecedente penal orientam a suspeita."@pt-BR, "Living in a certain territory, skin colour or a criminal record guide suspicion."@en .

hnc:condAcusacaoSemProva a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "A suspeita é tornada pública ou leva à prisão sem prova suficiente."@pt-BR, "The suspicion is made public or leads to imprisonment without sufficient evidence."@en .

hnc:pViolenciaPolicial a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condForcaLetal, hnc:condDesconfianca, hnc:condDomicilio ;
    aro:textValue "Violência policial letal em territórios populares"@pt-BR, "Lethal police violence in working-class territories"@en .

hnc:condForcaLetal a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition true ;
    aro:textValue "A ação de agentes do Estado produz risco ou resultado letal."@pt-BR, "The action of state agents produces a lethal risk or outcome."@en .

hnc:condDesconfianca a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Moradores não confiam na proteção policial e temem agressão ou execução."@pt-BR, "Residents do not trust police protection and fear assault or execution."@en .

hnc:condDomicilio a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
    aro:isRequiredCondition false ;
    aro:textValue "Agentes entram em casas sem as razões exigidas pela lei."@pt-BR, "Agents enter homes without the reasons required by law."@en .

hnc:pSilencio a aro:SituationPattern ;
    aro:producedByAct hnc:atoLeitura ;
    aro:hasCondition hnc:condMedoTestemunhar, hnc:condImpunidade ;
    aro:textValue "Silêncio de testemunhas e baixa elucidação de mortes"@pt-BR, "Silence of witnesses and low clearance of deaths"@en .

hnc:condMedoTestemunhar a aro:PatternCondition ;
    aro:producedByAct hnc:atoLeitura ;
