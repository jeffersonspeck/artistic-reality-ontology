    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Ele está sem trabalho."@pt-BR, "He is out of work."@en .

hnc:justificativa3-04 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "Sem emprego, sobreviver por meios legais fica difícil, mesmo com a decisão de deixar o crime."@pt-BR, "Without a job, surviving by legal means becomes hard, even with the decision to leave crime."@en .

