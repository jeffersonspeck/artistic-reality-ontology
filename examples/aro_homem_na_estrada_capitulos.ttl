hnc:situacao7-01 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pViolenciaPolicial ;
    aro:mentionsDepictedElement hnr:protagonista, hnr:policia ;
    aro:textValue "Ele acredita que, se fosse encontrado ferido por policiais, seria agredido e deixado sem socorro."@pt-BR, "He believes that, if he were found wounded by police officers, he would be beaten and left without help."@en .

hnc:justificativa7-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "É uma expectativa sobre a conduta policial que expressa insegurança diante de quem deveria proteger."@pt-BR, "It is an expectation about police conduct that expresses insecurity towards those who should protect."@en .

