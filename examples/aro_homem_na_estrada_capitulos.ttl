    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Os antecedentes são comparados a uma marca de que não se consegue sair; a tatuagem e o histórico penal reforçam essa identidade."@pt-BR .

hnc:justificativa6-04 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A identidade social do homem fica reduzida ao passado no crime."@pt-BR .

