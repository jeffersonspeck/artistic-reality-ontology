hnc:situacao3-01 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pPobrezaInfantil ;
    aro:mentionsDepictedElement hnr:protagonista, hnc:filho ;
    aro:textValue "O desejo de enriquecer volta, agora ligado a dar segurança e melhores condições de vida ao filho."@pt-BR, "The wish to get rich returns, now tied to giving his son security and better living conditions."@en .

hnc:justificativa3-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A ascensão passa a significar mudança da realidade familiar, não só conquista pessoal."@pt-BR, "Getting on in life comes to mean changing the family's situation, not only a personal achievement."@en .

