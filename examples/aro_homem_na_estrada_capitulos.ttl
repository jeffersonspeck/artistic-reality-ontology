hnc:situacao2-02 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pMoradiaRisco ;
    aro:mentionsDepictedElement hnc:casa ;
    aro:textValue "O esgoto corre perto da casa."@pt-BR, "Sewage runs near the house."@en .

hnc:justificativa2-02 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A presença do esgoto indica falta ou insuficiência de saneamento e exposição diária a condições insalubres."@pt-BR, "The presence of sewage points to the lack or inadequacy of sanitation and to daily exposure to unhealthy conditions."@en .

hnc:rec2-03 a aro:Selection ;
    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linha 26: risco provocado pelas chuvas" ;
