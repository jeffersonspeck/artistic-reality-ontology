    aro:selectsFrom hnr:letra ;
    aro:locatedInManifestation hnr:transcricaoLyricFind ;
    aro:selectorExpression "linhas 22–24: moradia precária como único refúgio" ;
    aro:textValue "linhas 22–24: moradia precária como único refúgio"@pt-BR, "lines 22–24: precarious housing as the only refuge"@en ;
    aro:hasSelector hnc:rec2-01-sel .
hnc:rec2-01-sel a oa:FragmentSelector ;
    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
    oa:value "line=21,24" .

