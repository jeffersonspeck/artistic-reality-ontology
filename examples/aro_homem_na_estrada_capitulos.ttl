# 15. Demora, descaso e falta de identificação no tratamento de mortos

hnc:situacaoEmpiricaSemIdentificacao a aro:EmpiricalSituation ;
    aro:startDate "2016"^^xsd:gYear ;
    aro:textValue "Reportagem de 2016 mostrou que pessoas com identidade conhecida foram enterradas como desconhecidas em São Paulo, e que famílias passaram anos procurando parentes já sepultados."@pt-BR .

hnc:casoSemIdentificacao a aro:EmpiricalCase ;
    aro:caseAboutSituation hnc:situacaoEmpiricaSemIdentificacao ;
    aro:citesSource hnc:fonteIndigente ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Pessoas enterradas como desconhecidas embora pudessem ser identificadas"@pt-BR .

hnc:afirmacaoSemIdentificacao a aro:EmpiricalClaim ;
    aro:citesSource hnc:fonteIndigente ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Falhas na identificação e na comunicação entre órgãos fazem com que mortos sejam enterrados sem nome, mesmo quando havia meios de identificá-los."@pt-BR .

hnc:evidenciaSemIdentificacao a aro:EvidenceItem ;
    aro:derivedFromSource hnc:fonteIndigente ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "A Agência Pública mostrou, a partir do programa de localização de desaparecidos do Ministério Público de São Paulo, casos de pessoas com documentos e impressões digitais registradas que foram enterradas como indigentes."@pt-BR .

hnc:correspondenciaSemIdentificacao a aro:CorrespondenceClaim ;
    aro:assertsPattern hnc:pCorpoIndigno ;
    aro:assertsCase hnc:casoSemIdentificacao ;
    aro:citesSource hnc:fonteIndigente ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "O medo de terminar no necrotério sem identificação corresponde a um padrão documentado de mortos enterrados como desconhecidos."@pt-BR .

hnc:avaliacaoSemIdentificacao a aro:EvidenceAssessment ;
    aro:assessesEvidence hnc:evidenciaSemIdentificacao ;
    aro:assessesClaim hnc:afirmacaoSemIdentificacao, hnc:correspondenciaSemIdentificacao ;
    aro:assessmentOutcome "supports" ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Apoio direto ao tipo de situação temido. Dimensões do caso real não representadas na letra: a busca das famílias por desaparecidos e os programas de localização."@pt-BR .

# 16. Interrupção recorrente do abastecimento de água

hnc:situacaoEmpiricaAgua a aro:EmpiricalSituation ;
    aro:textValue "A PNAD Contínua mede a frequência do abastecimento de água e mostra que parte dos domicílios ligados à rede não recebe água todos os dias, com menor regularidade no Nordeste."@pt-BR .

hnc:casoAgua a aro:EmpiricalCase ;
    aro:caseAboutSituation hnc:situacaoEmpiricaAgua ;
    aro:citesSource hnc:fonteIBGEAgua, hnr:fonteIBGECensoFavelas ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Abastecimento de água irregular em domicílios ligados à rede"@pt-BR .

hnc:afirmacaoAgua a aro:EmpiricalClaim ;
    aro:citesSource hnc:fonteIBGEAgua, hnr:fonteIBGECensoFavelas ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Estar ligado à rede de água não garante abastecimento diário; a falta de água é frequente em parte do país e das favelas."@pt-BR .

hnc:evidenciaAgua1 a aro:EvidenceItem ;
    aro:derivedFromSource hnc:fonteIBGEAgua ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "O IBGE informa que o abastecimento diário de água é menor no Nordeste do que nas outras regiões."@pt-BR .

hnc:evidenciaAgua2 a aro:EvidenceItem ;
    aro:derivedFromSource hnr:fonteIBGECensoFavelas ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "No Censo 2022, 86,5% dos domicílios em favelas tinham ligação à rede geral de água."@pt-BR .

hnc:correspondenciaAgua a aro:CorrespondenceClaim ;
    aro:assertsPattern hnc:pAgua ;
    aro:assertsCase hnc:casoAgua ;
    aro:citesSource hnc:fonteIBGEAgua, hnr:fonteIBGECensoFavelas ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Os cinco dias sem água correspondem a um padrão de abastecimento irregular medido pelo IBGE."@pt-BR .

hnc:avaliacaoAgua a aro:EvidenceAssessment ;
    aro:assessesEvidence hnc:evidenciaAgua1, hnc:evidenciaAgua2 ;
    aro:assessesClaim hnc:afirmacaoAgua, hnc:correspondenciaAgua ;
    aro:assessmentOutcome "supports" ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Apoio ao padrão. Dimensões do caso real não representadas na letra: a medição é feita por região e não por comunidade, e a falta de água varia com estiagens e racionamentos."@pt-BR .

# 17. Violência de filhos contra mães e pais, associada ao álcool

hnc:situacaoEmpiricaViolenciaIntrafamiliar a aro:EmpiricalSituation ;
    aro:startDate "2024"^^xsd:gYear ;
    aro:textValue "Denúncias ao Disque 100 apontam os filhos como principais agressores de pessoas idosas, e o levantamento nacional sobre álcool e drogas associou o álcool a parte dos casos de violência doméstica."@pt-BR .

hnc:casoViolenciaIntrafamiliar a aro:EmpiricalCase ;
    aro:caseAboutSituation hnc:situacaoEmpiricaViolenciaIntrafamiliar ;
    aro:citesSource hnc:fonteViolenciaIdosos, hnc:fonteLENAD ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Filhos que agridem os pais e violência doméstica associada ao álcool"@pt-BR .

hnc:afirmacaoViolenciaIntrafamiliar a aro:EmpiricalClaim ;
    aro:citesSource hnc:fonteViolenciaIdosos, hnc:fonteLENAD ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "A violência de filhos contra mães e pais é frequente entre as denúncias de violência contra idosos, e o álcool está presente em parte dos casos de violência doméstica."@pt-BR .

hnc:evidenciaViolenciaIntrafamiliar1 a aro:EvidenceItem ;
    aro:derivedFromSource hnc:fonteViolenciaIdosos ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Segundo dados do Disque 100, filhos e filhas são os principais agressores de pessoas idosas, especialmente de mulheres idosas."@pt-BR .

hnc:evidenciaViolenciaIntrafamiliar2 a aro:EvidenceItem ;
    aro:derivedFromSource hnc:fonteLENAD ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "O 2º LENAD indicou presença do álcool em cerca de metade dos casos de violência doméstica relatados pelos entrevistados."@pt-BR .

hnc:correspondenciaViolenciaIntrafamiliar a aro:CorrespondenceClaim ;
    aro:assertsPattern hnc:pViolenciaIntrafamiliar ;
    aro:assertsCase hnc:casoViolenciaIntrafamiliar ;
    aro:citesSource hnc:fonteViolenciaIdosos, hnc:fonteLENAD ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "O filho embriagado que agride a mãe corresponde a um padrão de violência intrafamiliar documentado em denúncias e em levantamento nacional."@pt-BR .

hnc:avaliacaoViolenciaIntrafamiliar a aro:EvidenceAssessment ;
    aro:assessesEvidence hnc:evidenciaViolenciaIntrafamiliar1, hnc:evidenciaViolenciaIntrafamiliar2 ;
