    aro:realizesArtwork hnr:elaPartiu ;
    aro:hasManifestation hnc:compactoElaPartiu ;
    aro:textValue "Gravação de Ela Partiu na voz de Tim Maia (1976)"@pt-BR .

hnc:compactoElaPartiu a aro:Manifestation ;
    aro:embodiesExpression hnc:gravacaoElaPartiu ;
    dcterms:issued "1976"^^xsd:gYear ;
    aro:textValue "Compacto de 1976 (Seroma, ligada à Vitória Régia Discos), com Meus Inimigos no lado B"@pt-BR .

hnc:criacaoElaPartiu a aro:CreativeAct ;
    aro:startDate "1976"^^xsd:gYear ;
    aro:hasContribution hnc:contribuicaoComposicaoTimMaia, hnc:contribuicaoComposicaoBetoCajueiro, hnc:contribuicaoVozTimMaia ;
    aro:producesCreation hnr:elaPartiu, hnc:gravacaoElaPartiu, hnc:compactoElaPartiu ;
    aro:textValue "Composição e gravação de Ela Partiu, lançada em compacto em 1976"@pt-BR .

