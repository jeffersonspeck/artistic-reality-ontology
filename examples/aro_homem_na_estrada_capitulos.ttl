    aro:citesSource hnc:fonteIMDSAprendizado ;
    aro:producedByAct hnc:atoAvaliacao ;
    aro:textValue "Crianças de famílias pobres aprendem menos, em média, do que crianças de famílias com mais recursos, e a diferença aparece cedo."@pt-BR .

