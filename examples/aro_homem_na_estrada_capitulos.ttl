hnc:situacao3-05 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pReinsercao ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "O histórico de prisão faz com que as pessoas desconfiem dele."@pt-BR, "His prison record makes people distrust him."@en .

hnc:justificativa3-05 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A pena formal terminou, mas as consequências sociais continuam a fechar oportunidades."@pt-BR, "The formal sentence has ended, but its social consequences keep closing off opportunities."@en .

