    aro:describesSituation hnc:situacao2-01 ;
    aro:hasJustification hnc:justificativa2-01 ;
    aro:supportsInterpretation hnc:interpretacaoCap2 ;
    aro:confidenceScore 0.93 .

hnc:situacao2-01 a aro:SituationDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pMoradiaRisco ;
    aro:mentionsDepictedElement hnr:protagonista, hnc:casa ;
    aro:textValue "A casa é malconservada e fica em terreno ruim, mas é o único lugar de pertencimento e proteção do homem."@pt-BR, "The house is run down and stands on poor ground, but it is the man's only place of belonging and protection."@en .

hnc:justificativa2-01 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "A precariedade material não apaga o valor afetivo da moradia; as duas coisas são ditas juntas."@pt-BR, "Material precariousness does not erase the emotional value of the home; both things are said together."@en .

