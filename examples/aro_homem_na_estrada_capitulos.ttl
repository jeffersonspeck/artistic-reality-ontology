    aro:producedByAct hnc:atoLeitura ;
    aro:describesSituation hnc:situacao1-04 ;
    aro:hasJustification hnc:justificativa1-04 ;
    aro:supportsInterpretation hnc:interpretacaoCap1 ;
    aro:confidenceScore 0.93 .

hnc:situacao1-04 a aro:IntentionalStateDescription ;
    aro:producedByAct hnc:atoLeitura ;
    aro:generalizesAs hnc:pReinsercao ;
    aro:mentionsDepictedElement hnr:protagonista ;
    aro:textValue "Ele declara a intenção de não voltar ao crime nem repetir o que viveu."@pt-BR, "He states his intention not to return to crime nor to repeat what he went through."@en .

hnc:justificativa1-04 a aro:Justification ;
    aro:producedByAct hnc:atoLeitura ;
    aro:textValue "O passado é aquilo de que ele quer se afastar, mas os capítulos seguintes mostram que esse passado continua produzindo efeitos."@pt-BR, "The past is what he wants to get away from, but the following chapters show that this past keeps having effects."@en .

