hne:condicao_suspeicao a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Associação contextual; não prova fabricação de lista específica de suspeitos."@pt-BR .

hne:condicao_versao a aro:PatternCondition ;
    aro:isRequiredCondition true ;
