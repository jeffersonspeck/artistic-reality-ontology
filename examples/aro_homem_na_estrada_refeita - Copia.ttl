hne:seletorLiteralCurto_01 a oa:TextQuoteSelector ;
    oa:exact "Um homem na estrada recomeça sua vida" .

hne:seletorLiteralCurto_43 a oa:TextQuoteSelector ;
    oa:exact "Bang! Bang! Bang!" .

hne:situacaoAlternativa45 a aro:SituationDescription ;
    aro:textValue "A notícia final relata como hipótese policial um conflito entre quadrilhas, mas o texto não oferece verificação independente; a identidade do autor da morte permanece indeterminada na representação."@pt-BR .

hne:situacaoEmpirica_c01 a aro:EmpiricalSituation ;
    aro:textValue "O SISDEPEN publica dados agregados do 2º semestre de 2025 sobre custódia, educação e trabalho no sistema penal brasileiro."@pt-BR .

hne:situacaoEmpirica_c02 a aro:EmpiricalSituation ;
    aro:textValue "A SENAPPEN registra 54.117 pessoas egressas atendidas no 2º semestre de 2025 e 6.209 familiares acompanhados."@pt-BR .

hne:situacaoEmpirica_c03 a aro:EmpiricalSituation ;
    aro:textValue "Em inspeções judiciais de 2024, 427 unidades socioeducativas abrigavam 11.016 adolescentes; 95,5% eram do sexo masculino."@pt-BR .

hne:situacaoEmpirica_c04 a aro:EmpiricalSituation ;
    aro:textValue "No painel do CNJ de 2024, 55,4% dos internos inspecionados foram identificados como pardos e 18,8% como pretos."@pt-BR .

hne:situacaoEmpirica_c05 a aro:EmpiricalSituation ;
    aro:textValue "O Censo 2022, após ajustes posteriores de consistência, identifica 16.390.790 moradores de favelas e comunidades urbanas."@pt-BR .

hne:situacaoEmpirica_c06 a aro:EmpiricalSituation ;
    aro:textValue "No Censo 2022, 74,6% dos domicílios de favelas possuíam esgotamento por rede, rede pluvial, fossa séptica ou filtro, segundo definição publicada."@pt-BR .

hne:situacaoEmpirica_c07 a aro:EmpiricalSituation ;
    aro:textValue "Segundo Censo 2022 divulgado em 2025, 19,2% dos moradores de favelas viviam em vias acessíveis apenas a pé, bicicleta ou motocicleta."@pt-BR .

hne:situacaoEmpirica_c08 a aro:EmpiricalSituation ;
    aro:textValue "O SINISA 2025 disponibiliza relatórios e indicadores dos serviços de abastecimento de água e esgotamento referentes a 2024."@pt-BR .

hne:situacaoEmpirica_c09 a aro:EmpiricalSituation ;
    aro:textValue "Estudo do Cemaden identificou 15.087 deslizamentos em 130 municípios do RS durante chuvas extremas de 2024."@pt-BR .

hne:situacaoEmpirica_c10 a aro:EmpiricalSituation ;
    aro:textValue "O Anuário Brasileiro de Segurança Pública 2026 relata crescimento dos feminicídios na série histórica e detalha violência contra mulheres em 2025."@pt-BR .

hne:situacaoEmpirica_c11 a aro:EmpiricalSituation ;
    aro:textValue "O Ligue 180 registrou 20.534 violações classificadas como violência sexual em 2025, considerando a classificação administrativa do canal."@pt-BR .

hne:situacaoEmpirica_c12 a aro:EmpiricalSituation ;
    aro:textValue "O FBSP/Datafolha publicou em 2025 pesquisa representativa de relatos de vitimização de mulheres de 16 anos ou mais."@pt-BR .

hne:situacaoEmpirica_c13 a aro:EmpiricalSituation ;
    aro:textValue "A Central Ligue 180 registrou 155.111 denúncias de violência contra mulheres em 2025."@pt-BR .

hne:situacaoEmpirica_c14 a aro:EmpiricalSituation ;
    aro:textValue "O Atlas da Violência 2025 estima 51.608 homicídios ocultos entre 2013 e 2023, associados a mortes violentas com causa indeterminada."@pt-BR .

hne:situacaoEmpirica_c15 a aro:EmpiricalSituation ;
    aro:textValue "No 4º trimestre de 2025, as taxas de desocupação foram 4,0% para brancos, 6,1% para pretos e 5,9% para pardos."@pt-BR .

hne:situacaoEmpirica_c16 a aro:EmpiricalSituation ;
    aro:textValue "A PNAD 2024 informa rendimentos habituais totais de R$ 2.484 para trabalhadores pretos ou pardos e R$ 4.119 para brancos."@pt-BR .

hne:situacaoEmpirica_c17 a aro:EmpiricalSituation ;
    aro:textValue "A PNAD/EBIA 2024 estima 24,2% de domicílios brasileiros em insegurança alimentar; 3,2% em grau grave."@pt-BR .

hne:situacaoEmpirica_c18 a aro:EmpiricalSituation ;
    aro:textValue "Em 2024, a insegurança alimentar grave entre crianças e adolescentes de 5 a 17 anos foi 3,5% entre estudantes e 10,9% entre não estudantes, segundo MDS/PNAD."@pt-BR .

hne:situacaoEmpirica_c19 a aro:EmpiricalSituation ;
    aro:textValue "Em 2026, o PNAE atende aproximadamente 40 milhões de estudantes da educação básica pública."@pt-BR .

hne:situacaoEmpirica_c20 a aro:EmpiricalSituation ;
    aro:textValue "O FNDE informou transferências de cerca de R$ 6,7 bilhões ao PNAE no exercício de 2026."@pt-BR .

hne:situacaoEmpirica_c21 a aro:EmpiricalSituation ;
    aro:textValue "Segundo relatório UNICEF, a violência foi causa de quase metade (49%) das mortes de meninos de 15 a 19 anos no Brasil em 2024."@pt-BR .

hne:situacaoEmpirica_c22 a aro:EmpiricalSituation ;
    aro:textValue "O Atlas 2025 apresenta 21.856 homicídios de jovens de 15 a 29 anos em 2023, equivalentes a 47,8% dos homicídios."@pt-BR .

hne:situacaoEmpirica_c23 a aro:EmpiricalSituation ;
    aro:textValue "Segundo Atlas 2025, pessoas negras tinham risco de homicídio 2,7 vezes o de não negras em 2023."@pt-BR .

hne:situacaoEmpirica_c24 a aro:EmpiricalSituation ;
    aro:textValue "O FBSP apurou 6.602 mortes decorrentes de intervenções policiais no Brasil em 2025, contra 6.237 em 2024."@pt-BR .

hne:situacaoEmpirica_c25 a aro:EmpiricalSituation ;
    aro:textValue "Segundo Anuário 2026, mortes decorrentes de intervenção policial representaram 16,2% das mortes violentas intencionais no Brasil em 2025."@pt-BR .

hne:situacaoEmpirica_c26 a aro:EmpiricalSituation ;
    aro:textValue "O 20º Anuário registra 40.775 mortes violentas intencionais no Brasil em 2025."@pt-BR .

hne:situacaoEmpirica_c27 a aro:EmpiricalSituation ;
    aro:textValue "Rede de Observatórios da Segurança, citada em reportagem de 2026, identificou 223 linchamentos em 2024 e 227 em 2025 em nove estados."@pt-BR .

hne:situacaoEmpirica_c28 a aro:EmpiricalSituation ;
    aro:textValue "Reportagem de agosto de 2026 relata a morte de um ciclista espancado após confusão com suspeito de furto de bicicleta no Rio de Janeiro."@pt-BR .

hne:situacaoEmpirica_c29 a aro:EmpiricalSituation ;
    aro:textValue "No LENAD III (dados de 2023), 34,7% dos adultos pesquisados relataram consumo episódico pesado no recorte de 30 dias, conforme definição do levantamento."@pt-BR .

hne:situacaoEmpirica_c30 a aro:EmpiricalSituation ;
    aro:textValue "De acordo com indicadores LENAD III divulgados pela Senad, 44,2% dos adultos consumiram álcool no ano anterior à entrevista."@pt-BR .

hne:situacaoEmpirica_c31 a aro:EmpiricalSituation ;
    aro:textValue "O LENAD III reporta consumo recente de crack de cerca de 0,5% e experimentação ao longo da vida de cerca de 1,4%."@pt-BR .

hne:situacaoEmpirica_c32 a aro:EmpiricalSituation ;
    aro:textValue "Levantamento nacional aponta cocaína como segunda substância ilícita mais consumida, atrás dos derivados de cannabis."@pt-BR .

hne:situacaoEmpirica_c33 a aro:EmpiricalSituation ;
    aro:textValue "O OBID disponibiliza o Caderno Temático LENAD III de 2025 sobre consumo de cocaína e crack no Brasil."@pt-BR .

hne:situacaoEmpirica_c34 a aro:EmpiricalSituation ;
    aro:textValue "O IBGE incorpora Umbanda e Candomblé como grupo pesquisado na amostra do Censo 2022."@pt-BR .

hne:situacaoEmpirica_c35 a aro:EmpiricalSituation ;
    aro:textValue "O MIR informou o encaminhamento de denúncias de restrição ao culto ou racismo religioso no Amazonas e em São Paulo em 2026."@pt-BR .

hne:situacaoEmpirica_c36 a aro:EmpiricalSituation ;
    aro:textValue "O IBGE divulga perfil populacional nacional por sexo, raça e religião, permitindo medir grupos, não trajetórias biográficas singulares."@pt-BR .

hne:situacaoEmpirica_c37 a aro:EmpiricalSituation ;
    aro:textValue "O Disque 100 disponibiliza registros de denúncias de violações de direitos humanos até o terceiro trimestre de 2026."@pt-BR .

hne:situacaoEmpirica_c38 a aro:EmpiricalSituation ;
    aro:textValue "UNICEF/FBSP registram, em relatório publicado em 2021, padrões de violência armada urbana e racismo na vitimização adolescente."@pt-BR .

hne:situacaoEmpirica_c39 a aro:EmpiricalSituation ;
    aro:textValue "IBGE define favelas e comunidades urbanas como territórios formados por estratégias populares de acesso à moradia diante de políticas insuficientes."@pt-BR .

hne:situacaoEmpirica_c40 a aro:EmpiricalSituation ;
    aro:textValue "A taxa de desocupação nacional foi de 5,1% no 4º trimestre de 2025, com variação segundo raça e escolaridade."@pt-BR .

hne:situacaoNarrada_01 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_liberdade,
        hne:padrao_reinsercao ;
    aro:textValue "O sujeito da narrativa procura reorientar sua trajetória após o encarceramento; a recuperação é intenção narrada, não resultado confirmado."@pt-BR .

hne:situacaoNarrada_02 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_liberdade,
        hne:padrao_reinsercao ;
    aro:textValue "Liberdade é apresentada como finalidade valorizada pelo personagem e como perda anterior, sem detalhamento judicial."@pt-BR .

hne:situacaoNarrada_03 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_reinsercao ;
    aro:textValue "O compromisso de abandonar o crime é autodescrição projetiva, não prova externa de ausência de delitos futuros."@pt-BR .

hne:situacaoNarrada_04 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_juvenil ;
    aro:textValue "O texto situa uma experiência de institucionalização juvenil dolorosa na biografia ficcional."@pt-BR .

hne:situacaoNarrada_05 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_aspiracao ;
    aro:textValue "O projeto de mobilidade econômica contrasta com referências a pessoas que morrem tentando realizá-lo."@pt-BR .

hne:situacaoNarrada_06 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_filho-pobreza ;
    aro:textValue "A responsabilidade parental intensifica a avaliação negativa das condições de vida e do futuro possível."@pt-BR .

hne:situacaoNarrada_07 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_cultura ;
    aro:textValue "A presença do bar e de referências ao candomblé compõe a ambientação cultural; não há base para tratar a religião como causa da pobreza."@pt-BR .

hne:situacaoNarrada_08 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_moradia ;
    aro:textValue "O mesmo espaço aparece como proteção afetiva e precariedade material, evitando reduzi-lo a estigma territorial."@pt-BR .

hne:situacaoNarrada_09 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_risco-encosta,
        hne:padrao_saneamento ;
    aro:textValue "O ambiente é narrado com infraestrutura inadequada e risco de dano quando chove."@pt-BR .

hne:situacaoNarrada_10 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_invisibilidade ;
    aro:textValue "Há crítica à distância entre registro estatístico e presença concreta de serviços; não se conclui que o IBGE era responsável por prestar esses serviços."@pt-BR .

hne:situacaoNarrada_11 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_violencia-mulher ;
    aro:textValue "A narrativa descreve violência brutal contra mulher; não classificar automaticamente como feminicídio sem informações sobre motivação."@pt-BR .

hne:situacaoNarrada_12 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_morte-anonima,
        hne:padrao_resposta-publica ;
    aro:textValue "O enredo denuncia demora de remoção e tratamento desrespeitoso ao corpo; falta evidência empírica específica comparável na fonte citada."@pt-BR .

hne:situacaoNarrada_13 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_filho-pobreza,
        hne:padrao_protege-filho ;
    aro:textValue "O personagem deseja deslocar o filho para condições de maior segurança, sem negar seus vínculos de origem."@pt-BR .

hne:situacaoNarrada_14 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_morte-jovem,
        hne:padrao_protege-filho ;
    aro:textValue "A expectativa expressa é preventiva: impedir inserção do filho em um cotidiano de violência armada."@pt-BR .

hne:situacaoNarrada_15 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_aspiracao,
        hne:padrao_filho-pobreza ;
    aro:textValue "A insônia e o planejamento são apresentados como efeitos da precariedade e da responsabilidade familiar; nenhuma condição clínica é diagnosticada."@pt-BR .

hne:situacaoNarrada_16 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_antecedentes,
        hne:padrao_estigma-trabalho ;
    aro:textValue "A passagem associa dificuldades de obtenção de trabalho ao histórico de detenção e ao estigma social."@pt-BR .

hne:situacaoNarrada_17 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_agua,
        hne:padrao_moradia ;
    aro:textValue "O calor e a repetição compõem a temporalidade da precariedade; não constituem por si uma medição climática."@pt-BR .

hne:situacaoNarrada_18 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_agua,
        hne:padrao_saneamento ;
    aro:textValue "O texto indica interrupção de abastecimento prolongada na comunidade; dados agregados não confirmam o episódio exato."@pt-BR .

hne:situacaoNarrada_19 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_resposta-publica,
        hne:padrao_violencia-familiar ;
    aro:textValue "Uma agressão à mãe, associada pelo narrador à embriaguez, mobiliza expectativa de atendimento de urgência."@pt-BR .

hne:situacaoNarrada_20 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_linchamento ;
    aro:textValue "Moradores punem extrajudicialmente o agressor; violência coletiva e responsabilização penal formal não se confundem."@pt-BR .

hne:situacaoNarrada_21 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_alcool ;
    aro:textValue "A narrativa critica a coexistência de campanha antidrogas e ganho econômico com venda de bebidas alcoólicas; trata-se de crítica sociopolítica."@pt-BR .

hne:situacaoNarrada_22 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_fome ;
    aro:textValue "Uma cena de privação alimentar extrema é utilizada para denunciar desigualdade material e abandono social."@pt-BR .

hne:situacaoNarrada_23 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_escola-fome,
        hne:padrao_fome ;
    aro:textValue "A fome é narrada como motivação relevante da frequência escolar, sem implicar que todos os estudantes partilham da situação."@pt-BR .

hne:situacaoNarrada_24 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_escola-futuro ;
    aro:textValue "O narrador questiona as condições sociais de aprendizagem e de desenvolvimento, sem medir desempenho escolar."@pt-BR .

hne:situacaoNarrada_25 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_ostentacao ;
    aro:textValue "A aquisição de bens por um jovem é narrada antes da morte, contrastando mobilidade econômica aparente e insegurança."@pt-BR .

hne:situacaoNarrada_26 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_crack,
        hne:padrao_morte-jovem ;
    aro:textValue "O episódio descreve execução de jovem envolvido na comercialização de cocaína para consumidores de maior poder aquisitivo."@pt-BR .

hne:situacaoNarrada_27 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_espetaculo ;
    aro:textValue "A narrativa critica o lucro e o sensacionalismo jornalístico relacionados à morte violenta."@pt-BR .

hne:situacaoNarrada_28 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_crack ;
    aro:textValue "A referência marca uma mudança temporal na economia local de drogas dentro da ficção; a evidência de 2023 não confirma crescimento atual."@pt-BR .

hne:situacaoNarrada_29 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_aspiracao,
        hne:padrao_economia-ilicita ;
    aro:textValue "O narrador atribui comando econômico a atores privilegiados e exploração a moradores vulneráveis; a estrutura específica não é verificada por dados de consumo."@pt-BR .

hne:situacaoNarrada_30 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_crack,
        hne:padrao_economia-ilicita ;
    aro:textValue "O contraste entre compradores e trabalhadores é interpretação do sistema de consumo ilícito dentro da voz narrativa."@pt-BR .

hne:situacaoNarrada_31 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_morte-anonima,
        hne:padrao_morte-jovem ;
    aro:textValue "A anonimização da própria morte é uma antecipação temida, não a identificação efetiva do personagem."@pt-BR .

hne:situacaoNarrada_32 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_suspeicao ;
    aro:textValue "A suspeição é socialmente distribuída sobre moradores da comunidade na narrativa; não confundir suspeita com culpa."@pt-BR .

hne:situacaoNarrada_33 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_antecedentes,
        hne:padrao_suspeicao ;
    aro:textValue "O histórico do protagonista contribui para seu enquadramento como suspeito; a descrição é intradiegética."@pt-BR .

hne:situacaoNarrada_34 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_antecedentes,
        hne:padrao_estigma-trabalho ;
    aro:textValue "O texto descreve como passado judicial e marcas corporais podem tornar-se rótulos sociais duradouros."@pt-BR .

hne:situacaoNarrada_35 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_policia ;
    aro:textValue "O narrador manifesta temor de agressão ou omissão policial mesmo se ferido; isso é perspectiva do personagem."@pt-BR .

hne:situacaoNarrada_36 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_confronto,
        hne:padrao_policia ;
    aro:textValue "O medo de não receber proteção pública contextualiza escolha de autodefesa sem a validar juridicamente."@pt-BR .

hne:situacaoNarrada_37 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_silencio ;
    aro:textValue "O despertar e a interpretação de ruídos constroem a percepção antecipada de um cerco; não comprovam autoria externa."@pt-BR .

hne:situacaoNarrada_38 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_cerco,
        hne:padrao_silencio ;
    aro:textValue "O silêncio é representado como medo e impotência diante de ameaça armada, não como prova de anuência de moradores."@pt-BR .

hne:situacaoNarrada_39 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_cerco,
        hne:padrao_policia ;
    aro:textValue "A voz narrativa atribui a policiais intenção de executar o personagem; é a percepção narrada, sem observador independente."@pt-BR .

hne:situacaoNarrada_40 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_cerco,
        hne:padrao_confronto ;
    aro:textValue "A passagem menciona vários agentes armados e a arma do protagonista, criando cenário de confronto potencialmente letal."@pt-BR .

hne:situacaoNarrada_41 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_cultura,
        hne:padrao_orixa ;
    aro:textValue "A invocação religiosa é recurso simbólico e existencial; não é evidência de participação religiosa de policiais nem de relação causal com violência."@pt-BR .

hne:situacaoNarrada_42 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_juvenil,
        hne:padrao_orfandade ;
    aro:textValue "O medo de orfandade e de futura institucionalização do filho é projeção do personagem, não destino confirmado."@pt-BR .

hne:situacaoNarrada_43 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_aspiracao,
        hne:padrao_versao ;
    aro:textValue "O desfecho contrapõe sonhos ao som de tiros; o áudio/texto indica violência, mas não documenta diretamente um autor identificável."@pt-BR .

hne:situacaoNarrada_44 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_morte-anonima,
        hne:padrao_versao ;
    aro:textValue "A narração informativa apresenta corpo de homem encontrado morto e identidade social marcada; não estabelece automaticamente relação causal com cenas anteriores."@pt-BR .

hne:situacaoNarrada_45 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_suspeicao,
        hne:padrao_versao ;
    aro:textValue "A notícia final atribui a uma fonte policial uma hipótese sobre a morte; deve ser representada como alegação, não conclusão ontológica."@pt-BR .

hne:situacaoNarrada_46 a aro:SituationDescription ;
    aro:generalizesAs hne:padrao_antecedentes,
        hne:padrao_versao ;
    aro:textValue "A referência final ao histórico penal contextualiza uma estratégia de enquadramento, sem demonstrar verdade sobre a motivação da morte."@pt-BR .

hne:afirmacaoEmpirica_c03 a aro:EmpiricalClaim ;
    aro:textValue "Em inspeções judiciais de 2024, 427 unidades socioeducativas abrigavam 11.016 adolescentes; 95,5% eram do sexo masculino."@pt-BR .

hne:afirmacaoEmpirica_c06 a aro:EmpiricalClaim ;
    aro:textValue "No Censo 2022, 74,6% dos domicílios de favelas possuíam esgotamento por rede, rede pluvial, fossa séptica ou filtro, segundo definição publicada."@pt-BR .

hne:afirmacaoEmpirica_c08 a aro:EmpiricalClaim ;
    aro:textValue "O SINISA 2025 disponibiliza relatórios e indicadores dos serviços de abastecimento de água e esgotamento referentes a 2024."@pt-BR .

hne:afirmacaoEmpirica_c12 a aro:EmpiricalClaim ;
    aro:textValue "O FBSP/Datafolha publicou em 2025 pesquisa representativa de relatos de vitimização de mulheres de 16 anos ou mais."@pt-BR .

hne:afirmacaoEmpirica_c23 a aro:EmpiricalClaim ;
    aro:textValue "Segundo Atlas 2025, pessoas negras tinham risco de homicídio 2,7 vezes o de não negras em 2023."@pt-BR .

hne:afirmacaoEmpirica_c25 a aro:EmpiricalClaim ;
    aro:textValue "Segundo Anuário 2026, mortes decorrentes de intervenção policial representaram 16,2% das mortes violentas intencionais no Brasil em 2025."@pt-BR .

hne:afirmacaoEmpirica_c29 a aro:EmpiricalClaim ;
    aro:textValue "No LENAD III (dados de 2023), 34,7% dos adultos pesquisados relataram consumo episódico pesado no recorte de 30 dias, conforme definição do levantamento."@pt-BR .

hne:afirmacaoEmpirica_c32 a aro:EmpiricalClaim ;
    aro:textValue "Levantamento nacional aponta cocaína como segunda substância ilícita mais consumida, atrás dos derivados de cannabis."@pt-BR .

hne:afirmacaoEmpirica_c33 a aro:EmpiricalClaim ;
    aro:textValue "O OBID disponibiliza o Caderno Temático LENAD III de 2025 sobre consumo de cocaína e crack no Brasil."@pt-BR .

hne:afirmacaoEmpirica_c34 a aro:EmpiricalClaim ;
    aro:textValue "O IBGE incorpora Umbanda e Candomblé como grupo pesquisado na amostra do Censo 2022."@pt-BR .

hne:caso_c03 a aro:EmpiricalCase ;
    dcterms:description "FEBEM é denominação histórica; as unidades e regras atuais são outras. Não descreve a infância do personagem."@pt-BR ;
    prov:wasDerivedFrom hne:fonte_cnj2025 ;
    aro:caseAboutSituation hne:situacaoEmpirica_c03 ;
    aro:citesSource hne:fonte_cnj2025 ;
    aro:textValue "Juventude privada de liberdade: 2024"@pt-BR .

hne:caso_c06 a aro:EmpiricalCase ;
    dcterms:description "O agregado inclui modalidades distintas; não equivale a tratamento de esgoto nem informa sobre o cenário fictício."@pt-BR ;
    prov:wasDerivedFrom hne:fonte_favelaSaneamento ;
    aro:caseAboutSituation hne:situacaoEmpirica_c06 ;
    aro:citesSource hne:fonte_favelaSaneamento ;
    aro:textValue "Infraestrutura de esgotamento nas favelas"@pt-BR .

hne:caso_c08 a aro:EmpiricalCase ;
    dcterms:description "Base de monitoramento não comprova interrupção específica de cinco dias nem ausência local de água."@pt-BR ;
    prov:wasDerivedFrom hne:fonte_sinisa2025 ;
    aro:caseAboutSituation hne:situacaoEmpirica_c08 ;
    aro:citesSource hne:fonte_sinisa2025 ;
    aro:textValue "Gestão nacional de abastecimento e esgoto"@pt-BR .

hne:caso_c12 a aro:EmpiricalCase ;
    dcterms:description "Pesquisa sobre vitimização não comprova o caso narrado na canção."@pt-BR ;
    prov:wasDerivedFrom hne:fonte_mulheres2025 ;
    aro:caseAboutSituation hne:situacaoEmpirica_c12 ;
    aro:citesSource hne:fonte_mulheres2025 ;
    aro:textValue "Pesquisa de vitimização de mulheres 2025"@pt-BR .

hne:caso_c23 a aro:EmpiricalCase ;
    dcterms:description "Razão populacional não estabelece a motivação de cada morte."@pt-BR ;
    prov:wasDerivedFrom hne:fonte_atlas2025 ;
    aro:caseAboutSituation hne:situacaoEmpirica_c23 ;
    aro:citesSource hne:fonte_atlas2025 ;
    aro:textValue "Diferencial racial de vitimização letal em 2023"@pt-BR .

hne:caso_c25 a aro:EmpiricalCase ;
    dcterms:description "Indicador agregado; não autoriza declarar ilegalidade de toda intervenção."@pt-BR ;
    prov:wasDerivedFrom hne:fonte_fbsp2026 ;
    aro:caseAboutSituation hne:situacaoEmpirica_c25 ;
    aro:citesSource hne:fonte_fbsp2026 ;
