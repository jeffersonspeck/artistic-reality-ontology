hne:condicao_agua a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Exclusão estrutural de serviços sem demonstrar a interrupção específica de cinco dias."@pt-BR .

hne:condicao_alcool a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Conexão crítica da narrativa com indicadores de consumo; não prova enriquecimento ilícito."@pt-BR .

hne:condicao_antecedentes a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Fichas penais administrativas não provam automaticamente perpetuação social do estigma."@pt-BR .

hne:condicao_aspiracao a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Aspiração subjetiva e desigualdade agregada são níveis distintos."@pt-BR .

hne:condicao_cerco a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Evidência do fenômeno social sem comprovação da autoria da morte ficcional."@pt-BR .

hne:condicao_confronto a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A descrição do armamento não legitima juridicamente a violência nem estabelece causalidade."@pt-BR .

hne:condicao_crack a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Dados contemporâneos não provam expansão recente do crack em área determinada."@pt-BR .

hne:condicao_cultura a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Representação de práticas comunitárias sem valorizar negativamente crenças."@pt-BR .

hne:condicao_economia-ilicita a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Não comprova organização econômica ou participação de classes sociais específicas."@pt-BR .

hne:condicao_escola-fome a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "O papel da merenda não comprova falta generalizada de valor da escolarização."@pt-BR .

hne:condicao_escola-futuro a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A narrativa apresenta crítica social, mas não mede aprendizagem efetiva."@pt-BR .

hne:condicao_espetaculo a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Dados sobre mortes não testam empiricamente efeitos de linguagem jornalística; evidência indireta."@pt-BR .

hne:condicao_estigma-trabalho a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Indicadores não isolam efeito causal do estigma de ex-presidiário."@pt-BR .

hne:condicao_filho-pobreza a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Preocupação com futuro de criança em situação de privação."@pt-BR .

hne:condicao_fome a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Cenas de fome não equivalem diretamente às categorias da escala EBIA."@pt-BR .

hne:condicao_invisibilidade a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Ser contado não significa receber políticas suficientes; não presume negligência comprovada."@pt-BR .

hne:condicao_juvenil a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Experiência juvenil de internação e composição demográfica das medidas socioeducativas."@pt-BR .

hne:condicao_liberdade a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Desejo individual de liberdade não se reduz a estatísticas de custódia."@pt-BR .

hne:condicao_linchamento a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Casos coletivos de violência não oficial; motivação das ocorrências pode ser diferente."@pt-BR .

hne:condicao_moradia a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Habitação como refúgio e como expressão de desigualdade de infraestrutura."@pt-BR .

hne:condicao_morte-anonima a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Estimativas de mortes ocultas não implicam falta de identificação nominal da vítima."@pt-BR .

hne:condicao_morte-jovem a aro:PatternCondition ;
    aro:isRequiredCondition true ;
