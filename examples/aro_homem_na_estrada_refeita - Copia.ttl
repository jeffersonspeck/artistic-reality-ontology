hne:condicao_saneamento a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Serviço e qualidade da infraestrutura não são iguais ao simples registro territorial."@pt-BR .

hne:condicao_silencio a aro:PatternCondition ;
    aro:isRequiredCondition true ;
