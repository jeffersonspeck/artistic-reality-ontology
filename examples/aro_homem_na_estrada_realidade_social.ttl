    aro:groupsSelection hnr:recorte01, hnr:recorte02, hnr:recorte03, hnr:recorte04, hnr:recorte05,
        hnr:recorte06, hnr:recorte07, hnr:recorte08, hnr:recorte09, hnr:recorte10,
        hnr:recorte11, hnr:recorte12, hnr:recorte13, hnr:recorte14, hnr:recorte15 ;
    aro:textValue "Recortes em que a narrativa representa situações sociais confrontáveis com evidência externa"@pt-BR .

