# aro_homem_na_estrada_realidade_social.ttl — ARO 1.0.0
# Homem na Estrada (Racionais MC's, 1993): realidade social sustentada por evidências.
#
# Anotação na estrutura da ARO 1.0.0 (claims, nível superior UFO, níveis IFLA LRM,
# validação OntoUML), a mesma introduzida na 0.3. Substitui as anotações de Homem na Estrada feitas na 0.2
# (aro_homem_na_estrada_refeita.ttl, sua cópia e example_homem_na_estrada_revisado.ttl),
# reunindo a camada empírica desta anotação e a derivação do sample de "Ela Partiu".
# Relatório: docs/pt-BR/relatorio-anotacao-homem-na-estrada-realidade-social.md
#
# Nenhum verso da letra é reproduzido: os recortes guardam só coordenadas de linha
# (RFC 5147) e uma descrição temática. Textos protegidos ficam em private/ (fora do git).
#
# Padrão seguido aqui:
#   - agentes tipados como aro:Person / aro:Collective (ADR-029), além do tipo schema.org;
#   - obra (Artwork) → expressões (Expression: gravação e letra) → manifestações
#     (Manifestation: álbum e transcrição pública) (ADR-028);
#   - todo registro analítico tem autoria por aro:producedByAct (ADR-033);
#   - avaliações declaram aro:assessmentOutcome e usam aro:assessesClaim;
#   - fontes citadas por aro:citesSource (relação única de citação);
#   - atos e situações empíricas datados por aro:startDate / aro:endDate (ADR-030).

@prefix aro: <https://w3id.org/aro/ontology#> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hnr: <https://example.org/aro-homem-na-estrada-realidade/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# Metadados e compromisso epistêmico
# -----------------------------------------------------------------------------

hnr:anotacao2026 a schema:Dataset ;
    dcterms:title "Homem na Estrada — realidade social sustentada por evidências"@pt-BR ;
    dcterms:created "2026-11-05"^^xsd:date ;
    dcterms:modified "2026-11-07"^^xsd:date ;
    dcterms:conformsTo <https://w3id.org/aro/ontology/1.0.0> ;
    dcterms:creator hnr:analistaPesquisador ;
    dcterms:description "Anotação autossuficiente. As fontes sustentam que os tipos de situação representados existem ou persistem no mundo social. Não se exige contemporaneidade entre a obra e a fonte, e não se afirma que a fonte documente o personagem, o bairro ou o episódio ficcional. A cadeia empírica é: fonte de referência → item de evidência → afirmação empírica e caso empírico → alegação de correspondência com um padrão → avaliação explícita do alcance."@pt-BR .

hnr:analistaPesquisador a schema:Person, aro:Person ;
    schema:name "Jefferson Rodrigo Speck" ;
    schema:affiliation "Programa de Pós-Graduação em Informática (PPGInf), Universidade Federal do Paraná (UFPR)"@pt-BR .

# -----------------------------------------------------------------------------
# Obra, expressões e manifestações (IFLA LRM)
# -----------------------------------------------------------------------------

hnr:homemNaEstrada a aro:Artwork ;
    aro:externalLink "https://en.wikipedia.org/wiki/Raio-X_do_Brasil"^^xsd:anyURI ;
    aro:textValue "Homem na Estrada — Racionais MC's"@pt-BR .

hnr:gravacao1993 a aro:Expression ;
    aro:realizesArtwork hnr:homemNaEstrada ;
    aro:hasManifestation hnr:albumRaioXDoBrasil ;
    aro:textValue "Gravação de 1993 dos Racionais MC's"@pt-BR .

hnr:letra a aro:Expression ;
    aro:realizesArtwork hnr:homemNaEstrada ;
    aro:hasManifestation hnr:transcricaoCifraClub ;
    aro:textValue "Texto da letra de Homem na Estrada (compositor: Pedro Paulo Soares Pereira)"@pt-BR .

hnr:albumRaioXDoBrasil a aro:Manifestation ;
    aro:embodiesExpression hnr:gravacao1993 ;
    aro:externalLink "https://en.wikipedia.org/wiki/Raio-X_do_Brasil"^^xsd:anyURI ;
    aro:textValue "Álbum Raio X do Brasil (1993)"@pt-BR .

# A numeração de linhas dos recortes vale para esta transcrição; ela é usada apenas
# para localizar recortes.
hnr:transcricaoCifraClub a aro:Manifestation ;
    aro:embodiesExpression hnr:letra ;
    aro:externalLink "https://www.cifraclub.com.br/racionais-mcs/homem-na-estrada/letra/"^^xsd:anyURI ;
    aro:textValue "Transcrição pública da letra (Cifra Club), usada apenas para localizar recortes"@pt-BR .

# -----------------------------------------------------------------------------
# Criação (ato criativo e contribuições) e agentes
# -----------------------------------------------------------------------------

hnr:criacao1993 a aro:CreativeAct ;
    aro:startDate "1993"^^xsd:gYear ;
    aro:hasContribution hnr:contribuicaoAutoria, hnr:contribuicaoInterpretacao ;
    aro:producesCreation hnr:homemNaEstrada, hnr:gravacao1993, hnr:letra .

hnr:contribuicaoAutoria a aro:CreativeContribution ;
    aro:contributionBy dbr:Mano_Brown ;
    aro:contributionRole aro:AuthorRole, aro:LyricistRole, aro:ComposerRole ;
    aro:contributionTo hnr:homemNaEstrada, hnr:letra .

hnr:contribuicaoInterpretacao a aro:CreativeContribution ;
    aro:contributionBy <http://dbpedia.org/resource/Racionais_MC's> ;
    aro:contributionRole aro:PerformerRole ;
    aro:contributionTo hnr:gravacao1993 .

dbr:Mano_Brown a schema:Person, aro:Person ;
    schema:name "Pedro Paulo Soares Pereira" ;
    schema:alternateName "Mano Brown" .

<http://dbpedia.org/resource/Racionais_MC's> a schema:MusicGroup, aro:Collective ;
    schema:name "Racionais MC's" .

# -----------------------------------------------------------------------------
# Derivação: a gravação de 1993 usa um sample de "Ela Partiu" (Tim Maia)
# -----------------------------------------------------------------------------

hnr:elaPartiu a aro:Artwork ;
    aro:textValue "Ela Partiu — Tim Maia"@pt-BR .

hnr:derivacaoSampleElaPartiu a aro:DerivationClaim ;
    aro:producedByAct hnr:atoInterpretativo2026 ;
    aro:hasSourceAnchor hnr:elaPartiu ;
    aro:hasDerivedAnchor hnr:gravacao1993 ;
    aro:hasDerivationType aro:Sampling ;
    aro:hasTransformation hnr:aspectoSampleElaPartiu ;
    aro:derivationRealizedBy hnr:criacao1993 ;
    aro:hasJustification hnr:justificativaSampleElaPartiu ;
    aro:citesSource hnr:fonteRaioXWiki ;
    aro:textValue "A gravação de Homem na Estrada (1993) usa um sample de Ela Partiu, de Tim Maia."@pt-BR .

hnr:aspectoSampleElaPartiu a aro:TransformationAspect ;
    aro:producedByAct hnr:atoInterpretativo2026 ;
    aro:hasDimension aro:RecordedSoundDimension ;
    aro:hasOperation aro:Recontextualized ;
    aro:textValue "O som gravado de uma canção romântica de soul passa a acompanhar uma narrativa sobre violência, encarceramento e exclusão urbana."@pt-BR .

hnr:justificativaSampleElaPartiu a aro:Justification ;
    aro:producedByAct hnr:atoInterpretativo2026 ;
    aro:textValue "O uso do sample é informado pela ficha do álbum Raio X do Brasil. A leitura de que o sentido do som muda com o novo contexto é interpretativa e revisável; a anotação não avalia autorização nem licenciamento do sample (ADR-014)."@pt-BR .

hnr:fonteRaioXWiki a aro:ReferenceSource ;
    rdfs:label "Raio-X do Brasil (artigo sobre o álbum; lista o sample de Ela Partiu, de Tim Maia)"@pt-BR ;
    aro:languageTag "en" ;
    aro:sourceURL "https://en.wikipedia.org/wiki/Raio-X_do_Brasil"^^xsd:anyURI ;
    aro:textValue "Raio-X do Brasil (artigo sobre o álbum; lista o sample de Ela Partiu, de Tim Maia)"@pt-BR .

# -----------------------------------------------------------------------------
