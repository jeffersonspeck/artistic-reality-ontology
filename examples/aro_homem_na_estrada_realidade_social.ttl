    aro:textValue "Leitura dos recortes e registro das interpretações e da derivação"@pt-BR .

hnr:atoAvaliacao2026 a aro:InterpretiveAct ;
    aro:hasParticipant hnr:analistaPesquisador ;
    aro:startDate "2026-11-05"^^xsd:date ;
    aro:endDate "2026-11-07"^^xsd:date ;
    aro:textValue "Levantamento de fontes, formulação das afirmações empíricas e correspondências, avaliação das evidências e revisão crítica das interpretações"@pt-BR .

