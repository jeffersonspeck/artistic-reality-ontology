  aro:textValue "UFPB repository — undergraduate thesis on police violence and the absence of the State in Homem na Estrada"@en ;
  aro:sourceURL "https://repositorio.ufpb.br/jspui/handle/123456789/31862"^^xsd:anyURI ; aro:languageTag "pt-BR" .
