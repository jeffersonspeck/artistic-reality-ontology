  aro:textValue "Poder360 — 100 milhões de brasileiros não têm coleta de esgoto em casa (Trata Brasil study based on SNIS data)"@pt-BR ;
  aro:sourceURL "https://www.poder360.com.br/brasil/100-milhoes-de-brasileiros-nao-tem-coleta-de-esgotos-em-casa/"^^xsd:anyURI ;
  aro:languageTag "pt-BR" .
ex:src-fapesp-seca a aro:ReferenceSource ;
  aro:textValue "Revista Pesquisa FAPESP — Memórias da seca"@pt-BR ;
  aro:sourceURL "https://revistapesquisa.fapesp.br/memorias-da-seca/"^^xsd:anyURI ; aro:languageTag "pt-BR" .
ex:src-patu a aro:ReferenceSource ;
