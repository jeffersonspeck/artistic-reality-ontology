  aro:sourceURL "https://diariodonordeste.verdesmares.com.br/ceara/campo-de-concentracao-que-abrigou-16-mil-retirantes-no-ceara-deve-ter-predios-e-ruinas-tombados-1.3258221"^^xsd:anyURI ;
  aro:languageTag "pt-BR" .
# Sources about the works themselves
ex:src-intexto a aro:ReferenceSource ;
  aro:textValue "Intexto (UFRGS) — Análise interseccional e discursiva das identidades culturais na canção Homem na Estrada do Racionais MC's (1993)"@pt-BR ;
  aro:sourceURL "https://seer.ufrgs.br/index.php/intexto/article/view/150581"^^xsd:anyURI ; aro:languageTag "pt-BR" .
