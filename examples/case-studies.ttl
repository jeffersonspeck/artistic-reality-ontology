  aro:confidenceScore 0.85 ; aro:citesSource ex:src-ufpb .
ex:hne-s15 a aro:SituationDescription ; aro:mentionsDepictedElement ex:hne-man, ex:hne-police, ex:hne-mboi ;
  aro:textValue "A news-style report: a mixed-race man is found dead on the M'Boi Mirim road; the police attribute it to rival gangs and cite his long criminal record."@en, "Um relato em tom de notícia: um homem mulato é encontrado morto na estrada do M'Boi Mirim; a polícia atribui a morte a quadrilhas rivais e destaca seus antecedentes criminais."@pt-BR ;
  aro:generalizesAs ex:pattern-state-violence .

ex:hne-man a aro:DepictedAgent ; aro:textValue "the man on the road (protagonist)"@en, "o homem na estrada (protagonista)"@pt-BR .
ex:hne-police a aro:DepictedAgent ; aro:textValue "the police"@en, "a polícia"@pt-BR .
ex:hne-febem a aro:DepictedElement ; aro:textValue "FEBEM (juvenile detention system of São Paulo)"@en, "FEBEM (sistema de internação de menores de São Paulo)"@pt-BR .
ex:hne-ibge a aro:DepictedElement ; aro:textValue "IBGE (Brazilian census bureau)"@en, "IBGE"@pt-BR .
ex:hne-iml a aro:DepictedElement ; aro:textValue "IML (forensic medical institute)"@en, "IML (Instituto Médico Legal)"@pt-BR .
ex:hne-mboi a aro:DepictedElement ; aro:textValue "Estrada do M'Boi Mirim (road in the south of São Paulo)"@en, "Estrada do M'Boi Mirim (zona sul de São Paulo)"@pt-BR .

# Plural readings: the analyst's justification for event 15, and a recorded challenge
ex:hne-r15 aro:hasJustification ex:hne-just15 .
ex:hne-just15 a aro:Justification ;
  aro:textValue "The narrative sequence (police raid at dawn, then the man's death) contrasts with the closing report attributing the death to rival gangs; the reading takes the report as the official version that criminalizes the victim."@en,
                "A sequência narrativa (invasão policial de madrugada e depois a morte do homem) contrasta com o relato final que atribui a morte a quadrilhas rivais; a leitura toma o relato como versão oficial que criminaliza a vítima."@pt-BR .
ex:hne-challenge15 a aro:Challenge ; aro:challenges ex:hne-r15 ; aro:producedByAct ex:review-act ;
  aro:textValue "Alternative reading: the lyrics leave the killers implicit, so the report's version cannot be excluded within the narrative itself."@en,
                "Leitura alternativa: a letra deixa os autores implícitos, então a versão do relato não pode ser excluída dentro da própria narrativa."@pt-BR .

# Competing interpretation of the same passage, by the reviewer (ADR-002: both coexist)
ex:hne-r15b a aro:InterpretationRecord ; aro:hasPrimarySelection ex:hne-e15 ;
  aro:producedByAct ex:review-act ; aro:describesSituation ex:hne-s15b ; aro:confidenceScore 0.6 .
ex:hne-s15b a aro:SituationDescription ; aro:mentionsDepictedElement ex:hne-man ;
  aro:textValue "The closing report leaves the death unexplained: the song shows how the man is remembered by the press, not who killed him."@en,
                "O relato final deixa a morte sem explicação: a canção mostra como o homem é lembrado pela imprensa, não quem o matou."@pt-BR .
# The reviewer assesses the first reading by explicit criteria, one epistemic and one of value
ex:crit-textual-support a aro:EpistemicCriterion ;
  aro:textValue "Textual support: the reading follows from the passage and its context in the lyrics."@en,
                "Apoio textual: a leitura decorre do trecho e de seu contexto na letra."@pt-BR .
ex:crit-social-relevance a aro:ValueCriterion ;
  aro:textValue "Social relevance: the reading helps discuss a documented social problem."@en,
                "Relevância social: a leitura ajuda a discutir um problema social documentado."@pt-BR .
ex:assess-hne-r15 a aro:CriteriaAssessment ; aro:assessesClaim ex:hne-r15 ;
  aro:usesCriterion ex:crit-textual-support, ex:crit-social-relevance ;
  aro:producedByAct ex:review-act ; aro:assessmentOutcome "partiallySupports" ;
  aro:textValue "Socially relevant and supported by the sequence of events, but the lyrics do not name the killers, so the official version is not excluded."@en,
                "Socialmente relevante e apoiada pela sequência de eventos, mas a letra não nomeia os autores, então a versão oficial não é excluída."@pt-BR .

# --- Derivation: the track samples Tim Maia's "Ela Partiu" ------------------------
ex:ela-partiu a aro:Artwork ; aro:textValue "Ela Partiu (Tim Maia)"@pt-BR, "Ela Partiu (Tim Maia)"@en .
ex:deriv-hne-sample a aro:DerivationClaim ;
  aro:hasSourceAnchor ex:ela-partiu ; aro:hasDerivedAnchor ex:homem-na-estrada ;
  aro:hasDerivationType aro:Sampling ;
  aro:hasTransformation ex:deriv-hne-sound ;
  aro:citesSource ex:src-raio-x-wiki ;
  aro:derivationRealizedBy ex:homem-na-estrada-creation .
ex:deriv-hne-sound a aro:TransformationAspect ;
  aro:hasDimension aro:RecordedSoundDimension ; aro:hasOperation aro:Recontextualized .

# =====================================================================================
# 2. VIDAS SECAS — Graciliano Ramos (novel, 1938) and the 1963 film
# =====================================================================================
ex:vidas-secas a aro:Artwork ;
  aro:textValue "Vidas Secas"@pt-BR, "Vidas Secas (Barren Lives)"@en ;
  aro:externalLink "https://pt.wikipedia.org/wiki/Vidas_Secas"^^xsd:anyURI .
ex:vidas-secas-1938 a aro:Expression ; aro:realizesArtwork ex:vidas-secas ;
  aro:textValue "Original Portuguese text of the novel (1938)"@en, "Texto original do romance em português (1938)"@pt-BR ;
  aro:hasManifestation ex:vidas-secas-first-edition .
ex:vidas-secas-first-edition a aro:Manifestation ; aro:embodiesExpression ex:vidas-secas-1938 ;
  aro:textValue "First edition of the novel (1938)"@en, "Primeira edição do romance (1938)"@pt-BR .
ex:vidas-secas-creation a aro:CreativeAct ; aro:startDate "1938"^^xsd:gYear ;
  aro:producesCreation ex:vidas-secas, ex:vidas-secas-1938 ; aro:hasContribution ex:vs-author .
ex:vs-author a aro:CreativeContribution ; aro:contributionTo ex:vidas-secas, ex:vidas-secas-1938 ; aro:contributionBy dbr:Graciliano_Ramos ; aro:contributionRole aro:AuthorRole .
dbr:Graciliano_Ramos a schema:Person, aro:Person ; schema:name "Graciliano Ramos" .

# --- Events: one chapter each ------------------------------------------------------
ex:vs-mudanca a aro:Selection ; aro:selectsFrom ex:vidas-secas-1938 ; aro:selectorExpression "chapter 1 «Mudança»" .
ex:vs-cadeia  a aro:Selection ; aro:selectsFrom ex:vidas-secas-1938 ; aro:selectorExpression "chapter 3 «Cadeia»" .
ex:vs-contas  a aro:Selection ; aro:selectsFrom ex:vidas-secas-1938 ; aro:selectorExpression "chapter 10 «Contas»" .
ex:vs-fuga    a aro:Selection ; aro:selectsFrom ex:vidas-secas-1938 ; aro:selectorExpression "chapter 13 «Fuga»" .

ex:vs-r1 a aro:InterpretationRecord ; aro:hasPrimarySelection ex:vs-mudanca ; aro:producedByAct ex:reading-act ;
  aro:describesSituation ex:vs-s1 ; aro:confidenceScore 0.95 .
ex:vs-s1 a aro:SituationDescription ; aro:mentionsDepictedElement ex:vs-fabiano ;
  aro:textValue "A family of rural workers walks across the drought-stricken backlands looking for somewhere to survive."@en,
                "Uma família de trabalhadores rurais atravessa o sertão castigado pela seca em busca de onde sobreviver."@pt-BR ;
  aro:generalizesAs ex:pattern-drought-migration .

ex:vs-r2 a aro:InterpretationRecord ; aro:hasPrimarySelection ex:vs-cadeia ; aro:producedByAct ex:reading-act ;
  aro:describesSituation ex:vs-s2 ; aro:confidenceScore 0.95 .
ex:vs-s2 a aro:SituationDescription ; aro:mentionsDepictedElement ex:vs-fabiano, ex:vs-soldier ;
  aro:textValue "In town, a soldier provokes Fabiano, who is arrested, beaten and spends the night in jail without having committed a crime."@en,
                "Na cidade, um soldado provoca Fabiano, que é preso, espancado e passa a noite na cadeia sem ter cometido crime."@pt-BR ;
  aro:generalizesAs ex:pattern-state-violence .

ex:vs-r3 a aro:InterpretationRecord ; aro:hasPrimarySelection ex:vs-contas ; aro:producedByAct ex:reading-act ;
  aro:describesSituation ex:vs-s3 ; aro:confidenceScore 0.9 .
ex:vs-s3 a aro:SituationDescription ; aro:mentionsDepictedElement ex:vs-fabiano ;
  aro:textValue "The landowner's accounts, with interest Fabiano cannot check, leave him always in debt."@en,
                "As contas do patrão, com juros que Fabiano não consegue conferir, o deixam sempre endividado."@pt-BR ;
  aro:generalizesAs ex:pattern-debt-exploitation .

ex:vs-r4 a aro:InterpretationRecord ; aro:hasPrimarySelection ex:vs-fuga ; aro:producedByAct ex:reading-act ;
  aro:describesSituation ex:vs-s4 ; aro:confidenceScore 0.95 .
ex:vs-s4 a aro:IntentionalStateDescription ; aro:mentionsDepictedElement ex:vs-fabiano ;
  aro:textValue "With a new drought, the family leaves again, hoping for a better life in the cities of the south."@en,
                "Com uma nova seca, a família parte de novo, esperando uma vida melhor nas cidades do sul."@pt-BR ;
  aro:generalizesAs ex:pattern-drought-migration .

ex:vs-fabiano a aro:DepictedAgent ; aro:textValue "Fabiano"@pt-BR, "Fabiano"@en .
ex:vs-soldier a aro:DepictedAgent ; aro:textValue "the yellow soldier"@en, "o soldado amarelo"@pt-BR .

# --- Derivation: the 1963 film adaptation ------------------------------------------
ex:vidas-secas-film a aro:Artwork ;
  aro:textValue "Vidas Secas (film, 1963)"@pt-BR, "Barren Lives (film, 1963)"@en ;
  aro:externalLink "https://en.wikipedia.org/wiki/Barren_Lives_(film)"^^xsd:anyURI .
ex:vidas-secas-film-production a aro:CreativeAct ; aro:startDate "1963"^^xsd:gYear ; aro:producesCreation ex:vidas-secas-film ;
  aro:hasContribution ex:vsf-director .
ex:vsf-director a aro:CreativeContribution ; aro:contributionTo ex:vidas-secas-film ; aro:contributionBy dbr:Nelson_Pereira_dos_Santos ;
  aro:contributionRole aro:DirectorRole, aro:AdapterRole .
dbr:Nelson_Pereira_dos_Santos a schema:Person, aro:Person ; schema:name "Nelson Pereira dos Santos" .
ex:deriv-vs-film a aro:DerivationClaim ;
  aro:hasSourceAnchor ex:vidas-secas ; aro:hasDerivedAnchor ex:vidas-secas-film ;
  aro:hasDerivationType aro:IntermedialAdaptation ; aro:hasRegime aro:SeriousRegime ;
  aro:derivationRealizedBy ex:vidas-secas-film-production ;
  aro:citesSource ex:src-barren-lives-wiki ;
  aro:hasTransformation ex:deriv-vs-medium, ex:deriv-vs-situation .
ex:deriv-vs-medium a aro:TransformationAspect ; aro:hasDimension aro:MediumDimension ; aro:hasOperation aro:Modified .
ex:deriv-vs-situation a aro:TransformationAspect ; aro:hasDimension aro:SituationDimension ; aro:hasOperation aro:Retained ;
  aro:aspectConcernsPattern ex:pattern-state-violence, ex:pattern-drought-migration ; aro:confidenceScore 0.7 .

# =====================================================================================
# 3. SITUATION PATTERNS (reused across works)
# =====================================================================================
ex:pattern-state-violence a aro:SituationPattern ;
  aro:textValue "Arbitrary or lethal violence by state security agents against a poor man"@en,
                "Violência arbitrária ou letal de agentes de segurança do Estado contra um homem pobre"@pt-BR ;
  aro:hasCondition ex:c-sv-agent, ex:c-sv-victim, ex:c-sv-framing, ex:c-sv-lethal .
ex:c-sv-agent a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "The aggressor acts as an agent of state security (police, soldier)."@en, "O agressor age como agente de segurança do Estado (polícia, soldado)."@pt-BR .
ex:c-sv-victim a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "The victim is poor or socially marginalized."@en, "A vítima é pobre ou socialmente marginalizada."@pt-BR .
ex:c-sv-framing a aro:PatternCondition ; aro:isRequiredCondition false ;
  aro:textValue "The victim is framed as an offender."@en, "A vítima é retratada como infratora."@pt-BR .
ex:c-sv-lethal a aro:PatternCondition ; aro:isRequiredCondition false ;
  aro:textValue "The violence is lethal."@en, "A violência é letal."@pt-BR .

ex:pattern-reintegration a aro:SituationPattern ;
  aro:textValue "Barriers to social reintegration after prison"@en, "Barreiras à reintegração social após a prisão"@pt-BR ;
  aro:hasCondition ex:c-ri-released, ex:c-ri-barrier .
ex:c-ri-released a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "A person has left prison."@en, "Uma pessoa saiu da prisão."@pt-BR .
ex:c-ri-barrier a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "Work or social acceptance is denied because of the criminal record."@en, "Trabalho ou aceitação social são negados por causa dos antecedentes."@pt-BR .

ex:pattern-precarious-housing a aro:SituationPattern ;
  aro:textValue "Precarious urban housing without basic sanitation or water supply"@en, "Moradia urbana precária sem saneamento ou abastecimento de água"@pt-BR ;
  aro:hasCondition ex:c-ph .
ex:c-ph a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "Households lack sewage collection or other basic services."@en, "Domicílios sem coleta de esgoto ou outros serviços básicos."@pt-BR .

ex:pattern-drought-migration a aro:SituationPattern ;
  aro:textValue "Drought-driven forced migration of rural families"@en, "Migração forçada de famílias rurais causada pela seca"@pt-BR ;
  aro:hasCondition ex:c-dm .
ex:c-dm a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "A family leaves its place of living because drought makes survival impossible."@en, "Uma família deixa seu lugar porque a seca torna a sobrevivência impossível."@pt-BR .

ex:pattern-debt-exploitation a aro:SituationPattern ;
  aro:textValue "Exploitation of rural workers through debt and opaque accounts"@en, "Exploração de trabalhadores rurais por dívidas e contas opacas"@pt-BR ;
  aro:hasCondition ex:c-de .
ex:c-de a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "The worker's earnings are controlled by the employer's accounts and debts."@en, "Os ganhos do trabalhador são controlados pelas contas e dívidas do empregador."@pt-BR .

ex:pattern-state-absence a aro:SituationPattern ;
  aro:textValue "Absence or delay of public services in the urban periphery"@en,
                "Ausência ou atraso de serviços públicos na periferia urbana"@pt-BR ;
  aro:hasCondition ex:c-sa .
ex:c-sa a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "A public service (census, forensics, water, health) is absent or arrives very late in a poor neighbourhood."@en,
                "Um serviço público (censo, perícia, água, saúde) está ausente ou chega muito atrasado num bairro pobre."@pt-BR .

ex:pattern-youth-detention a aro:SituationPattern ;
  aro:textValue "Institutionalization of poor youth in juvenile detention"@en,
                "Institucionalização de jovens pobres em internação de menores"@pt-BR ;
  aro:hasCondition ex:c-yd .
ex:c-yd a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "A poor child or adolescent is held in a juvenile detention institution."@en,
                "Uma criança ou adolescente pobre é mantida numa instituição de internação."@pt-BR .

ex:pattern-lynching a aro:SituationPattern ;
  aro:textValue "Lynching as popular punishment in a neighbourhood"@en, "Linchamento como punição popular no bairro"@pt-BR ;
  aro:hasCondition ex:c-ly .
ex:c-ly a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "Residents collectively attack a person accused of a crime, without any legal process."@en,
                "Moradores atacam coletivamente uma pessoa acusada de crime, sem processo legal."@pt-BR .

ex:pattern-hunger a aro:SituationPattern ;
  aro:textValue "Child hunger and dependence on school meals"@en, "Fome infantil e dependência da merenda escolar"@pt-BR ;
  aro:hasCondition ex:c-hu .
ex:c-hu a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "Children lack regular food and rely on scraps or school meals."@en,
                "Crianças não têm alimentação regular e dependem de restos ou da merenda escolar."@pt-BR .

ex:pattern-drug-trade-violence a aro:SituationPattern ;
  aro:textValue "Lethal violence linked to the retail drug trade, with profits concentrated outside the periphery"@en,
                "Violência letal ligada ao varejo de drogas, com lucros concentrados fora da periferia"@pt-BR ;
  aro:hasCondition ex:c-dt .
ex:c-dt a aro:PatternCondition ; aro:isRequiredCondition true ;
  aro:textValue "A young retail drug seller from the periphery is killed while wealthier actors profit."@en,
                "Um jovem vendedor de drogas da periferia é morto enquanto atores mais ricos lucram."@pt-BR .

# Explanatory hypothesis (a claim, not an established cause)
ex:hyp-selective-policing a aro:ExplanationHypothesis ; aro:explainsPattern ex:pattern-state-violence ;
  aro:textValue "Hypothesis: selective policing of poor and Black populations increases their exposure to state violence."@en,
                "Hipótese: o policiamento seletivo de populações pobres e negras aumenta sua exposição à violência do Estado."@pt-BR .
# The same evidence that supports the correspondence is not enough for the causal hypothesis
ex:assess-hyp-policing a aro:EvidenceAssessment ; aro:assessmentOutcome "inconclusive" ;
  aro:assessesClaim ex:hyp-selective-policing ; aro:assessesEvidence ex:ev-fbsp ; aro:producedByAct ex:review-act ;
  aro:textValue "The report shows who the victims are (a correlation), not why: insufficient to infer selective policing as the cause."@en,
                "O relatório mostra quem são as vítimas (uma correlação), não por quê: insuficiente para inferir o policiamento seletivo como causa."@pt-BR .

