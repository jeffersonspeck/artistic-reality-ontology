  aro:textValue "Barren Lives (film) — encyclopedic article on the 1963 adaptation"@en ;
  aro:sourceURL "https://en.wikipedia.org/wiki/Barren_Lives_(film)"^^xsd:anyURI ; aro:languageTag "en" .

# =====================================================================================
# 5. EMPIRICAL CASES, EVIDENCE, CORRESPONDENCE CLAIMS AND ASSESSMENTS
# =====================================================================================
# --- Police lethality in Brazil --------------------------------------------------
ex:case-police-lethality a aro:EmpiricalCase ;
  aro:textValue "Deaths resulting from police interventions in Brazil (national statistics)"@en,
                "Mortes decorrentes de intervenção policial no Brasil (estatísticas nacionais)"@pt-BR ;
  aro:caseAboutSituation ex:sit-police-lethality ; aro:citesSource ex:src-fbsp-2020 .
ex:sit-police-lethality a aro:EmpiricalSituation .
ex:ev-fbsp a aro:EvidenceItem ; aro:derivedFromSource ex:src-fbsp-2020 ;
  aro:externalLink "https://forumseguranca.org.br/wp-content/uploads/2021/07/4-as-mortes-decorrentes-de-intervencao-policial-no-brasil-em-2020.pdf"^^xsd:anyURI ;
  aro:textValue "The report presents national and state counts of deaths resulting from police interventions and the profile of the victims."@en,
                "O relatório apresenta contagens nacionais e estaduais de mortes decorrentes de intervenção policial e o perfil das vítimas."@pt-BR .
ex:corr-hne-police a aro:CorrespondenceClaim ;
  aro:assertsPattern ex:pattern-state-violence ; aro:assertsCase ex:case-police-lethality ;
  aro:citesSource ex:src-fbsp-2020 ;
  aro:textValue "The pattern represented in the song is similar to documented, recurrent police lethality in Brazil."@en,
                "O padrão representado na canção é semelhante à letalidade policial documentada e recorrente no Brasil."@pt-BR .
ex:assess-hne-police a aro:EvidenceAssessment ; aro:assessmentOutcome "supports" ; aro:assessesClaim ex:corr-hne-police ; aro:assessesEvidence ex:ev-fbsp ;
  aro:textValue "Supports that the represented situation is possible and recurrent; does not show that the song narrates a specific real event, nor any cause."@en,
                "Apoia que a situação representada é possível e recorrente; não mostra que a canção narra um evento real específico, nem causa alguma."@pt-BR .

# --- Carandiru massacre (1992), contemporary to the song -------------------------
ex:case-carandiru a aro:EmpiricalCase ;
  aro:textValue "Carandiru massacre, São Paulo, 2 October 1992"@en, "Massacre do Carandiru, São Paulo, 2 de outubro de 1992"@pt-BR ;
  aro:caseAboutEvent ex:event-carandiru ; aro:citesSource ex:src-carandiru .
ex:event-carandiru a aro:EmpiricalEvent .
ex:ev-carandiru a aro:EvidenceItem ; aro:derivedFromSource ex:src-carandiru ;
  aro:textValue "Military Police intervention in the Carandiru prison that left 111 prisoners dead."@en,
                "Intervenção da Polícia Militar no presídio do Carandiru que deixou 111 presos mortos."@pt-BR .
ex:corr-carandiru a aro:CorrespondenceClaim ;
  aro:assertsPattern ex:pattern-state-violence ; aro:assertsCase ex:case-carandiru ; aro:citesSource ex:src-carandiru ;
  aro:textValue "A documented, large-scale instance of lethal state violence against marginalized men, one year before the song."@en,
                "Instância documentada e de grande escala de violência letal do Estado contra homens marginalizados, um ano antes da canção."@pt-BR .
ex:assess-carandiru a aro:EvidenceAssessment ; aro:assessmentOutcome "supports" ; aro:assessesClaim ex:corr-carandiru ; aro:assessesEvidence ex:ev-carandiru ;
  aro:textValue "Supports the pattern as a real possibility in the song's historical context; the song is not claimed to describe this event."@en,
                "Apoia o padrão como possibilidade real no contexto histórico da canção; não se alega que a canção descreva este evento."@pt-BR .

# --- Reintegration after prison ----------------------------------------------------
ex:case-reintegration a aro:EmpiricalCase ;
  aro:textValue "Criminal recidivism and reintegration of former prisoners in Brazil"@en,
                "Reincidência criminal e reintegração de egressos do sistema prisional no Brasil"@pt-BR ;
  aro:caseAboutSituation ex:sit-reintegration ; aro:citesSource ex:src-ipea-2015 .
ex:sit-reintegration a aro:EmpiricalSituation .
ex:ev-ipea a aro:EvidenceItem ; aro:derivedFromSource ex:src-ipea-2015 ;
  aro:textValue "The report estimates recidivism from data of several states, describes the profile of recidivists and warns against the widely repeated but unsupported 70% figure."@en,
                "O relatório estima a reincidência a partir de dados de vários estados, descreve o perfil dos reincidentes e alerta contra o número de 70%, repetido sem fundamento."@pt-BR .
ex:corr-reintegration a aro:CorrespondenceClaim ;
  aro:assertsPattern ex:pattern-reintegration ; aro:assertsCase ex:case-reintegration ; aro:citesSource ex:src-ipea-2015 ;
  aro:textValue "The difficulties represented in the song correspond to a documented field of research on reintegration and recidivism."@en,
                "As dificuldades representadas na canção correspondem a um campo documentado de pesquisa sobre reintegração e reincidência."@pt-BR .
ex:assess-reintegration a aro:EvidenceAssessment ; aro:assessmentOutcome "partiallySupports" ; aro:assessesClaim ex:corr-reintegration ; aro:assessesEvidence ex:ev-ipea ;
  aro:textValue "Partial support: documents recidivism and the profile of former prisoners, but does not by itself measure job refusal due to a criminal record."@en,
                "Apoio parcial: documenta a reincidência e o perfil dos egressos, mas não mede por si a recusa de emprego por antecedentes."@pt-BR .

# --- Sanitation -----------------------------------------------------------------------
ex:case-sanitation a aro:EmpiricalCase ;
  aro:textValue "Lack of household sewage collection in Brazil"@en, "Falta de coleta de esgoto domiciliar no Brasil"@pt-BR ;
  aro:caseAboutSituation ex:sit-sanitation ; aro:citesSource ex:src-sanitation .
ex:sit-sanitation a aro:EmpiricalSituation .
ex:ev-sanitation a aro:EvidenceItem ; aro:derivedFromSource ex:src-sanitation ;
  aro:textValue "About 100 million Brazilians (47.6% of the population) had no household sewage collection in 2017, according to SNIS data."@en,
                "Cerca de 100 milhões de brasileiros (47,6% da população) não tinham coleta de esgoto em casa em 2017, segundo dados do SNIS."@pt-BR .
ex:corr-sanitation a aro:CorrespondenceClaim ;
  aro:assertsPattern ex:pattern-precarious-housing ; aro:assertsCase ex:case-sanitation ; aro:citesSource ex:src-sanitation ;
  aro:textValue "The precarious housing represented in the song is similar to a widespread, measured lack of sanitation."@en,
                "A moradia precária representada na canção é semelhante a uma falta de saneamento ampla e medida."@pt-BR .
ex:assess-sanitation a aro:EvidenceAssessment ; aro:assessmentOutcome "supports" ; aro:assessesClaim ex:corr-sanitation ; aro:assessesEvidence ex:ev-sanitation ;
  aro:textValue "Supports the pattern at national scale, decades after the song; does not describe the specific neighbourhood."@en,
                "Apoia o padrão em escala nacional, décadas depois da canção; não descreve o bairro específico."@pt-BR .

# --- Drought migration (Ceará, 1932) ---------------------------------------------
ex:case-ceara-1932 a aro:EmpiricalCase ;
  aro:textValue "Concentration camps for drought refugees in Ceará, 1932"@en,
                "Campos de concentração para retirantes da seca no Ceará, 1932"@pt-BR ;
  aro:caseAboutEvent ex:event-ceara-1932 ; aro:citesSource ex:src-fapesp-seca, ex:src-patu .
ex:event-ceara-1932 a aro:EmpiricalEvent .
ex:ev-ceara-camps a aro:EvidenceItem ; aro:derivedFromSource ex:src-fapesp-seca ;
  aro:textValue "During the 1932 drought the Ceará government set up camps along the railways to keep migrants from reaching Fortaleza."@en,
                "Durante a seca de 1932 o governo do Ceará instalou campos junto às ferrovias para impedir que os retirantes chegassem a Fortaleza."@pt-BR .
ex:ev-patu a aro:EvidenceItem ; aro:derivedFromSource ex:src-patu ;
  aro:externalLink "https://diariodonordeste.verdesmares.com.br/ceara/campo-de-concentracao-que-abrigou-16-mil-retirantes-no-ceara-deve-ter-predios-e-ruinas-tombados-1.3258221"^^xsd:anyURI ;
  aro:textValue "The Patu camp in Senador Pompeu, whose remains are being preserved as heritage."@en,
                "O campo do Patu, em Senador Pompeu, cujas ruínas estão sendo tombadas como patrimônio."@pt-BR .
ex:corr-drought a aro:CorrespondenceClaim ;
  aro:assertsPattern ex:pattern-drought-migration ; aro:assertsCase ex:case-ceara-1932 ; aro:citesSource ex:src-fapesp-seca ;
  aro:textValue "The forced migration represented in the novel corresponds to documented drought migrations, contemporary with its writing."@en,
                "A migração forçada representada no romance corresponde a migrações documentadas por seca, contemporâneas à sua escrita."@pt-BR .
ex:assess-drought a aro:EvidenceAssessment ; aro:assessmentOutcome "supports" ; aro:assessesClaim ex:corr-drought ; aro:assessesEvidence ex:ev-ceara-camps, ex:ev-patu ;
  aro:textValue "Supports the pattern as historically documented; the novel's family is fictional and is not claimed to have been in these camps."@en,
                "Apoia o padrão como historicamente documentado; a família do romance é ficcional e não se alega que tenha estado nesses campos."@pt-BR .
