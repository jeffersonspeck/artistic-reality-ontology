@prefix aro:    <https://w3id.org/aro/ontology#> .
@prefix schema: <https://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbr:    <http://dbpedia.org/resource/> .
@prefix oa:     <http://www.w3.org/ns/oa#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex:     <https://example.org/aro-cases/> .

# =====================================================================================
# Case studies: "Homem na Estrada" (Racionais MC's, 1993) and "Vidas Secas"
# (Graciliano Ramos, 1938) with its film adaptation (Nelson Pereira dos Santos, 1963).
#
# Method of this example
# - No lyrics or novel text are reproduced. Each Selection is one event of the narrative
#   (in the song, the 2-8 lines where it happens; in the novel, a chapter). Song events
#   are located by line ranges of the lyric transcription (RFC 5147 fragments).
# - Situation descriptions are paraphrases representing ONE analyst's reading
#   (InterpretationRecord), not the content of the work itself; confidenceScore marks
#   how sure the reading is.
# - Works follow the IFLA LRM levels (ARO 0.3): the artwork, its expressions (the
#   recording, the lyric text, the novel's text) and, where the edition matters, the
#   manifestation that embodies them (the album, the first edition).
# - Empirical cases cite real, public sources (URLs checked when the example was written).
#   Correspondence claims state similarity or possibility, never that the work narrates
#   a specific real event, and never causation.
# =====================================================================================

# ------------------------------------------------------------------ analyst and act
ex:analyst a schema:Person, aro:Person ; schema:name "Example analyst" .
ex:reading-act a aro:InterpretiveAct ; aro:hasParticipant ex:analyst ; aro:startDate "2026-10"^^xsd:gYearMonth .
# A second analyst reviews the first one's readings: a competing interpretation, a challenge,
# assessments by explicit criteria and of the evidence for a causal hypothesis
ex:reviewer a schema:Person, aro:Person ; schema:name "Example reviewer" .
ex:review-act a aro:InterpretiveAct ; aro:hasParticipant ex:reviewer ; aro:startDate "2026-11"^^xsd:gYearMonth .

# =====================================================================================
# 1. HOMEM NA ESTRADA — Racionais MC's
# Line numbers refer to the LyricFind transcription (151 lyric lines; credits excluded,
# refrain lines counted). Each event is located by an RFC 5147 line fragment
# ("line=a,b" = lines a+1..b, zero-based) and by a readable expression. No lyric text
# is stored in this repository.
# =====================================================================================
ex:homem-na-estrada a aro:Artwork ;
  aro:textValue "Homem na Estrada"@pt-BR, "Homem na Estrada (Man on the Road)"@en ;
  aro:externalLink "https://en.wikipedia.org/wiki/Raio-X_do_Brasil"^^xsd:anyURI .
ex:homem-na-estrada-1993 a aro:Expression ;
  aro:realizesArtwork ex:homem-na-estrada ;
  aro:textValue "Recording on the album Raio X do Brasil (1993)"@en, "Gravação no álbum Raio X do Brasil (1993)"@pt-BR .
ex:homem-na-estrada-lyrics a aro:Expression ;
  aro:realizesArtwork ex:homem-na-estrada ;
  aro:textValue "Lyric text (LyricFind transcription, 151 lines; composer Pedro Paulo Soares Pereira)"@en,
                "Texto da letra (transcrição LyricFind, 151 linhas; compositor Pedro Paulo Soares Pereira)"@pt-BR .
# The album is the manifestation (LRM) that embodies the 1993 recording
ex:raio-x-do-brasil a aro:Manifestation ;
  aro:embodiesExpression ex:homem-na-estrada-1993 ;
  aro:textValue "Album Raio X do Brasil (1993)"@en, "Álbum Raio X do Brasil (1993)"@pt-BR ;
  aro:externalLink "https://en.wikipedia.org/wiki/Raio-X_do_Brasil"^^xsd:anyURI .
ex:homem-na-estrada-1993 aro:hasManifestation ex:raio-x-do-brasil .

# Creation: written by Mano Brown (Pedro Paulo Soares Pereira), performed by Racionais MC's
ex:homem-na-estrada-creation a aro:CreativeAct ; aro:startDate "1993"^^xsd:gYear ;
  aro:producesCreation ex:homem-na-estrada, ex:homem-na-estrada-lyrics, ex:homem-na-estrada-1993 ;
  aro:hasContribution ex:hne-author, ex:hne-performer .
ex:hne-author a aro:CreativeContribution ; aro:contributionTo ex:homem-na-estrada, ex:homem-na-estrada-lyrics ; aro:contributionBy dbr:Mano_Brown ;
  aro:contributionRole aro:AuthorRole, aro:LyricistRole .
ex:hne-performer a aro:CreativeContribution ; aro:contributionTo ex:homem-na-estrada-1993 ; aro:contributionBy <http://dbpedia.org/resource/Racionais_MC's> ;
  aro:contributionRole aro:PerformerRole .
# Agents are external IRIs; aro:Person / aro:Collective place them in the OntoUML role pattern
dbr:Mano_Brown a schema:Person, aro:Person ; schema:name "Mano Brown" .
<http://dbpedia.org/resource/Racionais_MC's> a schema:MusicGroup, aro:Collective ; schema:name "Racionais MC's" .

# --- event 1: lines 1-7
ex:hne-e01 a aro:Selection ; aro:selectsFrom ex:homem-na-estrada-lyrics ;
  aro:selectorExpression "lines 1-7 (event 1 of 15)" ;
  aro:hasSelector ex:hne-e01-sel .
ex:hne-e01-sel a oa:FragmentSelector ; oa:value "line=0,7" ;
  dcterms:conformsTo <http://tools.ietf.org/rfc/rfc5147> .
ex:hne-r01 a aro:InterpretationRecord ; aro:hasPrimarySelection ex:hne-e01 ;
  aro:producedByAct ex:reading-act ; aro:describesSituation ex:hne-s01 ;
  aro:confidenceScore 0.95 ; aro:citesSource ex:src-intexto .
ex:hne-s01 a aro:SituationDescription ; aro:mentionsDepictedElement ex:hne-man ;
  aro:textValue "A man leaves prison and restarts his life, wanting to prove he has changed and to leave crime behind."@en, "Um homem sai da prisão e recomeça a vida, querendo provar que mudou e deixar o crime para trás."@pt-BR ;
  aro:generalizesAs ex:pattern-reintegration .

