        ex:hne-e20,
        ex:hne-e26 ;
    aro:textValue "Violence and economic inequality"@en,
        "Violências e desigualdades econômicas"@pt-BR .

ex:hyp-selective-policing a aro:ExplanationHypothesis ;
    aro:explainsPattern ex:pattern-state-violence ;
    aro:textValue "Hypothesis: selective policing of poor and Black populations increases their exposure to state violence."@en,
        "Hipótese: o policiamento seletivo de populações pobres e negras aumenta sua exposição à violência do Estado."@pt-BR .

dbr:Mano_Brown a schema:Person ;
    schema:name "Mano Brown" .

<http://dbpedia.org/resource/Racionais_MC's> a schema:MusicGroup ;
    schema:name "Racionais MC's" .

ex:analyst a schema:Person ;
    schema:name "Example analyst" .

ex:analyst-alternative a schema:Person ;
    schema:name "Analista metodológico de leitura alternativa"@pt-BR .

ex:c-alcohol-hypocrisy a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The critique contrasts moralizing drug discourse with profits from alcohol sales."@en,
        "A crítica opõe discursos moralizantes contra drogas a ganhos econômicos com comércio de álcool."@pt-BR .

ex:c-community-religion a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Candomblé practice is mentioned as a source of blessing in everyday community life."@en,
        "A prática do candomblé é mencionada como possibilidade de bênção no cotidiano local."@pt-BR .

ex:c-drug-market-inequality a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "In the representation, buyers have resources and protection, while the periphery supplies low-paid labor."@en,
        "Na representação, os compradores têm renda e proteção, enquanto a periferia fornece mão de obra barata."@pt-BR .

ex:c-dt a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A young retail drug seller from the periphery is killed while wealthier actors profit."@en,
        "Um jovem vendedor de drogas da periferia é morto enquanto atores mais ricos lucram."@pt-BR .

ex:c-family-future a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The character expresses responsibility for a child and a wish for a safer life."@en,
        "O personagem manifesta responsabilidade por uma criança e desejo de lhe garantir vida mais segura."@pt-BR .

ex:c-fear-police a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The character imagines abuse by security agents as a hypothetical possibility."@en,
        "O personagem projeta hipoteticamente abuso por agentes de segurança."@pt-BR .

ex:c-future-death-anxiety a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The character fears death without identification or recognition."@en,
        "O personagem teme morrer e não ser identificado ou reconhecido."@pt-BR .

ex:c-gender-violence a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The woman in the song is described as a victim of sexual violence and killing."@en,
        "A mulher mencionada na canção é apresentada como vítima de violência sexual e morte violenta."@pt-BR .

ex:c-hu a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Children lack regular food and rely on scraps or school meals."@en,
        "Crianças não têm alimentação regular e dependem de restos ou da merenda escolar."@pt-BR .

ex:c-ly a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Residents collectively attack a person accused of a crime, without any legal process."@en,
        "Moradores atacam coletivamente uma pessoa acusada de crime, sem processo legal."@pt-BR .

ex:c-media-framing a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "News coverage foregrounds a victim’s criminal record or notoriety."@en,
        "A cobertura jornalística privilegia antecedentes ou notoriedade da vítima e sua associação ao crime."@pt-BR .

ex:c-ph a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Households lack sewage collection or other basic services."@en,
        "Domicílios sem coleta de esgoto ou outros serviços básicos."@pt-BR .

ex:c-racialized-vulnerability a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The account of a death emphasizes a racial descriptor and the man’s criminal history."@en,
        "O discurso sobre uma morte destaca categoria racial e antecedentes do homem."@pt-BR .

ex:c-ri-barrier a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Work or social acceptance is denied because of the criminal record."@en,
        "Trabalho ou aceitação social são negados por causa dos antecedentes."@pt-BR .

ex:c-ri-released a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A person has left prison."@en,
        "Uma pessoa saiu da prisão."@pt-BR .

ex:c-sa a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A public service (census, forensics, water, health) is absent or arrives very late in a poor neighbourhood."@en,
        "Um serviço público (censo, perícia, água, saúde) está ausente ou chega muito atrasado num bairro pobre."@pt-BR .

ex:c-silence-violence a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "Neighbors remain silent and the narrator portrays an expectation of violence."@en,
        "Vizinhos permanecem em silêncio e o narrador descreve expectativa de violência."@pt-BR .

ex:c-sv-agent a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The aggressor acts as an agent of state security (police, soldier)."@en,
        "O agressor age como agente de segurança do Estado (polícia, soldado)."@pt-BR .

ex:c-sv-framing a aro:PatternCondition ;
    aro:isRequiredCondition false ;
    aro:textValue "The victim is framed as an offender."@en,
        "A vítima é retratada como infratora."@pt-BR .

ex:c-sv-lethal a aro:PatternCondition ;
    aro:isRequiredCondition false ;
    aro:textValue "The violence is lethal."@en,
        "A violência é letal."@pt-BR .

ex:c-sv-victim a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The victim is poor or socially marginalized."@en,
        "A vítima é pobre ou socialmente marginalizada."@pt-BR .

ex:c-yd a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "A poor child or adolescent is held in a juvenile detention institution."@en,
        "Uma criança ou adolescente pobre é mantida numa instituição de internação."@pt-BR .

ex:c-youth-illicit-market a aro:PatternCondition ;
    aro:isRequiredCondition true ;
    aro:textValue "The episode depicts a young person involved in drug sales without assuming his position in the value chain."@en,
        "O episódio representa um jovem envolvido no comércio de drogas, sem presumir sua posição na cadeia de valor."@pt-BR .

ex:case-carandiru a aro:EmpiricalCase ;
    aro:caseAboutEvent ex:event-carandiru ;
    aro:caseHasReference ex:src-carandiru ;
    aro:textValue "Carandiru massacre, São Paulo, 2 October 1992"@en,
        "Massacre do Carandiru, São Paulo, 2 de outubro de 1992"@pt-BR .

ex:case-cnj-pena-justa a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-cnj-pena-justa ;
    aro:caseHasReference ex:src-pena-justa ;
    aro:textValue "Current Brazilian public policy on ex-prisoner reintegration: Pena Justa plan, axis 3."@en,
        "Política pública brasileira atual para reinserção de egressos: eixo 3 do plano Pena Justa."@pt-BR .

ex:case-fbsp-2025 a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-fbsp-2025 ;
    aro:caseHasReference ex:src-fbsp-2026 ;
    aro:textValue "Police lethality recorded in Brazil in 2025 (national aggregate)."@en,
        "Letalidade policial documentada no Brasil em 2025 (agregado nacional)."@pt-BR .

ex:case-fbsp-race-2025 a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-fbsp-race-2025 ;
    aro:caseHasReference ex:src-fbsp-2026 ;
    aro:textValue "Racial inequality among victims of police intervention, Brazilian 2025 data."@en,
        "Desigualdade racial entre vítimas de intervenção policial, dados brasileiros de 2025."@pt-BR .

ex:case-fbsp-women-2025 a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-fbsp-women-2025 ;
    aro:caseHasReference ex:src-agencia-brasil-2026 ;
    aro:textValue "Lethal violence against women recorded in Brazil in 2025 (public security aggregate)."@en,
        "Violência letal contra mulheres registrada no Brasil em 2025 (agregado de segurança pública)."@pt-BR .

ex:case-ibge-food-2024 a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-ibge-food-2024 ;
    aro:caseHasReference ex:src-ebia-2024 ;
    aro:textValue "Food insecurity in 24.2% of Brazilian households in 2024, according to PNAD/EBIA."@en,
        "Insegurança alimentar em 24,2% dos domicílios brasileiros em 2024, segundo PNAD Contínua/EBIA."@pt-BR .

ex:case-police-lethality a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-police-lethality ;
    aro:caseHasReference ex:src-fbsp-2020 ;
    aro:textValue "Deaths resulting from police interventions in Brazil (national statistics)"@en,
        "Mortes decorrentes de intervenção policial no Brasil (estatísticas nacionais)"@pt-BR .

ex:case-reintegration a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-reintegration ;
    aro:caseHasReference ex:src-ipea-2015 ;
    aro:textValue "Criminal recidivism and reintegration of former prisoners in Brazil"@en,
        "Reincidência criminal e reintegração de egressos do sistema prisional no Brasil"@pt-BR .

ex:case-sanitation a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-sanitation ;
    aro:caseHasReference ex:src-sanitation ;
    aro:textValue "Lack of household sewage collection in Brazil"@en,
        "Falta de coleta de esgoto domiciliar no Brasil"@pt-BR .

ex:case-sinase-2025 a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-sinase-2025 ;
    aro:caseHasReference ex:src-sinase-2025 ;
    aro:textValue "Official juvenile socioeducational-system survey, SINASE 2025 edition."@en,
        "Levantamento oficial de atendimento socioeducativo, sistema SINASE, edição 2025."@pt-BR .

ex:case-sinase-market-2024 a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-sinase-market-2024 ;
    aro:caseHasReference ex:src-mjsp-2026 ;
    aro:textValue "Drug-trafficking-related juvenile offence records in SINASE 2024, publicized by the Justice Ministry in 2026."@en,
        "Atos infracionais ligados ao tráfico no levantamento SINASE 2024, divulgados pelo MJSP em 2026."@pt-BR .

ex:case-sinisa-2024 a aro:EmpiricalCase ;
    aro:caseAboutSituation ex:sit-sinisa-2024 ;
    aro:caseHasReference ex:src-sinisa-2025 ;
    aro:textValue "Brazilian water and sewerage service coverage, 2024 reference year (SINISA 2025)."@en,
        "Cobertura de abastecimento de água e esgotamento sanitário no Brasil, ano-base 2024 (SINISA 2025)."@pt-BR .

ex:corr-carandiru a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-carandiru ;
    aro:assertsPattern ex:pattern-state-violence ;
    aro:referencesSource ex:src-carandiru ;
    aro:textValue "A documented, large-scale instance of lethal state violence against marginalized men, one year before the song."@en,
        "Instância documentada e de grande escala de violência letal do Estado contra homens marginalizados, um ano antes da canção."@pt-BR .

ex:corr-cnj-pena-justa a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-cnj-pena-justa ;
    aro:assertsPattern ex:pattern-reintegration ;
    aro:referencesSource ex:src-pena-justa ;
    aro:textValue "The narrated reintegration challenge has a counterpart in a current policy agenda, not an identical empirical event."@en,
        "O projeto de reinserção social narrado encontra paralelo em uma agenda institucional vigente, não em um evento empírico idêntico."@pt-BR .

ex:corr-fbsp-2025 a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-fbsp-2025 ;
    aro:assertsPattern ex:pattern-state-violence ;
    aro:referencesSource ex:src-cnn-fbsp-2026,
        ex:src-fbsp-2026 ;
    aro:textValue "The police-raid scene corresponds structurally to a nationally recorded 2025 phenomenon, not to the same incident or a causal explanation."@en,
        "A crítica de violência policial na cena de cerco tem correspondência estrutural com um fenômeno nacional registrado em 2025, sem implicar mesma ocorrência ou causalidade."@pt-BR .

ex:corr-fbsp-race-2025 a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-fbsp-race-2025 ;
    aro:assertsPattern ex:pattern-racialized-vulnerability ;
    aro:referencesSource ex:src-fbsp-2026 ;
    aro:textValue "The fictional bulletin’s racial description can be compared to today’s racially disaggregated police lethality analyses without naturalizing dated terminology."@en,
        "O destaque racial do noticiário ficcional pode ser comparado a debates atuais de letalidade com recorte racial, evitando naturalização da terminologia datada."@pt-BR .

ex:corr-fbsp-women-2025 a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-fbsp-women-2025 ;
    aro:assertsPattern ex:pattern-gender-violence ;
    aro:referencesSource ex:src-agencia-brasil-2026 ;
    aro:textValue "The murdered-woman scene has a broad thematic correspondence with lethal violence against women, not an identical legal category or occurrence."@en,
        "A cena da mulher assassinada encontra uma correspondência temática geral com violência letal contra mulheres, sem correspondência de tipificação ou ocorrência."@pt-BR .

ex:corr-hne-police a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-police-lethality ;
    aro:assertsPattern ex:pattern-state-violence ;
    aro:referencesSource ex:src-fbsp-2020 ;
    aro:textValue "The pattern represented in the song is similar to documented, recurrent police lethality in Brazil."@en,
        "O padrão representado na canção é semelhante à letalidade policial documentada e recorrente no Brasil."@pt-BR .

ex:corr-ibge-food-2024 a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-ibge-food-2024 ;
    aro:assertsPattern ex:pattern-hunger ;
    aro:referencesSource ex:src-ebia-2024 ;
    aro:textValue "The narrated food hardship resembles a nationally measured contemporary issue, without equivalence of indicators or time periods."@en,
        "A precariedade alimentar narrada é análoga a um problema social quantificado nacionalmente, sem equivalência de indicadores ou períodos."@pt-BR .

ex:corr-reintegration a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-reintegration ;
    aro:assertsPattern ex:pattern-reintegration ;
    aro:referencesSource ex:src-ipea-2015 ;
    aro:textValue "The difficulties represented in the song correspond to a documented field of research on reintegration and recidivism."@en,
        "As dificuldades representadas na canção correspondem a um campo documentado de pesquisa sobre reintegração e reincidência."@pt-BR .

ex:corr-sanitation a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-sanitation ;
    aro:assertsPattern ex:pattern-precarious-housing ;
    aro:referencesSource ex:src-sanitation ;
    aro:textValue "The precarious housing represented in the song is similar to a widespread, measured lack of sanitation."@en,
        "A moradia precária representada na canção é semelhante a uma falta de saneamento ampla e medida."@pt-BR .

ex:corr-sinase-2025 a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-sinase-2025 ;
    aro:assertsPattern ex:pattern-youth-detention ;
    aro:referencesSource ex:src-sinase-2025 ;
    aro:textValue "Historical FEBEM references can be compared with present institutions while respecting legal and institutional changes."@en,
        "A passagem pela FEBEM pode ser contrastada historicamente com instituições atuais, respeitadas as mudanças legais e institucionais."@pt-BR .

ex:corr-sinase-market-2024 a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-sinase-market-2024 ;
    aro:assertsPattern ex:pattern-youth-illicit-market ;
    aro:referencesSource ex:src-mjsp-2026 ;
    aro:textValue "The song’s proposed economic exploitation motivates thematic comparison, while SINASE data concern a distinct population and indicator."@en,
        "A exploração econômica alegada na canção motiva uma comparação temática, mas os dados do SINASE têm população e indicadores distintos."@pt-BR .

ex:corr-sinisa-2024 a aro:CorrespondenceClaim ;
    aro:assertsCase ex:case-sinisa-2024 ;
    aro:assertsPattern ex:pattern-precarious-housing ;
    aro:referencesSource ex:src-sinisa-2025 ;
    aro:textValue "Precarious infrastructure maps to a currently monitored empirical domain; coverage and local service outages must be distinguished."@en,
        "O tema de infraestrutura precária aproxima-se de um domínio empírico atualmente monitorado; a comparação exige distinguir cobertura estrutural de interrupções locais."@pt-BR .

ex:deriv-hne-sound a aro:TransformationAspect ;
    aro:hasDimension aro:RecordedSoundDimension ;
    aro:hasOperation aro:Recontextualized .

ex:deriv-hne-voice a aro:TransformationAspect ;
    aro:hasDimension aro:RecordedSoundDimension ;
    aro:hasOperation aro:Recontextualized .

ex:deriv-hne-why a aro:InterpretiveJustification ;
    aro:textValue "A 2024 musicological comparison identifies sampled guitar and vocal passages from Ela Partiu. The new recording embeds these sounds in a socially critical rap; the derivation claim concerns recorded material, not identity of artworks or legal permission."@en,
        "A comparação musicológica publicada em 2024 identifica na faixa um sample da guitarra e passagens vocais de Ela Partiu. A nova gravação insere os sons em um rap de denúncia social; a alegação de derivação é sobre o material gravado, e não sobre identidade de obras ou autorização jurídica."@pt-BR .

ex:ela-partiu a aro:Artwork ;
    aro:hasManifestation ex:ela-partiu-recording ;
    aro:textValue "Ela Partiu (Tim Maia)"@en,
        "Ela Partiu (Tim Maia)"@pt-BR .

ex:ev-carandiru a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-carandiru ;
    aro:textValue "Military Police intervention in the Carandiru prison that left 111 prisoners dead."@en,
        "Intervenção da Polícia Militar no presídio do Carandiru que deixou 111 presos mortos."@pt-BR .

ex:ev-cnj-pena-justa a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-pena-justa ;
    aro:textValue "The CNJ describes axis 3 objectives of reintegration through work, education and income, with services for former prisoners and relatives."@en,
        "O CNJ explicita como objetivos do eixo 3 a reintegração pelo trabalho, educação e renda, com serviços voltados a egressos e familiares."@pt-BR .

ex:ev-fbsp a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-fbsp-2020 ;
    aro:externalLink "https://forumseguranca.org.br/wp-content/uploads/2021/07/4-as-mortes-decorrentes-de-intervencao-policial-no-brasil-em-2020.pdf"^^xsd:anyURI ;
    aro:textValue "The report presents national and state counts of deaths resulting from police interventions and the profile of the victims."@en,
        "O relatório apresenta contagens nacionais e estaduais de mortes decorrentes de intervenção policial e o perfil das vítimas."@pt-BR .

ex:ev-fbsp-2025 a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-fbsp-2026 ;
    aro:textValue "FBSP reports record police lethality in 2025; public reporting identifies 6,602 deaths resulting from police interventions."@en,
        "O FBSP informa recorde de letalidade policial em 2025; divulgação pública registra 6.602 mortes decorrentes de intervenções policiais."@pt-BR .

ex:ev-fbsp-race-2025 a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-fbsp-2026 ;
    aro:textValue "The 2026 Yearbook describes the racial profile of victims of police interventions and disparities between groups."@en,
        "O Anuário 2026 traz perfil racial de vítimas de intervenções policiais, evidenciando desigualdades entre grupos."@pt-BR .

ex:ev-fbsp-women-2025 a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-agencia-brasil-2026 ;
    aro:textValue "Reporting on the 2026 Yearbook notes rising femicide in 2025; femicide is a specific legal category and does not automatically cover every violent female death."@en,
        "Noticiário do Anuário 2026 relata aumento dos feminicídios em 2025; feminicídio é categoria jurídica específica e não cobre automaticamente toda morte violenta de mulher."@pt-BR .

ex:ev-ibge-food-2024 a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-ebia-2024 ;
    aro:textValue "The PNAD/EBIA reports 24.2% of households with some food insecurity in 2024, with 3.2% in the severe category."@en,
        "A PNAD Contínua com EBIA informa 24,2% dos domicílios com algum grau de insegurança alimentar em 2024 e 3,2% com insegurança grave."@pt-BR .

ex:ev-ipea a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-ipea-2015 ;
    aro:textValue "The report estimates recidivism from data of several states, describes the profile of recidivists and warns against the widely repeated but unsupported 70% figure."@en,
        "O relatório estima a reincidência a partir de dados de vários estados, descreve o perfil dos reincidentes e alerta contra o número de 70%, repetido sem fundamento."@pt-BR .

ex:ev-sanitation a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-sanitation ;
    aro:textValue "About 100 million Brazilians (47.6% of the population) had no household sewage collection in 2017, according to SNIS data."@en,
        "Cerca de 100 milhões de brasileiros (47,6% da população) não tinham coleta de esgoto em casa em 2017, segundo dados do SNIS."@pt-BR .

ex:ev-sinase-2025 a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-sinase-2025 ;
    aro:textValue "The current national survey tracks facilities and adolescents in restrictive or custodial socioeducational measures."@en,
        "O levantamento nacional atual acompanha unidades e adolescentes em medidas socioeducativas de restrição ou privação de liberdade."@pt-BR .

ex:ev-sinase-market-2024 a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-mjsp-2026 ;
    aro:textValue "The Justice Ministry reports that trafficking accounted for 27% of recorded infractions among adolescents deprived of liberty in 2024."@en,
        "O MJSP informa que tráfico correspondeu a 27% dos atos infracionais registrados entre adolescentes privados de liberdade em 2024."@pt-BR .

ex:ev-sinisa-2024 a aro:EvidenceItem ;
    aro:derivedFromSource ex:src-sinisa-2025 ;
    aro:textValue "SINISA 2025 publishes water and sewerage service indicators for 2024, with their own territorial and coverage definitions."@en,
        "O SINISA 2025 disponibiliza indicadores por módulo de água e esgotamento, referentes ao ano de 2024; os indicadores têm definição territorial e de atendimento próprias."@pt-BR .

ex:event-carandiru a aro:EmpiricalEvent .

ex:hne-author a aro:CreativeContribution ;
    aro:contributionBy dbr:Mano_Brown ;
    aro:contributionRole aro:AuthorRole,
        aro:LyricistRole .

ex:hne-criterion-separate-voices a aro:AssessmentCriterion ;
    aro:textValue "Distinguish the protagonist’s discourse, news voice and independent evidence; attribute certainty only to what the source establishes."@en,
        "Distinguir discurso do protagonista, voz noticiosa e evidência independente; atribuir certeza somente ao que a fonte explicita."@pt-BR .

ex:hne-drunk-man a aro:DepictedAgent ;
    aro:textValue "intoxicated man assaulted by a crowd"@en,
        "homem embriagado submetido a linchamento"@pt-BR .

