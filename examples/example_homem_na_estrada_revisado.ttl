ex:hne-unit-life a aro:AnalysisUnit ;
    aro:groupsSelection ex:hne-e01,
        ex:hne-e02,
        ex:hne-e06,
        ex:hne-e12,
        ex:hne-e16,
        ex:hne-e18,
        ex:hne-e21,
        ex:hne-e25 ;
    aro:textValue "Restart, care and life projects"@en,
        "Recomeço, cuidado e projetos de vida"@pt-BR .

ex:hne-unit-perspectives a aro:AnalysisUnit ;
    aro:groupsSelection ex:hne-e11,
        ex:hne-e13,
        ex:hne-e14,
        ex:hne-e15,
        ex:hne-e22,
        ex:hne-e23,
        ex:hne-e24 ;
    aro:textValue "Fear, siege and competing accounts of death"@en,
        "Medo, cerco e versões sobre a morte"@pt-BR .

ex:hne-unit-urban a aro:AnalysisUnit ;
