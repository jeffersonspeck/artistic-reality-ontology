# example_homem_na_estrada_revisado.ttl -- ARO v0.2.0-beta (2026-10-30)
# GRAFO AUTOSSUFICIENTE derivado do exemplo original fornecido pelo pesquisador.
# Conteúdo protegido: nenhum verso da letra foi reproduzido aqui.
# Interpretações, hipóteses e correspondências são alegações; não fatos ontológicos.
# Fontes atuais dizem respeito a fenômenos brasileiros medidos (2024-2025),
# NÃO a eventos históricos identificados na narrativa ficcional de 1993.
# O arquivo de exemplo distribuído pelo projeto é GERADO de examples/case-studies.ttl:
# para integrar a alteração permanentemente, use o script de mesclagem fornecido.
# Pontos de recorte 1-15: offsets herdados da transcrição LyricFind referida no projeto;
# novos recortes temáticos são semanticamente localizados, SEM inventar offsets.

@prefix aro: <https://w3id.org/aro/ontology#> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/aro-cases/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:assess-carandiru a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-carandiru ;
    aro:assessesEvidence ex:ev-carandiru ;
    aro:textValue "Limited historical correspondence with state lethality: Carandiru occurred inside a prison in 1992, whereas the song depicts a raid at a peripheral home. The song is not claimed to document the massacre or any individual case."@en,
        "Correspondência histórica restrita ao fenômeno de letalidade estatal: o Carandiru ocorreu dentro de estabelecimento prisional em 1992, enquanto a invasão na canção se passa numa moradia da periferia. Não se afirma que a canção documenta o massacre ou um caso individual."@pt-BR .

ex:assess-cnj-pena-justa a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-cnj-pena-justa ;
    aro:assessesEvidence ex:ev-cnj-pena-justa ;
    aro:textValue "It is evidence of institutional recognition and policy design, NOT a rate of employer refusal or proof of policy effectiveness."@en,
        "É evidência de reconhecimento institucional e resposta de política pública; NÃO é estatística de rejeição por empregadores nem demonstra efetividade do plano."@pt-BR .

ex:assess-fbsp-2025 a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-fbsp-2025 ;
    aro:assessesEvidence ex:ev-fbsp-2025 ;
    aro:textValue "Supports the current existence of lethal police intervention, but NOT that police killed the fictional protagonist or that any measured case is the song’s event."@en,
        "Apoia a existência contemporânea do fenômeno de letalidade policial, mas NÃO demonstra que a morte do personagem foi causada pela polícia, nem identidade entre ficção e casos."@pt-BR .

ex:assess-fbsp-race-2025 a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-fbsp-race-2025 ;
    aro:assessesEvidence ex:ev-fbsp-race-2025 ;
    aro:textValue "Supports the empirical relevance of racial inequality; does NOT establish the fictional character’s self-identification or who killed him."@en,
        "Apoia a relevância empírica das desigualdades raciais; NÃO permite inferir raça autodeclarada do personagem, nem identificar o autor de sua morte."@pt-BR .

ex:assess-fbsp-women-2025 a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-fbsp-women-2025 ;
    aro:assessesEvidence ex:ev-fbsp-women-2025 ;
    aro:textValue "Indirect thematic support for continuing lethal violence against women; it does not classify the fictional death as femicide or prove sexual violence and forensic delay."@en,
        "Apoio temático indireto para persistência de violência letal contra mulheres; não caracteriza como feminicídio a morte da mulher da canção, nem comprova estupro ou atraso do IML."@pt-BR .

ex:assess-hne-police a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-hne-police ;
    aro:assessesEvidence ex:ev-fbsp ;
    aro:textValue "Supports that the represented situation is possible and recurrent; does not show that the song narrates a specific real event, nor any cause."@en,
        "Apoia que a situação representada é possível e recorrente; não mostra que a canção narra um evento real específico, nem causa alguma."@pt-BR .

ex:assess-ibge-food-2024 a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-ibge-food-2024 ;
    aro:assessesEvidence ex:ev-ibge-food-2024 ;
    aro:textValue "Supports contemporary food insecurity, but household prevalence does not count children scavenging near markets or establish why any child attends school."@en,
        "Apoia a persistência contemporânea do problema alimentar; o percentual de domicílios não mede diretamente crianças em feiras nem a razão de comparecimento à escola."@pt-BR .

ex:assess-reintegration a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-reintegration ;
    aro:assessesEvidence ex:ev-ipea ;
    aro:textValue "Partial support: documents recidivism and the profile of former prisoners, but does not by itself measure job refusal due to a criminal record."@en,
        "Apoio parcial: documenta a reincidência e o perfil dos egressos, mas não mede por si a recusa de emprego por antecedentes."@pt-BR .

ex:assess-sanitation a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-sanitation ;
    aro:assessesEvidence ex:ev-sanitation ;
    aro:textValue "Supports the pattern at national scale, decades after the song; does not describe the specific neighbourhood."@en,
        "Apoia o padrão em escala nacional, décadas depois da canção; não descreve o bairro específico."@pt-BR .

ex:assess-sinase-2025 a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-sinase-2025 ;
    aro:assessesEvidence ex:ev-sinase-2025 ;
    aro:textValue "Supports the continued existence of youth institutions, but FEBEM and SINASE differ historically and legally; it does not document the protagonist’s childhood."@en,
        "Apoia a persistência de sistemas institucionalizados para adolescentes, mas FEBEM e SINASE são arranjos históricos e normativos distintos; não prova abuso na infância do protagonista."@pt-BR .

ex:assess-sinase-market-2024 a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-sinase-market-2024 ;
    aro:assessesEvidence ex:ev-sinase-market-2024 ;
    aro:textValue "Supports the contemporary relevance of youth involvement in illegal markets; it does NOT prove the song’s proposed economic hierarchy or equate surveyed youths with the adult character."@en,
        "Apoia que o tema de participação juvenil em mercados ilegais continua relevante; NÃO demonstra a cadeia econômica específica descrita na música, nem que adolescentes sejam equivalentes ao jovem adulto da história."@pt-BR .

ex:assess-sinisa-2024 a aro:EvidenceAssessment ;
    aro:assessesCorrespondence ex:corr-sinisa-2024 ;
    aro:assessesEvidence ex:ev-sinisa-2024 ;
    aro:textValue "Illustrates currently measurable sanitation inequality, not data about the fictional shack, a landslide or its five-day water outage."@en,
        "Exemplifica a mensurabilidade atual de desigualdades de saneamento. Não fornece, por si, dados do barraco ficcional, desabamento ou interrupção particular de cinco dias."@pt-BR .

ex:deriv-hne-sample a aro:DerivationClaim ;
    aro:derivationJustifiedBy ex:deriv-hne-why ;
    aro:derivationRealizedBy ex:homem-na-estrada-creation ;
    aro:derivationReferencesSource ex:src-praxis-2024,
        ex:src-raio-x-wiki ;
    aro:hasDerivationType aro:Sampling ;
    aro:hasDerivedAnchor ex:homem-na-estrada-1993 ;
    aro:hasSourceAnchor ex:ela-partiu-recording ;
    aro:hasTransformation ex:deriv-hne-sound,
        ex:deriv-hne-voice .

ex:hne-assess-r15 a aro:InterpretationAssessment ;
    aro:assessesInterpretation ex:hne-r15 ;
    aro:textValue "A plausible critical reading of the sequence, insufficient to establish factual authorship of the death."@en,
        "Leitura crítica plausível da sequência, porém insuficiente para comprovar a autoria factual da morte."@pt-BR ;
    aro:usesCriterion ex:hne-criterion-separate-voices .

ex:hne-challenge08 a aro:InterpretationChallenge ;
    aro:challenges ex:hne-r08 ;
    aro:textValue "The wording does not firmly establish whether the mother survived or the precise means of assault; the reading records violence and lynching but avoids invented details."@en,
        "A redação não permite afirmar com segurança se a mãe sobreviveu nem o meio exato da agressão; o recorte afirma violência e linchamento, mas evita pormenores não demonstrados."@pt-BR .

ex:hne-challenge11 a aro:InterpretationChallenge ;
    aro:challenges ex:hne-r11 ;
    aro:textValue "The list is presented as rumor on a bar wall, not as a confirmed police procedure."@en,
        "A lista mencionada na canção é apresentada como boato numa parede de bar; não é legítimo classificá-la como procedimento policial confirmado."@pt-BR .

ex:hne-challenge15 a aro:InterpretationChallenge ;
    aro:challenges ex:hne-r15 ;
    aro:textValue "The death after the raid is not followed by forensic attribution; the police-attributed hypothesis remains a competing account, although the siege supports critical suspicion."@en,
        "A morte após a invasão não é acompanhada de atribuição pericial de autoria; a hipótese atribuída à polícia deve permanecer uma versão concorrente, embora o cerco sustente suspeita crítica."@pt-BR .

