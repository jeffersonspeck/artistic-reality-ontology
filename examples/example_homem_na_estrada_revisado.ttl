    aro:hasJustification ex:hne-just11 ;
    aro:hasPrimarySelection ex:hne-e11 ;
    aro:producedByAct ex:reading-act .

ex:hne-religious-setting a aro:DepictedElement ;
    aro:textValue "Candomblé mentioned as community practice"@en,
        "candomblé mencionado como prática comunitária"@pt-BR .

ex:hne-s01 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-reintegration ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "The narrator follows a man seeking a new start and rejecting further crime; later passages establish his former imprisonment."@en,
        "O narrador acompanha um homem tentando recomeçar sua vida e evitar novos crimes; sua passagem anterior pela prisão é esclarecida adiante na narrativa."@pt-BR .

ex:hne-s02 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-youth-detention ;
    aro:mentionsDepictedElement ex:hne-febem,
        ex:hne-man ;
    aro:textValue "The protagonist associates childhood with painful memories of FEBEM, a historical São Paulo youth institution."@en,
        "A infância do protagonista é associada a lembranças dolorosas da FEBEM, instituição histórica do sistema paulista de atendimento a adolescentes."@pt-BR .

ex:hne-s03 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-precarious-housing ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "The protagonist lives in a precarious single-room shack on a slope, with sewage odor outside and fear of fatal consequences when it rains."@en,
        "O protagonista vive num único cômodo precário em um barranco, com odor de esgoto no quintal e temor de consequências fatais quando chove."@pt-BR .

ex:hne-s04 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-state-absence ;
    aro:mentionsDepictedElement ex:hne-ibge ;
    aro:textValue "The narrator reports that census workers numbered shacks and asked questions, without a visible return to the community."@en,
        "O narrador relata que agentes do IBGE passaram pela área, numeraram barracos e fizeram perguntas, sem retorno perceptível para a comunidade."@pt-BR .

ex:hne-s05 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-gender-violence,
        ex:pattern-state-absence ;
    aro:mentionsDepictedElement ex:hne-iml,
        ex:hne-victim-woman ;
    aro:textValue "A woman is found dead after sexual violence and assaults; her body remains exposed, and the narrator describes an approximately ten-hour forensic-service delay."@en,
        "Uma mulher é encontrada morta após violência sexual e agressões; o corpo permanece exposto e o narrador denuncia atraso de aproximadamente dez horas do IML."@pt-BR .

ex:hne-s06 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-reintegration ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "The protagonist is unemployed and distrusted because of his detention history, despite wanting a different life and to support his family."@en,
        "O protagonista está desempregado e enfrenta desconfiança vinculada ao período de detenção, embora deseje sustentar a família e construir outra vida."@pt-BR .

ex:hne-s07 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-precarious-housing ;
    aro:textValue "The narrator describes a five-day interruption in water supply, framed as a recurrent neighborhood problem."@en,
        "O narrador descreve interrupção no abastecimento de água que já dura cinco dias, apresentada como problema rotineiro da comunidade."@pt-BR .

ex:hne-s08 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-lynching ;
    aro:mentionsDepictedElement ex:hne-drunk-man ;
    aro:textValue "A drunken man is reported to have committed serious violence against his mother and is then collectively assaulted and lynched before sobering up."@en,
        "Um homem embriagado é acusado de praticar violência grave contra a própria mãe e, antes de recuperar a sobriedade, sofre agressão coletiva e linchamento."@pt-BR .

ex:hne-s09 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-hunger ;
    aro:mentionsDepictedElement ex:hne-market ;
    aro:textValue "The narrator sees children competing with animals for food scraps near a market and interprets school attendance as driven primarily by meals."@en,
        "O narrador encontra crianças disputando restos de comida com animais numa feira e interpreta que muitas frequentam a escola prioritariamente para se alimentar."@pt-BR .

ex:hne-s10 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-drug-trade-violence,
        ex:pattern-media-framing,
        ex:pattern-youth-illicit-market ;
    aro:mentionsDepictedElement ex:hne-wealthy-clients,
        ex:hne-young-friend ;
    aro:textValue "A roughly twenty-year-old acquaintance supplying cocaine to wealthy buyers is shot dead at a school and becomes sensationalized news."@en,
        "Um conhecido de aproximadamente vinte anos que fornecia cocaína a consumidores ricos é morto a tiros numa escola e se torna notícia explorada por jornal sensacionalista."@pt-BR .

ex:hne-s11 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-media-framing,
        ex:pattern-reintegration ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "Following nearby robberies, suspicion falls on the favela; a rumor places the protagonist’s name on a list posted at a bar."@en,
        "Depois de assaltos na redondeza, a favela é apontada como suspeita; circula o boato de que o nome do protagonista está numa lista afixada num bar."@pt-BR .

ex:hne-s12 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-media-framing,
        ex:pattern-reintegration ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "Someone exposes the protagonist’s past, including a tattoo marked DVC and reference to article 157; he fears enduring ex-prisoner stigma."@en,
        "Os antecedentes do protagonista são delatados, incluindo uma tatuagem identificada como DVC e referência ao artigo 157; ele teme a estigmatização permanente como ex-presidiário."@pt-BR .

ex:hne-s13 a aro:IntentionalStateDescription ;
    aro:generalizesAs ex:pattern-fear-police ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-police ;
    aro:textValue "The protagonist distrusts police and imagines that he would be mistreated rather than rescued if found wounded."@en,
        "O protagonista declara desconfiança da polícia e antecipa, hipoteticamente, que seria maltratado em vez de socorrido caso estivesse ferido."@pt-BR .

ex:hne-s14 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-family-future,
        ex:pattern-silence-violence,
        ex:pattern-state-violence ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-neighbours,
        ex:hne-police,
        ex:hne-son ;
    aro:textValue "After hearing dogs, cars and steps, the protagonist identifies police surrounding the shack; he narrates fear of execution, about fifteen armed men, and planned resistance because of concern for his son."@en,
        "Após ouvir cães, carros e passos, o protagonista reconhece policiais cercando o barraco; relata risco de execução, a presença de aproximadamente quinze homens armados e prepara resistência, preocupado com o filho."@pt-BR .

ex:hne-s15 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-media-framing,
        ex:pattern-racialized-vulnerability ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-mboi,
        ex:hne-news-narrator,
        ex:hne-police ;
    aro:textValue "A news-style coda reports that a man described with a dated racialized term, around 25–30 years old, was found dead on Estrada do M’Boi Mirim; the news relays a rival-gang explanation and cites a police criminal-record claim."@en,
        "A coda adota voz de noticiário: um homem descrito pelo noticiário como mulato, com cerca de 25 a 30 anos, é encontrado morto na Estrada do M’Boi Mirim; a hipótese noticiada é confronto entre quadrilhas e a polícia menciona seus antecedentes."@pt-BR .

ex:hne-s15-alternative a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-media-framing ;
    aro:textValue "Alternative reading: the immediate cause of the protagonist’s death is not directly specified; the bulletin relays a police-attributed possibility of conflict between rival groups."@en,
        "Leitura concorrente: a causa imediata da morte do protagonista permanece não especificada; o noticiário apresenta uma versão atribuída à polícia sobre possível conflito entre grupos rivais."@pt-BR .

ex:hne-s16 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-family-future ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-son ;
    aro:textValue "The protagonist thinks of a child growing up in poverty and connects his fresh start with prospects for material improvement."@en,
        "O protagonista pensa no filho que cresce na pobreza e associa o recomeço à possibilidade de oferecer melhores condições materiais."@pt-BR .

ex:hne-s17 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-community-religion ;
    aro:mentionsDepictedElement ex:hne-religious-setting ;
    aro:textValue "The narrator mentions a bar and Candomblé as local reference points; the religious practice appears as a place for seeking a blessing."@en,
        "O narrador menciona o bar e o candomblé como referências do território; a prática religiosa aparece como lugar de busca de bênção."@pt-BR .

ex:hne-s18 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-family-future ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-son ;
    aro:textValue "The father hopes his son can live safely without having to grow up amid weapons and threats."@en,
        "O pai deseja que o filho tenha vida segura e não seja obrigado a conviver com armas e ameaças."@pt-BR .

ex:hne-s19 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-alcohol-hypocrisy ;
    aro:textValue "The narrator juxtaposes anti-drug campaigns attributed to wealthy people with profits from alcohol sold in the favela."@en,
        "O narrador contrapõe campanhas antidrogas atribuídas aos ricos aos lucros obtidos com a venda de bebidas alcoólicas na favela."@pt-BR .

ex:hne-s20 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-drug-market-inequality,
        ex:pattern-youth-illicit-market ;
    aro:mentionsDepictedElement ex:hne-wealthy-clients ;
    aro:textValue "A week after the young man is killed, the narrative describes crack entering the area and attributes control of the illegal trade to better-resourced actors using low-paid peripheral labor."@en,
        "Uma semana depois da morte do jovem, a narrativa descreve a chegada do crack e atribui o comando econômico do comércio ilegal a atores com mais recursos, que exploram mão de obra periférica."@pt-BR .

ex:hne-s21 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-future-death-anxiety ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "The protagonist fears being killed, recorded merely as indigent, and deprived of identity and dignity."@en,
        "O protagonista expressa medo de ser morto, reconhecido apenas como indigente e privado de identificação e dignidade."@pt-BR .

ex:hne-s22 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-fear-police,
        ex:pattern-silence-violence ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-neighbours ;
    aro:textValue "Dogs, footsteps and cars wake the protagonist; neighbors’ silence is read as a warning of impending danger."@en,
        "Cães, passos e carros despertam o protagonista; o silêncio dos vizinhos é percebido como sinal de perigo iminente."@pt-BR .

ex:hne-s23 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-community-religion,
        ex:pattern-family-future,
        ex:pattern-fear-police ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-police,
        ex:hne-son ;
    aro:textValue "Facing an armed police group while holding his own weapon, the protagonist declares an intention to resist, invokes God and an orixá, and fears leaving his child unsupported."@en,
        "Percebendo o desequilíbrio entre policiais armados e sua própria arma, o protagonista declara intenção de reagir, invoca Deus e seu orixá e teme deixar o filho desamparado."@pt-BR .

ex:hne-s24 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-media-framing,
        ex:pattern-racialized-vulnerability ;
    aro:mentionsDepictedElement ex:hne-man,
        ex:hne-news-narrator ;
    aro:textValue "The coda switches from the protagonist’s perspective to a news report that attributes a rival-gang hypothesis to the police and foregrounds the dead man’s criminal record."@en,
        "A coda substitui o ponto de vista do protagonista por uma comunicação jornalística que atribui à polícia uma hipótese de conflito entre quadrilhas e destaca os antecedentes do morto."@pt-BR .

ex:hne-s25 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-family-future,
        ex:pattern-future-death-anxiety ;
    aro:mentionsDepictedElement ex:hne-man ;
    aro:textValue "Repeated aspirations to earn money and escape poverty emphasize the tension between agency and structural constraints."@en,
        "A repetição das aspirações de ganhar dinheiro e sair da pobreza enfatiza a tensão entre projeto de vida e condicionamentos sociais."@pt-BR .

ex:hne-s26 a aro:SituationDescription ;
    aro:generalizesAs ex:pattern-media-framing ;
    aro:mentionsDepictedElement ex:hne-young-friend ;
    aro:textValue "The narrative criticizes the transformation of a twenty-year-old’s murder into sensationalist news content and public spectacle."@en,
        "A narrativa critica a transformação do assassinato do jovem de vinte anos em mercadoria jornalística e espetáculo público."@pt-BR .

ex:hne-victim-woman a aro:DepictedAgent ;
    aro:textValue "woman found dead"@en,
        "mulher encontrada morta"@pt-BR .

ex:homem-na-estrada-creation a aro:CreativeAct ;
    aro:hasContribution ex:hne-author,
        ex:hne-performer ;
    aro:producesCreation ex:homem-na-estrada,
        ex:homem-na-estrada-1993 .

ex:pattern-alcohol-hypocrisy a aro:SituationPattern ;
    aro:hasCondition ex:c-alcohol-hypocrisy ;
    aro:textValue "Perceived contradiction between anti-drug discourse and profit from alcohol"@en,
        "Contradição percebida entre discurso antidrogas e lucro com álcool"@pt-BR .

ex:pattern-drug-market-inequality a aro:SituationPattern ;
    aro:hasCondition ex:c-drug-market-inequality ;
    aro:textValue "Drug trade, economic hierarchy and exploitation of peripheral labor"@en,
        "Mercado de drogas, hierarquia econômica e exploração da mão de obra periférica"@pt-BR .

ex:pattern-drug-trade-violence a aro:SituationPattern ;
    aro:hasCondition ex:c-dt ;
    aro:textValue "Lethal violence linked to the retail drug trade, with profits concentrated outside the periphery"@en,
        "Violência letal ligada ao varejo de drogas, com lucros concentrados fora da periferia"@pt-BR .

ex:pattern-lynching a aro:SituationPattern ;
    aro:hasCondition ex:c-ly ;
    aro:textValue "Lynching as popular punishment in a neighbourhood"@en,
        "Linchamento como punição popular no bairro"@pt-BR .

