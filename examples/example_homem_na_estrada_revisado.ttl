    aro:citesSource ex:src-letra-cifraclub ;
    aro:confidenceScore 0.85 ;
    aro:describesSituation ex:hne-s08 ;
    aro:hasJustification ex:hne-just08 ;
    aro:hasPrimarySelection ex:hne-e08 ;
    aro:producedByAct ex:reading-act .

ex:hne-r11 a aro:InterpretationRecord ;
    aro:citesSource ex:src-letra-cifraclub ;
    aro:confidenceScore 0.85 ;
