{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aro/schema/derivation-annotation.json",
  "$comment": "Generated by scripts/build.py from model/conceptual-model.json. Do not edit by hand.",
  "title": "ARO derivation annotation (annotator exchange)",
  "description": "One DerivationClaim as produced by an annotation tool. Maps to aro:DerivationClaim, aro:TransformationAspect and oa:Selector. Legality and originality are out of scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "source",
    "derived",
    "derivationTypes",
    "annotator",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "DerivationAnnotation"
    },
    "source": {
      "$ref": "#/$defs/anchor"
    },
    "derived": {
      "$ref": "#/$defs/anchor"
    },
    "derivationTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Rerealization",
          "Translation",
          "Performance",
          "CoverVersion",
          "Arrangement",
          "Transcription",
          "Revision",
          "Abridgment",
          "Amplification",
          "Remake",
          "ExtendedRemix",
          "Incorporation",
          "Quotation",
          "Allusion",
          "UnacknowledgedBorrowing",
          "Sampling",
          "Interpolation",
          "Paraphrase",
          "Medley",
          "Collage",
          "Remix",
          "Appropriation",
          "Ekphrasis",
          "Transformation",
          "Adaptation",
          "IntermedialAdaptation",
          "Parody",
          "Travesty",
          "Variation",
          "Imitation",
          "Pastiche",
          "Caricature",
          "SeriousImitation",
          "Extension",
          "Continuation",
          "Sequel",
          "Prequel",
          "SpinOff",
          "Crossover",
          "FanWork"
        ]
      }
    },
    "regimes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PlayfulRegime",
          "SatiricalRegime",
          "SeriousRegime",
          "ReverentialRegime"
        ]
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag of plain-string texts in this annotation (e.g. en, pt-BR, es)."
    },
    "extent": {
      "$ref": "#/$defs/text"
    },
    "aspects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aspect"
      }
    },
    "justification": {
      "$ref": "#/$defs/text",
      "description": "Explanation of why the derivation is claimed, in one or more languages."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ReferenceSource ids or IRIs."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Application-defined confidence; not a calibrated probability."
    },
    "annotator": {
      "type": "string",
      "format": "uri",
      "description": "IRI of an agent from any external vocabulary."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "selector": {
      "description": "W3C Web Annotation selector (https://www.w3.org/TR/annotation-model/#selectors).",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "description": "Media fragment, e.g. t=12,16 (audio/video) or xywh=10,10,200,120 (image/video region).",
          "properties": {
            "type": {
              "const": "FragmentSelector"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "conformsTo": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "exact"
          ],
          "properties": {
            "type": {
              "const": "TextQuoteSelector"
            },
            "exact": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "start",
            "end"
          ],
          "properties": {
            "type": {
              "const": "TextPositionSelector"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "description": "SVG shape delimiting a region of an image or video frame.",
          "properties": {
            "type": {
              "const": "SvgSelector"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "text": {
      "description": "Plain string (in the annotation's `language`) or a map from BCP 47 tag to text, e.g. {\"en\": \"...\", \"pt-BR\": \"...\", \"es\": \"...\"}.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "target"
      ],
      "properties": {
        "level": {
          "enum": [
            "Artwork",
            "Manifestation",
            "Selection"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Artwork or manifestation id/IRI; for a Selection, the manifestation it selects from."
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      },
      "if": {
        "properties": {
          "level": {
            "const": "Selection"
          }
        }
      },
      "then": {
        "required": [
          "selector"
        ]
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "operation"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "NarrativeDimension",
            "PlotDimension",
            "CharacterDimension",
            "SettingDimension",
            "SituationDimension",
            "NarrationDimension",
            "FocalizationDimension",
            "NarrativeTimeDimension",
            "TextDimension",
            "LyricsDimension",
            "DialogueDimension",
            "DictionDimension",
            "VersificationDimension",
            "LanguageDimension",
            "MusicDimension",
            "MelodyDimension",
            "HarmonyDimension",
            "RhythmDimension",
            "TempoDimension",
            "TimbreDimension",
            "MusicalTextureDimension",
            "MusicalFormDimension",
            "DynamicsDimension",
            "VocalDeliveryDimension",
            "RecordedSoundDimension",
            "ProductionDimension",
            "VisualDimension",
            "VisualCompositionDimension",
            "ColorDimension",
            "ShapeDimension",
            "SurfaceTextureDimension",
            "SpaceDimension",
            "MaterialTechniqueDimension",
            "IconographyDimension",
            "PoseGestureDimension",
            "AudiovisualDimension",
            "MiseEnSceneDimension",
            "SetDesignDimension",
            "CostumeMakeupDimension",
            "LightingDimension",
            "ActingDimension",
            "CinematographyDimension",
            "FramingDimension",
            "CameraMovementDimension",
            "EditingDimension",
            "FilmSoundDimension",
            "GeneralDimension",
            "ThemeDimension",
            "StyleDimension",
            "GenreDimension",
            "ToneDimension",
            "MediumDimension",
            "ParatextDimension",
            "TitleDimension",
            "CreditsDimension",
            "CoverArtDimension"
          ]
        },
        "operation": {
          "enum": [
            "Retained",
            "Modified",
            "Added",
            "Removed",
            "Recontextualized"
          ]
        },
        "sourceSelector": {
          "$ref": "#/$defs/selector"
        },
        "derivedSelector": {
          "$ref": "#/$defs/selector"
        },
        "pattern": {
          "type": "string",
          "description": "SituationPattern id/IRI."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Application-defined confidence; not a calibrated probability."
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
